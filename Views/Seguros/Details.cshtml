@model PROYJHOME2026.Models.Seguro
@{
    ViewData["Title"]      = "Detalle Seguro";
    ViewData["Breadcrumb"] = "Seguros / Detalle";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Seguros</div>
        <h1 class="page-header__title">@Model.TipoSeguro</h1>
        <p class="page-header__subtitle">@Model.CarroSeguros.Count vehículo(s) · @Model.EmpleadoSeguros.Count empleado(s)</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.IdSeguro" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Editar
        </a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>


<div style="max-width:960px; display:flex; gap:16px; flex-wrap:wrap; align-items:flex-start;">

    <!-- Vehículos con este seguro -->
    <div style="flex:1; min-width:300px;">
        <div class="card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
                <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                    <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--azul);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    Vehículos asignados
                </div>
                <span class="badge badge--azul">@Model.CarroSeguros.Count</span>
            </div>

            @if (Model.CarroSeguros.Any())
            {
                <div style="display:flex; flex-direction:column; gap:8px;">
                    @foreach (var cs in Model.CarroSeguros)
                    {
                        <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 12px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200);">
                            <div>
                                <div style="font-weight:600; font-size:0.85rem; color:var(--azul); font-family:monospace;">@cs.Carro?.Placa</div>
                                <div style="font-size:0.76rem; color:var(--gris-600);">@cs.Carro?.Marca @cs.Carro?.Modelo</div>
                                <div style="font-size:0.72rem; color:var(--gris-400); margin-top:2px;">
                                    @(cs.FechaAsignada.HasValue ? "Desde " + cs.FechaAsignada.Value.ToString("dd/MM/yyyy") : "Sin fecha")
                                    @if (cs.FechaCulminada.HasValue) { <span> — Hasta @cs.FechaCulminada.Value.ToString("dd/MM/yyyy")</span> }
                                </div>
                            </div>
                            <a asp-controller="Carros" asp-action="Details" asp-route-id="@cs.IdCarro"
                               class="btn btn--ghost btn--icon btn--sm" title="Ver vehículo">
                                <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="text-align:center; padding:20px 0; color:var(--gris-400); font-size:0.82rem;">
                    Ningún vehículo tiene este seguro asignado.
                </div>
            }
        </div>
    </div>

    <!-- Empleados con este seguro -->
    <div style="flex:1; min-width:300px;">
        <div class="card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
                <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                    <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--celeste);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                    Empleados asignados
                </div>
                <span class="badge badge--celeste">@Model.EmpleadoSeguros.Count</span>
            </div>

            @if (Model.EmpleadoSeguros.Any())
            {
                <div style="display:flex; flex-direction:column; gap:8px;">
                    @foreach (var es in Model.EmpleadoSeguros)
                    {
                        <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 12px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200);">
                            <div>
                                <div style="font-weight:600; font-size:0.85rem; color:var(--gris-900);">@es.Empleado?.nombre @es.Empleado?.paterno</div>
                                <div style="font-size:0.72rem; color:var(--gris-400); margin-top:2px;">
                                    @(es.FechaAsignada.HasValue ? "Desde " + es.FechaAsignada.Value.ToString("dd/MM/yyyy") : "Sin fecha")
                                    @if (es.FechaCulminada.HasValue) { <span> — Hasta @es.FechaCulminada.Value.ToString("dd/MM/yyyy")</span> }
                                </div>
                            </div>
                            <a asp-controller="Empleados" asp-action="Details" asp-route-id="@es.IdEmpleado"
                               class="btn btn--ghost btn--icon btn--sm" title="Ver empleado">
                                <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="text-align:center; padding:20px 0; color:var(--gris-400); font-size:0.82rem;">
                    Ningún empleado tiene este seguro asignado.
                </div>
            }
        </div>
    </div>

</div>
