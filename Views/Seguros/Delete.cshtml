@model PROYJHOME2026.Models.Seguro
@{
    ViewData["Title"]      = "Eliminar Seguro";
    ViewData["Breadcrumb"] = "Seguros / Eliminar";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Seguros</div>
        <h1 class="page-header__title">Eliminar Seguro</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:500px;">
    <div class="card" style="border-color:var(--rojo-border);">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px; padding-bottom:14px; border-bottom:1px solid var(--gris-200);">
            <div style="width:44px;height:44px;border-radius:var(--r-md);background:var(--rojo-light);border:1px solid var(--rojo-border);display:grid;place-items:center;flex-shrink:0;">
                <svg viewBox="0 0 24 24" style="width:20px;height:20px;stroke:var(--rojo);fill:none;stroke-width:1.8;stroke-linecap:round;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
                <div style="font-weight:700; font-size:1rem; color:var(--gris-900);">@Model.TipoSeguro</div>
                <div style="font-size:0.78rem; color:var(--gris-600);">Este seguro será eliminado permanentemente.</div>
            </div>
        </div>
        <div style="background:var(--rojo-light); border:1px solid var(--rojo-border); border-radius:var(--r-sm); padding:10px 14px; margin-bottom:16px; font-size:0.82rem; color:var(--rojo);">
            ⚠️ Si tiene vehículos o empleados asociados, no podrá eliminarse.
        </div>
        <form asp-action="Delete" method="post" style="display:flex; gap:10px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.IdSeguro" />
            <button type="submit" class="btn btn--danger btn--lg">
                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6M9 6V4h6v2"/></svg>
                Eliminar definitivamente
            </button>
            <a asp-action="Details" asp-route-id="@Model.IdSeguro" class="btn btn--secondary btn--lg">Cancelar</a>
        </form>
    </div>
</div>
