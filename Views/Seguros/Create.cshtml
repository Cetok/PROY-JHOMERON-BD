@model PROYJHOME2026.Models.Seguro
@{
    ViewData["Title"]      = "Nuevo Seguro";
    ViewData["Breadcrumb"] = "Seguros / Nuevo";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Seguros</div>
        <h1 class="page-header__title">Nuevo Seguro</h1>
        <p class="page-header__subtitle">Registra un tipo de seguro</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:500px;">
    <div class="card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">Tipo de seguro <span class="req">*</span></label>
                <input asp-for="TipoSeguro" class="form-control" placeholder="Ej: SOAT, SCTR, Vida, Vehicular..." maxlength="100" />
                <span asp-validation-for="TipoSeguro" class="form-error"></span>
            </div>
            <div style="display:flex; gap:10px; padding-top:12px; border-top:1px solid var(--gris-200); margin-top:8px;">
                <button type="submit" class="btn btn--celeste btn--lg">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    Registrar seguro
                </button>
                <a asp-action="Index" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
