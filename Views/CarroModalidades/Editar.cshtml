@model PROYJHOME2026.Models.CarroModalidad
@{
    ViewData["Title"]      = "Editar Modalidad";
    ViewData["Breadcrumb"] = "Flota / Editar Modalidad";
}
<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Flota Vehicular</div>
        <h1 class="page-header__title">Editar Fechas de Modalidad</h1>
        <p class="page-header__subtitle">@Model.Carro?.Placa — @Model.Modalidad?.TipoModalidad</p>
    </div>
    <div class="page-header__actions">
        <a asp-controller="Carros" asp-action="Details" asp-route-id="@Model.IdCarro" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver al vehículo
        </a>
    </div>
</div>
<div style="max-width:520px;">
    <div class="card">
        <form asp-action="Editar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="idCarro"     value="@Model.IdCarro" />
            <input type="hidden" name="idModalidad" value="@Model.IdModalidad" />

            <div style="padding:12px 16px; background:var(--gris-50); border-radius:var(--r-sm); margin-bottom:20px; border:1px solid var(--gris-200);">
                <div style="font-size:0.72rem; color:var(--gris-400); font-weight:600; text-transform:uppercase; letter-spacing:0.08em; margin-bottom:4px;">Modalidad</div>
                <div style="font-weight:700; color:var(--gris-900);">@Model.Modalidad?.TipoModalidad</div>
                <div style="font-size:0.78rem; color:var(--gris-500);">Código: @(Model.Modalidad?.Codigo ?? "—")</div>
            </div>

            <div class="form-grid" style="margin-bottom:16px;">
                <div class="form-group">
                    <label class="form-label">Fecha de asignación</label>
                    <input asp-for="FechaAsignacion" type="date" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Fecha de vencimiento</label>
                    <input asp-for="FechaVencimiento" type="date" class="form-control" />
                    <span style="font-size:0.72rem; color:var(--gris-400); margin-top:3px; display:block;">
                        Aprox. 6 meses desde la asignación
                    </span>
                </div>
            </div>

            <div style="display:flex; gap:10px; padding-top:12px; border-top:1px solid var(--gris-200);">
                <button type="submit" class="btn btn--celeste btn--lg">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    Guardar cambios
                </button>
                <a asp-controller="Carros" asp-action="Details" asp-route-id="@Model.IdCarro" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
