@model IEnumerable<PROYJHOME2026.Models.EquipoBitacora>
@{
    ViewData["Title"]      = "Historial de equipos";
    ViewData["Breadcrumb"] = "Historial de equipos";
    int pagina       = ViewBag.Pagina;
    int totalPaginas = ViewBag.TotalPaginas;
    int total        = ViewBag.Total;
    string buscar    = ViewBag.Buscar ?? "";
    string orden     = ViewBag.Orden  ?? "za";
    string? estado   = ViewBag.Estado;

    var estadosFiltro = new[] {
        "Mantenimiento", "Malogrado", "Defectuoso", "En reparación", "Dado de baja", "En revisión"
    };
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Equipos TI</div>
        <h1 class="page-header__title">Historial de equipos</h1>
        <p class="page-header__subtitle">@total registro(s) de bitácora — solo lectura</p>
    </div>
    <div class="page-header__actions">
        <button type="button" class="btn btn--secondary btn--sm" onclick="exportarTabla('Historial_Equipos', 'excel')" title="Exportar a Excel">
            <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            Excel
        </button>
        <button type="button" class="btn btn--secondary btn--sm" onclick="exportarTabla('Historial_Equipos', 'pdf')" title="Exportar a PDF">
            <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            PDF
        </button>
    </div>
</div>

<!-- FILTROS -->
<div class="card" style="margin-bottom:20px; padding:16px 20px;">
    <form method="get" asp-action="Index" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
        <div style="flex:1; min-width:180px;">
            <label class="form-label">Buscar</label>
            <div style="position:relative;">
                <svg style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:15px;height:15px;stroke:var(--gris-400);fill:none;stroke-width:2;stroke-linecap:round;pointer-events:none;" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" name="buscar" value="@buscar" class="form-control"
                       style="padding-left:32px;" placeholder="Equipo, motivo..." />
            </div>
        </div>
        <div style="min-width:180px;">
            <label class="form-label">Estado</label>
            <select name="estado" class="form-control">
                <option value="">Todos</option>
                @foreach (var e in estadosFiltro)
                {
                    if (estado == e)
                    {
                        <option value="@e" selected>@e</option>
                    }
                    else
                    {
                        <option value="@e">@e</option>
                    }
                }
            </select>
        </div>
        <div style="display:flex; gap:8px;">
            <button type="submit" class="btn btn--primary">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                Buscar
            </button>
            @if (!string.IsNullOrEmpty(buscar) || !string.IsNullOrEmpty(estado))
            {
                <a asp-action="Index" class="btn btn--secondary">Limpiar</a>
            }
        </div>
    </form>
</div>

<!-- TABLA -->
<div class="card" style="padding:0; overflow:hidden;">
    @if (Model.Any())
    {
        <div class="table-wrapper" style="border:none; border-radius:0;">
            <table>
                <thead>
                    <tr>
                        <th>Equipo</th>
                        <th>Estado</th>
                        <th>Motivo</th>
                        <th>Fecha</th>
                        <th>Registrado por</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        var nombreEq = b.Equipo?.TipoEquipo?.tipo?.ToUpper().Contains("PC COMPLETO") == true
                            ? b.Equipo.NombrePc
                            : $"{b.Equipo?.marca} {b.Equipo?.modelo}";
                        <tr>
                            <td>
                                <div style="font-weight:600; font-size:0.85rem; color:var(--gris-900);">
                                    @(nombreEq ?? "—")
                                </div>
                                <div style="font-size:0.75rem; color:var(--gris-500);">
                                    <a asp-controller="Equipos" asp-action="Details" asp-route-id="@b.IdEquipo"
                                       style="color:var(--celeste);">Equipo #@b.IdEquipo</a>
                                    · @(b.Equipo?.TipoEquipo?.tipo ?? "—")
                                </div>
                            </td>
                            <td>
                                @{
                                    var badgeEstado = b.EstadoNuevo switch {
                                        "Mantenimiento" => "badge--amarillo",
                                        "Inactivo"      => "badge--rojo",
                                        "Asignado"      => "badge--celeste",
                                        "Activo"        => "badge--verde",
                                        _               => "badge--gris"
                                    };
                                }
                                <span class="badge @badgeEstado">@b.EstadoNuevo</span>
                                @if (!string.IsNullOrEmpty(b.EstadoAnterior) && b.EstadoAnterior != b.EstadoNuevo)
                                {
                                    <div style="font-size:0.72rem; color:var(--gris-400); margin-top:3px;">desde @b.EstadoAnterior</div>
                                }
                            </td>
                            <td style="font-size:0.82rem; color:var(--gris-600); max-width:260px;">
                                <span style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                                    @b.Motivo
                                </span>
                            </td>
                            <td style="font-size:0.82rem; color:var(--gris-600); white-space:nowrap;">
                                @b.Fecha.ToString("dd/MM/yyyy")
                            </td>
                            <td style="font-size:0.78rem; color:var(--gris-400);">
                                @(b.RegistradoPor ?? "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPaginas > 1)
        {
            <div class="pagination">
                <span style="font-size:0.75rem; color:var(--gris-400); margin-right:8px;">
                    Página @pagina de @totalPaginas
                </span>
                @if (pagina > 1)
                {
                    <a asp-action="Index" asp-route-pagina="@(pagina-1)"
                       asp-route-buscar="@buscar" asp-route-estado="@estado" asp-route-orden="@orden"
                       class="pagination__btn"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg></a>
                }
                @for (int i = Math.Max(1, pagina-2); i <= Math.Min(totalPaginas, pagina+2); i++)
                {
                    <a asp-action="Index" asp-route-pagina="@i"
                       asp-route-buscar="@buscar" asp-route-estado="@estado" asp-route-orden="@orden"
                       class="pagination__btn @(i == pagina ? "active" : "")">@i</a>
                }
                @if (pagina < totalPaginas)
                {
                    <a asp-action="Index" asp-route-pagina="@(pagina+1)"
                       asp-route-buscar="@buscar" asp-route-estado="@estado" asp-route-orden="@orden"
                       class="pagination__btn"><svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg></a>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state__icon">
                <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            </div>
            <div class="empty-state__title">Sin registros de historial</div>
            <div class="empty-state__text">
                @if (!string.IsNullOrEmpty(buscar) || !string.IsNullOrEmpty(estado))
                { <span>Intenta con otros filtros.</span> }
                else { <span>Aún no hay eventos de bitácora registrados (fuera de Activo/Inactivo).</span> }
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
function exportarTabla(titulo, tipo) {
    var params = 'buscar='+encodeURIComponent(document.querySelector('[name="buscar"]')?.value||'')
        +'&estado='+encodeURIComponent(document.querySelector('[name="estado"]')?.value||'');
    var base = tipo === 'pdf' ? '/Historiales/ExportarPdf' : '/Historiales/ExportarExcel';
    fetch(base + '?' + params)
        .then(function(res) {
            if (!res.ok) throw new Error('Error ' + res.status);
            return res.blob();
        })
        .then(function(blob) {
            var u = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = u;
            a.download = titulo.replace(/ /g,'_') + '_' + new Date().toISOString().slice(0,10)
                       + (tipo === 'pdf' ? '.pdf' : '.csv');
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(u);
        })
        .catch(function(e) { alert('Error al exportar: ' + e.message); });
}
</script>
}
