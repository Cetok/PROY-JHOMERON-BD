@model IEnumerable<PROYJHOME2026.Models.Historial>
@{
    ViewData["Title"]      = "Historiales";
    ViewData["Breadcrumb"] = "Historiales";
    int pagina       = ViewBag.Pagina;
    int totalPaginas = ViewBag.TotalPaginas;
    int total        = ViewBag.Total;
    string buscar    = ViewBag.Buscar ?? "";
    string orden     = ViewBag.Orden  ?? "za";
    int? motivoId    = ViewBag.MotivoId;
    int? asigId      = ViewBag.AsignacionId;
    var motivos      = ViewBag.Motivos as List<PROYJHOME2026.Models.Motivo> ?? new();
    var asigCtx      = ViewBag.AsignacionCtx as PROYJHOME2026.Models.Asignacion;
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Equipos TI</div>
        <h1 class="page-header__title">Historiales</h1>
        <p class="page-header__subtitle">
            @if (asigCtx != null)
            {
                <span>Asignación #@asigCtx.IdAsignacion — @(asigCtx.Empleado?.nombre) @(asigCtx.Empleado?.paterno) / @(asigCtx.Equipo?.marca) @(asigCtx.Equipo?.modelo)</span>
            }
            else
            {
                <span>@total registro(s) encontrado(s)</span>
            }
        </p>
    </div>
    <div class="page-header__actions">
        @if (asigCtx != null)
        {
            <a asp-action="Create" asp-route-asignacionId="@asigCtx.IdAsignacion" class="btn btn--celeste">
                <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Agregar registro
            </a>
            <a asp-controller="Asignaciones" asp-action="Details" asp-route-id="@asigCtx.IdAsignacion"
               class="btn btn--secondary">
                <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Volver a asignación
            </a>
        }
        else
        {
            <a asp-action="Create" class="btn btn--celeste">
                <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Nuevo registro
            </a>
        }
    </div>
</div>

<!-- FILTROS — solo si no viene filtrado por asignación -->
@if (asigCtx == null)
{
    <div class="card" style="margin-bottom:20px; padding:16px 20px;">
        <form method="get" asp-action="Index" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
            <div style="flex:1; min-width:180px;">
                <label class="form-label">Buscar</label>
                <div style="position:relative;">
                    <svg style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:15px;height:15px;stroke:var(--gris-400);fill:none;stroke-width:2;stroke-linecap:round;pointer-events:none;" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="text" name="buscar" value="@buscar" class="form-control"
                           style="padding-left:34px;" placeholder="Empleado, motivo, observaciones..." />
                </div>
            </div>
            <div style="min-width:180px;">
                <label class="form-label">Motivo</label>
                <select name="motivoId" class="form-control">
                    <option value="">Todos</option>
                    @foreach (var m in motivos)
                    {
                        if (motivoId == m.IdMotivo)
                        {
                            <option value="@m.IdMotivo" selected>@m.TipoMotivo</option>
                        }
                        else
                        {
                            <option value="@m.IdMotivo">@m.TipoMotivo</option>
                        }
                    }
                </select>
            </div>
            <div style="min-width:130px;">
                <label class="form-label">Ordenar</label>
                <select name="orden" class="form-control">
                    <option value="za" @(orden == "za" ? "selected" : "")>Más reciente</option>
                    <option value="az" @(orden == "az" ? "selected" : "")>Más antiguo</option>
                </select>
            </div>
            <div style="display:flex; gap:8px;">
                <button type="submit" class="btn btn--primary">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    Buscar
                </button>
                @if (!string.IsNullOrEmpty(buscar) || motivoId.HasValue)
                {
                    <a asp-action="Index" class="btn btn--secondary">Limpiar</a>
                }
            </div>
        </form>
    </div>
}

<!-- TABLA -->
<div class="card" style="padding:0; overflow:hidden;">
    @if (Model.Any())
    {
        <div class="table-wrapper" style="border:none; border-radius:0;">
            <table>
                <thead>
                    <tr>
                        <th style="width:50px;">#</th>
                        <th>Asignación</th>
                        <th>Motivo</th>
                        <th>Fecha</th>
                        <th>Observaciones</th>
                        <th style="text-align:center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model)
                    {
                        <tr>
                            <td style="color:var(--gris-400); font-size:0.78rem; font-weight:400;">
                                @h.IdHistoria
                            </td>
                            <td>
                                <div style="font-weight:600; font-size:0.85rem; color:var(--gris-900);">
                                    @(h.Asignacion?.Empleado?.nombre ?? "—") @(h.Asignacion?.Empleado?.paterno ?? "")
                                </div>
                                <div style="font-size:0.75rem; color:var(--gris-500);">
                                    @(h.Asignacion?.Equipo?.marca ?? "—") @(h.Asignacion?.Equipo?.modelo ?? "") ·
                                    <a asp-controller="Asignaciones" asp-action="Details"
                                       asp-route-id="@h.IdAsignacion"
                                       style="color:var(--celeste);">Asig. #@h.IdAsignacion</a>
                                </div>
                            </td>
                            <td>
                                <span class="badge badge--azul">@(h.Motivo?.TipoMotivo ?? "—")</span>
                            </td>
                            <td style="font-size:0.82rem; color:var(--gris-600); white-space:nowrap;">
                                @h.Fecha.ToString("dd/MM/yyyy")
                            </td>
                            <td style="font-size:0.82rem; color:var(--gris-600); max-width:220px;">
                                @if (!string.IsNullOrEmpty(h.Observaciones))
                                {
                                    <span style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                                        @h.Observaciones
                                    </span>
                                }
                                else
                                {
                                    <span style="color:var(--gris-300);">Sin observaciones</span>
                                }
                            </td>
                            <td>
                                <div style="display:flex; gap:6px; justify-content:center;">
                                    <a asp-action="Details" asp-route-id="@h.IdHistoria"
                                       class="btn btn--ghost btn--icon" title="Ver detalle">
                                        <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@h.IdHistoria"
                                       class="btn btn--secondary btn--icon" title="Editar">
                                        <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@h.IdHistoria"
                                       class="btn btn--danger btn--icon" title="Eliminar">
                                        <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6M9 6V4h6v2"/></svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPaginas > 1)
        {
            <div class="pagination">
                <span style="font-size:0.75rem; color:var(--gris-400); margin-right:8px;">
                    Página @pagina de @totalPaginas
                </span>
                @if (pagina > 1)
                {
                    <a asp-action="Index" asp-route-pagina="@(pagina-1)"
                       asp-route-buscar="@buscar" asp-route-motivoId="@motivoId" asp-route-asignacionId="@asigId" asp-route-orden="@orden"
                       class="pagination__btn"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg></a>
                }
                @for (int i = Math.Max(1, pagina-2); i <= Math.Min(totalPaginas, pagina+2); i++)
                {
                    <a asp-action="Index" asp-route-pagina="@i"
                       asp-route-buscar="@buscar" asp-route-motivoId="@motivoId" asp-route-asignacionId="@asigId" asp-route-orden="@orden"
                       class="pagination__btn @(i == pagina ? "active" : "")">@i</a>
                }
                @if (pagina < totalPaginas)
                {
                    <a asp-action="Index" asp-route-pagina="@(pagina+1)"
                       asp-route-buscar="@buscar" asp-route-motivoId="@motivoId" asp-route-asignacionId="@asigId" asp-route-orden="@orden"
                       class="pagination__btn"><svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg></a>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state__icon">
                <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            </div>
            <div class="empty-state__title">Sin registros de historial</div>
            <div class="empty-state__text">
                @if (!string.IsNullOrEmpty(buscar) || motivoId.HasValue)
                { <span>Intenta con otros filtros.</span> }
                else { <span>Aún no hay eventos registrados.</span> }
            </div>
            <a asp-action="Create" class="btn btn--celeste" style="margin-top:8px;">
                <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Agregar primer registro
            </a>
        </div>
    }
</div>
