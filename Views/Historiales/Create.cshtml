@model PROYJHOME2026.Models.Historial
@{
    ViewData["Title"]      = "Nuevo Registro de Historial";
    ViewData["Breadcrumb"] = "Historiales / Nuevo";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Equipos TI</div>
        <h1 class="page-header__title">Nuevo Registro</h1>
        <p class="page-header__subtitle">Registra un evento en el historial de una asignación</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:640px;">
    <div class="card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div style="margin-bottom:24px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Referencia
                </p>
                <div class="form-grid">
                    <div class="form-group form-group--full">
                        <label class="form-label">Asignación <span class="req">*</span></label>
                        <select asp-for="IdAsignacion" asp-items="ViewBag.AsignacionesList" class="form-control">
                            <option value="">— Seleccionar asignación —</option>
                        </select>
                        <span asp-validation-for="IdAsignacion" class="form-error"></span>
                        <div class="form-hint">Se muestra: #ID — Empleado / Equipo [Estado]</div>
                    </div>
                    <div class="form-group form-group--full">
                        <label class="form-label">Motivo <span class="req">*</span></label>
                        <select asp-for="IdMotivo" asp-items="ViewBag.MotivosList" class="form-control">
                            <option value="">— Seleccionar motivo —</option>
                        </select>
                        <span asp-validation-for="IdMotivo" class="form-error"></span>
                    </div>
                </div>
            </div>

            <div style="margin-bottom:28px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Detalle del evento
                </p>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Fecha del evento <span class="req">*</span></label>
                        <input asp-for="Fecha" type="date" class="form-control" />
                        <span asp-validation-for="Fecha" class="form-error"></span>
                    </div>
                    <div class="form-group form-group--full">
                        <label class="form-label">Observaciones</label>
                        <textarea asp-for="Observaciones" class="form-control"
                                  rows="4" maxlength="500"
                                  placeholder="Describe el evento, incidencia o novedad..."></textarea>
                        <span asp-validation-for="Observaciones" class="form-error"></span>
                        <div class="form-hint">Máximo 500 caracteres.</div>
                    </div>
                </div>
            </div>

            <div style="display:flex; gap:10px; padding-top:4px; border-top:1px solid var(--gris-200);">
                <button type="submit" class="btn btn--celeste btn--lg">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    Guardar registro
                </button>
                <a asp-action="Index" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
