@model PROYJHOME2026.Models.EmpleadoSeguro
@{
    ViewData["Title"]      = "Editar Seguro de Empleado";
    ViewData["Breadcrumb"] = "Empleados / Editar Seguro";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Recursos Humanos</div>
        <h1 class="page-header__title">Editar Seguro</h1>
        <p class="page-header__subtitle">@Model.Empleado?.nombre @Model.Empleado?.paterno — @Model.Seguro?.TipoSeguro</p>
    </div>
    <div class="page-header__actions">
        <a asp-controller="Empleados" asp-action="Details" asp-route-id="@Model.IdEmpleado" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:540px;">
    <div class="card">
        <form asp-action="Editar" asp-route-idEmpleado="@Model.IdEmpleado" asp-route-idSeguro="@Model.IdSeguro" method="post">
            @Html.AntiForgeryToken()

            <div style="background:var(--gris-50); border:1px solid var(--gris-200); border-radius:var(--r-sm); padding:10px 14px; margin-bottom:18px; font-size:0.85rem; color:var(--gris-700);">
                <strong>Seguro:</strong> @Model.Seguro?.TipoSeguro &nbsp;·&nbsp;
                <strong>Empleado:</strong> @Model.Empleado?.nombre @Model.Empleado?.paterno
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Fecha de inicio</label>
                    <input asp-for="FechaAsignada" type="date" class="form-control" />
                    <span asp-validation-for="FechaAsignada" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Fecha de vencimiento</label>
                    <input asp-for="FechaCulminada" type="date" class="form-control" />
                    <span asp-validation-for="FechaCulminada" class="form-error"></span>
                </div>
            </div>

            <div style="display:flex; gap:10px; padding-top:12px; border-top:1px solid var(--gris-200); margin-top:8px;">
                <button type="submit" class="btn btn--celeste btn--lg">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    Guardar cambios
                </button>
                <a asp-controller="Empleados" asp-action="Details" asp-route-id="@Model.IdEmpleado" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
