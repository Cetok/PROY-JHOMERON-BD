@model PROYJHOME2026.Models.Grupo
@{
    ViewData["Title"]      = "Detalle Grupo";
    ViewData["Breadcrumb"] = "Grupos / Detalle";
    var asesorios = ViewBag.Asesorios as List<PROYJHOME2026.Models.GrupoAsesorio> ?? new();
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Recursos Humanos</div>
        <h1 class="page-header__title">@(Model.area ?? "Sin nombre")</h1>
        <p class="page-header__subtitle">ID: #@Model.idGrupo</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.idGrupo" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Editar
        </a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:680px; display:flex; flex-direction:column; gap:16px;">

    <!-- Datos del grupo -->
    <div class="card">
        <div style="display:flex; align-items:center; gap:14px; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid var(--gris-200);">
            <div class="grupo-icon-lg">
                <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            </div>
            <div>
                <div style="font-family:var(--font-display); font-size:1.15rem; font-weight:700; color:var(--azul-dark);">
                    @(Model.area ?? "Sin nombre")
                </div>
                <div style="font-size:0.78rem; color:var(--gris-500); margin-top:2px;">ID de grupo: #@Model.idGrupo</div>
            </div>
        </div>
        <div>
            <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:4px;">Área</div>
            <div style="font-size:0.92rem; font-weight:500; color:var(--gris-900);">@(Model.area ?? "—")</div>
        </div>
    </div>

    <!-- Accesorios del grupo -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--azul);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
                Accesorios asignados
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
                <span class="badge badge--azul">@asesorios.Count</span>
                <a asp-controller="GrupoAsesorios" asp-action="Asignar" asp-route-idGrupo="@Model.idGrupo"
                   class="btn btn--celeste btn--sm">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Asignar accesorio
                </a>
            </div>
        </div>

        @if (asesorios.Any())
        {
            <div style="display:flex; flex-direction:column; gap:8px;">
                @foreach (var ga in asesorios)
                {
                    bool esExtintor = !string.IsNullOrEmpty(ga.TipoExtintor);
                    var vence       = ga.FechaVencimientoExtintor;
                    var diasRest    = vence.HasValue
                        ? vence.Value.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber
                        : (int?)null;
                    var colVenc     = diasRest.HasValue
                        ? (diasRest <= 30 ? "#dc2626" : diasRest <= 90 ? "#d97706" : "var(--gris-500)")
                        : "var(--gris-500)";

                    <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 14px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200);">
                        <div style="flex:1; min-width:0;">

                            <div style="font-weight:600; font-size:0.85rem; color:var(--gris-900);">@ga.Asesorio?.TipoAsesorio</div>

                            <div style="font-size:0.72rem; color:var(--gris-400); margin-top:2px;">
                                @if (ga.FechaAsignada.HasValue) { <span>Desde @ga.FechaAsignada.Value.ToString("dd/MM/yyyy")</span> }
                                @if (!string.IsNullOrEmpty(ga.Observaciones)) { <span> · @ga.Observaciones</span> }
                            </div>

                            @if (esExtintor)
                            {
                                <div style="display:flex; gap:8px; align-items:center; margin-top:5px; flex-wrap:wrap;">
                                    <span class="badge" style="background:rgba(220,38,38,0.1); color:#dc2626; font-size:0.68rem;">
                                        🧯 @ga.TipoExtintor
                                    </span>
                                    @if (!string.IsNullOrEmpty(ga.PesoExtintor))
                                    {
                                        <span style="font-size:0.72rem; color:var(--gris-600);">@ga.PesoExtintor</span>
                                    }
                                    @if (vence.HasValue)
                                    {
                                        <span style="font-size:0.72rem; color:@colVenc; font-weight:600;">
                                            Vence: @vence.Value.ToString("dd/MM/yyyy")
                                            @if (diasRest.HasValue && diasRest <= 90)
                                            {
                                                <span>(@diasRest días)</span>
                                            }
                                        </span>
                                    }
                                </div>
                            }

                        </div>
                        <div style="display:flex; gap:4px; flex-shrink:0; margin-left:12px;">
                            <a asp-controller="GrupoAsesorios" asp-action="Editar"
                               asp-route-idGrupo="@Model.idGrupo" asp-route-idAsesorio="@ga.IdAsesorio"
                               class="btn btn--ghost btn--icon btn--sm" title="Editar">
                                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </a>
                            <form asp-controller="GrupoAsesorios" asp-action="Quitar" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idGrupo"    value="@Model.idGrupo" />
                                <input type="hidden" name="idAsesorio" value="@ga.IdAsesorio" />
                                <button type="submit" class="btn btn--danger btn--icon btn--sm"
                                        onclick="return confirm('¿Quitar este accesorio del grupo?')">
                                    <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="text-align:center; padding:16px 0; color:var(--gris-400); font-size:0.82rem;">
                Este grupo no tiene accesorios asignados.
            </div>
        }
    </div>

    <!-- Inspección de Botiquín -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:#16a34a;fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                Inspección de Botiquín
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
                <a asp-controller="InspeccionBotiquinGrupo" asp-action="Crear" asp-route-idGrupo="@Model.idGrupo"
                   class="btn btn--celeste btn--sm">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Nueva Inspección
                </a>
                <a asp-controller="InspeccionBotiquinGrupo" asp-action="Historial" asp-route-idGrupo="@Model.idGrupo"
                   class="btn btn--secondary btn--sm">
                    <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    Ver historial
                </a>
            </div>
        </div>
        <div style="font-size:0.82rem; color:var(--gris-400);">
            Registra y consulta las inspecciones diarias del botiquín de este grupo.
        </div>
    </div>

</div>

@section Styles {
<style>
.grupo-icon-lg {
    width: 48px; height: 48px; border-radius: var(--r-md);
    background: var(--celeste-glow); border: 1px solid var(--celeste-border);
    display: grid; place-items: center; flex-shrink: 0;
}
.grupo-icon-lg svg { width: 22px; height: 22px; stroke: var(--celeste); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
</style>
}
