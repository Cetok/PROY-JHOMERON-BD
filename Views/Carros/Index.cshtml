@model IEnumerable<PROYJHOME2026.Models.Carro>
@{
    ViewData["Title"]      = "Vehículos";
    ViewData["Breadcrumb"] = "Flota Vehicular";
    int pagina       = ViewBag.Pagina;
    int totalPaginas = ViewBag.TotalPaginas;
    int total        = ViewBag.Total;
    string buscar    = ViewBag.Buscar    ?? "";
    string estado    = ViewBag.Estado    ?? "";
    string categoria = ViewBag.Categoria ?? "";
    var categorias   = ViewBag.Categorias as List<string> ?? new();
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Flota Vehicular</div>
        <h1 class="page-header__title">Vehículos</h1>
        <p class="page-header__subtitle">@total vehículo(s) encontrado(s)</p>
    </div>
    <div class="page-header__actions">
        <button type="button" class="btn btn--secondary btn--sm" onclick="exportarTabla('Vehículos', 'excel')" title="Exportar a Excel">
            <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            Excel
        </button>
        <button type="button" class="btn btn--secondary btn--sm" onclick="exportarTabla('Vehículos', 'pdf')" title="Exportar a PDF">
            <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            PDF
        </button>
        <a asp-controller="Modalidades" asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            Modalidades
        </a>
        <a asp-action="Create" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nuevo vehículo
        </a>
    </div>
</div>

<!-- FILTROS -->
<div class="card" style="margin-bottom:20px; padding:16px 20px;">
    <form method="get" asp-action="Index" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
        <div style="flex:1; min-width:180px;">
            <label class="form-label">Buscar</label>
            <div style="position:relative;">
                <svg style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:15px;height:15px;stroke:var(--gris-400);fill:none;stroke-width:2;stroke-linecap:round;pointer-events:none;" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" name="buscar" value="@buscar" class="form-control"
                       style="padding-left:34px;" placeholder="Placa, marca, empleado..." />
            </div>
        </div>
        <div style="min-width:150px;">
            <label class="form-label">Estado</label>
            <select name="estado" class="form-control">
                <option value="">Todos</option>
                @foreach (var op in new[] { "Activo", "Inactivo", "En mantenimiento", "De baja" }) {
                    if (estado == op) { <option value="@op" selected>@op</option> }
                    else              { <option value="@op">@op</option> }
                }
            </select>
        </div>
        @if (categorias.Any())
        {
            <div style="min-width:150px;">
                <label class="form-label">Categoría</label>
                <select name="categoria" class="form-control">
                    <option value="">Todas</option>
                    @foreach (var cat in categorias) {
                        if (categoria == cat) { <option value="@cat" selected>@cat</option> }
                        else                  { <option value="@cat">@cat</option> }
                    }
                </select>
            </div>
        }
        <div style="display:flex; gap:8px;">
            <button type="submit" class="btn btn--primary">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                Buscar
            </button>
            @if (!string.IsNullOrEmpty(buscar) || !string.IsNullOrEmpty(estado) || !string.IsNullOrEmpty(categoria))
            {
                <a asp-action="Index" class="btn btn--secondary">Limpiar</a>
            }
        </div>
    </form>
</div>

<!-- TABLA -->
<div class="card" style="padding:0; overflow:hidden;">
    @if (Model.Any())
    {
        <div class="table-wrapper" style="border:none; border-radius:0;">
            <table>
                <thead>
                    <tr>
                        <th>Placa</th>
                        <th>Vehículo</th>
                        <th>Conductor asignado</th>
                        <th>Categoría</th>
                        <th style="text-align:center;">Ejes</th>
                        <th>Estado</th>
                        <th style="text-align:center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        var conductor = c.EmpleadosCarros.FirstOrDefault()?.Empleado;
                        <tr>
                            <td>
                                <span style="font-family:monospace; font-weight:700; font-size:0.9rem; letter-spacing:0.08em; color:var(--azul);">
                                    @c.Placa
                                </span>
                            </td>
                            <td>
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <div class="carro-icon">
                                        <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                                    </div>
                                    <div>
                                        <div style="font-weight:600; color:var(--gris-900);">@c.Marca @c.Modelo</div>
                                        @if (c.FechaCarro.HasValue)
                                        {
                                            <div style="font-size:0.75rem; color:var(--gris-400);">Año @c.FechaCarro.Value.Year</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (conductor != null)
                                {
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        <div class="emp-avatar-sm">
                                            @((conductor.nombre?.Length > 0 ? conductor.nombre[0].ToString() : "?").ToUpper())@((conductor.paterno?.Length > 0 ? conductor.paterno[0].ToString() : "").ToUpper())
                                        </div>
                                        <div>
                                            <div style="font-size:0.85rem; font-weight:600; color:var(--gris-900);">@conductor.nombre @conductor.paterno</div>
                                            <div style="font-size:0.72rem; color:var(--gris-400);">@conductor.dni</div>
                                        </div>
                                    </div>
                                }
                                else { <span style="font-size:0.82rem; color:var(--gris-400);">Sin asignar</span> }
                            </td>
                            <td style="font-size:0.82rem; color:var(--gris-600);">@(c.Categoria ?? "—")</td>
                            <td style="font-size:0.82rem; color:var(--gris-600); text-align:center;">@(c.Ejes.HasValue ? c.Ejes.ToString() : "—")</td>
                            <td>
                                @{
                                    var bc = c.Estado switch {
                                        "Activo"           => "badge--verde",
                                        "Inactivo"         => "badge--gris",
                                        "En mantenimiento" => "badge--amarillo",
                                        "De baja"          => "badge--rojo",
                                        _                  => "badge--gris"
                                    };
                                }
                                <span class="badge @bc">@c.Estado</span>
                            </td>
                            <td>
                                <div style="display:flex; gap:6px; justify-content:center;">
                                    <a asp-action="Details" asp-route-id="@c.IdCarro" class="btn btn--ghost btn--icon" title="Ver detalle">
                                        <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@c.IdCarro" class="btn btn--secondary btn--icon" title="Editar">
                                        <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (totalPaginas > 1)
        {
            <div class="pagination">
                <span style="font-size:0.75rem; color:var(--gris-400); margin-right:8px;">Página @pagina de @totalPaginas</span>
                @if (pagina > 1) {
                    <a asp-action="Index" asp-route-pagina="@(pagina-1)" asp-route-buscar="@buscar" asp-route-estado="@estado" asp-route-categoria="@categoria" class="pagination__btn"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg></a>
                }
                @for (int i = Math.Max(1, pagina-2); i <= Math.Min(totalPaginas, pagina+2); i++) {
                    <a asp-action="Index" asp-route-pagina="@i" asp-route-buscar="@buscar" asp-route-estado="@estado" asp-route-categoria="@categoria" class="pagination__btn @(i == pagina ? "active" : "")">@i</a>
                }
                @if (pagina < totalPaginas) {
                    <a asp-action="Index" asp-route-pagina="@(pagina+1)" asp-route-buscar="@buscar" asp-route-estado="@estado" asp-route-categoria="@categoria" class="pagination__btn"><svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg></a>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state__icon">
                <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <div class="empty-state__title">No se encontraron vehículos</div>
            <div class="empty-state__text">
                @if (!string.IsNullOrEmpty(buscar) || !string.IsNullOrEmpty(estado) || !string.IsNullOrEmpty(categoria))
                { <span>Intenta con otros filtros.</span> }
                else { <span>Aún no hay vehículos registrados en la flota.</span> }
            </div>
        </div>
    }
</div>


@section Scripts {
<script>
function exportarTabla(titulo, tipo) {
    var params = 'buscar='+encodeURIComponent(document.querySelector('[name="buscar"]')?.value||'')
        +'&estado='+encodeURIComponent(document.querySelector('[name="estado"]')?.value||'');
    var base = tipo === 'pdf' ? '/Carros/ExportarPdf' : '/Carros/ExportarExcel';
    fetch(base + '?' + params)
        .then(function(res) {
            if (!res.ok) throw new Error('Error ' + res.status);
            return res.blob();
        })
        .then(function(blob) {
            var u = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = u;
            a.download = titulo.replace(/ /g,'_') + '_' + new Date().toISOString().slice(0,10)
                       + (tipo === 'pdf' ? '.pdf' : '.csv');
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(u);
        })
        .catch(function(e) { alert('Error al exportar: ' + e.message); });
}
</script>
}
@section Styles {
<style>
.carro-icon { width:32px; height:32px; border-radius:var(--r-sm); background:rgba(26,58,107,0.08); border:1px solid rgba(26,58,107,0.12); display:grid; place-items:center; flex-shrink:0; }
.carro-icon svg { width:15px; height:15px; stroke:var(--azul); fill:none; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
.emp-avatar-sm { width:28px; height:28px; border-radius:50%; background:linear-gradient(135deg, var(--azul-mid), var(--celeste)); display:grid; place-items:center; flex-shrink:0; font-family:var(--font-display); font-weight:800; font-size:0.65rem; color:var(--blanco); }
</style>
}
