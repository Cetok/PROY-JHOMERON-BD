@model PROYJHOME2026.Models.Carro
@{
    ViewData["Title"]      = "Detalle Vehículo";
    ViewData["Breadcrumb"] = "Flota Vehicular / Detalle";
    var bc = Model.Estado switch {
        "Activo"           => "badge--verde",
        "Inactivo"         => "badge--gris",
        "En mantenimiento" => "badge--amarillo",
        "De baja"          => "badge--rojo",
        _                  => "badge--gris"
    };
    var estadoLog    = ViewBag.EstadoLog    as List<PROYJHOME2026.Models.CarroEstadoLog>    ?? new();
    var conductorLog = ViewBag.ConductorLog as List<PROYJHOME2026.Models.CarroConductorLog> ?? new();
    var modalidadLog = ViewBag.ModalidadLog as List<PROYJHOME2026.Models.CarroModalidadLog> ?? new();
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Flota Vehicular</div>
        <h1 class="page-header__title">@Model.Marca @Model.Modelo</h1>
        <p class="page-header__subtitle">Placa: @Model.Placa</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.IdCarro" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Editar
        </a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>


<div style="max-width:1000px; display:flex; flex-direction:column; gap:16px;">

    <!-- FILA 1: Datos del vehículo + Zona peligro -->
    <div style="display:flex; gap:16px; align-items:flex-start;">

        <!-- Datos principales -->
        <div class="card" style="flex:1; min-width:0;">
            <div style="display:flex; align-items:center; gap:16px; margin-bottom:24px; padding-bottom:18px; border-bottom:1px solid var(--gris-200);">
                <div class="carro-icon-lg">
                    <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                </div>
                <div>
                    <div style="font-family:var(--font-display); font-size:1.2rem; font-weight:800; color:var(--azul-dark);">
                        @Model.Marca @Model.Modelo
                    </div>
                    <div style="font-family:monospace; font-size:1rem; font-weight:700; color:var(--azul); letter-spacing:0.1em; margin-top:2px;">
                        @Model.Placa
                    </div>
                    <div style="margin-top:8px; display:flex; gap:6px; flex-wrap:wrap;">
                        <span class="badge @bc">@Model.Estado</span>
                        @if (!string.IsNullOrEmpty(Model.Categoria)) {
                            <span class="badge badge--azul">@Model.Categoria</span>
                        }
                    </div>
                </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px;">
                <div class="det-field">
                    <div class="det-label">Placa</div>
                    <div class="det-value" style="font-family:monospace; letter-spacing:0.08em; font-size:1rem; font-weight:700; color:var(--azul);">@Model.Placa</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Marca</div>
                    <div class="det-value">@Model.Marca</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Modelo</div>
                    <div class="det-value">@Model.Modelo</div>
                </div>
                <div class="det-field">
                    <div class="det-label">N° de motor</div>
                    <div class="det-value" style="font-family:monospace;">@(Model.NumeroMotor ?? "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Categoría</div>
                    <div class="det-value">@(Model.Categoria ?? "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">N° de ejes</div>
                    <div class="det-value">@(Model.Ejes.HasValue ? Model.Ejes.ToString() : "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Peso</div>
                    <div class="det-value">@(Model.Peso.HasValue ? $"{Model.Peso:N2} Kg" : "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Carga útil</div>
                    <div class="det-value">@(Model.CargaUtil.HasValue ? $"{Model.CargaUtil:N2} Kg" : "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Año de modelo</div>
                    <div class="det-value">@(Model.FechaCarro.HasValue ? Model.FechaCarro.Value.Year.ToString() : "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Fecha de título</div>
                    <div class="det-value">@(Model.FechaTitulo.HasValue ? Model.FechaTitulo.Value.ToString("dd/MM/yyyy") : "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Color</div>
                    <div class="det-value">@(Model.Color ?? "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Fórmula rodante</div>
                    <div class="det-value">@(Model.FormulaRodante ?? "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Estado</div>
                    <div class="det-value"><span class="badge @bc">@Model.Estado</span></div>
                </div>
            </div>
        </div>

        

    </div>

    <!-- FILA 2: Conductor -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--azul);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                Conductor asignado
            </div>
        </div>

        @{
            var conductor = Model.EmpleadosCarros.FirstOrDefault()?.Empleado;
        }

        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px;">
            @if (conductor != null)
            {
                <div style="display:flex; align-items:center; gap:12px;">
                    <div class="emp-avatar-md">
                        @((conductor.nombre?.Length > 0 ? conductor.nombre[0].ToString() : "?").ToUpper())@((conductor.paterno?.Length > 0 ? conductor.paterno[0].ToString() : "").ToUpper())
                    </div>
                    <div>
                        <div style="font-weight:600; font-size:0.92rem; color:var(--gris-900);">@conductor.nombre @conductor.paterno @conductor.materno</div>
                        <div style="font-size:0.78rem; color:var(--gris-400);">DNI: @(conductor.dni ?? "—")</div>
                    </div>
                </div>
            }
            else
            {
                <div style="font-size:0.85rem; color:var(--gris-400);">Sin conductor asignado.</div>
            }

            <!-- Formulario para asignar/cambiar/quitar conductor -->
            <form asp-action="AsignarConductor" method="post" id="formConductor"
                  style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idCarro" value="@Model.IdCarro" />
                <input type="hidden" name="sinConductor" id="sinConductorInput" value="false" />
                <select name="idEmpleado" id="selectConductor" class="form-control" style="min-width:220px;">
                    <option value="">— Seleccionar conductor —</option>
                    @foreach (var item in ViewBag.EmpleadosList as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                    {
                        if (conductor != null && item.Value == conductor.idEmpleado.ToString()) {
                            <option value="@item.Value" selected>@item.Text</option>
                        } else {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
                <button type="submit" class="btn btn--celeste btn--sm"
                        onclick="return validarConductor()">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    @(conductor != null ? "Cambiar" : "Asignar")
                </button>
                @if (conductor != null)
                {
                    <button type="button" class="btn btn--secondary btn--sm"
                            onclick="confirmarSinConductor()">
                        Sin conductor
                    </button>
                }
            </form>

            <!-- Historial de conductores -->
            @if (conductorLog.Any())
            {
                <div style="margin-top:14px; padding-top:12px; border-top:1px solid var(--gris-200);">
                    <div style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:8px;">Historial de conductores</div>
                    <div style="display:flex; flex-direction:column; gap:5px;">
                        @foreach (var log in conductorLog)
                        {
                            <div style="display:flex; align-items:center; gap:8px; padding:7px 10px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200); font-size:0.78rem; flex-wrap:wrap;">
                                <span style="color:var(--gris-400); font-size:0.7rem; flex-shrink:0;">@log.FechaHora.ToString("dd/MM/yy HH:mm")</span>
                                <span style="color:var(--gris-600);">@(log.NombreConductorAnterior ?? "Sin conductor")</span>
                                <svg viewBox="0 0 24 24" style="width:11px;height:11px;stroke:var(--gris-400);fill:none;stroke-width:2;flex-shrink:0;"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                <span style="font-weight:600; color:var(--azul);">@(log.NombreConductorNuevo ?? "Sin conductor")</span>
                                <span style="margin-left:auto; color:var(--gris-400); font-size:0.7rem;">@(log.NombreUsuario ?? "—")</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- FILA 3: Cambio de estado -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:#d97706;fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                Estado del vehículo
            </div>
            <span class="badge @bc">@Model.Estado</span>
        </div>

        @if (Model.Estado == "Activo")
        {
            <!-- Activo → puede pasar a Inactivo -->
            <form asp-action="CambiarEstado" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idCarro"     value="@Model.IdCarro" />
                <input type="hidden" name="nuevoEstado" value="Inactivo" />
                <div class="form-grid" style="margin-bottom:12px;">
                    <div class="form-group" style="margin:0;">
                        <label class="form-label">Motivo de inactivación <span class="req">*</span></label>
                        <select name="motivo" class="form-control" required>
                            <option value="">— Seleccionar —</option>
                            <option value="Por pérdida">Por pérdida</option>
                            <option value="Robo">Robo</option>
                            <option value="Accidente">Accidente</option>
                            <option value="No en uso">No en uso</option>
                            <option value="Venta">Venta</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                    <div class="form-group" style="margin:0;">
                        <label class="form-label">Observaciones</label>
                        <input type="text" name="observaciones" class="form-control" maxlength="500"
                               placeholder="Detalles adicionales (opcional)" />
                    </div>
                </div>
                <button type="submit" class="btn btn--sm"
                        style="background:#b45309; color:white; border:none; cursor:pointer; border-radius:var(--r-sm); padding:8px 14px; display:flex; align-items:center; gap:6px;"
                        onclick="return confirm('¿Marcar este vehículo como Inactivo?')">
                    <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:white;fill:none;stroke-width:2;stroke-linecap:round;"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                    Marcar como Inactivo
                </button>
            </form>
        }
        else if (Model.Estado == "Inactivo")
        {
            <!-- Inactivo → reactivar con observación obligatoria -->
            <div style="background:rgba(220,38,38,0.05); border:1px solid rgba(220,38,38,0.2); border-radius:var(--r-sm); padding:10px 14px; margin-bottom:14px; font-size:0.85rem; color:#b91c1c;">
                Este vehículo está <strong>Inactivo</strong>. Si fue recuperado o hay un motivo para reactivarlo, regístralo aquí.
            </div>
            <form asp-action="CambiarEstado" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idCarro"     value="@Model.IdCarro" />
                <input type="hidden" name="nuevoEstado" value="Activo" />
                <input type="hidden" name="motivo"      value="Reactivación" />
                <div class="form-group" style="margin-bottom:12px;">
                    <label class="form-label">Motivo de reactivación <span class="req">*</span></label>
                    <input type="text" name="observaciones" class="form-control" maxlength="500" required
                           placeholder="Ej: Se encontró el vehículo, se resolvió el siniestro..." />
                    <div class="form-hint">Explica brevemente por qué se reactiva el vehículo.</div>
                </div>
                <button type="submit" class="btn btn--sm"
                        style="background:#16a34a; color:white; border:none; cursor:pointer; border-radius:var(--r-sm); padding:8px 14px; display:flex; align-items:center; gap:6px;"
                        onclick="return confirm('¿Reactivar este vehículo?')">
                    <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:white;fill:none;stroke-width:2.5;stroke-linecap:round;"><polyline points="20 6 9 17 4 12"/></svg>
                    Reactivar vehículo
                </button>
            </form>
        }
        else
        {
            <!-- En mantenimiento u otro estado automático -->
            <div style="font-size:0.85rem; color:var(--gris-500); padding:8px 0;">
                El estado <strong>@Model.Estado</strong> es gestionado automáticamente por el sistema.
                Cuando finalice el mantenimiento el vehículo volverá a Activo.
            </div>
        }

        <!-- Historial de estados -->
        @if (estadoLog.Any())
        {
            <div style="margin-top:16px; padding-top:14px; border-top:1px solid var(--gris-200);">
                <div style="font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:10px;">Historial de estados</div>
                <div style="display:flex; flex-direction:column; gap:6px;">
                    @foreach (var log in estadoLog)
                    {
                        <div style="display:flex; align-items:center; gap:10px; padding:8px 12px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200); font-size:0.80rem;">
                            <span style="color:var(--gris-400); flex-shrink:0; font-size:0.72rem;">@log.FechaHora.ToString("dd/MM/yy HH:mm")</span>
                            <span class="badge badge--gris" style="font-size:0.68rem;">@log.EstadoAnterior</span>
                            <svg viewBox="0 0 24 24" style="width:12px;height:12px;stroke:var(--gris-400);fill:none;stroke-width:2;flex-shrink:0;"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                            <span class="badge @(log.EstadoNuevo == "Activo" ? "badge--verde" : log.EstadoNuevo == "De baja" ? "badge--rojo" : "badge--amarillo")" style="font-size:0.68rem;">@log.EstadoNuevo</span>
                            <span style="color:var(--gris-600);">@log.Motivo</span>
                            @if (!string.IsNullOrEmpty(log.Observaciones)) { <span style="color:var(--gris-400);">— @log.Observaciones</span> }
                            <span style="margin-left:auto; color:var(--gris-400); font-size:0.72rem;">@(log.NombreUsuario ?? "—")</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- FILA 4: Seguros -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--azul);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Seguros asignados
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
                <span class="badge badge--azul">@Model.CarroSeguros.Count</span>
                <a asp-controller="CarroSeguros" asp-action="Asignar" asp-route-idCarro="@Model.IdCarro"
                   class="btn btn--celeste btn--sm">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Asignar seguro
                </a>
            </div>
        </div>

        @if (Model.CarroSeguros.Any())
        {
            <div style="display:flex; flex-direction:column; gap:10px;">
                @foreach (var cs in Model.CarroSeguros)
                {
                    var hoyS   = DateTime.Today;
                    var venceS = cs.FechaCulminada?.Date;
                    var diasS  = venceS.HasValue ? (venceS.Value - hoyS).Days : (int?)null;
                    var borderS = diasS.HasValue ? (diasS < 0 ? "#dc2626" : diasS <= 30 ? "#d97706" : "#e2e8f0") : "#e2e8f0";
                    var bgS     = diasS.HasValue ? (diasS < 0 ? "rgba(220,38,38,0.03)" : diasS <= 30 ? "rgba(217,119,6,0.03)" : "var(--gris-50)") : "var(--gris-50)";
                    var colorS  = diasS.HasValue ? (diasS < 0 ? "#dc2626" : diasS <= 30 ? "#d97706" : "var(--gris-500)") : "var(--gris-500)";
                    var etiqS   = diasS.HasValue
                        ? (diasS < 0  ? $"⛔ Vencido hace {Math.Abs(diasS.Value)} día(s)"
                         : diasS == 0 ? "⚠️ Vence HOY"
                         : diasS <= 30? $"⚠️ Vence en {diasS} día(s)"
                                      : $"✅ Vence en {diasS} días")
                        : "Sin fecha de vencimiento";
                    <div style="border:1.5px solid @borderS; border-radius:var(--r-md); padding:14px 16px; background:@bgS;">
                        <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:8px;">
                            <div>
                                <div style="font-weight:700; font-size:0.95rem; color:var(--gris-900); margin-bottom:4px;">
                                    <svg viewBox="0 0 24 24" style="width:13px;height:13px;stroke:var(--azul);fill:none;stroke-width:2;vertical-align:middle;margin-right:4px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                    @cs.Seguro?.TipoSeguro
                                </div>
                                <div style="display:flex; flex-wrap:wrap; gap:12px; font-size:0.78rem; color:var(--gris-600); margin-top:4px;">
                                    @if (cs.FechaAsignada.HasValue)
                                    {
                                        <span>📅 Desde: <strong>@cs.FechaAsignada.Value.ToString("dd/MM/yyyy")</strong></span>
                                    }
                                    @if (venceS.HasValue)
                                    {
                                        <span>🏁 Vence: <strong>@venceS.Value.ToString("dd/MM/yyyy")</strong></span>
                                    }
                                </div>
                                <div style="margin-top:6px; font-size:0.76rem; font-weight:600; color:@colorS;">
                                    @etiqS
                                </div>
                            </div>
                            <div style="display:flex; gap:6px; flex-shrink:0;">
                                <a asp-controller="CarroSeguros" asp-action="Editar"
                                   asp-route-idCarro="@Model.IdCarro" asp-route-idSeguro="@cs.IdSeguro"
                                   class="btn btn--ghost btn--icon btn--sm" title="Editar fechas">
                                    <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                                <form asp-controller="CarroSeguros" asp-action="Quitar" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idCarro"  value="@Model.IdCarro" />
                                    <input type="hidden" name="idSeguro" value="@cs.IdSeguro" />
                                    <button type="submit" class="btn btn--danger btn--icon btn--sm" title="Quitar seguro"
                                            onclick="return confirm('¿Quitar este seguro del vehículo?')">
                                        <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="text-align:center; padding:16px 0; color:var(--gris-400); font-size:0.82rem;">
                Este vehículo no tiene seguros asignados.
            </div>
        }
    </div>

    <!-- FILA 5: Accesorios -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--azul);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
                Accesorios asignados
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
                <span class="badge badge--azul">@Model.CarroAsesorios.Count</span>
                <a asp-controller="CarroAsesorios" asp-action="Asignar" asp-route-idCarro="@Model.IdCarro"
                   class="btn btn--celeste btn--sm">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Asignar accesorio
                </a>
            </div>
        </div>
        @if (Model.CarroAsesorios.Any())
        {
            <div style="display:flex; flex-direction:column; gap:8px;">
                @foreach (var ca in Model.CarroAsesorios)
                {
                    var esExt = !string.IsNullOrEmpty(ca.TipoExtintor);
                    var venceExt = ca.FechaVencimientoExtintor;
                    var diasExt = venceExt.HasValue ? venceExt.Value.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber : (int?)null;
                    var borderAcc = esExt && diasExt.HasValue ? (diasExt <= 0 ? "#dc2626" : diasExt <= 30 ? "#d97706" : diasExt <= 90 ? "#f59e0b" : "#e2e8f0") : "#e2e8f0";
                    var bgAcc     = esExt && diasExt.HasValue ? (diasExt <= 0 ? "rgba(220,38,38,0.03)" : diasExt <= 30 ? "rgba(217,119,6,0.03)" : "var(--gris-50)") : "var(--gris-50)";
                    <div style="border:1.5px solid @borderAcc; border-radius:var(--r-md); padding:12px 14px; background:@bgAcc;">
                        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:8px; flex-wrap:wrap;">
                            <div style="flex:1; min-width:0;">
                                <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900); margin-bottom:4px;">
                                    @ca.Asesorio?.TipoAsesorio
                                </div>
                                <div style="display:flex; flex-wrap:wrap; gap:10px; font-size:0.76rem; color:var(--gris-500);">
                                    @if (ca.FechaAsignada.HasValue)
                                    {
                                        <span>📅 Asignado: <strong>@ca.FechaAsignada.Value.ToString("dd/MM/yyyy")</strong></span>
                                    }
                                    @if (!string.IsNullOrEmpty(ca.Observaciones))
                                    {
                                        <span>💬 @ca.Observaciones</span>
                                    }
                                </div>
                                @if (esExt)
                                {
                                    <div style="display:flex; flex-wrap:wrap; gap:6px; align-items:center; margin-top:6px;">
                                        <span class="badge" style="background:rgba(220,38,38,0.1); color:#dc2626; font-size:0.68rem;">🧯 @ca.TipoExtintor</span>
                                        @if (!string.IsNullOrEmpty(ca.PesoExtintor))
                                        {
                                            <span style="font-size:0.72rem; color:var(--gris-600);">@ca.PesoExtintor</span>
                                        }
                                        @if (venceExt.HasValue)
                                        {
                                            var cExt = diasExt <= 0 ? "#dc2626" : diasExt <= 30 ? "#dc2626" : diasExt <= 90 ? "#d97706" : "var(--gris-500)";
                                            var tExt = diasExt <= 0 ? $"⛔ Vencido hace {Math.Abs(diasExt.Value)} días"
                                                     : diasExt <= 30 ? $"⚠️ Vence en {diasExt} días ({venceExt.Value:dd/MM/yyyy})"
                                                     : diasExt <= 90 ? $"⚡ Vence en {diasExt} días ({venceExt.Value:dd/MM/yyyy})"
                                                     : $"✅ Vence {venceExt.Value:dd/MM/yyyy}";
                                            <span style="font-size:0.73rem; font-weight:600; color:@cExt;">@tExt</span>
                                        }
                                    </div>
                                }
                            </div>
                            <div style="display:flex; gap:4px; flex-shrink:0;">
                                <a asp-controller="CarroAsesorios" asp-action="Editar"
                                   asp-route-idCarro="@Model.IdCarro" asp-route-idAsesorio="@ca.IdAsesorio"
                                   class="btn btn--ghost btn--icon btn--sm" title="Editar">
                                    <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                                <form asp-controller="CarroAsesorios" asp-action="Quitar" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idCarro"    value="@Model.IdCarro" />
                                    <input type="hidden" name="idAsesorio" value="@ca.IdAsesorio" />
                                    <button type="submit" class="btn btn--danger btn--icon btn--sm"
                                            onclick="return confirm('¿Quitar este accesorio?')">
                                        <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else { <div style="text-align:center; padding:16px 0; color:var(--gris-400); font-size:0.82rem;">Este vehículo no tiene accesorios asignados.</div> }
    </div>

    <!-- FILA 6: Revisión Técnica -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--azul);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
                Revisión Técnica
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
                <span class="badge badge--azul">@Model.CarroModalidades.Count</span>
                <a asp-controller="CarroModalidades" asp-action="Asignar" asp-route-idCarro="@Model.IdCarro"
                   class="btn btn--celeste btn--sm">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Asignar Revisión Técnica
                </a>
            </div>
        </div>
        @if (Model.CarroModalidades.Any())
        {
            <div style="display:flex; flex-direction:column; gap:10px;">
                @foreach (var cm in Model.CarroModalidades)
                {
                    var hoy2      = DateTime.Today;
                    var vence2    = cm.FechaVencimiento?.Date;
                    var dias2     = vence2.HasValue ? (vence2.Value - hoy2).Days : (int?)null;
                    var colorBorde = dias2.HasValue
                        ? (dias2 < 0   ? "#dc2626"
                         : dias2 <= 30 ? "#d97706"
                                       : "#e2e8f0")
                        : "#e2e8f0";
                    var colorDias = dias2.HasValue
                        ? (dias2 < 0   ? "#dc2626"
                         : dias2 <= 30 ? "#d97706"
                                       : "var(--gris-500)")
                        : "var(--gris-500)";
                    var etiquetaVenc = dias2.HasValue
                        ? (dias2 < 0   ? $"⛔ Vencida hace {Math.Abs(dias2.Value)} día(s)"
                         : dias2 == 0  ? "⚠️ Vence HOY"
                         : dias2 <= 30 ? $"⚠️ Vence en {dias2} día(s)"
                                       : $"✅ Vence en {dias2} días")
                        : "Sin fecha de vencimiento";
                    <div style="border:1.5px solid @colorBorde; border-radius:var(--r-md); padding:14px 16px; background:@(dias2.HasValue && dias2 < 0 ? "rgba(220,38,38,0.03)" : dias2.HasValue && dias2 <= 30 ? "rgba(217,119,6,0.03)" : "var(--gris-50)");">
                        <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:8px;">
                            <div>
                                <div style="font-weight:700; font-size:0.95rem; color:var(--gris-900); margin-bottom:4px;">
                                    @cm.Modalidad?.TipoModalidad
                                    <span style="font-size:0.72rem; font-weight:500; color:var(--gris-400); margin-left:6px;">Código: @(cm.Modalidad?.Codigo ?? "—")</span>
                                </div>
                                <div style="display:flex; flex-wrap:wrap; gap:12px; font-size:0.78rem; color:var(--gris-600); margin-top:6px;">
                                    @if (cm.FechaAsignacion.HasValue)
                                    {
                                        <span>📅 Asignado: <strong>@cm.FechaAsignacion.Value.ToString("dd/MM/yyyy")</strong></span>
                                    }
                                    @if (vence2.HasValue)
                                    {
                                        <span>🏁 Vencimiento: <strong>@vence2.Value.ToString("dd/MM/yyyy")</strong></span>
                                    }
                                </div>
                                <div style="margin-top:6px; font-size:0.76rem; font-weight:600; color:@colorDias;">
                                    @etiquetaVenc
                                </div>
                            </div>
                            <div style="display:flex; gap:6px; flex-shrink:0;">
                                <a asp-controller="CarroModalidades" asp-action="Editar"
                                   asp-route-idCarro="@Model.IdCarro" asp-route-idModalidad="@cm.IdModalidad"
                                   class="btn btn--ghost btn--icon btn--sm" title="Editar fechas">
                                    <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                                <form asp-controller="CarroModalidades" asp-action="Quitar" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idCarro"     value="@Model.IdCarro" />
                                    <input type="hidden" name="idModalidad" value="@cm.IdModalidad" />
                                    <button type="submit" class="btn btn--danger btn--icon btn--sm"
                                            onclick="return confirm('¿Quitar esta modalidad del vehículo?')" title="Quitar">
                                        <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* Historial de cambios de modalidad *@
            @if (modalidadLog.Any())
            {
                <div style="margin-top:16px; padding-top:14px; border-top:1px solid var(--gris-200);">
                    <div style="font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:10px;">
                        Historial de cambios de modalidad
                    </div>
                    <div style="display:flex; flex-direction:column; gap:6px; max-height:220px; overflow-y:auto;">
                        @foreach (var log in modalidadLog)
                        {
                            var accionColor = log.Accion == "Asignado"    ? "#16a34a"
                                            : log.Accion == "Removido"    ? "#dc2626"
                                            : "#2563eb";
                            <div style="display:flex; align-items:flex-start; gap:10px; font-size:0.78rem; padding:8px 10px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-100);">
                                <span style="background:@(accionColor)20; color:@accionColor; font-weight:700; font-size:0.68rem; padding:2px 7px; border-radius:20px; flex-shrink:0; margin-top:1px;">@log.Accion</span>
                                <div style="flex:1; min-width:0;">
                                    <div style="font-weight:600; color:var(--gris-800);">@log.TipoModalidad <span style="font-weight:400; color:var(--gris-400);">(@(log.Codigo ?? "—"))</span></div>
                                    <div style="color:var(--gris-500); margin-top:2px;">
                                        @if (log.FechaAsignacion.HasValue) { <span>Desde @log.FechaAsignacion.Value.ToString("dd/MM/yyyy") </span> }
                                        @if (log.FechaVencimiento.HasValue) { <span>→ hasta @log.FechaVencimiento.Value.ToString("dd/MM/yyyy")</span> }
                                    </div>
                                </div>
                                <div style="text-align:right; flex-shrink:0; color:var(--gris-400);">
                                    <div>@log.FechaRegistro.ToString("dd/MM/yy")</div>
                                    <div style="font-size:0.7rem;">@(log.UsuarioNombre ?? "—")</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else { <div style="text-align:center; padding:16px 0; color:var(--gris-400); font-size:0.82rem;">Este vehículo no tiene modalidades asignadas.</div> }
    </div>

    <!-- FILA 7: Mantenimientos -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:#d97706;fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
                Historial de mantenimientos
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
                <span class="badge badge--amarillo">@Model.MantenimientosCarros.Count</span>
                <a asp-controller="MantenimientoCarros" asp-action="Create" asp-route-idCarro="@Model.IdCarro"
                   class="btn btn--celeste btn--sm">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Nuevo mantenimiento
                </a>
            </div>
        </div>

        @if (Model.MantenimientosCarros.Any())
        {
            <div style="display:flex; flex-direction:column; gap:8px;">
                @foreach (var m in Model.MantenimientosCarros.OrderByDescending(x => x.FechaProgramada))
                {
                    var mbc = m.Estado switch {
                        "En proceso" => "badge--amarillo",
                        "Culminado"  => "badge--verde",
                        "Cancelado"  => "badge--rojo",
                        _            => "badge--gris"
                    };
                    <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 14px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200);">
                        <div>
                            <div style="font-weight:600; font-size:0.85rem; color:var(--gris-900);">@m.TipoMantenimiento?.Nombre</div>
                            <div style="font-size:0.72rem; color:var(--gris-400); margin-top:3px;">
                                @m.FechaProgramada.ToString("dd/MM/yyyy")
                                @if (m.FechaCulminada.HasValue) { <span> → @m.FechaCulminada.Value.ToString("dd/MM/yyyy")</span> }
                                @if (!string.IsNullOrEmpty(m.Observaciones)) { <span> · @m.Observaciones</span> }
                            </div>
                        </div>
                        <div style="display:flex; align-items:center; gap:8px; flex-shrink:0; margin-left:10px;">
                            <span class="badge @mbc">@m.Estado</span>
                            <a asp-controller="MantenimientoCarros" asp-action="Details" asp-route-id="@m.IdMante"
                               class="btn btn--ghost btn--icon btn--sm" title="Ver detalle">
                                <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="text-align:center; padding:16px 0; color:var(--gris-400); font-size:0.82rem;">
                Este vehículo no tiene mantenimientos registrados.
            </div>
        }
    </div>
    <!-- FILA 8: Check List Transporte -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--azul);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg>
                Check List de Transporte
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
                <a asp-controller="CheckListTransporte" asp-action="Crear" asp-route-idCarro="@Model.IdCarro"
                   class="btn btn--celeste btn--sm">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Nuevo Check List
                </a>
                <a asp-controller="CheckListTransporte" asp-action="Historial" asp-route-idCarro="@Model.IdCarro"
                   class="btn btn--secondary btn--sm">
                    <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    Ver historial
                </a>
            </div>
        </div>
        <div style="font-size:0.82rem; color:var(--gris-400);">
            Registra y consulta las inspecciones de seguridad diarias del vehículo.
        </div>
    </div>
     <!-- FILA 9: Inspección Botiquín Transporte -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:#16a34a;fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                Inspección de Botiquín
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
                <a asp-controller="InspeccionBotiquinTransporte" asp-action="Crear" asp-route-idCarro="@Model.IdCarro"
                   class="btn btn--celeste btn--sm">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Nueva Inspección
                </a>
                <a asp-controller="InspeccionBotiquinTransporte" asp-action="Historial" asp-route-idCarro="@Model.IdCarro"
                   class="btn btn--secondary btn--sm">
                    <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    Ver historial
                </a>
            </div>
        </div>
        <div style="font-size:0.82rem; color:var(--gris-400);">
            Registra y consulta las inspecciones diarias del botiquín del vehículo.
        </div>
    </div>
    @{
    var historial = ViewBag.HistorialCambios as List<PROYJHOME2026.Models.AuditoriaLog>;
    var habilitaciones = ViewBag.Habilitaciones as List<PROYJHOME2026.Models.HabilitacionVehicular> ?? new();
    var lunas          = ViewBag.Lunas          as List<PROYJHOME2026.Models.LunaPolarizada>        ?? new();
    var habVigente     = habilitaciones.FirstOrDefault(h => h.EsVigente);
    var lunaVigente    = lunas.FirstOrDefault(l => l.EsVigente);
}

    <!-- FILA: Habilitación Vehicular Especial -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--azul);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                Habilitación Vehicular Especial
            </div>
            <a asp-controller="CertificadosCarro" asp-action="CrearHabilitacion" asp-route-idCarro="@Model.IdCarro"
               class="btn btn--celeste btn--sm">
                <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Nueva habilitación
            </a>
        </div>

        @if (habVigente != null)
        {
            var hFecha = habVigente.FechaCulminacion < DateTime.Today ? "badge--rojo"
                       : habVigente.FechaCulminacion < DateTime.Today.AddDays(30) ? "badge--amarillo"
                       : "badge--verde";
            <div style="background:var(--gris-50); border:1px solid var(--gris-200); border-radius:var(--r-md); padding:16px; margin-bottom:12px;">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:12px;">
                    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px; flex:1;">
                        <div class="det-field">
                            <div class="det-label">Código</div>
                            <div class="det-value" style="font-family:monospace; font-weight:700;">@habVigente.Codigo</div>
                        </div>
                        <div class="det-field">
                            <div class="det-label">Revisión Técnica vinculada</div>
                            <div class="det-value">@(habVigente.Modalidad?.TipoModalidad ?? "—")</div>
                        </div>
                        <div class="det-field">
                            <div class="det-label">Fecha de vigencia</div>
                            <div class="det-value">@habVigente.FechaVigencia.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="det-field">
                            <div class="det-label">Fecha de culminación</div>
                            <div class="det-value">
                                <span class="badge @hFecha">@habVigente.FechaCulminacion.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>
                        <div class="det-field">
                            <div class="det-label">Registrado</div>
                            <div class="det-value" style="font-size:0.78rem; color:var(--gris-400);">@habVigente.FechaRegistro.ToString("dd/MM/yyyy")</div>
                        </div>
                    </div>
                    <div style="display:flex; gap:6px; flex-shrink:0;">
                        <a asp-controller="CertificadosCarro" asp-action="EditarHabilitacion" asp-route-id="@habVigente.IdHabilitacion"
                           class="btn btn--ghost btn--icon btn--sm" title="Editar">
                            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </a>
                        <form asp-controller="CertificadosCarro" asp-action="EliminarHabilitacion" method="post" style="display:inline;"
                              onsubmit="return confirm('¿Eliminar esta habilitación vehicular?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idHabilitacion" value="@habVigente.IdHabilitacion" />
                            <input type="hidden" name="idCarro"         value="@Model.IdCarro" />
                            <button type="submit" class="btn btn--ghost btn--icon btn--sm" title="Eliminar"
                                    style="color:var(--rojo);">
                                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div style="font-size:0.82rem; color:var(--gris-400); padding:8px 0;">
                Sin habilitación vehicular especial registrada.
            </div>
        }

        @if (habilitaciones.Count > 1)
        {
            <details style="margin-top:8px;">
                <summary style="font-size:0.78rem; font-weight:600; color:var(--azul); cursor:pointer; list-style:none; display:flex; align-items:center; gap:6px;">
                    <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;"><polyline points="6 9 12 15 18 9"/></svg>
                    Ver historial (@(habilitaciones.Count - 1) anterior(es))
                </summary>
                <div class="table-wrapper" style="margin-top:10px; border-radius:var(--r-md);">
                    <table>
                        <thead>
                            <tr><th>Código</th><th>Revisión Técnica</th><th>Vigencia</th><th>Culminación</th><th>Registrado</th><th>Estado</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var h in habilitaciones.Where(h => !h.EsVigente).OrderByDescending(h => h.FechaRegistro))
                            {
                                <tr>
                                    <td style="font-family:monospace; font-weight:600;">@h.Codigo</td>
                                    <td style="font-size:0.78rem;">@(h.Modalidad?.TipoModalidad ?? "—")</td>
                                    <td style="font-size:0.78rem;">@h.FechaVigencia.ToString("dd/MM/yyyy")</td>
                                    <td style="font-size:0.78rem;">@h.FechaCulminacion.ToString("dd/MM/yyyy")</td>
                                    <td style="font-size:0.75rem; color:var(--gris-400);">@h.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge badge--gris" style="font-size:0.66rem;">Inactivo</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    </div>

    <!-- FILA: Luna Polarizada -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--celeste);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><path d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z"/></svg>
                Luna Polarizada
            </div>
            <a asp-controller="CertificadosCarro" asp-action="CrearLuna" asp-route-idCarro="@Model.IdCarro"
               class="btn btn--celeste btn--sm">
                <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                @(lunaVigente != null ? "Registrar nuevo" : "Registrar")
            </a>
        </div>

        @if (lunaVigente != null)
        {
            <div style="background:var(--gris-50); border:1px solid var(--gris-200); border-radius:var(--r-md); padding:16px; margin-bottom:12px;">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:12px;">
                    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px; flex:1;">
                        <div class="det-field">
                            <div class="det-label">Fecha de vigencia</div>
                            <div class="det-value">@lunaVigente.FechaVigencia.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="det-field">
                            <div class="det-label">Registrado</div>
                            <div class="det-value" style="font-size:0.78rem; color:var(--gris-400);">@lunaVigente.FechaRegistro.ToString("dd/MM/yyyy")</div>
                        </div>
                        @if (!string.IsNullOrEmpty(lunaVigente.Comentario))
                        {
                            <div class="det-field" style="grid-column:1/-1;">
                                <div class="det-label">Comentario</div>
                                <div class="det-value" style="color:var(--gris-600);">@lunaVigente.Comentario</div>
                            </div>
                        }
                    </div>
                    <div style="display:flex; gap:6px; flex-shrink:0;">
                        <a asp-controller="CertificadosCarro" asp-action="EditarLuna" asp-route-id="@lunaVigente.IdLuna"
                           class="btn btn--ghost btn--icon btn--sm" title="Editar">
                            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </a>
                        <form asp-controller="CertificadosCarro" asp-action="EliminarLuna" method="post" style="display:inline;"
                              onsubmit="return confirm('¿Eliminar este registro de luna polarizada?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idLuna"   value="@lunaVigente.IdLuna" />
                            <input type="hidden" name="idCarro"  value="@Model.IdCarro" />
                            <button type="submit" class="btn btn--ghost btn--icon btn--sm" title="Eliminar"
                                    style="color:var(--rojo);">
                                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div style="font-size:0.82rem; color:var(--gris-400); padding:8px 0;">
                Sin certificado de luna polarizada registrado.
            </div>
        }

        @if (lunas.Count > 1)
        {
            <details style="margin-top:8px;">
                <summary style="font-size:0.78rem; font-weight:600; color:var(--azul); cursor:pointer; list-style:none; display:flex; align-items:center; gap:6px;">
                    <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;"><polyline points="6 9 12 15 18 9"/></svg>
                    Ver historial (@(lunas.Count - 1) anterior(es))
                </summary>
                <div class="table-wrapper" style="margin-top:10px; border-radius:var(--r-md);">
                    <table>
                        <thead>
                            <tr><th>Fecha de vigencia</th><th>Comentario</th><th>Registrado</th><th>Estado</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var l in lunas.Where(l => !l.EsVigente).OrderByDescending(l => l.FechaRegistro))
                            {
                                <tr>
                                    <td style="font-size:0.78rem;">@l.FechaVigencia.ToString("dd/MM/yyyy")</td>
                                    <td style="font-size:0.78rem; color:var(--gris-600);">@(l.Comentario ?? "—")</td>
                                    <td style="font-size:0.75rem; color:var(--gris-400);">@l.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge badge--gris" style="font-size:0.66rem;">Inactivo</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    </div>

@if (historial != null && historial.Any())
{
    <div class="card" style="padding:0; overflow:hidden; margin-top:16px;">
        <div style="padding:14px 20px; border-bottom:1px solid var(--gris-200); display:flex; justify-content:space-between; align-items:center;">
            <span style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                📋 Historial de cambios
            </span>
            <span class="badge badge--gris">@historial.Count registro(s)</span>
        </div>
        <div class="table-wrapper" style="border:none; border-radius:0; max-height:380px; overflow-y:auto;">
            <table>
                <thead>
                    <tr>
                        <th>Fecha / Hora</th>
                        <th>Acción</th>
                        <th>Descripción / Cambio</th>
                        <th>Datos anteriores</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in historial)
                    {
                        string accionColor;
                        if      (log.Accion == "Crear")        accionColor = "badge--verde";
                        else if (log.Accion == "Editar")       accionColor = "badge--azul";
                        else if (log.Accion == "Eliminar")     accionColor = "badge--rojo";
                        else if (log.Accion == "CambioEstado") accionColor = "badge--amarillo";
                        else                                    accionColor = "badge--gris";

                        <tr>
                            <td style="font-size:0.75rem; color:var(--gris-400); white-space:nowrap;">
                                @log.FechaHora.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                <span class="badge @accionColor" style="font-size:0.68rem;">@log.Accion</span>
                            </td>
                            <td style="font-size:0.8rem; color:var(--gris-800); max-width:280px;">
                                @(log.Descripcion ?? "—")
                            </td>
                            <td style="font-size:0.75rem; color:var(--gris-500); max-width:200px;">
                                @if (!string.IsNullOrEmpty(log.DatosAnteriores))
                                {
                                    <span title="@log.DatosAnteriores" style="cursor:help; text-decoration:underline dotted;">
                                        @(log.DatosAnteriores.Length > 60 ? log.DatosAnteriores[..60] + "..." : log.DatosAnteriores)
                                    </span>
                                }
                                else
                                {
                                    <span style="color:var(--gris-300);">—</span>
                                }
                            </td>
                            <td style="font-size:0.75rem; color:var(--azul);">
                                @(log.NombreUsuario ?? "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (historial != null)
{
    <div style="margin-top:16px; padding:14px 20px; background:var(--gris-50); border-radius:var(--r-md); border:1px solid var(--gris-200); font-size:0.82rem; color:var(--gris-400);">
        📋 Sin historial de cambios registrado.
    </div>
}

</div>

@section Styles {
<style>
.emp-avatar-md {
    width:40px; height:40px; border-radius:50%;
    background:linear-gradient(135deg, var(--azul-mid), var(--celeste));
    display:grid; place-items:center; flex-shrink:0;
    font-family:var(--font-display); font-weight:800;
    font-size:0.85rem; color:var(--blanco);
}
.carro-icon-lg {
    width:60px; height:60px; border-radius:var(--r-md);
    background:linear-gradient(135deg, var(--azul-dark), var(--azul-mid));
    display:grid; place-items:center; flex-shrink:0;
    box-shadow:0 4px 16px rgba(26,58,107,0.3);
}
.carro-icon-lg svg { width:28px; height:28px; stroke:var(--blanco); fill:none; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
.det-label { font-size:0.67rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px; }
.det-value { font-size:0.88rem; font-weight:500; color:var(--gris-900); }
</style>
}

@section Scripts {
<script>
function validarConductor() {
    const sel = document.getElementById('selectConductor');
    if (!sel.value) {
        alert('Debes seleccionar un conductor. Si quieres quitar al conductor actual, usa el botón "Sin conductor".');
        return false;
    }
    return true;
}

function confirmarSinConductor() {
    if (confirm('¿Quitar al conductor asignado a este vehículo?')) {
        document.getElementById('sinConductorInput').value = 'true';
        document.getElementById('selectConductor').value   = '';
        document.getElementById('formConductor').submit();
    }
}
</script>
}
