@model PROYJHOME2026.Models.Carro
@{
    ViewData["Title"]      = "Detalle Vehículo";
    ViewData["Breadcrumb"] = "Flota Vehicular / Detalle";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Flota Vehicular</div>
        <h1 class="page-header__title">@Model.Marca @Model.Modelo</h1>
        <p class="page-header__subtitle">Placa: @Model.Placa</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.IdCarro" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Editar
        </a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:820px; display:flex; flex-direction:column; gap:16px;">

    <div class="card">
        <!-- Cabecera -->
        <div style="display:flex; align-items:center; gap:16px; margin-bottom:24px; padding-bottom:18px; border-bottom:1px solid var(--gris-200);">
            <div class="carro-icon-lg">
                <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <div>
                <div style="font-family:var(--font-display); font-size:1.2rem; font-weight:800; color:var(--azul-dark);">
                    @Model.Marca @Model.Modelo
                </div>
                <div style="font-family:monospace; font-size:1rem; font-weight:700; color:var(--azul); letter-spacing:0.1em; margin-top:2px;">
                    @Model.Placa
                </div>
                <div style="margin-top:8px; display:flex; gap:6px; flex-wrap:wrap;">
                    @{
                        var bc = Model.Estado switch {
                            "Activo"           => "badge--verde",
                            "Inactivo"         => "badge--gris",
                            "En mantenimiento" => "badge--amarillo",
                            "De baja"          => "badge--rojo",
                            _                  => "badge--gris"
                        };
                    }
                    <span class="badge @bc">@Model.Estado</span>
                    @if (!string.IsNullOrEmpty(Model.Categoria))
                    {
                        <span class="badge badge--azul">@Model.Categoria</span>
                    }
                </div>
            </div>
        </div>

        <!-- Grid de datos -->
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px;">

            <div class="det-field">
                <div class="det-label">Placa</div>
                <div class="det-value" style="font-family:monospace; letter-spacing:0.08em; font-size:1rem; font-weight:700; color:var(--azul);">@Model.Placa</div>
            </div>
            <div class="det-field">
                <div class="det-label">Marca</div>
                <div class="det-value">@Model.Marca</div>
            </div>
            <div class="det-field">
                <div class="det-label">Modelo</div>
                <div class="det-value">@Model.Modelo</div>
            </div>
            <div class="det-field">
                <div class="det-label">N° de motor</div>
                <div class="det-value" style="font-family:monospace;">@(Model.NumeroMotor ?? "—")</div>
            </div>
            <div class="det-field">
                <div class="det-label">Categoría</div>
                <div class="det-value">@(Model.Categoria ?? "—")</div>
            </div>
            <div class="det-field">
                <div class="det-label">N° de ejes</div>
                <div class="det-value">@(Model.Ejes.HasValue ? Model.Ejes.ToString() : "—")</div>
            </div>
            <div class="det-field">
                <div class="det-label">Peso</div>
                <div class="det-value">@(Model.Peso.HasValue ? $"{Model.Peso:N2} Kg" : "—")</div>
            </div>
            <div class="det-field">
                <div class="det-label">Carga útil</div>
                <div class="det-value">@(Model.CargaUtil.HasValue ? $"{Model.CargaUtil:N2} Kg" : "—")</div>
            </div>
            <div class="det-field">
                <div class="det-label">Año vehículo</div>
                <div class="det-value">@(Model.FechaCarro.HasValue ? Model.FechaCarro.Value.Year.ToString() : "—")</div>
            </div>
            <div class="det-field">
                <div class="det-label">Fecha de compra</div>
                <div class="det-value">@(Model.FechaCompra.HasValue ? Model.FechaCompra.Value.ToString("dd/MM/yyyy") : "—")</div>
            </div>
            <div class="det-field">
                <div class="det-label">Estado</div>
                <div class="det-value"><span class="badge @bc">@Model.Estado</span></div>
            </div>

        </div>
    </div>

    <!-- Zona peligro -->
    <div class="card" style="border-color:var(--rojo-border); background:var(--rojo-light);">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
            <div>
                <div style="font-weight:700; color:var(--rojo); font-size:0.88rem;">Zona de peligro</div>
                <div style="font-size:0.76rem; color:var(--gris-600); margin-top:2px;">
                    Solo si no tiene seguros, mantenimientos ni conductores asociados.
                </div>
            </div>
            <a asp-action="Delete" asp-route-id="@Model.IdCarro" class="btn btn--danger btn--sm">
                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6M9 6V4h6v2"/></svg>
                Eliminar
            </a>
        </div>
    </div>

</div>

@section Styles {
<style>
.carro-icon-lg {
    width:60px; height:60px; border-radius:var(--r-md);
    background:linear-gradient(135deg, var(--azul-dark), var(--azul-mid));
    display:grid; place-items:center; flex-shrink:0;
    box-shadow:0 4px 16px rgba(26,58,107,0.3);
}
.carro-icon-lg svg { width:28px; height:28px; stroke:var(--blanco); fill:none; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
.det-label { font-size:0.67rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px; }
.det-value { font-size:0.88rem; font-weight:500; color:var(--gris-900); }
</style>
}
