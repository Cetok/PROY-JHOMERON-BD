@model PROYJHOME2026.Models.Carro
@{
    ViewData["Title"]      = "Detalle Vehículo";
    ViewData["Breadcrumb"] = "Flota Vehicular / Detalle";
    var bc = Model.Estado switch {
        "Activo"           => "badge--verde",
        "Inactivo"         => "badge--gris",
        "En mantenimiento" => "badge--amarillo",
        "De baja"          => "badge--rojo",
        _                  => "badge--gris"
    };
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Flota Vehicular</div>
        <h1 class="page-header__title">@Model.Marca @Model.Modelo</h1>
        <p class="page-header__subtitle">Placa: @Model.Placa</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.IdCarro" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Editar
        </a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>


<div style="max-width:1000px; display:flex; flex-direction:column; gap:16px;">

    <!-- FILA 1: Datos del vehículo + Zona peligro -->
    <div style="display:flex; gap:16px; align-items:flex-start;">

        <!-- Datos principales -->
        <div class="card" style="flex:1; min-width:0;">
            <div style="display:flex; align-items:center; gap:16px; margin-bottom:24px; padding-bottom:18px; border-bottom:1px solid var(--gris-200);">
                <div class="carro-icon-lg">
                    <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                </div>
                <div>
                    <div style="font-family:var(--font-display); font-size:1.2rem; font-weight:800; color:var(--azul-dark);">
                        @Model.Marca @Model.Modelo
                    </div>
                    <div style="font-family:monospace; font-size:1rem; font-weight:700; color:var(--azul); letter-spacing:0.1em; margin-top:2px;">
                        @Model.Placa
                    </div>
                    <div style="margin-top:8px; display:flex; gap:6px; flex-wrap:wrap;">
                        <span class="badge @bc">@Model.Estado</span>
                        @if (!string.IsNullOrEmpty(Model.Categoria)) {
                            <span class="badge badge--azul">@Model.Categoria</span>
                        }
                    </div>
                </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px;">
                <div class="det-field">
                    <div class="det-label">Placa</div>
                    <div class="det-value" style="font-family:monospace; letter-spacing:0.08em; font-size:1rem; font-weight:700; color:var(--azul);">@Model.Placa</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Marca</div>
                    <div class="det-value">@Model.Marca</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Modelo</div>
                    <div class="det-value">@Model.Modelo</div>
                </div>
                <div class="det-field">
                    <div class="det-label">N° de motor</div>
                    <div class="det-value" style="font-family:monospace;">@(Model.NumeroMotor ?? "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Categoría</div>
                    <div class="det-value">@(Model.Categoria ?? "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">N° de ejes</div>
                    <div class="det-value">@(Model.Ejes.HasValue ? Model.Ejes.ToString() : "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Peso</div>
                    <div class="det-value">@(Model.Peso.HasValue ? $"{Model.Peso:N2} Kg" : "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Carga útil</div>
                    <div class="det-value">@(Model.CargaUtil.HasValue ? $"{Model.CargaUtil:N2} Kg" : "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Año vehículo</div>
                    <div class="det-value">@(Model.FechaCarro.HasValue ? Model.FechaCarro.Value.Year.ToString() : "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Fecha de compra</div>
                    <div class="det-value">@(Model.FechaCompra.HasValue ? Model.FechaCompra.Value.ToString("dd/MM/yyyy") : "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Estado</div>
                    <div class="det-value"><span class="badge @bc">@Model.Estado</span></div>
                </div>
            </div>
        </div>

        <!-- Zona peligro -->
        <div style="width:220px; flex-shrink:0;">
            <div class="card" style="border-color:var(--rojo-border); background:var(--rojo-light);">
                <div style="font-weight:700; color:var(--rojo); font-size:0.88rem; margin-bottom:6px;">Zona de peligro</div>
                <div style="font-size:0.76rem; color:var(--gris-600); margin-bottom:14px;">
                    Solo si no tiene seguros, mantenimientos ni conductores asociados.
                </div>
                <a asp-action="Delete" asp-route-id="@Model.IdCarro" class="btn btn--danger btn--sm" style="width:100%; justify-content:center;">
                    <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6M9 6V4h6v2"/></svg>
                    Eliminar
                </a>
            </div>
        </div>

    </div>

    <!-- FILA 2: Conductor -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--azul);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                Conductor asignado
            </div>
        </div>

        @{
            var conductor = Model.EmpleadosCarros.FirstOrDefault()?.Empleado;
        }

        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px;">
            @if (conductor != null)
            {
                <div style="display:flex; align-items:center; gap:12px;">
                    <div class="emp-avatar-md">
                        @((conductor.nombre?.Length > 0 ? conductor.nombre[0].ToString() : "?").ToUpper())@((conductor.paterno?.Length > 0 ? conductor.paterno[0].ToString() : "").ToUpper())
                    </div>
                    <div>
                        <div style="font-weight:600; font-size:0.92rem; color:var(--gris-900);">@conductor.nombre @conductor.paterno @conductor.materno</div>
                        <div style="font-size:0.78rem; color:var(--gris-400);">DNI: @(conductor.dni ?? "—")</div>
                    </div>
                </div>
            }
            else
            {
                <div style="font-size:0.85rem; color:var(--gris-400);">Sin conductor asignado.</div>
            }

            <!-- Formulario para asignar/cambiar/quitar conductor -->
            <form asp-action="AsignarConductor" method="post" style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idCarro" value="@Model.IdCarro" />
                <select name="idEmpleado" class="form-control" style="min-width:220px;">
                    <option value="">— Sin conductor —</option>
                    @foreach (var item in ViewBag.EmpleadosList as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                    {
                        if (conductor != null && item.Value == conductor.idEmpleado.ToString()) {
                            <option value="@item.Value" selected>@item.Text</option>
                        } else {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
                <button type="submit" class="btn btn--celeste btn--sm">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    @(conductor != null ? "Cambiar" : "Asignar")
                </button>
            </form>
        </div>
    </div>

    <!-- FILA 3: Cambio de estado -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:#d97706;fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                Cambiar estado del vehículo
            </div>
            <span class="badge @bc">@Model.Estado</span>
        </div>

        @{
            // Solo permite Activo ↔ Inactivo
            // Si está en otro estado (En mantenimiento) no muestra el form
            bool puedeActivo   = Model.Estado == "Inactivo";
            bool puedeInactivo = Model.Estado == "Activo";
            bool puedecambiar  = puedeActivo || puedeInactivo;
        }

        @if (puedecambiar)
        {
            <form asp-action="CambiarEstado" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idCarro" value="@Model.IdCarro" />
                <input type="hidden" name="nuevoEstado" value="@(puedeActivo ? "Activo" : "Inactivo")" />

                <div style="background:var(--gris-50); border:1px solid var(--gris-200); border-radius:var(--r-sm); padding:10px 14px; margin-bottom:14px; font-size:0.85rem;">
                    Cambiar a:
                    <strong style="color:@(puedeActivo ? "#16a34a" : "#b45309");">
                        @(puedeActivo ? "Activo" : "Inactivo")
                    </strong>
                </div>

                <div class="form-grid" style="margin-bottom:12px;">
                    <div class="form-group" style="margin:0;">
                        <label class="form-label">Motivo <span class="req">*</span></label>
                        <select name="motivo" class="form-control" required>
                            <option value="">— Seleccionar —</option>
                            @if (puedeActivo)
                            {
                                <!-- Volviendo a Activo -->
                                <option value="Recuperado">Recuperado</option>
                                <option value="Reactivación">Reactivación</option>
                                <option value="Otro">Otro</option>
                            }
                            else
                            {
                                <!-- Pasando a Inactivo -->
                                <option value="Por pérdida">Por pérdida</option>
                                <option value="Robo">Robo</option>
                                <option value="Accidente">Accidente</option>
                                <option value="No en uso">No en uso</option>
                                <option value="Venta">Venta</option>
                                <option value="Otro">Otro</option>
                            }
                        </select>
                    </div>
                    <div class="form-group" style="margin:0;">
                        <label class="form-label">Observaciones</label>
                        <input type="text" name="observaciones" class="form-control" maxlength="500"
                               placeholder="Detalles adicionales (opcional)" />
                    </div>
                </div>

                <button type="submit" class="btn btn--primary btn--sm"
                        onclick="return confirm('¿Confirmar cambio de estado?')">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    Registrar cambio de estado
                </button>
            </form>
        }
        else
        {
            <div style="font-size:0.85rem; color:var(--gris-500); padding:8px 0;">
                El estado <strong>@Model.Estado</strong> se gestiona automáticamente por el sistema
                (mantenimiento activo). Cuando finalice el mantenimiento volverá a Activo.
            </div>
        }

        <!-- Historial de estados -->
        @{
            var estadoLog = ViewBag.EstadoLog as List<PROYJHOME2026.Models.CarroEstadoLog> ?? new();
        }
        @if (estadoLog.Any())
        {
            <div style="margin-top:16px; padding-top:14px; border-top:1px solid var(--gris-200);">
                <div style="font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:10px;">Historial de estados</div>
                <div style="display:flex; flex-direction:column; gap:6px;">
                    @foreach (var log in estadoLog)
                    {
                        <div style="display:flex; align-items:center; gap:10px; padding:8px 12px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200); font-size:0.80rem;">
                            <span style="color:var(--gris-400); flex-shrink:0; font-size:0.72rem;">@log.FechaHora.ToString("dd/MM/yy HH:mm")</span>
                            <span class="badge badge--gris" style="font-size:0.68rem;">@log.EstadoAnterior</span>
                            <svg viewBox="0 0 24 24" style="width:12px;height:12px;stroke:var(--gris-400);fill:none;stroke-width:2;flex-shrink:0;"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                            <span class="badge @(log.EstadoNuevo == "Activo" ? "badge--verde" : log.EstadoNuevo == "De baja" ? "badge--rojo" : "badge--amarillo")" style="font-size:0.68rem;">@log.EstadoNuevo</span>
                            <span style="color:var(--gris-600);">@log.Motivo</span>
                            @if (!string.IsNullOrEmpty(log.Observaciones)) { <span style="color:var(--gris-400);">— @log.Observaciones</span> }
                            <span style="margin-left:auto; color:var(--gris-400); font-size:0.72rem;">@(log.NombreUsuario ?? "—")</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- FILA 4: Seguros -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--azul);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Seguros asignados
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
                <span class="badge badge--azul">@Model.CarroSeguros.Count</span>
                <a asp-controller="CarroSeguros" asp-action="Asignar" asp-route-idCarro="@Model.IdCarro"
                   class="btn btn--celeste btn--sm">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Asignar seguro
                </a>
            </div>
        </div>

        @if (Model.CarroSeguros.Any())
        {
            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:10px;">
                @foreach (var cs in Model.CarroSeguros)
                {
                    <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 14px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200);">
                        <div>
                            <div style="display:flex; align-items:center; gap:6px;">
                                <svg viewBox="0 0 24 24" style="width:13px;height:13px;stroke:var(--azul);fill:none;stroke-width:2;flex-shrink:0;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                <span style="font-weight:600; font-size:0.85rem; color:var(--gris-900);">@cs.Seguro?.TipoSeguro</span>
                            </div>
                            <div style="font-size:0.72rem; color:var(--gris-400); margin-top:3px;">
                                @(cs.FechaAsignada.HasValue ? "Desde " + cs.FechaAsignada.Value.ToString("dd/MM/yyyy") : "Sin fecha de inicio")
                                @if (cs.FechaCulminada.HasValue) { <span> · Vence @cs.FechaCulminada.Value.ToString("dd/MM/yyyy")</span> }
                            </div>
                        </div>
                        <div style="display:flex; gap:4px; flex-shrink:0; margin-left:8px;">
                            <a asp-controller="CarroSeguros" asp-action="Editar"
                               asp-route-idCarro="@Model.IdCarro" asp-route-idSeguro="@cs.IdSeguro"
                               class="btn btn--ghost btn--icon btn--sm" title="Editar fechas">
                                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </a>
                            <form asp-controller="CarroSeguros" asp-action="Quitar" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idCarro"  value="@Model.IdCarro" />
                                <input type="hidden" name="idSeguro" value="@cs.IdSeguro" />
                                <button type="submit" class="btn btn--danger btn--icon btn--sm" title="Quitar seguro"
                                        onclick="return confirm('¿Quitar este seguro del vehículo?')">
                                    <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="text-align:center; padding:16px 0; color:var(--gris-400); font-size:0.82rem;">
                Este vehículo no tiene seguros asignados.
            </div>
        }
    </div>

    <!-- FILA 5: Accesorios -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--azul);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
                Accesorios asignados
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
                <span class="badge badge--azul">@Model.CarroAsesorios.Count</span>
                <a asp-controller="CarroAsesorios" asp-action="Asignar" asp-route-idCarro="@Model.IdCarro"
                   class="btn btn--celeste btn--sm">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Asignar accesorio
                </a>
            </div>
        </div>
        @if (Model.CarroAsesorios.Any())
        {
            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(220px, 1fr)); gap:10px;">
                @foreach (var ca in Model.CarroAsesorios)
                {
                    <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 14px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200);">
                        <div>
                            <div style="font-weight:600; font-size:0.85rem; color:var(--gris-900);">@ca.Asesorio?.TipoAsesorio</div>
                            @if (ca.FechaAsignada.HasValue) { <div style="font-size:0.72rem; color:var(--gris-400); margin-top:2px;">@ca.FechaAsignada.Value.ToString("dd/MM/yyyy")</div> }
                            @if (!string.IsNullOrEmpty(ca.Observaciones)) { <div style="font-size:0.72rem; color:var(--gris-400); font-style:italic;">@ca.Observaciones</div> }
                        </div>
                        <div style="display:flex; gap:4px; flex-shrink:0; margin-left:8px;">
                            <a asp-controller="CarroAsesorios" asp-action="Editar"
                               asp-route-idCarro="@Model.IdCarro" asp-route-idAsesorio="@ca.IdAsesorio"
                               class="btn btn--ghost btn--icon btn--sm" title="Editar">
                                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </a>
                            <form asp-controller="CarroAsesorios" asp-action="Quitar" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idCarro"    value="@Model.IdCarro" />
                                <input type="hidden" name="idAsesorio" value="@ca.IdAsesorio" />
                                <button type="submit" class="btn btn--danger btn--icon btn--sm"
                                        onclick="return confirm('¿Quitar este accesorio?')">
                                    <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        else { <div style="text-align:center; padding:16px 0; color:var(--gris-400); font-size:0.82rem;">Este vehículo no tiene accesorios asignados.</div> }
    </div>

    <!-- FILA 6: Modalidades -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--azul);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
                Modalidades asignadas
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
                <span class="badge badge--azul">@Model.CarroModalidades.Count</span>
                <a asp-controller="CarroModalidades" asp-action="Asignar" asp-route-idCarro="@Model.IdCarro"
                   class="btn btn--celeste btn--sm">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Asignar modalidad
                </a>
            </div>
        </div>
        @if (Model.CarroModalidades.Any())
        {
            <div style="display:flex; flex-wrap:wrap; gap:8px;">
                @foreach (var cm in Model.CarroModalidades)
                {
                    <div style="display:flex; align-items:center; gap:8px; padding:8px 14px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200);">
                        <span style="font-weight:600; font-size:0.85rem; color:var(--gris-900);">@cm.Modalidad?.TipoModalidad</span>
                        <span class="badge @(cm.Modalidad?.Estado == "Activo" ? "badge--verde" : "badge--gris")" style="font-size:0.68rem;">@cm.Modalidad?.Estado</span>
                        <form asp-controller="CarroModalidades" asp-action="Quitar" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idCarro"     value="@Model.IdCarro" />
                            <input type="hidden" name="idModalidad" value="@cm.IdModalidad" />
                            <button type="submit" class="btn btn--ghost btn--icon btn--sm"
                                    onclick="return confirm('¿Quitar esta modalidad?')" title="Quitar">
                                <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
        else { <div style="text-align:center; padding:16px 0; color:var(--gris-400); font-size:0.82rem;">Este vehículo no tiene modalidades asignadas.</div> }
    </div>

    <!-- FILA 7: Mantenimientos -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:#d97706;fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
                Historial de mantenimientos
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
                <span class="badge badge--amarillo">@Model.MantenimientosCarros.Count</span>
                <a asp-controller="MantenimientoCarros" asp-action="Create" asp-route-idCarro="@Model.IdCarro"
                   class="btn btn--celeste btn--sm">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Nuevo mantenimiento
                </a>
            </div>
        </div>

        @if (Model.MantenimientosCarros.Any())
        {
            <div style="display:flex; flex-direction:column; gap:8px;">
                @foreach (var m in Model.MantenimientosCarros.OrderByDescending(x => x.FechaProgramada))
                {
                    var mbc = m.Estado switch {
                        "En proceso" => "badge--amarillo",
                        "Culminado"  => "badge--verde",
                        "Cancelado"  => "badge--rojo",
                        _            => "badge--gris"
                    };
                    <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 14px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200);">
                        <div>
                            <div style="font-weight:600; font-size:0.85rem; color:var(--gris-900);">@m.TipoMantenimiento?.Nombre</div>
                            <div style="font-size:0.72rem; color:var(--gris-400); margin-top:3px;">
                                @m.FechaProgramada.ToString("dd/MM/yyyy")
                                @if (m.FechaCulminada.HasValue) { <span> → @m.FechaCulminada.Value.ToString("dd/MM/yyyy")</span> }
                                @if (!string.IsNullOrEmpty(m.Observaciones)) { <span> · @m.Observaciones</span> }
                            </div>
                        </div>
                        <div style="display:flex; align-items:center; gap:8px; flex-shrink:0; margin-left:10px;">
                            <span class="badge @mbc">@m.Estado</span>
                            <a asp-controller="MantenimientoCarros" asp-action="Details" asp-route-id="@m.IdMante"
                               class="btn btn--ghost btn--icon btn--sm" title="Ver detalle">
                                <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="text-align:center; padding:16px 0; color:var(--gris-400); font-size:0.82rem;">
                Este vehículo no tiene mantenimientos registrados.
            </div>
        }
    </div>

</div>

@section Styles {
<style>
.emp-avatar-md {
    width:40px; height:40px; border-radius:50%;
    background:linear-gradient(135deg, var(--azul-mid), var(--celeste));
    display:grid; place-items:center; flex-shrink:0;
    font-family:var(--font-display); font-weight:800;
    font-size:0.85rem; color:var(--blanco);
}
.carro-icon-lg {
    width:60px; height:60px; border-radius:var(--r-md);
    background:linear-gradient(135deg, var(--azul-dark), var(--azul-mid));
    display:grid; place-items:center; flex-shrink:0;
    box-shadow:0 4px 16px rgba(26,58,107,0.3);
}
.carro-icon-lg svg { width:28px; height:28px; stroke:var(--blanco); fill:none; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
.det-label { font-size:0.67rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px; }
.det-value { font-size:0.88rem; font-weight:500; color:var(--gris-900); }
</style>
}
