@model PROYJHOME2026.Models.Carro
@{
    ViewData["Title"]      = "Eliminar Vehículo";
    ViewData["Breadcrumb"] = "Flota Vehicular / Eliminar";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Flota Vehicular</div>
        <h1 class="page-header__title">Eliminar Vehículo</h1>
        <p class="page-header__subtitle">Esta acción no se puede deshacer</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Cancelar
        </a>
    </div>
</div>

<div style="max-width:560px;">

    <div class="alert alert--danger" style="margin-bottom:20px;">
        <svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <span>Si este vehículo tiene seguros, mantenimientos, conductores u otros registros asociados, la eliminación será bloqueada.</span>
    </div>

    <div class="card" style="margin-bottom:20px;">
        <div style="display:flex; align-items:center; gap:14px; margin-bottom:18px; padding-bottom:14px; border-bottom:1px solid var(--gris-200);">
            <div class="carro-icon-lg">
                <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <div>
                <div style="font-family:var(--font-display); font-size:1.05rem; font-weight:700; color:var(--azul-dark);">
                    @Model.Marca @Model.Modelo
                </div>
                <div style="font-family:monospace; font-size:0.95rem; font-weight:700; color:var(--azul); letter-spacing:0.1em; margin-top:2px;">
                    @Model.Placa
                </div>
            </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; font-size:0.84rem;">
            <div>
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:2px;">N° Motor</div>
                <div style="font-family:monospace; color:var(--gris-700);">@(Model.NumeroMotor ?? "—")</div>
            </div>
            <div>
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:2px;">Categoría</div>
                <div style="color:var(--gris-700);">@(Model.Categoria ?? "—")</div>
            </div>
            <div>
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:2px;">Fecha de título</div>
                <div style="color:var(--gris-700);">@(Model.FechaTitulo.HasValue ? Model.FechaTitulo.Value.ToString("dd/MM/yyyy") : "—")</div>
            </div>
            <div>
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:2px;">Estado</div>
                @{
                    var bc = Model.Estado switch {
                        "Activo"           => "badge--verde",
                        "Inactivo"         => "badge--gris",
                        "En mantenimiento" => "badge--amarillo",
                        "De baja"          => "badge--rojo",
                        _                  => "badge--gris"
                    };
                }
                <span class="badge @bc">@Model.Estado</span>
            </div>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdCarro" />
        <div style="display:flex; gap:10px;">
            <button type="submit" class="btn btn--danger btn--lg">
                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6M9 6V4h6v2"/></svg>
                Sí, eliminar definitivamente
            </button>
            <a asp-action="Details" asp-route-id="@Model.IdCarro" class="btn btn--secondary btn--lg">
                No, conservar
            </a>
        </div>
    </form>
</div>

@section Styles {
<style>
.carro-icon-lg {
    width:48px; height:48px; border-radius:var(--r-md);
    background:linear-gradient(135deg, var(--azul-dark), var(--azul-mid));
    display:grid; place-items:center; flex-shrink:0;
}
.carro-icon-lg svg { width:22px; height:22px; stroke:var(--blanco); fill:none; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
</style>
}
