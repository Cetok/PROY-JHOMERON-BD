@model IEnumerable<PROYJHOME2026.Models.Notificacion>
@{
    ViewData["Title"]      = "Notificaciones";
    ViewData["Breadcrumb"] = "Notificaciones";
    var leidas   = Model.Where(n =>  n.Leida).ToList();
    var noLeidas = Model.Where(n => !n.Leida).ToList();
}

@section Styles {
<style>
.notif-page { max-width: 760px; }

/* ── Tarjeta individual ────────────────────────────────────── */
.ncard {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px 18px;
    background: #fff;
    border: 1px solid rgba(26,58,107,0.1);
    border-radius: 14px;
    box-shadow: 0 1px 4px rgba(26,58,107,0.06);
    transition: box-shadow 0.15s, transform 0.15s;
    text-decoration: none;
    color: inherit;
    cursor: default;
}
.ncard--nueva {
    border-left: 3px solid var(--ncard-color, #0d3393);
    background: linear-gradient(to right, color-mix(in srgb, var(--ncard-color, #0d3393) 4%, white), white 60%);
}
.ncard:hover { box-shadow: 0 4px 16px rgba(26,58,107,0.1); transform: translateY(-1px); }

/* Ícono */
.ncard__icon {
    width: 44px; height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    background: color-mix(in srgb, var(--ncard-color, #0d3393) 12%, white);
}
.ncard__icon svg {
    width: 20px; height: 20px;
    fill: none;
    stroke: var(--ncard-color, #0d3393);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
}

/* Contenido */
.ncard__body  { flex: 1; min-width: 0; }
.ncard__top   { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 4px; }
.ncard__titulo {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1c2340;
    line-height: 1.3;
}
.ncard--leida .ncard__titulo { font-weight: 500; color: #7a85a0; }

.ncard__badge {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
    background: color-mix(in srgb, var(--ncard-color, #0d3393) 14%, white);
    color: var(--ncard-color, #0d3393);
}
.ncard__mensaje {
    font-size: 0.82rem;
    color: #4a5370;
    line-height: 1.5;
    margin-bottom: 8px;
}
.ncard--leida .ncard__mensaje { color: #b0b8cc; }

.ncard__footer { display: flex; align-items: center; justify-content: space-between; }
.ncard__fecha  { font-size: 0.72rem; color: #b0b8cc; }
.ncard__link {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ncard-color, #0d3393);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--ncard-color, #0d3393) 10%, white);
    transition: background 0.15s;
}
.ncard__link:hover { background: color-mix(in srgb, var(--ncard-color, #0d3393) 20%, white); }
.ncard__link svg { width: 12px; height: 12px; stroke: currentColor; fill: none; stroke-width: 2.5; stroke-linecap: round; }

/* ── Separador de sección ──────────────────────────────────── */
.notif-section-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #b0b8cc;
    padding: 16px 4px 8px;
    display: flex;
    align-items: center;
    gap: 8px;
}
.notif-section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #eaecf3;
}

/* ── Punto de no leída ─────────────────────────────────────── */
.ncard__dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--ncard-color, #0d3393);
    flex-shrink: 0;
    margin-top: 6px;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ncard-color, #0d3393) 20%, white);
}

/* ── Empty state ───────────────────────────────────────────── */
.notif-empty {
    text-align: center;
    padding: 60px 20px;
}
.notif-empty__icon {
    width: 64px; height: 64px;
    border-radius: 20px;
    background: #f4f6fa;
    display: grid;
    place-items: center;
    margin: 0 auto 16px;
}
.notif-empty__icon svg { width: 28px; height: 28px; stroke: #b0b8cc; fill: none; stroke-width: 1.5; stroke-linecap: round; }
.notif-empty__title { font-size: 1rem; font-weight: 700; color: #1c2340; margin-bottom: 6px; }
.notif-empty__sub   { font-size: 0.82rem; color: #b0b8cc; }
</style>
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Sistema</div>
        <h1 class="page-header__title">Notificaciones</h1>
        <p class="page-header__subtitle">
            @if (noLeidas.Any())
            { <span>@noLeidas.Count sin leer · </span> }
            @Model.Count() en total
        </p>
    </div>
</div>

@{
    // Config por tipo: color, etiqueta, SVG path(s)
    (string color, string label, string svg) TipoConfig(string? tipo) => tipo switch {
        "Mantenimiento" => ("#f59e0b", "Mantenimiento",
            "<path d='M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z'/>"),

        "Creacion" => ("#10b981", "Nuevo registro",
            "<circle cx='12' cy='12' r='10'/><line x1='12' y1='8' x2='12' y2='16'/><line x1='8' y1='12' x2='16' y2='12'/>"),

        "Edicion" => ("#3b9be8", "Editado",
            "<path d='M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7'/><path d='M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z'/>"),

        "Eliminacion" => ("#e03d3d", "Eliminado",
            "<polyline points='3 6 5 6 21 6'/><path d='M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6'/><path d='M10 11v6'/><path d='M14 11v6'/><path d='M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2'/>"),

        "CambioEstado" => ("#7c3aed", "Cambio de estado",
            "<polyline points='17 1 21 5 17 9'/><path d='M3 11V9a4 4 0 014-4h14'/><polyline points='7 23 3 19 7 15'/><path d='M21 13v2a4 4 0 01-4 4H3'/>"),

        _ => ("#0d3393", "Sistema",
            "<path d='M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9'/><path d='M13.73 21a2 2 0 01-3.46 0'/>")
    };
}

<div class="notif-page">

@if (!Model.Any())
{
    <div class="notif-empty">
        <div class="notif-empty__icon">
            <svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
        </div>
        <div class="notif-empty__title">Todo al día</div>
        <div class="notif-empty__sub">No tienes notificaciones por ahora.</div>
    </div>
}
else
{
    @if (noLeidas.Any())
    {
        <div class="notif-section-label">Sin leer — @noLeidas.Count</div>
        <div style="display:flex; flex-direction:column; gap:10px; margin-bottom:8px;">
        @foreach (var n in noLeidas)
        {
            var (color, label, svgPath) = TipoConfig(n.Tipo);
            <div class="ncard ncard--nueva" style="--ncard-color:@color;">
                <div class="ncard__icon">
                    <svg viewBox="0 0 24 24">@Html.Raw(svgPath)</svg>
                </div>
                <div class="ncard__body">
                    <div class="ncard__top">
                        <div class="ncard__titulo">@n.Titulo</div>
                        <span class="ncard__badge">@label</span>
                    </div>
                    @if (!string.IsNullOrEmpty(n.Mensaje))
                    {
                        <div class="ncard__mensaje">@n.Mensaje</div>
                    }
                    <div class="ncard__footer">
                        <span class="ncard__fecha">@n.FechaCreacion.ToString("dd/MM/yyyy · HH:mm")</span>
                        @if (!string.IsNullOrEmpty(n.Url))
                        {
                            <a href="@n.Url" class="ncard__link">
                                Ver registro
                                <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                            </a>
                        }
                    </div>
                </div>
                <div class="ncard__dot"></div>
            </div>
        }
        </div>
    }

    @if (leidas.Any())
    {
        <div class="notif-section-label">Anteriores — @leidas.Count</div>
        <div style="display:flex; flex-direction:column; gap:8px;">
        @foreach (var n in leidas)
        {
            var (color, label, svgPath) = TipoConfig(n.Tipo);
            <div class="ncard ncard--leida" style="--ncard-color:@color;">
                <div class="ncard__icon" style="opacity:0.5;">
                    <svg viewBox="0 0 24 24">@Html.Raw(svgPath)</svg>
                </div>
                <div class="ncard__body">
                    <div class="ncard__top">
                        <div class="ncard__titulo">@n.Titulo</div>
                        <span class="ncard__badge" style="opacity:0.6;">@label</span>
                    </div>
                    @if (!string.IsNullOrEmpty(n.Mensaje))
                    {
                        <div class="ncard__mensaje">@n.Mensaje</div>
                    }
                    <div class="ncard__footer">
                        <span class="ncard__fecha">@n.FechaCreacion.ToString("dd/MM/yyyy · HH:mm")</span>
                        @if (!string.IsNullOrEmpty(n.Url))
                        {
                            <a href="@n.Url" class="ncard__link" style="opacity:0.7;">
                                Ver registro
                                <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
        </div>
    }
}

</div>
