@{
    ViewData["Title"]      = "Dashboard Flota Vehicular";
    ViewData["Breadcrumb"] = "Reportes / Dashboard Flota";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Reportes</div>
        <h1 class="page-header__title">Dashboard Flota Vehicular</h1>
        <p class="page-header__subtitle">Resumen visual del estado de la flota</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="IndexFlota" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Reportes Flota
        </a>
    </div>
</div>

<!-- KPIs -->
<div class="dash-kpis">
    <div class="kpi-card kpi-card--azul">
        <div class="kpi-val" id="kpi-total">—</div>
        <div class="kpi-lbl">Total vehículos</div>
    </div>
    <div class="kpi-card kpi-card--verde">
        <div class="kpi-val" id="kpi-activos">—</div>
        <div class="kpi-lbl">Activos</div>
    </div>
    <div class="kpi-card kpi-card--amarillo">
        <div class="kpi-val" id="kpi-mante">—</div>
        <div class="kpi-lbl">En mantenimiento</div>
    </div>
    <div class="kpi-card kpi-card--celeste">
        <div class="kpi-val" id="kpi-pendientes">—</div>
        <div class="kpi-lbl">Mant. pendientes</div>
    </div>
</div>

<!-- FILA 1 -->
<div class="dash-row">
    <div class="card dash-card">
        <div class="dash-card-title">Vehículos por estado</div>
        <div style="position:relative; height:260px;">
            <canvas id="chartEstadoFlota"></canvas>
        </div>
    </div>
    <div class="card dash-card dash-card--wide">
        <div class="dash-card-title">Vehículos por categoría</div>
        <div style="position:relative; height:260px;">
            <canvas id="chartCategoria"></canvas>
        </div>
    </div>
</div>

<!-- FILA 2 -->
<div class="card" style="margin-bottom:14px;">
    <div class="dash-card-title">Mantenimientos por mes (últimos 12 meses)</div>
    <div style="position:relative; height:240px;">
        <canvas id="chartMantesFlota"></canvas>
    </div>
</div>

<!-- TOP vehículos -->
<div class="card" style="padding:0; overflow:hidden;">
    <div style="padding:14px 20px; border-bottom:1px solid var(--gris-200);">
        <span style="font-weight:700; font-size:0.9rem;">Top vehículos con más mantenimientos</span>
    </div>
    <div class="table-wrapper" style="border:none; border-radius:0;">
        <table>
            <thead><tr><th>#</th><th>Placa</th><th>Vehículo</th><th style="text-align:right;">Mantenimientos</th><th>Barra</th></tr></thead>
            <tbody id="topMantesFlota"></tbody>
        </table>
    </div>
</div>

@section Styles {
<style>
.dash-kpis { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:16px; }
.kpi-card { border-radius:var(--r-md); padding:20px 22px; color:#fff; }
.kpi-card--azul     { background:linear-gradient(135deg,var(--azul-dark),var(--azul-mid)); }
.kpi-card--verde    { background:linear-gradient(135deg,#16a34a,#22c55e); }
.kpi-card--amarillo { background:linear-gradient(135deg,#d97706,#f59e0b); }
.kpi-card--celeste  { background:linear-gradient(135deg,var(--celeste),#38bdf8); }
.kpi-val { font-size:2rem; font-weight:800; line-height:1; }
.kpi-lbl { font-size:0.78rem; opacity:.85; margin-top:6px; font-weight:500; }
.dash-row { display:grid; grid-template-columns:1fr 1.8fr; gap:14px; margin-bottom:14px; }
.dash-card { flex:1; }
.dash-card--wide { flex:1.8; }
.dash-card-title { font-weight:700; font-size:0.88rem; color:var(--gris-900); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-100); }
@@media(max-width:900px) { .dash-kpis { grid-template-columns:1fr 1fr; } .dash-row { grid-template-columns:1fr; } }
</style>
}

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
const COLORES_ESTADO_FLOTA = {
    'Activo':           '#16a34a',
    'Inactivo':         '#6b7280',
    'En mantenimiento': '#d97706',
    'De baja':          '#dc2626',
};
const PALETA = ['#2563eb','#16a34a','#d97706','#dc2626','#7c3aed','#0891b2','#db2777','#065f46'];

Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
Chart.defaults.font.size   = 12;

async function cargarDashboardFlota() {
    const res  = await fetch('/Reportes/DashboardFlotaData');
    const data = await res.json();

    document.getElementById('kpi-total').textContent     = data.resumen.totalVehiculos;
    document.getElementById('kpi-activos').textContent   = data.resumen.totalActivos;
    document.getElementById('kpi-mante').textContent     = data.resumen.totalMante;
    document.getElementById('kpi-pendientes').textContent= data.resumen.totalPendientes;

    // Dona — por estado
    new Chart(document.getElementById('chartEstadoFlota'), {
        type: 'doughnut',
        data: {
            labels:   data.porEstado.map(d => d.estado),
            datasets: [{ data: data.porEstado.map(d => d.total),
                backgroundColor: data.porEstado.map(d => COLORES_ESTADO_FLOTA[d.estado] ?? '#94a3b8'),
                borderWidth: 2, borderColor: '#fff', hoverOffset: 8 }]
        },
        options: { responsive:true, maintainAspectRatio:false,
            plugins: { legend:{ position:'right', labels:{ padding:16, boxWidth:12 } } }, cutout:'60%' }
    });

    // Barras — por categoría
    new Chart(document.getElementById('chartCategoria'), {
        type: 'bar',
        data: {
            labels:   data.porCategoria.map(d => d.categoria),
            datasets: [{ label:'Vehículos', data: data.porCategoria.map(d => d.total),
                backgroundColor: data.porCategoria.map((_,i) => PALETA[i % PALETA.length] + 'cc'),
                borderColor:     data.porCategoria.map((_,i) => PALETA[i % PALETA.length]),
                borderWidth:1.5, borderRadius:5 }]
        },
        options: { responsive:true, maintainAspectRatio:false,
            plugins:{ legend:{display:false} },
            scales:{ y:{beginAtZero:true,ticks:{stepSize:1},grid:{color:'rgba(0,0,0,0.05)'}}, x:{grid:{display:false}} } }
    });

    // Línea — mantenimientos por mes
    new Chart(document.getElementById('chartMantesFlota'), {
        type: 'line',
        data: {
            labels:   data.mantesPorMes.map(d => d.mes),
            datasets: [{ label:'Mantenimientos', data: data.mantesPorMes.map(d => d.total),
                borderColor:'#d97706', backgroundColor:'rgba(217,119,6,0.12)',
                borderWidth:2.5, pointBackgroundColor:'#d97706', pointRadius:4,
                fill:true, tension:0.35 }]
        },
        options: { responsive:true, maintainAspectRatio:false,
            plugins:{ legend:{display:false} },
            scales:{ y:{beginAtZero:true,ticks:{stepSize:1},grid:{color:'rgba(0,0,0,0.05)'}}, x:{grid:{display:false}} } }
    });

    // Top mantenimientos
    const maxM = data.topMantes[0]?.total ?? 1;
    document.getElementById('topMantesFlota').innerHTML = data.topMantes.map((v,i) => `
        <tr>
            <td style="font-weight:700;color:var(--gris-400);width:30px;">${i+1}</td>
            <td style="font-weight:700;color:var(--azul-dark);font-family:monospace;">${v.placa}</td>
            <td style="font-weight:600;">${v.marca} ${v.modelo}</td>
            <td style="text-align:right;font-size:1rem;font-weight:800;color:var(--azul);">${v.total}</td>
            <td style="width:180px;padding-right:16px;">
                <div style="background:var(--gris-100);border-radius:10px;height:8px;overflow:hidden;">
                    <div style="background:var(--azul);height:100%;border-radius:10px;width:${Math.round(v.total/maxM*100)}%;"></div>
                </div>
            </td>
        </tr>`).join('');
}

cargarDashboardFlota();
</script>
}
