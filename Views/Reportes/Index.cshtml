@{
    ViewData["Title"]      = "Reportes";
    ViewData["Breadcrumb"] = "Reportes";
    var tab      = ViewBag.Tab as string ?? "equipos";
    var tipos    = ViewBag.Tipos    as List<PROYJHOME2026.Models.TipoEquipo> ?? new();
    var grupos   = ViewBag.Grupos   as List<PROYJHOME2026.Models.Grupo>      ?? new();
    var motivos  = ViewBag.Motivos  as List<PROYJHOME2026.Models.Motivo>     ?? new();
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Reportes</div>
        <h1 class="page-header__title">Centro de Reportes</h1>
        <p class="page-header__subtitle">Filtra, previsualiza y exporta en PDF o CSV</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Dashboard" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            Ver Dashboard
        </a>
    </div>
</div>

<!-- PESTAÑAS -->
<div class="rep-tabs">
    <button class="rep-tab @(tab == "equipos"     ? "rep-tab--active" : "")" onclick="cambiarTab('equipos')">
        <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/></svg>
        Equipos
    </button>
    <button class="rep-tab @(tab == "asignaciones" ? "rep-tab--active" : "")" onclick="cambiarTab('asignaciones')">
        <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        Asignaciones
    </button>
    <button class="rep-tab @(tab == "historial"   ? "rep-tab--active" : "")" onclick="cambiarTab('historial')">
        <svg viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Historial
    </button>
</div>

<!-- ══════════════════════════════════════════════════════════ -->
<!-- TAB: EQUIPOS                                               -->
<!-- ══════════════════════════════════════════════════════════ -->
<div id="tab-equipos" class="rep-panel" style="display:@(tab == "equipos" ? "block" : "none");">
    <div class="card" style="margin-bottom:16px;">
        <p class="rep-section-title">Filtros</p>
        <div class="form-grid" style="align-items:end; gap:12px;">
            <div class="form-group">
                <label class="form-label">Desde</label>
                <input type="date" id="eq-desde" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">Hasta</label>
                <input type="date" id="eq-hasta" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">Tipo de equipo</label>
                <select id="eq-tipo" class="form-control">
                    <option value="">— Todos —</option>
                    @foreach (var t in tipos)
                    {
                        <option value="@t.idTipoEquipo">@t.tipo</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Grupo / Área</label>
                <select id="eq-grupo" class="form-control">
                    <option value="">— Todos —</option>
                    @foreach (var g in grupos)
                    {
                        <option value="@g.idGrupo">@g.area</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Buscar</label>
                <input type="text" id="eq-buscar" class="form-control" placeholder="Marca, modelo, serie..." />
            </div>
        </div>

        <!-- Estados (checkboxes múltiples) -->
        <div style="margin-top:12px;">
            <label class="form-label">Estado (puedes combinar)</label>
            <div class="rep-checks">
                @foreach (var est in new[] { "Activo","Asignado","Mantenimiento","Devuelto","Perdida","Rotura","Baja" })
                {
                    <label class="rep-check-item">
                        <input type="checkbox" class="eq-estado" value="@est" checked />
                        <span class="rep-check-label">@est</span>
                    </label>
                }
            </div>
        </div>

        <div style="display:flex; gap:10px; margin-top:16px; flex-wrap:wrap;">
            <button onclick="consultarEquipos()" class="btn btn--celeste">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                Consultar
            </button>
            <button onclick="exportarEquiposCsv()" class="btn btn--verde" id="btn-eq-csv" disabled>
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Exportar CSV
            </button>
            <button onclick="exportarEquiposPdf()" class="btn btn--rojo" id="btn-eq-pdf" disabled>
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                Exportar PDF
            </button>
        </div>
    </div>

    <!-- Resultado -->
    <div id="eq-resultado" style="display:none;">
        <div class="card" style="padding:0; overflow:hidden;">
            <div style="padding:14px 20px; border-bottom:1px solid var(--gris-200); display:flex; justify-content:space-between; align-items:center;">
                <span style="font-weight:700; font-size:0.9rem;">Resultados</span>
                <span class="badge badge--azul" id="eq-total">0</span>
            </div>
            <div class="table-wrapper" style="border:none; border-radius:0; max-height:420px; overflow-y:auto;">
                <table id="eq-tabla">
                    <thead>
                        <tr>
                            <th>Tipo</th><th>Marca / Modelo</th><th>N° Serie</th>
                            <th>Estado</th><th>Fecha Compra</th><th>Asignado a</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody id="eq-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>
    <div id="eq-vacio" style="display:none; text-align:center; padding:40px; color:var(--gris-400);">
        Sin resultados para los filtros seleccionados.
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════ -->
<!-- TAB: ASIGNACIONES                                          -->
<!-- ══════════════════════════════════════════════════════════ -->
<div id="tab-asignaciones" class="rep-panel" style="display:@(tab == "asignaciones" ? "block" : "none");">
    <div class="card" style="margin-bottom:16px;">
        <p class="rep-section-title">Filtros</p>
        <div class="form-grid" style="gap:12px; align-items:end;">
            <div class="form-group">
                <label class="form-label">Desde</label>
                <input type="date" id="as-desde" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">Hasta</label>
                <input type="date" id="as-hasta" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">Tipo de equipo</label>
                <select id="as-tipo" class="form-control">
                    <option value="">— Todos —</option>
                    @foreach (var t in tipos)
                    {
                        <option value="@t.idTipoEquipo">@t.tipo</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Grupo / Área</label>
                <select id="as-grupo" class="form-control">
                    <option value="">— Todos —</option>
                    @foreach (var g in grupos)
                    {
                        <option value="@g.idGrupo">@g.area</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Buscar</label>
                <input type="text" id="as-buscar" class="form-control" placeholder="Empleado, equipo..." />
            </div>
        </div>
        <div style="margin-top:12px;">
            <label class="form-label">Estado de asignación</label>
            <div class="rep-checks">
                @foreach (var est in new[] { "Activo","Asignado","En mantenimiento","Devuelto","Inactivo","Baja","Perdida","Rotura" })
                {
                    <label class="rep-check-item">
                        <input type="checkbox" class="as-estado" value="@est" checked />
                        <span class="rep-check-label">@est</span>
                    </label>
                }
            </div>
        </div>
        <div style="display:flex; gap:10px; margin-top:16px; flex-wrap:wrap;">
            <button onclick="consultarAsignaciones()" class="btn btn--celeste">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                Consultar
            </button>
            <button onclick="exportarAsigCsv()" class="btn btn--verde" id="btn-as-csv" disabled>
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Exportar CSV
            </button>
            <button onclick="exportarAsigPdf()" class="btn btn--rojo" id="btn-as-pdf" disabled>
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Exportar PDF
            </button>
        </div>
    </div>
    <div id="as-resultado" style="display:none;">
        <div class="card" style="padding:0; overflow:hidden;">
            <div style="padding:14px 20px; border-bottom:1px solid var(--gris-200); display:flex; justify-content:space-between; align-items:center;">
                <span style="font-weight:700; font-size:0.9rem;">Resultados</span>
                <span class="badge badge--azul" id="as-total">0</span>
            </div>
            <div class="table-wrapper" style="border:none; border-radius:0; max-height:420px; overflow-y:auto;">
                <table id="as-tabla">
                    <thead>
                        <tr>
                            <th>Empleado</th><th>Tipo Equipo</th><th>Equipo</th><th>N° Serie</th>
                            <th>Estado</th><th>Fecha Asig.</th><th>Grupo/Área</th><th>Chip</th>
                        </tr>
                    </thead>
                    <tbody id="as-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>
    <div id="as-vacio" style="display:none; text-align:center; padding:40px; color:var(--gris-400);">
        Sin resultados para los filtros seleccionados.
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════ -->
<!-- TAB: HISTORIAL                                             -->
<!-- ══════════════════════════════════════════════════════════ -->
<div id="tab-historial" class="rep-panel" style="display:@(tab == "historial" ? "block" : "none");">
    <div class="card" style="margin-bottom:16px;">
        <p class="rep-section-title">Filtros</p>
        <div class="form-grid" style="gap:12px; align-items:end;">
            <div class="form-group">
                <label class="form-label">Desde</label>
                <input type="date" id="hi-desde" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">Hasta</label>
                <input type="date" id="hi-hasta" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">Motivo (asignaciones)</label>
                <select id="hi-motivo" class="form-control">
                    <option value="">— Todos —</option>
                    @foreach (var m in motivos)
                    {
                        <option value="@m.IdMotivo">@m.TipoMotivo</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Buscar</label>
                <input type="text" id="hi-buscar" class="form-control" placeholder="Equipo, componente..." />
            </div>
        </div>
        <div style="margin-top:12px;">
            <label class="form-label">Tipo de evento</label>
            <div class="rep-checks">
                @foreach (var ev in new[] { "CambioComponente","Mantenimiento","ActualizacionSO","HistorialAsig" })
                {
                    <label class="rep-check-item">
                        <input type="checkbox" class="hi-evento" value="@ev" checked />
                        <span class="rep-check-label">@(ev == "HistorialAsig" ? "Mov. Asignación" : ev)</span>
                    </label>
                }
            </div>
        </div>
        <div style="display:flex; gap:10px; margin-top:16px; flex-wrap:wrap;">
            <button onclick="consultarHistorial()" class="btn btn--celeste">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                Consultar
            </button>
            <button onclick="exportarHistCsv()" class="btn btn--verde" id="btn-hi-csv" disabled>
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Exportar CSV
            </button>
            <button onclick="exportarHistPdf()" class="btn btn--rojo" id="btn-hi-pdf" disabled>
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Exportar PDF
            </button>
        </div>
    </div>
    <div id="hi-resultado" style="display:none;">
        <div class="card" style="padding:0; overflow:hidden;">
            <div style="padding:14px 20px; border-bottom:1px solid var(--gris-200); display:flex; justify-content:space-between; align-items:center;">
                <span style="font-weight:700; font-size:0.9rem;">Resultados</span>
                <span class="badge badge--azul" id="hi-total">0</span>
            </div>
            <div class="table-wrapper" style="border:none; border-radius:0; max-height:420px; overflow-y:auto;">
                <table>
                    <thead>
                        <tr>
                            <th>Origen</th><th>Fecha</th><th>Tipo Equipo</th><th>Equipo</th>
                            <th>Evento</th><th>Detalle</th><th>Anterior</th><th>Nuevo</th>
                            <th>Motivo</th><th>Observación</th><th>Usuario</th>
                        </tr>
                    </thead>
                    <tbody id="hi-tbody"></tbody>
                </table>
            </div>
        </div>
    </div>
    <div id="hi-vacio" style="display:none; text-align:center; padding:40px; color:var(--gris-400);">
        Sin resultados para los filtros seleccionados.
    </div>
</div>

@section Styles {
<style>
.rep-tabs { display:flex; gap:4px; margin-bottom:16px; background:var(--gris-100); padding:4px; border-radius:var(--r-md); width:fit-content; }
.rep-tab { display:flex; align-items:center; gap:7px; padding:9px 18px; border:none; border-radius:calc(var(--r-md) - 2px); background:transparent; cursor:pointer; font-size:0.86rem; font-weight:600; color:var(--gris-500); transition:all 0.18s; }
.rep-tab svg { width:15px; height:15px; stroke:currentColor; fill:none; stroke-width:2; stroke-linecap:round; }
.rep-tab:hover { background:var(--blanco); color:var(--azul); }
.rep-tab--active { background:var(--blanco); color:var(--azul-dark); box-shadow:0 1px 4px rgba(0,0,0,0.1); }
.rep-section-title { font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); padding-bottom:8px; border-bottom:1px solid var(--gris-200); margin-bottom:14px; }
.rep-checks { display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; }
.rep-check-item { display:flex; align-items:center; gap:6px; padding:6px 12px; border:1.5px solid var(--gris-300); border-radius:20px; cursor:pointer; transition:all 0.15s; user-select:none; font-size:0.82rem; }
.rep-check-item:has(input:checked) { border-color:var(--celeste); background:rgba(59,130,246,0.07); color:var(--azul-dark); font-weight:600; }
.rep-check-item input { display:none; }
.btn--verde { background:#16a34a; color:#fff; border:none; }
.btn--verde:hover { background:#15803d; }
.btn--rojo  { background:#dc2626; color:#fff; border:none; }
.btn--rojo:hover  { background:#b91c1c; }
</style>
}

@section Scripts {
<script>
// ── Navegación por pestañas ───────────────────────────────────
function cambiarTab(t) {
    ['equipos','asignaciones','historial'].forEach(id => {
        document.getElementById('tab-' + id).style.display = id === t ? 'block' : 'none';
        document.querySelectorAll('.rep-tab').forEach((btn, i) => {
            btn.classList.toggle('rep-tab--active', ['equipos','asignaciones','historial'][i] === t);
        });
    });
}

// ── Helpers ───────────────────────────────────────────────────
function getChecked(cls) {
    return [...document.querySelectorAll('.' + cls + ':checked')].map(c => c.value).join(',');
}
function buildParams(obj) {
    return '?' + Object.entries(obj).filter(([,v]) => v).map(([k,v]) => `${k}=${encodeURIComponent(v)}`).join('&');
}
function estadoBadge(est) {
    const m = { 'Activo':'badge--verde', 'Asignado':'badge--azul', 'En mantenimiento':'badge--amarillo', 'Devuelto':'badge--gris', 'Inactivo':'badge--rojo', 'Baja':'badge--rojo', 'Perdida':'badge--rojo', 'Rotura':'badge--rojo' };
    return `<span class="badge ${m[est] ?? 'badge--rojo'}" style="font-size:0.7rem;">${est}</span>`;
}

// ── EQUIPOS ───────────────────────────────────────────────────
let lastEqParams = {};
async function consultarEquipos() {
    const p = {
        fechaDesde: document.getElementById('eq-desde').value,
        fechaHasta: document.getElementById('eq-hasta').value,
        tipoId:     document.getElementById('eq-tipo').value,
        grupoId:    document.getElementById('eq-grupo').value,
        buscar:     document.getElementById('eq-buscar').value,
        estado:     getChecked('eq-estado')
    };
    lastEqParams = p;
    const res  = await fetch('/Reportes/EquiposData' + buildParams(p));
    const data = await res.json();
    const tbody = document.getElementById('eq-tbody');
    document.getElementById('eq-total').textContent = data.total;

    if (data.total === 0) {
        document.getElementById('eq-resultado').style.display = 'none';
        document.getElementById('eq-vacio').style.display = 'block';
        document.getElementById('btn-eq-csv').disabled = true;
        document.getElementById('btn-eq-pdf').disabled = true;
        return;
    }
    document.getElementById('eq-resultado').style.display = 'block';
    document.getElementById('eq-vacio').style.display = 'none';
    document.getElementById('btn-eq-csv').disabled = false;
    document.getElementById('btn-eq-pdf').disabled = false;

    tbody.innerHTML = data.registros.map(e => `
        <tr>
            <td><span class="badge badge--azul" style="font-size:0.7rem;">${e.tipo}</span></td>
            <td style="font-weight:600;">${e.nombrePc ? e.nombrePc : ((e.marca ?? '—') + ' ' + (e.modelo ?? ''))}</td>
            <td style="font-family:monospace; font-size:0.8rem;">${e.nombrePc ? '—' : (e.numero_serie ?? '—')}</td>
            <td>${estadoBadge(e.estado_equipo)}</td>
            <td style="font-size:0.8rem; color:var(--gris-500);">${e.fechaCompra}</td>
            <td style="font-size:0.82rem;">${e.asignado}</td>
            <td style="font-size:0.78rem; color:var(--gris-600); max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${e.observaciones ?? '—'}</td>
        </tr>`).join('');
}
function exportarEquiposCsv() {
    window.location.href = '/Reportes/EquiposCsv' + buildParams(lastEqParams);
}
function exportarEquiposPdf() {
    window.open('/Reportes/EquiposPdf' + buildParams(lastEqParams), '_blank');
}

// ── ASIGNACIONES ──────────────────────────────────────────────
let lastAsParams = {};
async function consultarAsignaciones() {
    const p = {
        fechaDesde:  document.getElementById('as-desde').value,
        fechaHasta:  document.getElementById('as-hasta').value,
        tipoId:      document.getElementById('as-tipo').value,
        grupoId:     document.getElementById('as-grupo').value,
        buscar:      document.getElementById('as-buscar').value,
        estadoAsig:  getChecked('as-estado')
    };
    lastAsParams = p;
    const res  = await fetch('/Reportes/AsignacionesData' + buildParams(p));
    const data = await res.json();
    document.getElementById('as-total').textContent = data.total;

    if (data.total === 0) {
        document.getElementById('as-resultado').style.display = 'none';
        document.getElementById('as-vacio').style.display = 'block';
        document.getElementById('btn-as-csv').disabled = true;
        document.getElementById('btn-as-pdf').disabled = true;
        return;
    }
    document.getElementById('as-resultado').style.display = 'block';
    document.getElementById('as-vacio').style.display = 'none';
    document.getElementById('btn-as-csv').disabled = false;
    document.getElementById('btn-as-pdf').disabled = false;

    document.getElementById('as-tbody').innerHTML = data.registros.map(a => `
        <tr>
            <td style="font-weight:600;">${a.empleado}</td>
            <td><span class="badge badge--azul" style="font-size:0.7rem;">${a.tipoEquipo}</span></td>
            <td>${a.equipo}</td>
            <td style="font-family:monospace; font-size:0.8rem;">${a.serie}</td>
            <td>${estadoBadge(a.estadoAsignacion)}</td>
            <td style="font-size:0.8rem; color:var(--gris-500);">${a.fechaAsig}</td>
            <td style="font-size:0.82rem;">${a.grupo}</td>
            <td style="font-size:0.8rem;">${a.chip}</td>
        </tr>`).join('');
}
function exportarAsigCsv() {
    window.location.href = '/Reportes/AsignacionesCsv' + buildParams(lastAsParams);
}
function exportarAsigPdf() {
    window.open('/Reportes/AsignacionesPdf' + buildParams(lastAsParams), '_blank');
}

// ── HISTORIAL ─────────────────────────────────────────────────
let lastHiParams = {};
async function consultarHistorial() {
    const p = {
        fechaDesde:  document.getElementById('hi-desde').value,
        fechaHasta:  document.getElementById('hi-hasta').value,
        motivoId:    document.getElementById('hi-motivo').value,
        buscar:      document.getElementById('hi-buscar').value,
        tipoEvento:  getChecked('hi-evento')
    };
    lastHiParams = p;
    const res  = await fetch('/Reportes/HistorialData' + buildParams(p));
    const data = await res.json();
    document.getElementById('hi-total').textContent = data.total;

    const evColor = { 'CambioComponente':'badge--azul','Mantenimiento':'badge--amarillo','ActualizacionSO':'badge--celeste','Movimiento':'badge--verde' };

    if (data.total === 0) {
        document.getElementById('hi-resultado').style.display = 'none';
        document.getElementById('hi-vacio').style.display = 'block';
        document.getElementById('btn-hi-csv').disabled = true;
        document.getElementById('btn-hi-pdf').disabled = true;
        return;
    }
    document.getElementById('hi-resultado').style.display = 'block';
    document.getElementById('hi-vacio').style.display = 'none';
    document.getElementById('btn-hi-csv').disabled = false;
    document.getElementById('btn-hi-pdf').disabled = false;

    document.getElementById('hi-tbody').innerHTML = data.registros.map(h => `
        <tr>
            <td><span class="badge badge--gris" style="font-size:0.7rem;">${h.origen}</span></td>
            <td style="font-size:0.78rem; color:var(--gris-500); white-space:nowrap;">${h.fecha}</td>
            <td><span class="badge badge--azul" style="font-size:0.7rem;">${h.tipo}</span></td>
            <td style="font-size:0.82rem; font-weight:500;">${h.equipo}</td>
            <td><span class="badge ${evColor[h.evento] ?? 'badge--gris'}" style="font-size:0.7rem;">${h.evento}</span></td>
            <td style="font-size:0.8rem;">${h.detalle}</td>
            <td style="font-size:0.78rem; color:var(--gris-500);">${h.valorAntes}</td>
            <td style="font-size:0.78rem; color:var(--azul);">${h.valorDespues}</td>
            <td style="font-size:0.78rem;">${h.motivo}</td>
            <td style="font-size:0.78rem; color:var(--gris-600);">${h.obs}</td>
            <td style="font-size:0.75rem; color:var(--gris-400);">${h.usuario}</td>
        </tr>`).join('');
}
function exportarHistCsv() {
    window.location.href = '/Reportes/HistorialCsv' + buildParams(lastHiParams);
}
function exportarHistPdf() {
    window.open('/Reportes/HistorialPdf' + buildParams(lastHiParams), '_blank');
}
</script>
}
