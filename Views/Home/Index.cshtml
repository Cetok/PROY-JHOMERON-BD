@model PROYJHOME2026.Controllers.DashboardViewModel
@{
    ViewData["Title"]      = "Dashboard";
    ViewData["Breadcrumb"] = "Dashboard";
}

<!-- ENCABEZADO -->
<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Resumen general</div>
        <h1 class="page-header__title">Dashboard</h1>
        <p class="page-header__subtitle">
            Bienvenido — @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy",
                new System.Globalization.CultureInfo("es-PE"))
        </p>
    </div>
</div>

<!-- KPIs -->
<div class="stats-grid" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:14px; margin-bottom:20px;">
    <div class="stat-card">
        <div class="stat-card__top">
            <div class="stat-card__icon stat-card__icon--azul">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            </div>
            <span class="stat-card__delta stat-card__delta--up">@Model.EmpleadosActivos activos</span>
        </div>
        <div class="stat-card__value">@Model.TotalEmpleados</div>
        <div class="stat-card__label">Empleados</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__top">
            <div class="stat-card__icon stat-card__icon--celeste">
                <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/></svg>
            </div>
            <span class="stat-card__delta stat-card__delta--up">@Model.EquiposAsignados asignados</span>
        </div>
        <div class="stat-card__value">@Model.TotalEquipos</div>
        <div class="stat-card__label">Equipos TI</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__top">
            <div class="stat-card__icon stat-card__icon--verde">
                <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <span class="stat-card__delta stat-card__delta--up">@Model.CarrosActivos activos</span>
        </div>
        <div class="stat-card__value">@Model.TotalCarros</div>
        <div class="stat-card__label">Vehículos</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__top">
            <div class="stat-card__icon stat-card__icon--amarillo">
                <svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
            </div>
            <span class="stat-card__delta stat-card__delta--down">@Model.MantenimientosPendientes pendientes</span>
        </div>
        <div class="stat-card__value">@Model.MantenimientosPendientes</div>
        <div class="stat-card__label">Mantenimientos</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__top">
            <div class="stat-card__icon" style="background:rgba(124,58,237,0.1);">
                <svg viewBox="0 0 24 24" style="stroke:#7c3aed;"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
            </div>
            <span class="stat-card__delta stat-card__delta--up">@Model.MaquinasActivas activas</span>
        </div>
        <div class="stat-card__value">@Model.TotalMaquinas</div>
        <div class="stat-card__label">Máquinas</div>
    </div>
</div>

<!-- GRÁFICOS -->
<div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:14px; margin-bottom:20px;">
    <div class="card">
        <div style="font-weight:700; font-size:0.85rem; margin-bottom:12px; color:var(--gris-900);">Equipos por estado</div>
        <div style="position:relative; height:180px;"><canvas id="chartEquipos"></canvas></div>
    </div>
    <div class="card">
        <div style="font-weight:700; font-size:0.85rem; margin-bottom:12px; color:var(--gris-900);">Vehículos por estado</div>
        <div style="position:relative; height:180px;"><canvas id="chartCarros"></canvas></div>
    </div>
    <div class="card">
        <div style="font-weight:700; font-size:0.85rem; margin-bottom:12px; color:var(--gris-900);">Máquinas por estado</div>
        <div style="position:relative; height:180px;"><canvas id="chartMaquinas"></canvas></div>
    </div>
</div>

<!-- FILA: Últimas asignaciones + Mantenimientos próximos -->
<div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:20px;">
    <div class="card" style="padding:0; overflow:hidden;">
        <div style="padding:14px 20px; border-bottom:1px solid var(--gris-200); display:flex; justify-content:space-between; align-items:center;">
            <span style="font-weight:700; font-size:0.88rem;">Últimas asignaciones</span>
            <a asp-controller="Asignaciones" asp-action="Index" style="font-size:0.78rem; color:var(--azul);">Ver todas →</a>
        </div>
        <div class="table-wrapper" style="border:none; border-radius:0;">
            <table>
                <thead><tr><th>Empleado</th><th>Equipo</th><th>Fecha</th><th>Estado</th></tr></thead>
                <tbody>
                    @foreach (var a in Model.UltimasAsignaciones)
                    {
                        var bc = a.EstadoAsignacion == "Activo" ? "badge--verde" : a.EstadoAsignacion == "Asignado" ? "badge--azul" : "badge--gris";
                        <tr>
                            <td style="font-size:0.82rem; font-weight:600;">@(a.Empleado?.nombre) @(a.Empleado?.paterno)</td>
                            <td style="font-size:0.78rem; color:var(--gris-500);">@(a.Equipo?.marca) @(a.Equipo?.modelo)</td>
                            <td style="font-size:0.75rem; color:var(--gris-400);">@a.FechaAsignacion.ToString("dd/MM/yy")</td>
                            <td><span class="badge @bc" style="font-size:0.65rem;">@a.EstadoAsignacion</span></td>
                        </tr>
                    }
                    @if (!Model.UltimasAsignaciones.Any())
                    {
                        <tr><td colspan="4" style="text-align:center; color:var(--gris-400); padding:20px;">Sin asignaciones</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card" style="padding:0; overflow:hidden;">
        <div style="padding:14px 20px; border-bottom:1px solid var(--gris-200); display:flex; justify-content:space-between; align-items:center;">
            <span style="font-weight:700; font-size:0.88rem;">Mantenimientos pendientes</span>
            <a asp-controller="MantenimientoCarros" asp-action="Index" style="font-size:0.78rem; color:var(--azul);">Ver todos →</a>
        </div>
        <div class="table-wrapper" style="border:none; border-radius:0;">
            <table>
                <thead><tr><th>Vehículo</th><th>Tipo</th><th>F. Programada</th></tr></thead>
                <tbody>
                    @foreach (var m in Model.MantenimientosRecientes)
                    {
                        <tr>
                            <td style="font-size:0.82rem; font-weight:600; color:var(--azul-dark);">@(m.Carro?.Placa)</td>
                            <td style="font-size:0.78rem; color:var(--gris-500);">@(m.TipoMantenimiento?.Nombre)</td>
                            <td style="font-size:0.78rem; color:var(--amarillo, #d97706); font-weight:600;">@m.FechaProgramada.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                    @if (!Model.MantenimientosRecientes.Any())
                    {
                        <tr><td colspan="3" style="text-align:center; color:var(--gris-400); padding:20px;">Sin mantenimientos pendientes ✓</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- TABLA DE ÚLTIMOS MOVIMIENTOS PAGINADA -->
<div class="card" style="padding:0; overflow:hidden;">
    <div style="padding:14px 20px; border-bottom:1px solid var(--gris-200); display:flex; justify-content:space-between; align-items:center;">
        <span style="font-weight:700; font-size:0.88rem;">Últimos movimientos del sistema</span>
        <span class="badge badge--gris" id="mov-total-label" style="font-size:0.75rem;">—</span>
    </div>
    <div id="mov-loading" style="text-align:center; padding:20px; color:var(--gris-400); font-size:0.82rem;">Cargando...</div>
    <div id="mov-tabla-wrap" style="display:none;">
        <div class="table-wrapper" style="border:none; border-radius:0;">
            <table>
                <thead>
                    <tr>
                        <th>Fecha / Hora</th>
                        <th>Acción</th>
                        <th>Entidad</th>
                        <th>Descripción</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody id="mov-tbody"></tbody>
            </table>
        </div>
        <!-- Paginación -->
        <div class="pagination" id="mov-pagination" style="padding:10px 16px;"></div>
    </div>
    <div id="mov-vacio" style="display:none; text-align:center; padding:20px; color:var(--gris-400);">Sin movimientos.</div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
// ── Gráficos de dona ─────────────────────────────────────────────────────────
const coloresEstado = {
    'Activo':           '#16a34a',
    'Asignado':         '#2563eb',
    'Mantenimiento':    '#d97706',
    'En mantenimiento': '#d97706',
    'Inoperativo':      '#dc2626',
    'Inactivo':         '#6b7280',
    'Devuelto':         '#9ca3af',
    'Perdida':          '#dc2626',
    'Rotura':           '#dc2626',
    'Baja':             '#dc2626',
    'Registrado':       '#9ca3af',
};

function donaChart(id, datos) {
    new Chart(document.getElementById(id), {
        type: 'doughnut',
        data: {
            labels:   datos.map(d => d.estado),
            datasets: [{ data: datos.map(d => d.total),
                backgroundColor: datos.map(d => coloresEstado[d.estado] ?? '#94a3b8'),
                borderWidth: 2, borderColor: '#fff', hoverOffset: 6 }]
        },
        options: {
            responsive: true, maintainAspectRatio: false, cutout: '60%',
            plugins: { legend: { position: 'right', labels: { padding: 10, boxWidth: 10, font: { size: 11 } } } }
        }
    });
}

// Datos del servidor → JS
const equiposPorEstado  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EquiposPorEstado.Select(e => new { estado = e.Estado, total = e.Total })));
const carrosPorEstado   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CarrosPorEstado.Select(e => new { estado = e.Estado, total = e.Total })));
const maquinasPorEstado = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MaquinasPorEstado.Select(e => new { estado = e.Estado, total = e.Total })));

donaChart('chartEquipos',  equiposPorEstado);
donaChart('chartCarros',   carrosPorEstado);
donaChart('chartMaquinas', maquinasPorEstado);

// ── Tabla paginada de movimientos ─────────────────────────────────────────────
let paginaActual = 1;

const accionColor = {
    'Crear':        '#16a34a',
    'Editar':       '#2563eb',
    'Eliminar':     '#dc2626',
    'CambioEstado': '#d97706',
    'Login':        '#7c3aed',
    'Logout':       '#6b7280',
};

async function cargarMovimientos(pagina) {
    paginaActual = pagina;
    const res  = await fetch(`/Home/MovimientosData?pagina=${pagina}`);
    const data = await res.json();

    document.getElementById('mov-total-label').textContent = `${data.total} registro(s)`;
    document.getElementById('mov-loading').style.display   = 'none';

    if (data.total === 0) {
        document.getElementById('mov-vacio').style.display = 'block';
        return;
    }
    document.getElementById('mov-tabla-wrap').style.display = 'block';

    document.getElementById('mov-tbody').innerHTML = data.registros.map(m => `
        <tr>
            <td style="font-size:0.78rem; color:var(--gris-400); white-space:nowrap;">${m.fecha}</td>
            <td><span style="font-size:0.75rem; font-weight:700; color:${accionColor[m.accion] ?? '#6b7280'};">${m.accion}</span></td>
            <td style="font-size:0.78rem; color:var(--gris-600);">${m.entidad}</td>
            <td style="font-size:0.78rem; color:var(--gris-700); max-width:300px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="${m.descripcion ?? ''}">${m.descripcion ?? '—'}</td>
            <td style="font-size:0.75rem; color:var(--azul);">${m.nombreUsuario ?? '—'}</td>
        </tr>`).join('');

    // Paginación
    const pag = document.getElementById('mov-pagination');
    pag.innerHTML = '';
    if (data.totalPaginas > 1) {
        const span = document.createElement('span');
        span.style.cssText = 'font-size:0.75rem; color:var(--gris-400); margin-right:8px;';
        span.textContent   = `Página ${pagina} de ${data.totalPaginas}`;
        pag.appendChild(span);

        for (let i = 1; i <= data.totalPaginas; i++) {
            const btn = document.createElement('a');
            btn.className   = 'pagination__btn' + (i === pagina ? ' active' : '');
            btn.textContent = i;
            btn.href        = '#';
            btn.onclick     = (e) => { e.preventDefault(); cargarMovimientos(i); };
            pag.appendChild(btn);
        }
    }
}

cargarMovimientos(1);
</script>
}
