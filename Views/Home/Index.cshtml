@model PROYJHOME2026.Controllers.DashboardViewModel
@{
    ViewData["Title"]      = "Dashboard";
    ViewData["Breadcrumb"] = "Dashboard";
}

@section Styles {
<style>
/* ── KPI Cards ─────────────────────────────────────────────── */
.kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 14px;
    margin-bottom: 22px;
}

.kpi-card {
    position: relative;
    background: #fff;
    border-radius: 16px;
    padding: 20px 20px 16px;
    box-shadow: 0 1px 3px rgba(26,58,107,0.07), 0 4px 14px rgba(26,58,107,0.05);
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    border: 1px solid rgba(26,58,107,0.07);
}
.kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(26,58,107,0.13);
}

/* Franja de color izquierda */
.kpi-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
    border-radius: 16px 0 0 16px;
}
.kpi-card--azul::before   { background: #0d3393; }
.kpi-card--celeste::before { background: #3b9be8; }
.kpi-card--verde::before  { background: #10b981; }
.kpi-card--amarillo::before { background: #f59e0b; }
.kpi-card--purpura::before { background: #7c3aed; }

/* Círculo decorativo fondo */
.kpi-card__bg-circle {
    position: absolute;
    right: -18px; top: -18px;
    width: 90px; height: 90px;
    border-radius: 50%;
    opacity: 0.06;
}
.kpi-card--azul    .kpi-card__bg-circle { background: #0d3393; }
.kpi-card--celeste .kpi-card__bg-circle { background: #3b9be8; }
.kpi-card--verde   .kpi-card__bg-circle { background: #10b981; }
.kpi-card--amarillo .kpi-card__bg-circle { background: #f59e0b; }
.kpi-card--purpura  .kpi-card__bg-circle { background: #7c3aed; }

.kpi-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
}

.kpi-card__icon {
    width: 38px; height: 38px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
}
.kpi-card__icon svg {
    width: 18px; height: 18px;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}
.kpi-card--azul    .kpi-card__icon { background: rgba(13,51,147,0.09);  }
.kpi-card--azul    .kpi-card__icon svg { stroke: #0d3393; }
.kpi-card--celeste .kpi-card__icon { background: rgba(59,155,232,0.1); }
.kpi-card--celeste .kpi-card__icon svg { stroke: #3b9be8; }
.kpi-card--verde   .kpi-card__icon { background: rgba(16,185,129,0.1); }
.kpi-card--verde   .kpi-card__icon svg { stroke: #10b981; }
.kpi-card--amarillo .kpi-card__icon { background: rgba(245,158,11,0.1); }
.kpi-card--amarillo .kpi-card__icon svg { stroke: #f59e0b; }
.kpi-card--purpura  .kpi-card__icon { background: rgba(124,58,237,0.1); }
.kpi-card--purpura  .kpi-card__icon svg { stroke: #7c3aed; }

.kpi-card__pill {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 20px;
    letter-spacing: 0.02em;
}
.kpi-pill--up   { background: rgba(16,185,129,0.12); color: #059669; }
.kpi-pill--warn { background: rgba(245,158,11,0.12); color: #d97706; }
.kpi-pill--info { background: rgba(59,155,232,0.12); color: #2563eb; }
.kpi-pill--purple { background: rgba(124,58,237,0.1); color: #7c3aed; }

.kpi-card__value {
    font-family: 'Outfit', sans-serif;
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1;
    color: #1c2340;
    letter-spacing: -0.02em;
    margin-bottom: 4px;
}
.kpi-card__label {
    font-size: 0.78rem;
    font-weight: 500;
    color: #7a85a0;
    letter-spacing: 0.02em;
}

/* ── Gráficos ──────────────────────────────────────────────── */
.charts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 22px;
}

.chart-card {
    background: #fff;
    border-radius: 16px;
    padding: 20px;
    border: 1px solid rgba(26,58,107,0.07);
    box-shadow: 0 1px 3px rgba(26,58,107,0.07), 0 4px 14px rgba(26,58,107,0.04);
}

.chart-card__title {
    font-size: 0.82rem;
    font-weight: 700;
    color: #1c2340;
    margin-bottom: 4px;
    letter-spacing: 0.01em;
}
.chart-card__sub {
    font-size: 0.7rem;
    color: #b0b8cc;
    margin-bottom: 14px;
}

.chart-card__wrap {
    position: relative;
    height: 170px;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Total centrado dentro de la dona */
.chart-center-label {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
}
.chart-center-label__num {
    font-family: 'Outfit', sans-serif;
    font-size: 1.65rem;
    font-weight: 700;
    color: #1c2340;
    line-height: 1;
}
.chart-center-label__txt {
    font-size: 0.63rem;
    font-weight: 600;
    color: #b0b8cc;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 2px;
}

/* Leyenda custom debajo del gráfico */
.chart-legend {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 14px;
}
.chart-legend__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.73rem;
}
.chart-legend__left {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #4a5370;
    font-weight: 500;
}
.chart-legend__dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
}
.chart-legend__count {
    font-weight: 700;
    color: #1c2340;
    font-family: 'Outfit', sans-serif;
    font-size: 0.8rem;
}

/* ── Tablas inferiores ─────────────────────────────────────── */
.bottom-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 22px;
}

.table-card {
    background: #fff;
    border-radius: 16px;
    border: 1px solid rgba(26,58,107,0.07);
    box-shadow: 0 1px 3px rgba(26,58,107,0.07);
    overflow: hidden;
}
.table-card__header {
    padding: 14px 20px;
    border-bottom: 1px solid #eaecf3;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.table-card__header-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #1c2340;
}
.table-card__header-link {
    font-size: 0.74rem;
    color: #3b9be8;
    font-weight: 600;
    transition: color 0.15s;
}
.table-card__header-link:hover { color: #0d3393; }

/* ── Logs card ─────────────────────────────────────────────── */
.logs-card {
    background: #fff;
    border-radius: 16px;
    border: 1px solid rgba(26,58,107,0.07);
    box-shadow: 0 1px 3px rgba(26,58,107,0.07);
    overflow: hidden;
}

@@media (max-width: 900px) {
    .charts-grid  { grid-template-columns: 1fr; }
    .bottom-grid  { grid-template-columns: 1fr; }
    .kpi-grid     { grid-template-columns: repeat(2, 1fr); }
}
</style>
}

<!-- ENCABEZADO -->
<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Resumen general</div>
        <h1 class="page-header__title">Dashboard</h1>
        <p class="page-header__subtitle">
            @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy",
                new System.Globalization.CultureInfo("es-PE"))
        </p>
    </div>
</div>

<!-- KPIs -->
<div class="kpi-grid">

    <!-- Empleados -->
    <div class="kpi-card kpi-card--azul">
        <div class="kpi-card__bg-circle"></div>
        <div class="kpi-card__header">
            <div class="kpi-card__icon">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
            </div>
            <span class="kpi-card__pill kpi-pill--up">@Model.EmpleadosActivos activos</span>
        </div>
        <div class="kpi-card__value">@Model.TotalEmpleados</div>
        <div class="kpi-card__label">Empleados</div>
    </div>

    <!-- Equipos TI -->
    <div class="kpi-card kpi-card--celeste">
        <div class="kpi-card__bg-circle"></div>
        <div class="kpi-card__header">
            <div class="kpi-card__icon">
                <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            </div>
            <span class="kpi-card__pill kpi-pill--info">@Model.EquiposAsignados asignados</span>
        </div>
        <div class="kpi-card__value">@Model.TotalEquipos</div>
        <div class="kpi-card__label">Equipos TI</div>
    </div>

    <!-- Vehículos -->
    <div class="kpi-card kpi-card--verde">
        <div class="kpi-card__bg-circle"></div>
        <div class="kpi-card__header">
            <div class="kpi-card__icon">
                <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <span class="kpi-card__pill kpi-pill--up">@Model.CarrosActivos activos</span>
        </div>
        <div class="kpi-card__value">@Model.TotalCarros</div>
        <div class="kpi-card__label">Vehículos</div>
    </div>

    <!-- Mantenimientos -->
    <div class="kpi-card kpi-card--amarillo">
        <div class="kpi-card__bg-circle"></div>
        <div class="kpi-card__header">
            <div class="kpi-card__icon">
                <svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
            </div>
            <span class="kpi-card__pill kpi-pill--warn">pendientes</span>
        </div>
        <div class="kpi-card__value">@Model.MantenimientosPendientes</div>
        <div class="kpi-card__label">Mantenimientos</div>
    </div>

    <!-- Máquinas -->
    <div class="kpi-card kpi-card--purpura">
        <div class="kpi-card__bg-circle"></div>
        <div class="kpi-card__header">
            <div class="kpi-card__icon">
                <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/></svg>
            </div>
            <span class="kpi-card__pill kpi-pill--purple">@Model.MaquinasActivas activas</span>
        </div>
        <div class="kpi-card__value">@Model.TotalMaquinas</div>
        <div class="kpi-card__label">Máquinas</div>
    </div>

</div>

<!-- GRÁFICOS DONA -->
<div class="charts-grid">

    <!-- Equipos -->
    <div class="chart-card">
        <div class="chart-card__title">Equipos TI</div>
        <div class="chart-card__sub">Distribución por estado</div>
        <div class="chart-card__wrap">
            <canvas id="chartEquipos"></canvas>
            <div class="chart-center-label" id="centerEquipos">
                <span class="chart-center-label__num">@Model.TotalEquipos</span>
                <span class="chart-center-label__txt">total</span>
            </div>
        </div>
        <div class="chart-legend" id="legendEquipos"></div>
    </div>

    <!-- Vehículos -->
    <div class="chart-card">
        <div class="chart-card__title">Vehículos</div>
        <div class="chart-card__sub">Distribución por estado</div>
        <div class="chart-card__wrap">
            <canvas id="chartCarros"></canvas>
            <div class="chart-center-label" id="centerCarros">
                <span class="chart-center-label__num">@Model.TotalCarros</span>
                <span class="chart-center-label__txt">total</span>
            </div>
        </div>
        <div class="chart-legend" id="legendCarros"></div>
    </div>

    <!-- Máquinas -->
    <div class="chart-card">
        <div class="chart-card__title">Máquinas</div>
        <div class="chart-card__sub">Distribución por estado</div>
        <div class="chart-card__wrap">
            <canvas id="chartMaquinas"></canvas>
            <div class="chart-center-label" id="centerMaquinas">
                <span class="chart-center-label__num">@Model.TotalMaquinas</span>
                <span class="chart-center-label__txt">total</span>
            </div>
        </div>
        <div class="chart-legend" id="legendMaquinas"></div>
    </div>

</div>

<!-- TABLAS: Asignaciones + Mantenimientos -->
<div class="bottom-grid">

    <div class="table-card">
        <div class="table-card__header">
            <span class="table-card__header-title">Últimas asignaciones</span>
            <a asp-controller="Asignaciones" asp-action="Index" class="table-card__header-link">Ver todas →</a>
        </div>
        <div class="table-wrapper" style="border:none; border-radius:0;">
            <table>
                <thead><tr><th>Empleado</th><th>Equipo</th><th>Fecha</th><th>Estado</th></tr></thead>
                <tbody>
                    @foreach (var a in Model.UltimasAsignaciones)
                    {
                        var bc = a.EstadoAsignacion == "Activo" ? "badge--verde" : a.EstadoAsignacion == "Asignado" ? "badge--azul" : "badge--gris";
                        <tr>
                            <td style="font-size:0.82rem; font-weight:600;">@(a.Empleado?.nombre) @(a.Empleado?.paterno)</td>
                            <td style="font-size:0.78rem; color:var(--gris-500);">@(a.Equipo?.marca) @(a.Equipo?.modelo)</td>
                            <td style="font-size:0.75rem; color:var(--gris-400);">@a.FechaAsignacion.ToString("dd/MM/yy")</td>
                            <td><span class="badge @bc" style="font-size:0.65rem;">@a.EstadoAsignacion</span></td>
                        </tr>
                    }
                    @if (!Model.UltimasAsignaciones.Any())
                    {
                        <tr><td colspan="4" style="text-align:center; color:var(--gris-400); padding:20px;">Sin asignaciones</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="table-card">
        <div class="table-card__header">
            <span class="table-card__header-title">Mantenimientos pendientes</span>
            <a asp-controller="MantenimientoCarros" asp-action="Index" class="table-card__header-link">Ver todos →</a>
        </div>
        <div class="table-wrapper" style="border:none; border-radius:0;">
            <table>
                <thead><tr><th>Vehículo</th><th>Tipo</th><th>F. Programada</th></tr></thead>
                <tbody>
                    @foreach (var m in Model.MantenimientosRecientes)
                    {
                        <tr>
                            <td style="font-size:0.82rem; font-weight:600; color:var(--azul-dark);">@(m.Carro?.Placa)</td>
                            <td style="font-size:0.78rem; color:var(--gris-500);">@(m.TipoMantenimiento?.Nombre)</td>
                            <td style="font-size:0.78rem; color:#d97706; font-weight:600;">@m.FechaProgramada.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                    @if (!Model.MantenimientosRecientes.Any())
                    {
                        <tr><td colspan="3" style="text-align:center; color:var(--gris-400); padding:20px;">Sin mantenimientos pendientes ✓</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- TABLA MOVIMIENTOS PAGINADA -->
<div class="logs-card">
    <div class="table-card__header">
        <span class="table-card__header-title">Últimos movimientos del sistema</span>
        <span class="badge badge--gris" id="mov-total-label" style="font-size:0.72rem;">—</span>
    </div>
    <div id="mov-loading" style="text-align:center; padding:20px; color:var(--gris-400); font-size:0.82rem;">Cargando...</div>
    <div id="mov-tabla-wrap" style="display:none;">
        <div class="table-wrapper" style="border:none; border-radius:0;">
            <table>
                <thead>
                    <tr>
                        <th>Fecha / Hora</th>
                        <th>Acción</th>
                        <th>Entidad</th>
                        <th>Descripción</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody id="mov-tbody"></tbody>
            </table>
        </div>
        <div class="pagination" id="mov-pagination" style="padding:10px 16px;"></div>
    </div>
    <div id="mov-vacio" style="display:none; text-align:center; padding:20px; color:var(--gris-400);">Sin movimientos.</div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
// ── Paleta de colores por estado ─────────────────────────────
const COLORES = {
    'Activo':           { hex: '#10b981', bg: 'rgba(16,185,129,0.12)' },
    'Asignado':         { hex: '#3b9be8', bg: 'rgba(59,155,232,0.12)' },
    'Mantenimiento':    { hex: '#f59e0b', bg: 'rgba(245,158,11,0.12)' },
    'En mantenimiento': { hex: '#f59e0b', bg: 'rgba(245,158,11,0.12)' },
    'Inoperativo':      { hex: '#e03d3d', bg: 'rgba(224,61,61,0.12)'  },
    'Inactivo':         { hex: '#94a3b8', bg: 'rgba(148,163,184,0.12)' },
    'Devuelto':         { hex: '#94a3b8', bg: 'rgba(148,163,184,0.12)' },
    'Perdida':          { hex: '#e03d3d', bg: 'rgba(224,61,61,0.12)'  },
    'Rotura':           { hex: '#e03d3d', bg: 'rgba(224,61,61,0.12)'  },
    'Baja':             { hex: '#e03d3d', bg: 'rgba(224,61,61,0.12)'  },
    'Registrado':       { hex: '#94a3b8', bg: 'rgba(148,163,184,0.12)' },
};
const colorHex = s => (COLORES[s] ?? { hex: '#94a3b8' }).hex;

// ── Dona mejorada + leyenda custom ───────────────────────────
function crearDona(canvasId, legendId, datos) {
    const hexes = datos.map(d => colorHex(d.estado));

    const chart = new Chart(document.getElementById(canvasId), {
        type: 'doughnut',
        data: {
            labels: datos.map(d => d.estado),
            datasets: [{
                data: datos.map(d => d.total),
                backgroundColor: hexes,
                borderWidth: 3,
                borderColor: '#fff',
                hoverBorderWidth: 3,
                hoverOffset: 8,
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '72%',
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => ` ${ctx.label}: ${ctx.parsed} (${Math.round(ctx.parsed / ctx.dataset.data.reduce((a,b)=>a+b,0)*100)}%)`
                    },
                    backgroundColor: '#1c2340',
                    padding: 10,
                    titleFont: { size: 12 },
                    bodyFont: { size: 12 },
                    cornerRadius: 8,
                }
            },
            animation: {
                animateRotate: true,
                duration: 700,
                easing: 'easeOutQuart'
            }
        }
    });

    // Leyenda custom
    const legend = document.getElementById(legendId);
    const total = datos.reduce((s, d) => s + d.total, 0);
    legend.innerHTML = datos.map((d, i) => {
        const pct = total > 0 ? Math.round(d.total / total * 100) : 0;
        return `
        <div class="chart-legend__item">
            <div class="chart-legend__left">
                <span class="chart-legend__dot" style="background:${hexes[i]};"></span>
                ${d.estado}
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
                <span style="font-size:0.68rem;color:#b0b8cc;">${pct}%</span>
                <span class="chart-legend__count">${d.total}</span>
            </div>
        </div>`;
    }).join('');

    return chart;
}

// Datos del servidor
const equiposPorEstado  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EquiposPorEstado.Select(e  => new { estado = e.Estado, total = e.Total })));
const carrosPorEstado   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CarrosPorEstado.Select(e   => new { estado = e.Estado, total = e.Total })));
const maquinasPorEstado = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MaquinasPorEstado.Select(e => new { estado = e.Estado, total = e.Total })));

crearDona('chartEquipos',  'legendEquipos',  equiposPorEstado);
crearDona('chartCarros',   'legendCarros',   carrosPorEstado);
crearDona('chartMaquinas', 'legendMaquinas', maquinasPorEstado);

// ── Tabla paginada de movimientos ─────────────────────────────
const accionConfig = {
    'Crear':        { color:'#059669', bg:'rgba(5,150,105,0.1)',   label:'Crear'  },
    'Editar':       { color:'#2563eb', bg:'rgba(37,99,235,0.1)',   label:'Editar' },
    'Eliminar':     { color:'#dc2626', bg:'rgba(220,38,38,0.1)',   label:'Eliminar' },
    'CambioEstado': { color:'#d97706', bg:'rgba(217,119,6,0.1)',   label:'Estado' },
    'Login':        { color:'#7c3aed', bg:'rgba(124,58,237,0.1)',  label:'Login'  },
    'Logout':       { color:'#6b7280', bg:'rgba(107,114,128,0.1)', label:'Logout' },
};

async function cargarMovimientos(pagina) {
    const res  = await fetch(`/Home/MovimientosData?pagina=${pagina}`);
    const data = await res.json();

    document.getElementById('mov-total-label').textContent = `${data.total} registro(s)`;
    document.getElementById('mov-loading').style.display   = 'none';

    if (data.total === 0) {
        document.getElementById('mov-vacio').style.display = 'block';
        return;
    }
    document.getElementById('mov-tabla-wrap').style.display = 'block';

    const cfg = a => accionConfig[a] ?? { color:'#6b7280', bg:'rgba(107,114,128,0.1)', label: a };

    document.getElementById('mov-tbody').innerHTML = data.registros.map(m => {
        const c = cfg(m.accion);
        return `<tr>
            <td style="font-size:0.78rem; color:var(--gris-400); white-space:nowrap;">${m.fecha}</td>
            <td><span style="font-size:0.7rem;font-weight:700;padding:3px 8px;border-radius:12px;background:${c.bg};color:${c.color};">${c.label}</span></td>
            <td style="font-size:0.78rem; color:var(--gris-600);">${m.entidad}</td>
            <td style="font-size:0.78rem; color:var(--gris-700); max-width:280px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="${m.descripcion ?? ''}">${m.descripcion ?? '—'}</td>
            <td style="font-size:0.75rem; color:var(--celeste); font-weight:600;">${m.nombreUsuario ?? '—'}</td>
        </tr>`;
    }).join('');

    // Paginación
    const pag = document.getElementById('mov-pagination');
    pag.innerHTML = '';
    if (data.totalPaginas > 1) {
        const span = document.createElement('span');
        span.style.cssText = 'font-size:0.74rem; color:var(--gris-400); margin-right:8px;';
        span.textContent   = `Página ${pagina} de ${data.totalPaginas}`;
        pag.appendChild(span);
        for (let i = 1; i <= data.totalPaginas; i++) {
            const btn = document.createElement('a');
            btn.className   = 'pagination__btn' + (i === pagina ? ' active' : '');
            btn.textContent = i;
            btn.href        = '#';
            btn.onclick     = (e) => { e.preventDefault(); cargarMovimientos(i); };
            pag.appendChild(btn);
        }
    }
}

cargarMovimientos(1);
</script>
}
