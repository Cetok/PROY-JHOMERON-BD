@{
    ViewData["Title"]      = "Inspección de Extintores";
    ViewData["Breadcrumb"] = "Accesorios / Inspección Extintores";
    var accesorio         = ViewBag.Accesorio         as PROYJHOME2026.Models.Asesorio;
    var gruposConExtintor = ViewBag.GruposConExtintor  as List<PROYJHOME2026.Models.GrupoAsesorio> ?? new();
    var observaciones     = ViewBag.Observaciones      as Dictionary<int, string> ?? new();
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Accesorios</div>
        <h1 class="page-header__title">Inspección de Extintores</h1>
        <p class="page-header__subtitle">@accesorio?.TipoAsesorio</p>
    </div>
    <div class="page-header__actions">
        <a asp-controller="Asesorios" asp-action="Details" asp-route-id="@accesorio?.IdAsesorio" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<form asp-action="Crear" method="post" id="formInspeccion">
    @Html.AntiForgeryToken()
    <input type="hidden" name="idAsesorio" value="@accesorio?.IdAsesorio" />

    <div style="max-width:1000px; display:flex; flex-direction:column; gap:16px;">

        <!-- ENCABEZADO ──────────────────────────────────────────── -->
        <div class="card">
            <div style="text-align:center; padding-bottom:14px; border-bottom:1px solid var(--gris-200); margin-bottom:18px;">
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; color:var(--gris-400);">FMT-SST-018 · Versión 00 · Sistema de Gestión de Seguridad y Salud en el Trabajo</div>
                <div style="font-family:var(--font-display); font-size:1.15rem; font-weight:800; color:var(--azul-dark); margin-top:4px;">INSPECCIÓN DE EXTINTORES</div>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <div>
                    <div class="det-label">Fecha de inspección</div>
                    <div class="det-value" style="font-weight:700; color:var(--azul);">@DateTime.Today.ToString("dd/MM/yyyy")</div>
                </div>
                <div>
                    <label class="form-label">Inspeccionado por <span class="req">*</span></label>
                    <input type="text" name="inspeccionadoPor" class="form-control" required maxlength="200"
                           placeholder="Nombre completo del inspector" />
                </div>
            </div>
        </div>

        <!-- LEYENDA OBSERVACIONES ───────────────────────────────── -->
        <div class="card">
            <div style="font-weight:700; font-size:0.88rem; color:var(--gris-900); margin-bottom:12px;">
                Leyenda de Observaciones
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:6px;">
                @foreach (var obs in observaciones)
                {
                    <div style="font-size:0.74rem; color:var(--gris-600); padding:4px 8px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-100);">
                        <span style="font-weight:700; color:var(--azul-dark);">@obs.Key.</span> @obs.Value
                    </div>
                }
                <div style="font-size:0.74rem; color:var(--gris-600); padding:4px 8px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-100);">
                    <span style="font-weight:700; color:var(--azul-dark);">18.</span> Otros (Indicar) — texto obligatorio
                </div>
            </div>
        </div>

        <!-- TABLA DE EXTINTORES POR GRUPO ──────────────────────── -->
        @for (int i = 0; i < gruposConExtintor.Count; i++)
        {
            var ga       = gruposConExtintor[i];
            var vence    = ga.FechaVencimientoExtintor;
            var diasRest = vence.HasValue
                ? vence.Value.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber
                : (int?)null;
            var colVenc  = diasRest.HasValue
                ? (diasRest <= 30 ? "#dc2626" : diasRest <= 90 ? "#d97706" : "var(--verde)")
                : "var(--gris-400)";

            <div class="card">
                <!-- Cabecera del grupo -->
                <div style="display:flex; align-items:center; gap:12px; margin-bottom:14px; padding-bottom:12px; border-bottom:1px solid var(--gris-200); flex-wrap:wrap;">
                    <div style="width:32px; height:32px; border-radius:50%; background:var(--azul-dark); display:grid; place-items:center; flex-shrink:0;">
                        <span style="font-family:var(--font-display); font-weight:800; font-size:0.78rem; color:var(--blanco);">@(i+1)</span>
                    </div>
                    <div style="flex:1;">
                        <div style="font-weight:700; font-size:0.95rem; color:var(--gris-900);">@ga.Grupo?.area</div>
                    </div>
                    <!-- Datos jalados automáticamente -->
                    <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
                        @if (!string.IsNullOrEmpty(ga.TipoExtintor))
                        {
                            <span class="badge" style="background:rgba(220,38,38,0.1); color:#dc2626; font-size:0.72rem;">🧯 @ga.TipoExtintor</span>
                        }
                        @if (!string.IsNullOrEmpty(ga.PesoExtintor))
                        {
                            <span style="font-size:0.78rem; color:var(--gris-600); font-weight:600;">@ga.PesoExtintor</span>
                        }
                        @if (vence.HasValue)
                        {
                            <span style="font-size:0.78rem; color:@colVenc; font-weight:700;">
                                Vence: @vence.Value.ToString("dd/MM/yyyy")
                                @if (diasRest.HasValue && diasRest <= 90) { <span>(@diasRest días)</span> }
                            </span>
                        }
                    </div>
                </div>

                <!-- Comentario del área -->
                <div class="form-group" style="margin-bottom:14px;">
                    <label class="form-label">Comentario del área</label>
                    <input type="text" name="comentario_@i" class="form-control"
                           maxlength="500" placeholder="Ej: Abarca también pasillo norte y almacén secundario..." />
                    <div class="form-hint">Indica si este extintor cubre otras áreas adicionales.</div>
                </div>

                <!-- Observaciones 1-17 + 18 -->
                <div>
                    <div style="font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:10px;">
                        Observaciones — marque las que aplican (dejar sin marcar = OK)
                    </div>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px; margin-bottom:10px;">
                        @foreach (var obs in observaciones)
                        {
                            <label style="display:flex; align-items:flex-start; gap:8px; padding:7px 10px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-100); cursor:pointer; font-size:0.8rem; color:var(--gris-800);">
                                <input type="checkbox" name="obs_@(i)_@(obs.Key)"
                                       style="margin-top:2px; width:15px; height:15px; accent-color:#dc2626; flex-shrink:0;" />
                                <span><strong style="color:var(--azul-dark);">@obs.Key.</strong> @obs.Value</span>
                            </label>
                        }
                    </div>

                    <!-- Ítem 18 -->
                    <div style="background:rgba(239,68,68,0.04); border:1px solid rgba(239,68,68,0.2); border-radius:var(--r-sm); padding:10px 14px;">
                        <label style="display:flex; align-items:center; gap:8px; cursor:pointer; margin-bottom:8px;">
                            <input type="checkbox" name="obs_@(i)_18" id="check18_@i"
                                   style="width:16px; height:16px; accent-color:#dc2626;"
                                   onchange="toggle18(@i)" />
                            <span style="font-size:0.82rem; font-weight:700; color:#dc2626;">18. Otros (Indicar)</span>
                        </label>
                        <div id="div18_@i" style="display:none;">
                            <input type="text" name="obs18text_@i" id="text18_@i"
                                   class="form-control" maxlength="500"
                                   placeholder="Describa el problema encontrado..." />
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- FIRMA ───────────────────────────────────────────────── -->
        <div class="card">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900); margin-bottom:14px; padding-bottom:10px; border-bottom:1px solid var(--gris-200);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--azul);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/></svg>
                Firma del Inspector <span class="req">*</span>
            </div>
            <div style="display:flex; flex-direction:column; gap:10px; align-items:flex-start;">
                <div style="position:relative; border:2px dashed var(--gris-300); border-radius:var(--r-md); overflow:hidden; background:#fff; width:100%; max-width:500px;">
                    <canvas id="firmaCanvas" width="500" height="160"
                            style="display:block; cursor:crosshair; touch-action:none; width:100%; height:auto;"></canvas>
                    <div id="firmaPlaceholder" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;color:var(--gris-300);font-size:0.85rem;">
                        Dibuje su firma aquí
                    </div>
                </div>
                <button type="button" onclick="limpiarFirma()" class="btn btn--secondary btn--sm">
                    <svg viewBox="0 0 24 24"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.5"/></svg>
                    Limpiar firma
                </button>
                <input type="hidden" name="firmaBase64" id="firmaBase64Input" />
            </div>
        </div>

        <!-- BOTONES ─────────────────────────────────────────────── -->
        <div style="display:flex; gap:10px; justify-content:flex-end; padding-bottom:32px;">
            <a asp-controller="Asesorios" asp-action="Details" asp-route-id="@accesorio?.IdAsesorio" class="btn btn--secondary">
                Cancelar
            </a>
            <button type="submit" class="btn btn--celeste" onclick="return prepararEnvio()">
                <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                Guardar Inspección
            </button>
        </div>

    </div>
</form>

@section Styles {
<style>
.det-label { font-size:0.67rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px; }
.det-value { font-size:0.88rem; font-weight:500; color:var(--gris-900); }
</style>
}

@section Scripts {
<script>
// ── Toggle ítem 18 ───────────────────────────────────────────
function toggle18(idx) {
    const cb  = document.getElementById('check18_' + idx);
    const div = document.getElementById('div18_'   + idx);
    const txt = document.getElementById('text18_'  + idx);
    div.style.display = cb.checked ? 'block' : 'none';
    txt.required = cb.checked;
    if (!cb.checked) txt.value = '';
}

// ── Canvas firma ─────────────────────────────────────────────
const canvas      = document.getElementById('firmaCanvas');
const ctx         = canvas.getContext('2d');
const placeholder = document.getElementById('firmaPlaceholder');
let dibujando = false, tieneFirma = false;
ctx.strokeStyle = '#1a3a6b'; ctx.lineWidth = 2.2; ctx.lineCap = 'round'; ctx.lineJoin = 'round';

function getPos(e) {
    const rect = canvas.getBoundingClientRect();
    const scaleX = canvas.width / rect.width, scaleY = canvas.height / rect.height;
    const src = e.touches ? e.touches[0] : e;
    return { x: (src.clientX - rect.left) * scaleX, y: (src.clientY - rect.top) * scaleY };
}
canvas.addEventListener('mousedown',  e => { dibujando = true; ctx.beginPath(); const p = getPos(e); ctx.moveTo(p.x, p.y); });
canvas.addEventListener('mousemove',  e => { if (!dibujando) return; const p = getPos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); marcar(); });
canvas.addEventListener('mouseup',    () => dibujando = false);
canvas.addEventListener('mouseleave', () => dibujando = false);
canvas.addEventListener('touchstart', e => { e.preventDefault(); dibujando = true; ctx.beginPath(); const p = getPos(e); ctx.moveTo(p.x, p.y); }, { passive: false });
canvas.addEventListener('touchmove',  e => { e.preventDefault(); if (!dibujando) return; const p = getPos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); marcar(); }, { passive: false });
canvas.addEventListener('touchend',   () => dibujando = false);

function marcar() { tieneFirma = true; placeholder.style.display = 'none'; }
function limpiarFirma() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    tieneFirma = false; placeholder.style.display = 'flex';
    document.getElementById('firmaBase64Input').value = '';
}
function prepararEnvio() {
    if (!tieneFirma) {
        alert('La firma es obligatoria.');
        canvas.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return false;
    }
    document.getElementById('firmaBase64Input').value = canvas.toDataURL('image/png');
    return true;
}
</script>
}
