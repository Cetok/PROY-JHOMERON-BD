@model List<PROYJHOME2026.Models.InspeccionExtintor>
@{
    ViewData["Title"]      = "Historial Inspección Extintores";
    ViewData["Breadcrumb"] = "Accesorios / Inspección Extintores / Historial";
    var accesorio = ViewBag.Accesorio as PROYJHOME2026.Models.Asesorio;
    var hoy       = DateOnly.FromDateTime(DateTime.Today);
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Accesorios</div>
        <h1 class="page-header__title">Historial Inspección Extintores</h1>
        <p class="page-header__subtitle">@accesorio?.TipoAsesorio</p>
    </div>
    <div class="page-header__actions">
        @{ bool yaHoy = Model.Any(i => i.FechaInspeccion == hoy); }
        @if (!yaHoy)
        {
            <a asp-action="Crear" asp-route-idAsesorio="@accesorio?.IdAsesorio" class="btn btn--celeste">
                <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Nueva Inspección
            </a>
        }
        else
        {
            <span class="badge badge--verde" style="font-size:0.78rem; padding:6px 12px;">✓ Inspección registrada hoy</span>
        }
        <a asp-controller="Asesorios" asp-action="Details" asp-route-id="@accesorio?.IdAsesorio" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver al accesorio
        </a>
    </div>
</div>

<div style="max-width:900px;">
    @if (!Model.Any())
    {
        <div class="card" style="text-align:center; padding:40px 20px; color:var(--gris-400);">
            <svg viewBox="0 0 24 24" style="width:40px;height:40px;stroke:var(--gris-300);fill:none;stroke-width:1.4;margin:0 auto 12px;display:block;"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <div style="font-size:0.9rem;">No hay inspecciones registradas para este extintor.</div>
            <a asp-action="Crear" asp-route-idAsesorio="@accesorio?.IdAsesorio" class="btn btn--celeste" style="margin-top:16px;display:inline-flex;">
                Registrar primera inspección
            </a>
        </div>
    }
    else
    {
        <div class="card" style="padding:0; overflow:hidden;">
            <div style="display:grid; grid-template-columns:110px 1fr 80px 80px 70px; gap:10px; padding:10px 18px; background:var(--gris-100); border-bottom:1px solid var(--gris-200);">
                <div class="th-label">Fecha</div>
                <div class="th-label">Inspeccionado por</div>
                <div class="th-label" style="text-align:center;">Grupos</div>
                <div class="th-label" style="text-align:center;">Con obs.</div>
                <div></div>
            </div>

            @foreach (var ins in Model)
            {
                bool esHoy    = ins.FechaInspeccion == hoy;
                int  conObs   = ins.Filas.Count(f => !string.IsNullOrEmpty(f.ObservacionesMarcadas));
                int  total    = ins.Filas.Count;
                string colObs = conObs == 0 ? "var(--verde)" : conObs < total ? "#d97706" : "#dc2626";

                <div style="display:grid; grid-template-columns:110px 1fr 80px 80px 70px; gap:10px; padding:12px 18px; border-bottom:1px solid var(--gris-100); align-items:center; @(esHoy ? "background:rgba(34,197,94,0.04);" : "")">
                    <div>
                        <div style="font-size:0.84rem; font-weight:600; color:var(--gris-900);">@ins.FechaInspeccion.ToString("dd/MM/yyyy")</div>
                        @if (esHoy) { <span class="badge badge--verde" style="font-size:0.62rem;">Hoy</span> }
                    </div>
                    <div>
                        <div style="font-size:0.84rem; color:var(--gris-900);">@ins.InspeccionadoPor</div>
                        @if (!string.IsNullOrEmpty(ins.NombreUsuario))
                        { <div style="font-size:0.72rem; color:var(--gris-400);">Por: @ins.NombreUsuario</div> }
                    </div>
                    <div style="text-align:center; font-size:1rem; font-weight:800; color:var(--azul); font-family:var(--font-display);">@total</div>
                    <div style="text-align:center;">
                        <span style="font-size:1rem; font-weight:800; color:@colObs; font-family:var(--font-display);">@conObs</span>
                        <div style="font-size:0.68rem; color:var(--gris-400);">grupos</div>
                    </div>
                    <div>
                        <a asp-action="Ver" asp-route-id="@ins.IdInspeccion" class="btn btn--ghost btn--sm" style="font-size:0.78rem;">
                            <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            Ver
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Styles {
<style>.th-label { font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.07em; color:var(--gris-500); }</style>
}
