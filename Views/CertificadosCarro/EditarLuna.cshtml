@model PROYJHOME2026.Models.LunaPolarizada
@{
    ViewData["Title"]      = "Editar Luna Polarizada";
    ViewData["Breadcrumb"] = "Flota Vehicular / Editar Luna Polarizada";
    var carro = ViewBag.Carro as PROYJHOME2026.Models.Carro;
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Flota Vehicular</div>
        <h1 class="page-header__title">Editar Luna Polarizada</h1>
        <p class="page-header__subtitle">@carro?.Placa — @carro?.Marca @carro?.Modelo</p>
    </div>
    <div class="page-header__actions">
        <a asp-controller="Carros" asp-action="Details" asp-route-id="@Model.IdCarro" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver al vehículo
        </a>
    </div>
</div>

<div style="max-width:580px;">
    <div class="card">
        <form asp-action="EditarLuna" asp-route-id="@Model.IdLuna" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="IdLuna"        type="hidden" />
            <input asp-for="IdCarro"       type="hidden" />
            <input asp-for="EsVigente"     type="hidden" />
            <input asp-for="FechaRegistro" type="hidden" />

            <!-- Info del vehículo -->
            <div style="background:var(--gris-50); border:1px solid var(--gris-200); border-radius:var(--r-md); padding:14px 18px; margin-bottom:24px; display:flex; align-items:center; gap:14px;">
                <div style="width:40px; height:40px; border-radius:var(--r-md); background:linear-gradient(135deg,var(--azul-dark),var(--celeste)); display:grid; place-items:center; flex-shrink:0;">
                    <svg viewBox="0 0 24 24" style="width:20px;height:20px;stroke:white;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;"><path d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z"/></svg>
                </div>
                <div>
                    <div style="font-weight:700; font-size:0.9rem; color:var(--azul-dark);">@carro?.Marca @carro?.Modelo</div>
                    <div style="font-family:monospace; font-size:0.82rem; color:var(--azul); font-weight:700;">@carro?.Placa</div>
                </div>
                @if (Model.EsVigente)
                {
                    <span class="badge badge--verde" style="margin-left:auto;">Vigente</span>
                }
                else
                {
                    <span class="badge badge--gris" style="margin-left:auto;">Inactivo</span>
                }
            </div>

            <!-- Datos -->
            <div style="margin-bottom:24px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Datos del certificado
                </p>
                <div class="form-grid">
                    <div class="form-group" style="grid-column:1/-1;">
                        <label class="form-label">Fecha de vigencia <span class="req">*</span></label>
                        <input asp-for="FechaVigencia" type="date" class="form-control" />
                        <span asp-validation-for="FechaVigencia" class="form-error"></span>
                    </div>

                    <div class="form-group" style="grid-column:1/-1;">
                        <label class="form-label">Comentario / Motivo</label>
                        <textarea asp-for="Comentario" class="form-control" rows="3" maxlength="500"
                                  placeholder="Observaciones opcionales..."></textarea>
                        <span asp-validation-for="Comentario" class="form-error"></span>
                    </div>
                </div>
            </div>

            <div style="display:flex; gap:10px; padding-top:4px; border-top:1px solid var(--gris-200);">
                <button type="submit" class="btn btn--primary btn--lg">
                    <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v14a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    Guardar cambios
                </button>
                <a asp-controller="Carros" asp-action="Details" asp-route-id="@Model.IdCarro" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
