@model PROYJHOME2026.Models.HabilitacionVehicular
@{
    ViewData["Title"]      = "Editar Habilitación Vehicular";
    ViewData["Breadcrumb"] = "Flota Vehicular / Editar Habilitación";
    var carro = ViewBag.Carro as PROYJHOME2026.Models.Carro;
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Flota Vehicular</div>
        <h1 class="page-header__title">Editar Habilitación Vehicular</h1>
        <p class="page-header__subtitle">@carro?.Placa — @carro?.Marca @carro?.Modelo</p>
    </div>
    <div class="page-header__actions">
        <a asp-controller="Carros" asp-action="Details" asp-route-id="@Model.IdCarro" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver al vehículo
        </a>
    </div>
</div>

<div style="max-width:640px;">
    <div class="card">
        <form asp-action="EditarHabilitacion" asp-route-id="@Model.IdHabilitacion" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="IdHabilitacion" type="hidden" />
            <input asp-for="IdCarro"        type="hidden" />
            <input asp-for="EsVigente"      type="hidden" />
            <input asp-for="FechaRegistro"  type="hidden" />

            <!-- Info del vehículo -->
            <div style="background:var(--gris-50); border:1px solid var(--gris-200); border-radius:var(--r-md); padding:14px 18px; margin-bottom:24px; display:flex; align-items:center; gap:14px;">
                <div style="width:40px; height:40px; border-radius:var(--r-md); background:linear-gradient(135deg,var(--azul-dark),var(--azul-mid)); display:grid; place-items:center; flex-shrink:0;">
                    <svg viewBox="0 0 24 24" style="width:20px;height:20px;stroke:white;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                </div>
                <div>
                    <div style="font-weight:700; font-size:0.9rem; color:var(--azul-dark);">@carro?.Marca @carro?.Modelo</div>
                    <div style="font-family:monospace; font-size:0.82rem; color:var(--azul); font-weight:700;">@carro?.Placa</div>
                </div>
                @if (Model.EsVigente)
                {
                    <span class="badge badge--verde" style="margin-left:auto;">Vigente</span>
                }
                else
                {
                    <span class="badge badge--gris" style="margin-left:auto;">Inactivo</span>
                }
            </div>

            <!-- Datos del certificado -->
            <div style="margin-bottom:24px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Datos del certificado
                </p>
                <div class="form-grid">
                    <div class="form-group" style="grid-column:1/-1;">
                        <label class="form-label">Revisión Técnica vinculada <span class="req">*</span></label>
                        <select asp-for="IdModalidad" asp-items="ViewBag.Modalidades" class="form-control">
                            <option value="">— Seleccionar revisión técnica —</option>
                        </select>
                        <span asp-validation-for="IdModalidad" class="form-error"></span>
                    </div>

                    <div class="form-group" style="grid-column:1/-1;">
                        <label class="form-label">Código del certificado <span class="req">*</span></label>
                        <input asp-for="Codigo" class="form-control" maxlength="100"
                               style="text-transform:uppercase; font-family:monospace;" />
                        <span asp-validation-for="Codigo" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Fecha de vigencia <span class="req">*</span></label>
                        <input asp-for="FechaVigencia" type="date" class="form-control" />
                        <span asp-validation-for="FechaVigencia" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Fecha de culminación <span class="req">*</span></label>
                        <input asp-for="FechaCulminacion" type="date" class="form-control" />
                        <span asp-validation-for="FechaCulminacion" class="form-error"></span>
                    </div>
                </div>
            </div>

            <div style="display:flex; gap:10px; padding-top:4px; border-top:1px solid var(--gris-200);">
                <button type="submit" class="btn btn--primary btn--lg">
                    <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v14a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    Guardar cambios
                </button>
                <a asp-controller="Carros" asp-action="Details" asp-route-id="@Model.IdCarro" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('@Html.IdFor(m => m.Codigo)').addEventListener('input', function () {
            const pos = this.selectionStart;
            this.value = this.value.toUpperCase();
            this.setSelectionRange(pos, pos);
        });

        document.querySelector('form').addEventListener('submit', function (e) {
            const vigencia    = document.getElementById('@Html.IdFor(m => m.FechaVigencia)').value;
            const culminacion = document.getElementById('@Html.IdFor(m => m.FechaCulminacion)').value;
            if (vigencia && culminacion && culminacion <= vigencia) {
                alert('La fecha de culminación debe ser posterior a la fecha de vigencia.');
                e.preventDefault();
            }
        });
    </script>
}
