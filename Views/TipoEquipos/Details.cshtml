@model PROYJHOME2026.Models.TipoEquipo
@{
    ViewData["Title"]      = "Detalle Tipo Equipo";
    ViewData["Breadcrumb"] = "Tipos de Equipo / Detalle";
    int totalEquipos = ViewBag.TotalEquipos ?? 0;
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Configuración</div>
        <h1 class="page-header__title">@(Model.tipo ?? "Sin nombre")</h1>
        <p class="page-header__subtitle">ID: #@Model.idTipoEquipo</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.idTipoEquipo" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Editar
        </a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:480px; display:flex; flex-direction:column; gap:16px;">

    <div class="card">
        <div style="display:flex; align-items:center; gap:14px; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid var(--gris-200);">
            <div class="tipo-icon-lg">
                <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <div>
                <div style="font-family:var(--font-display); font-size:1.15rem; font-weight:700; color:var(--azul-dark);">
                    @(Model.tipo ?? "Sin nombre")
                </div>
                <div style="margin-top:6px;">
                    <span class="badge badge--celeste">@totalEquipos equipo(s) asociado(s)</span>
                </div>
            </div>
        </div>

        <div style="display:grid; gap:14px;">
            <div>
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px;">ID</div>
                <div style="font-size:0.9rem; font-weight:500; color:var(--gris-900);">#@Model.idTipoEquipo</div>
            </div>
            <div>
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px;">Tipo</div>
                <div style="font-size:0.9rem; font-weight:500; color:var(--gris-900);">@(Model.tipo ?? "—")</div>
            </div>
            <div>
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px;">Equipos registrados</div>
                <div style="font-size:0.9rem; font-weight:500; color:var(--gris-900);">
                    @totalEquipos equipo(s) usan este tipo —
                    <a asp-controller="Equipos" asp-action="Index" asp-route-tipoId="@Model.idTipoEquipo"
                       style="color:var(--celeste); font-size:0.82rem;">Ver equipos →</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Zona peligro -->
    <div class="card" style="border-color:var(--rojo-border); background:var(--rojo-light);">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
            <div>
                <div style="font-weight:700; color:var(--rojo); font-size:0.88rem;">Zona de peligro</div>
                <div style="font-size:0.76rem; color:var(--gris-600); margin-top:2px;">
                    @if (totalEquipos > 0)
                    { <span>No se puede eliminar — tiene @totalEquipos equipo(s) asociado(s).</span> }
                    else
                    { <span>Sin equipos asociados, se puede eliminar.</span> }
                </div>
            </div>
            @if (totalEquipos == 0)
            {
                <a asp-action="Delete" asp-route-id="@Model.idTipoEquipo" class="btn btn--danger btn--sm">
                    <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6M9 6V4h6v2"/></svg>
                    Eliminar
                </a>
            }
            else
            {
                <button class="btn btn--danger btn--sm" disabled title="Tiene equipos asociados" style="opacity:0.4; cursor:not-allowed;">
                    <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                    Eliminar
                </button>
            }
        </div>
    </div>

</div>

@section Styles {
<style>
.tipo-icon-lg {
    width: 48px; height: 48px; border-radius: var(--r-md);
    background: rgba(26,58,107,0.08); border: 1px solid rgba(26,58,107,0.12);
    display: grid; place-items: center; flex-shrink: 0;
}
.tipo-icon-lg svg {
    width: 22px; height: 22px; stroke: var(--azul);
    fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
}
</style>
}
