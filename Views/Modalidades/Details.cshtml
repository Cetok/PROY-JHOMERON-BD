@model PROYJHOME2026.Models.Modalidad
@{
    ViewData["Title"]      = "Detalle Modalidad";
    ViewData["Breadcrumb"] = "Modalidades / Detalle";
    var bc = Model.Estado == "Activo" ? "badge--verde" : "badge--gris";
}
<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Modalidades</div>
        <h1 class="page-header__title">@Model.TipoModalidad</h1>
        <p class="page-header__subtitle">@Model.CarroModalidades.Count vehículo(s) con esta modalidad</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.IdModalidad" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Editar
        </a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:860px; display:flex; gap:16px; align-items:flex-start;">
    <div class="card" style="flex:1;">
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid var(--gris-200);">
            <div class="det-field"><div class="det-label">Tipo</div><div class="det-value">@Model.TipoModalidad</div></div>
            <div class="det-field"><div class="det-label">Fecha vigente</div><div class="det-value">@(Model.FechaVigente.HasValue ? Model.FechaVigente.Value.ToString("dd/MM/yyyy") : "—")</div></div>
            <div class="det-field"><div class="det-label">Estado</div><div class="det-value"><span class="badge @bc">@Model.Estado</span></div></div>
        </div>

        <div style="font-weight:700; font-size:0.85rem; margin-bottom:12px; color:var(--gris-900);">Vehículos asignados</div>
        @if (Model.CarroModalidades.Any())
        {
            <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:8px;">
                @foreach (var cm in Model.CarroModalidades)
                {
                    <div style="padding:10px 14px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200); display:flex; justify-content:space-between; align-items:center;">
                        <div>
                            <div style="font-weight:600; font-size:0.85rem; font-family:monospace; color:var(--azul);">@cm.Carro?.Placa</div>
                            <div style="font-size:0.75rem; color:var(--gris-500);">@cm.Carro?.Marca @cm.Carro?.Modelo</div>
                        </div>
                        <a asp-controller="Carros" asp-action="Details" asp-route-id="@cm.IdCarro"
                           class="btn btn--ghost btn--icon btn--sm">
                            <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </a>
                    </div>
                }
            </div>
        }
        else { <div style="text-align:center; padding:16px 0; color:var(--gris-400); font-size:0.82rem;">Ningún vehículo tiene esta modalidad asignada.</div> }
    </div>

    <div style="width:220px; flex-shrink:0;">
        <div class="card" style="border-color:var(--rojo-border); background:var(--rojo-light);">
            <div style="font-weight:700; color:var(--rojo); font-size:0.88rem; margin-bottom:6px;">Zona de peligro</div>
            <div style="font-size:0.76rem; color:var(--gris-600); margin-bottom:14px;">Solo si no tiene vehículos asociados.</div>
            <a asp-action="Delete" asp-route-id="@Model.IdModalidad" class="btn btn--danger btn--sm" style="width:100%; justify-content:center;">
                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                Eliminar
            </a>
        </div>
    </div>
</div>
@section Styles {
<style>
.det-label { font-size:0.67rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px; }
.det-value { font-size:0.88rem; font-weight:500; color:var(--gris-900); }
</style>
}
