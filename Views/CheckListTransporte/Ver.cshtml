@model PROYJHOME2026.Models.CheckListTransporte
@{
    ViewData["Title"]      = "Detalle Check List";
    ViewData["Breadcrumb"] = "Flota Vehicular / Check List / Detalle";

    int totalItems       = Model.Items.Count(i => i.Cumple.HasValue);
    int totalSi          = Model.Items.Count(i => i.Cumple == true);
    int totalNo          = Model.Items.Count(i => i.Cumple == false);
    int pct              = totalItems > 0 ? (int)Math.Round((double)totalSi / totalItems * 100) : 0;
    string colorPct      = pct >= 80 ? "var(--verde)" : pct >= 50 ? "#d97706" : "#dc2626";

    var secciones = Model.Items
        .GroupBy(i => new { i.Seccion, i.NombreSeccion })
        .OrderBy(g => g.Key.Seccion)
        .ToList();
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Flota Vehicular / Check List</div>
        <h1 class="page-header__title">Detalle de Inspección</h1>
        <p class="page-header__subtitle">
            @Model.Carro?.Placa — @Model.Carro?.Marca @Model.Carro?.Modelo ·
            @Model.FechaInspeccion.ToString("dd/MM/yyyy") @Model.HoraInspeccion.ToString("HH:mm")
        </p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Historial" asp-route-idCarro="@Model.IdCarro" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver al historial
        </a>
    </div>
</div>

<div style="max-width:860px; display:flex; flex-direction:column; gap:16px;">

    <!-- ENCABEZADO ──────────────────────────────────────────── -->
    <div class="card">
        <div style="text-align:center; padding-bottom:14px; border-bottom:1px solid var(--gris-200); margin-bottom:18px;">
            <div style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; color:var(--gris-400);">Check List de Inspecciones de Seguridad y Salud en el Trabajo</div>
            <div style="font-family:var(--font-display); font-size:1.1rem; font-weight:800; color:var(--azul-dark); margin-top:4px;">ÁREA DE TRANSPORTE</div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; margin-bottom:16px;">
            <div>
                <div class="det-label">Fecha de inspección</div>
                <div class="det-value" style="font-weight:700; color:var(--azul);">@Model.FechaInspeccion.ToString("dd/MM/yyyy")</div>
            </div>
            <div>
                <div class="det-label">Hora</div>
                <div class="det-value" style="font-weight:700; color:var(--azul);">@Model.HoraInspeccion.ToString("HH:mm")</div>
            </div>
            <div>
                <div class="det-label">Sede o Área</div>
                <div class="det-value">@Model.SedeArea</div>
            </div>
            <div>
                <div class="det-label">Placa</div>
                <div class="det-value" style="font-family:monospace; font-weight:700; color:var(--azul); font-size:1rem;">@Model.Carro?.Placa</div>
            </div>
            <div>
                <div class="det-label">Responsable</div>
                <div class="det-value">@Model.NombreResponsable</div>
            </div>
            <div>
                <div class="det-label">Registrado por</div>
                <div class="det-value">@(Model.NombreUsuario ?? "—")</div>
            </div>
        </div>

        <!-- Resumen de cumplimiento -->
        <div style="display:flex; gap:12px; padding:14px 16px; background:var(--gris-50); border-radius:var(--r-md); border:1px solid var(--gris-200); flex-wrap:wrap;">
            <div style="text-align:center; min-width:80px;">
                <div style="font-size:2rem; font-weight:800; color:@colorPct; font-family:var(--font-display); line-height:1;">@pct%</div>
                <div style="font-size:0.7rem; color:var(--gris-400); text-transform:uppercase; letter-spacing:0.06em;">Cumplimiento</div>
            </div>
            <div style="width:1px; background:var(--gris-200); flex-shrink:0;"></div>
            <div style="display:flex; gap:20px; align-items:center; flex-wrap:wrap;">
                <div style="text-align:center;">
                    <div style="font-size:1.4rem; font-weight:800; color:var(--verde); font-family:var(--font-display);">@totalSi</div>
                    <div style="font-size:0.72rem; color:var(--gris-400);">SI</div>
                </div>
                <div style="text-align:center;">
                    <div style="font-size:1.4rem; font-weight:800; color:#dc2626; font-family:var(--font-display);">@totalNo</div>
                    <div style="font-size:0.72rem; color:var(--gris-400);">NO</div>
                </div>
                <div style="text-align:center;">
                    <div style="font-size:1.4rem; font-weight:800; color:var(--gris-400); font-family:var(--font-display);">@(Model.Items.Count - totalItems)</div>
                    <div style="font-size:0.72rem; color:var(--gris-400);">Sin resp.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ÍTEMS POR SECCIÓN ──────────────────────────────────── -->
    @foreach (var sec in secciones)
    {
        <div class="card">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:14px; padding-bottom:10px; border-bottom:1px solid var(--gris-200);">
                <div style="width:28px; height:28px; border-radius:50%; background:var(--azul-dark); display:grid; place-items:center; flex-shrink:0;">
                    <span style="font-family:var(--font-display); font-weight:800; font-size:0.8rem; color:var(--blanco);">@sec.Key.Seccion</span>
                </div>
                <div style="font-weight:700; font-size:0.92rem; color:var(--gris-900); text-transform:uppercase; letter-spacing:0.04em;">@sec.Key.NombreSeccion</div>
            </div>

            <!-- Cabecera -->
            <div style="display:grid; grid-template-columns:1fr 60px 1fr; gap:8px; padding:6px 10px; background:var(--gris-100); border-radius:var(--r-sm); margin-bottom:8px;">
                <div style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.07em; color:var(--gris-500);">Elemento</div>
                <div style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.07em; color:var(--gris-500); text-align:center;">Cumple</div>
                <div style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.07em; color:var(--gris-500);">Observación</div>
            </div>

            @foreach (var item in sec.OrderBy(i => i.IdItem))
            {
                string? badgeClass = item.Cumple == true  ? "badge--verde" :
                                     item.Cumple == false ? "badge--rojo"  : "badge--gris";
                string  badgeText  = item.Cumple == true  ? "SI" :
                                     item.Cumple == false ? "NO" : "—";

                <div style="display:grid; grid-template-columns:1fr 60px 1fr; gap:8px; align-items:center; padding:8px 10px; border-radius:var(--r-sm); border:1px solid var(--gris-100); margin-bottom:4px; @(item.Cumple == false ? "background:rgba(220,38,38,0.03);" : "")">
                    <div style="font-size:0.84rem; color:var(--gris-900);">@item.Elemento</div>
                    <div style="text-align:center;">
                        <span class="badge @badgeClass" style="font-size:0.72rem;">@badgeText</span>
                    </div>
                    <div style="font-size:0.8rem; color:var(--gris-600);">
                        @(string.IsNullOrEmpty(item.Observacion) ? "—" : item.Observacion)
                    </div>
                </div>
            }
        </div>
    }

    <!-- OBSERVACIONES GENERALES ────────────────────────────── -->
    @if (!string.IsNullOrEmpty(Model.ObservacionesGenerales))
    {
        <div class="card">
            <div class="det-label" style="margin-bottom:8px;">Observaciones generales</div>
            <div style="font-size:0.88rem; color:var(--gris-800); line-height:1.6;">@Model.ObservacionesGenerales</div>
        </div>
    }

    <!-- FIRMA ──────────────────────────────────────────────── -->
    <div class="card">
        <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900); margin-bottom:14px; padding-bottom:10px; border-bottom:1px solid var(--gris-200);">
            <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--azul);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/></svg>
            Firma del Responsable
        </div>
        <div>
            <div class="det-label" style="margin-bottom:6px;">@Model.NombreResponsable</div>
            <div style="border:1px solid var(--gris-200); border-radius:var(--r-md); overflow:hidden; display:inline-block; background:var(--blanco);">
                <img src="@Model.FirmaBase64" alt="Firma" style="display:block; max-width:500px; height:160px; object-fit:contain;" />
            </div>
        </div>
    </div>

</div>

@section Styles {
<style>
.det-label { font-size:0.67rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px; }
.det-value { font-size:0.88rem; font-weight:500; color:var(--gris-900); }
.badge--rojo { background: rgba(220,38,38,0.1); color: #dc2626; }
</style>
}
