@model PROYJHOME2026.Models.CuentaBancaria
@{
    ViewData["Title"]      = "Editar cuenta bancaria";
    ViewData["Breadcrumb"] = "Editar cuenta";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Empleados</div>
        <h1 class="page-header__title">Editar cuenta bancaria</h1>
        <p class="page-header__subtitle">@Model.Empleado?.nombre @Model.Empleado?.paterno</p>
    </div>
    <div class="page-header__actions">
        <a asp-controller="Empleados" asp-action="Details" asp-route-id="@Model.IdEmpleado"
           class="btn btn--secondary btn--sm">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:560px;">
    <div class="card">
        <form asp-action="Editar" asp-route-id="@Model.IdCuenta" method="post">
            @Html.AntiForgeryToken()

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">

                <div class="form-group">
                    <label class="form-label">Banco <span class="req">*</span></label>
                    <select name="tipoBanco" class="form-control" required>
                        @foreach (var b in new[]{"BCP","Interbank","BBVA","Scotiabank","BanBif","Pichincha","Nación","Mibanco","Otro"})
                        {
                            <option value="@b" selected="@(Model.TipoBanco == b ? "selected" : null)">@b</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Tipo de cuenta</label>
                    <select name="tipoCuenta" class="form-control">
                        <option value="">— Selecciona —</option>
                        @foreach (var t in new[]{"Ahorro","Corriente","CTS","Sueldo"})
                        {
                            <option value="@t" selected="@(Model.TipoCuenta == t ? "selected" : null)">@t</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Número de cuenta <span class="req">*</span></label>
                    <input type="text" name="numeroCuenta" class="form-control"
                           value="@Model.NumeroCuenta" required />
                </div>

                <div class="form-group">
                    <label class="form-label">CCI (opcional)</label>
                    <input type="text" name="numeroCCI" class="form-control"
                           value="@(Model.NumeroCCI ?? "")" placeholder="20 dígitos" />
                </div>

            </div>

            <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:8px;">
                <a asp-controller="Empleados" asp-action="Details" asp-route-id="@Model.IdEmpleado"
                   class="btn btn--secondary btn--sm">Cancelar</a>
                <button type="submit" class="btn btn--primary btn--sm">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>
