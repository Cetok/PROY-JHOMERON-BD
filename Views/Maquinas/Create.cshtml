@model PROYJHOME2026.Models.Maquina
@{
    ViewData["Title"]      = "Nueva Máquina";
    ViewData["Breadcrumb"] = "Producción / Máquinas / Nueva";
    string proximoCorrelativo = ViewBag.ProximoCorrelativo ?? "";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Producción</div>
        <h1 class="page-header__title">Nueva Máquina</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:760px;">
    <div class="card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div style="margin-bottom:24px;">
                <p class="form-section-title">Datos de la máquina</p>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">N° de Máquina (base) <span class="req">*</span></label>
                        <input asp-for="NumeroMaquina" id="inp-numero" class="form-control"
                               placeholder="Ej: E01, BN, MAQ..." autocomplete="off" />
                        <span asp-validation-for="NumeroMaquina" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <!-- Correlativo calculado automáticamente -->
                        <label class="form-label">Correlativo asignado</label>
                        <div id="correlativo-preview" style="display:flex; align-items:center; gap:10px; margin-top:4px;">
                            <span id="correlativo-badge" style="font-family:monospace; font-size:1.1rem; font-weight:800;
                                  color:var(--azul); background:rgba(37,99,235,0.08); border:1px solid rgba(37,99,235,0.2);
                                  border-radius:var(--r-sm); padding:6px 14px;">
                                @(string.IsNullOrEmpty(proximoCorrelativo) ? "—" : $"{ViewBag.NumeroBase}-{proximoCorrelativo}")
                            </span>
                            <span id="correlativo-hint" style="font-size:0.75rem; color:var(--gris-400);">
                                @(string.IsNullOrEmpty(proximoCorrelativo) ? "Escribe el N° base" : $"Correlativo: {proximoCorrelativo}")
                            </span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Nombre de Máquina <span class="req">*</span></label>
                        <input asp-for="NombreMaquina" class="form-control" placeholder="Ej: Torno CNC Principal" />
                        <span asp-validation-for="NombreMaquina" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Estado inicial</label>
                        <select asp-for="Estado" class="form-control">
                            <option value="Registrado">Registrado</option>
                            <option value="Activo">Activo</option>
                            <option value="Mantenimiento">Mantenimiento</option>
                            <option value="Inoperativo">Inoperativo</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Marca</label>
                        <input asp-for="Marca" class="form-control" placeholder="Ej: Siemens, Fanuc" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Fecha de compra</label>
                        <input asp-for="FechaCompra" type="date" class="form-control" />
                    </div>
                </div>
            </div>

            <div style="margin-bottom:24px;">
                <p class="form-section-title">Accesorios / Partes</p>
                <div class="form-group">
                    <textarea asp-for="AccesoriosParte" class="form-control" rows="5" maxlength="2000"
                              placeholder="Lista cada pieza o accesorio de la máquina...&#10;Ej: Motor principal 5HP, Bomba hidráulica..."></textarea>
                    <span style="font-size:0.75rem; color:var(--gris-400); margin-top:3px; display:block;">Máximo 2000 caracteres</span>
                </div>
            </div>

            <div style="margin-bottom:24px;">
                <p class="form-section-title">Observaciones</p>
                <div class="form-group">
                    <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="1000"
                              placeholder="Estado inicial, condiciones, notas relevantes..."></textarea>
                </div>
            </div>

            <div style="display:flex; gap:10px; padding-top:4px; border-top:1px solid var(--gris-200);">
                <button type="submit" class="btn btn--celeste btn--lg">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    Registrar máquina
                </button>
                <a asp-action="Index" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Styles {
<style>
.form-section-title {
    font-family:var(--font-display); font-size:0.72rem; font-weight:700;
    letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste);
    margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);
}
</style>
}
@section Scripts {
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
<script>
(function(){
    var inp    = document.getElementById('inp-numero');
    var badge  = document.getElementById('correlativo-badge');
    var hint   = document.getElementById('correlativo-hint');
    var timer  = null;

    inp.addEventListener('input', function(){
        clearTimeout(timer);
        var val = inp.value.trim();
        if (!val) {
            badge.textContent = '—';
            hint.textContent  = 'Escribe el N° base';
            return;
        }
        badge.textContent = '...';
        hint.textContent  = 'Calculando...';
        timer = setTimeout(function(){
            fetch('/Maquinas/ProximoCorrelativo?numero=' + encodeURIComponent(val))
                .then(function(r){ return r.json(); })
                .then(function(d){
                    if (d.esPrimera) {
                        badge.textContent = val;
                        hint.textContent  = 'Primera de su serie — sin correlativo por ahora';
                    } else {
                        badge.textContent = d.completo;
                        hint.textContent  = 'Correlativo asignado: ' + d.correlativo;
                    }
                })
                .catch(function(){ badge.textContent = '—'; });
        }, 400);
    });
})();
</script>
}
