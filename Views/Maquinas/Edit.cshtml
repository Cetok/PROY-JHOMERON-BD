@model PROYJHOME2026.Models.Maquina
@{
    ViewData["Title"]      = "Editar Máquina";
    ViewData["Breadcrumb"] = "Producción / Máquinas / Editar";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Producción</div>
        <h1 class="page-header__title">Editar Máquina</h1>
        <p class="page-header__subtitle">@Model.NumeroMaquina — @Model.NombreMaquina</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Details" asp-route-id="@Model.IdMaquina" class="btn btn--ghost btn--sm">Ver detalle</a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:760px;">
    <div class="card">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="IdMaquina" type="hidden" />
            <input asp-for="FechaRegistro" type="hidden" />
            <input asp-for="IdUsuarioCreador" type="hidden" />

            <div style="margin-bottom:24px;">
                <p class="form-section-title">Datos de la máquina</p>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">N° de Máquina <span class="req">*</span></label>
                        <input asp-for="NumeroMaquina" class="form-control" />
                        <span asp-validation-for="NumeroMaquina" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Nombre de Máquina <span class="req">*</span></label>
                        <input asp-for="NombreMaquina" class="form-control" />
                        <span asp-validation-for="NombreMaquina" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Marca</label>
                        <input asp-for="Marca" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Fecha de compra</label>
                        <input asp-for="FechaCompra" type="date" class="form-control" />
                    </div>
                </div>
            </div>

            <div style="margin-bottom:24px;">
                <p class="form-section-title">Accesorios / Partes</p>
                <div class="form-group">
                    <textarea asp-for="AccesoriosParte" class="form-control" rows="5" maxlength="2000"></textarea>
                </div>
            </div>

            <div style="margin-bottom:24px;">
                <p class="form-section-title">Observaciones</p>
                <div class="form-group">
                    <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="1000"></textarea>
                </div>
            </div>

            <div style="display:flex; gap:10px; padding-top:4px; border-top:1px solid var(--gris-200);">
                <button type="submit" class="btn btn--primary btn--lg">
                    <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v14a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/></svg>
                    Guardar cambios
                </button>
                <a asp-action="Details" asp-route-id="@Model.IdMaquina" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Styles {
<style>
.form-section-title {
    font-family:var(--font-display); font-size:0.72rem; font-weight:700;
    letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste);
    margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);
}
</style>
}
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
