@model PROYJHOME2026.Models.Maquina
@{
    ViewData["Title"]      = "Detalle Máquina";
    ViewData["Breadcrumb"] = "Producción / Máquinas / Detalle";
    var bc = Model.Estado switch {
        "Registrado"    => "badge--gris",
        "Activo"        => "badge--verde",
        "Mantenimiento" => "badge--amarillo",
        "Inoperativo"   => "badge--rojo",
        "Dado de Baja"  => "badge--rojo",
        _               => "badge--gris"
    };
    bool esBaja = Model.Estado == "Dado de Baja";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Producción</div>
        <div style="margin-bottom:4px;">
            <span class="badge @bc">@Model.Estado</span>
        </div>
        <h1 class="page-header__title" style="color:var(--azul);">@Model.NombreMaquina</h1>
        <p class="page-header__subtitle" style="font-family:monospace; font-weight:800; font-size:1rem;">@Model.NumeroCompleto</p>
    </div>
    <div class="page-header__actions">
        @if (!esBaja)
        {
            <a asp-action="Edit" asp-route-id="@Model.IdMaquina" class="btn btn--celeste">
                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Editar
            </a>
        }
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:1000px; display:flex; flex-direction:column; gap:16px;">

    <!-- DATOS GENERALES -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
        <div class="card">
            <p class="det-section-title">Datos de la máquina</p>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                <div class="det-field"><div class="det-label">N° Máquina</div><div class="det-value" style="font-family:monospace; font-weight:700; color:var(--azul-dark);">@Model.NumeroCompleto</div></div>
                <div class="det-field"><div class="det-label">Nombre</div><div class="det-value">@Model.NombreMaquina</div></div>
                <div class="det-field"><div class="det-label">Marca</div><div class="det-value">@(Model.Marca ?? "—")</div></div>
                <div class="det-field"><div class="det-label">Estado</div><div class="det-value"><span class="badge @bc">@Model.Estado</span></div></div>
                <div class="det-field"><div class="det-label">F. Compra</div><div class="det-value">@(Model.FechaCompra.HasValue ? Model.FechaCompra.Value.ToString("dd/MM/yyyy") : "—")</div></div>
                @if (!string.IsNullOrEmpty(Model.Observaciones))
                {
                    <div class="det-field" style="grid-column:1/-1;">
                        <div class="det-label">Observaciones</div>
                        <div class="det-value" style="background:var(--gris-50); padding:8px 12px; border-radius:var(--r-sm); border:1px solid var(--gris-200);">@Model.Observaciones</div>
                    </div>
                }
            </div>
        </div>

        <!-- ASIGNACIÓN ACTUAL -->
        <div class="card">
            <p class="det-section-title">Asignación actual</p>
            @if (Model.AsignacionActual != null)
            {
                var bcOp = Model.AsignacionActual.EstadoOperativo switch {
                    "Operativo"           => "badge--verde",
                    "Mantenimiento"       => "badge--amarillo",
                    "Almacenado en stock" => "badge--amarillo",
                    _                     => "badge--rojo"
                };
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                    <div class="det-field"><div class="det-label">Grupo / Área</div><div class="det-value" style="font-weight:700; color:var(--azul-dark);">@(Model.AsignacionActual.Grupo?.area ?? "—")</div></div>
                    <div class="det-field"><div class="det-label">Estado operativo</div><div class="det-value"><span class="badge @bcOp">@Model.AsignacionActual.EstadoOperativo</span></div></div>
                    @if (!string.IsNullOrEmpty(Model.AsignacionActual.AreaEspecifica))
                    {
                        <div class="det-field" style="grid-column:1/-1;"><div class="det-label">Área específica</div><div class="det-value" style="color:var(--gris-800);">@Model.AsignacionActual.AreaEspecifica</div></div>
                    }
                    <div class="det-field" style="grid-column:1/-1;">
                        <div class="det-label">Encargados</div>
                        <div class="det-value" style="color:var(--azul);">
                            @if (Model.AsignacionActual.Encargados.Any())
                            {
                                <ul style="margin:0;padding:0;list-style:none;">
                                    @foreach (var enc in Model.AsignacionActual.Encargados)
                                    {
                                        <li>@(enc.Empleado?.nombre + " " + enc.Empleado?.paterno)</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span style="color:var(--gris-400);">—</span>
                            }
                        </div>
                    </div>
                    <div class="det-field"><div class="det-label">Fecha asignación</div><div class="det-value">@(Model.AsignacionActual.FechaAsignacion.HasValue ? Model.AsignacionActual.FechaAsignacion.Value.ToString("dd/MM/yyyy") : "—")</div></div>
                    @if (!string.IsNullOrEmpty(Model.AsignacionActual.Observaciones))
                    {
                        <div class="det-field" style="grid-column:1/-1;"><div class="det-label">Observaciones</div><div class="det-value">@Model.AsignacionActual.Observaciones</div></div>
                    }
                </div>
                <div style="display:flex; gap:8px; margin-top:14px; padding-top:12px; border-top:1px solid var(--gris-200);">
                    <a asp-controller="MaquinaAsignaciones" asp-action="Edit" asp-route-id="@Model.AsignacionActual.IdAsignacion"
                       class="btn btn--secondary btn--sm">
                        <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        Editar asignación
                    </a>
                    <a asp-controller="MaquinaAsignaciones" asp-action="Create" asp-route-idMaquina="@Model.IdMaquina"
                       class="btn btn--celeste btn--sm">
                        Reasignar
                    </a>
                </div>
            }
            else
            {
                <div style="text-align:center; padding:20px; color:var(--gris-400); font-size:0.82rem;">
                    Sin asignación activa
                </div>
                <a asp-controller="MaquinaAsignaciones" asp-action="Create" asp-route-idMaquina="@Model.IdMaquina"
                   class="btn btn--celeste btn--sm" style="margin-top:8px;">
                    + Asignar a grupo
                </a>
            }
        </div>
    </div>

    <!-- ACCESORIOS/PARTES -->
    @if (!string.IsNullOrEmpty(Model.AccesoriosParte))
    {
        <div class="card">
            <p class="det-section-title">Accesorios / Partes</p>
            <div style="background:var(--gris-50); padding:14px 16px; border-radius:var(--r-sm); border:1px solid var(--gris-200); white-space:pre-wrap; font-size:0.87rem; color:var(--gris-800); line-height:1.6;">@Model.AccesoriosParte</div>
        </div>
    }

    <!-- CAMBIAR ESTADO -->
    @if (esBaja)
    {
        <div class="card" style="border:2px solid #dc2626; max-width:600px;">
            <p class="det-section-title" style="color:#dc2626;">⛔ Dado de Baja</p>
            <p style="font-size:0.82rem; color:var(--gris-600); margin-bottom:10px;">
                Esta máquina fue dada de baja de forma definitiva y no puede ser reactivada.
            </p>
            @if (Model.FechaBaja.HasValue || !string.IsNullOrEmpty(Model.MotivoBaja))
            {
                <div style="background:var(--gris-50); border:1px solid var(--gris-200); border-radius:var(--r-sm); padding:10px 14px; font-size:0.82rem;">
                    @if (Model.FechaBaja.HasValue)
                    {
                        <div><strong>Fecha de baja:</strong> @Model.FechaBaja.Value.ToString("dd/MM/yyyy")</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.MotivoBaja))
                    {
                        <div style="margin-top:4px;"><strong>Motivo:</strong> @Model.MotivoBaja</div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">

        @* ── Cambiar estado (selector rápido) ── *@
        <div class="card" style="border:2px solid var(--celeste);">
            <p class="det-section-title" style="color:var(--celeste);">🔄 Cambiar Estado</p>
            <form asp-action="CambiarEstado" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idMaquina" value="@Model.IdMaquina" />
                <div class="form-group" style="margin-bottom:10px;">
                    <label class="form-label">Nuevo estado</label>
                    <select name="nuevoEstado" class="form-control">
                        @if (Model.Estado != "Registrado")  { <option value="Registrado">Registrado</option> }
                        @if (Model.Estado != "Activo")       { <option value="Activo">Activo</option> }
                        @if (Model.Estado != "Mantenimiento"){ <option value="Mantenimiento">Mantenimiento</option> }
                        @if (Model.Estado != "Inoperativo")  { <option value="Inoperativo">Inoperativo</option> }
                    </select>
                </div>
                <div class="form-group" style="margin-bottom:10px;">
                    <label class="form-label">Observaciones</label>
                    <input type="text" name="observaciones" class="form-control" maxlength="500"
                           placeholder="Motivo del cambio de estado..." />
                </div>
                <button type="submit" class="btn btn--sm btn--primary"
                        onclick="return confirm('¿Confirmar cambio de estado?')">
                    ✓ Aplicar cambio
                </button>
            </form>
        </div>

        @* ── Dar de Baja ── *@
        <div class="card" style="border:2px solid #7f1d1d;">
            <p class="det-section-title" style="color:#7f1d1d;">⛔ Dar de Baja</p>
            <p style="font-size:0.82rem; color:var(--gris-500); margin-bottom:10px;">
                Acción <strong>irreversible</strong>. La máquina quedará fuera de uso permanentemente y se cerrará su asignación activa.
            </p>
            <form asp-action="DarDeBaja" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idMaquina" value="@Model.IdMaquina" />
                <div class="form-group" style="margin-bottom:10px;">
                    <label class="form-label">Fecha de baja</label>
                    <input type="date" name="fechaBaja" class="form-control"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="form-group" style="margin-bottom:10px;">
                    <label class="form-label">Motivo de baja <span class="req">*</span></label>
                    <input type="text" name="motivoBaja" class="form-control" maxlength="500"
                           placeholder="Ej: Vida útil cumplida, daño irreparable..." required />
                </div>
                <button type="submit" class="btn btn--sm"
                        style="background:#7f1d1d; color:white; border:none; cursor:pointer; border-radius:var(--r-sm); padding:8px 14px; font-size:0.85rem; font-weight:700;"
                        onclick="return confirm('⚠ ¿Dar de baja definitivamente esta máquina? Esta acción NO se puede deshacer.')">
                    ⛔ Dar de Baja definitivamente
                </button>
            </form>
        </div>

        </div>
    }

    <!-- HISTORIAL DE CAMBIOS DE ACCESORIOS/PARTES -->
    <div class="card" style="padding:0; overflow:hidden; margin-bottom:20px;">
        <div style="padding:16px 20px; border-bottom:1px solid var(--gris-200); display:flex; justify-content:space-between; align-items:center;">
            <div>
                <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">Historial de cambios — Accesorios / Partes</div>
                <div style="font-size:0.75rem; color:var(--gris-400); margin-top:2px;">Se registra automáticamente cada vez que se edita el campo de accesorios</div>
            </div>
            <span class="badge badge--celeste">@Model.CambiosAccesorios.Count()</span>
        </div>

        @if (Model.CambiosAccesorios.Any())
        {
            <div class="table-wrapper" style="border:none; border-radius:0;">
                <table>
                    <thead>
                        <tr>
                            <th>Fecha / Hora</th>
                            <th>Contenido anterior</th>
                            <th>Contenido nuevo</th>
                            <th>Modificado por</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.CambiosAccesorios)
                        {
                            <tr>
                                <td style="font-size:0.78rem; color:var(--gris-500); white-space:nowrap;">@c.FechaHora.ToString("dd/MM/yy HH:mm")</td>
                                <td style="font-size:0.78rem; max-width:300px; word-break:break-word;">
                                    <span class="diff-cell"
                                          data-antes="@(c.AccesorioAnterior ?? "")"
                                          data-despues="@(c.AccesorioNuevo ?? "")"
                                          data-modo="antes"></span>
                                </td>
                                <td style="font-size:0.82rem; max-width:300px; word-break:break-word;">
                                    <span class="diff-cell"
                                          data-antes="@(c.AccesorioAnterior ?? "")"
                                          data-despues="@(c.AccesorioNuevo ?? "")"
                                          data-modo="despues"></span>
                                </td>
                                <td style="font-size:0.75rem; color:var(--gris-400);">@(c.NombreUsuario ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding:24px; text-align:center; color:var(--gris-400); font-size:0.85rem;">
                Aún no hay cambios de accesorios registrados. Se registran automáticamente al editar la máquina.
            </div>
        }
    </div>

    <!-- HISTORIAL DE CAMBIOS -->
    @if (Model.Logs.Any())
    {
        <div class="card" style="padding:0; overflow:hidden;">
            <div style="padding:16px 20px; border-bottom:1px solid var(--gris-200); display:flex; justify-content:space-between; align-items:center;">
                <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">Historial de cambios</div>
                <span class="badge badge--azul">@Model.Logs.Count()</span>
            </div>
            <div class="table-wrapper" style="border:none; border-radius:0;">
                <table>
                    <thead>
                        <tr>
                            <th>Fecha / Hora</th>
                            <th>Tipo evento</th>
                            <th>Anterior</th>
                            <th>Nuevo</th>
                            <th>Observación</th>
                            <th>Usuario</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Logs)
                        {
                            var logColor = log.TipoEvento switch {
                                "CambioEstado"    => "badge--amarillo",
                                "CambioAsignacion"=> "badge--azul",
                                "CambioEncargado" => "badge--celeste",
                                "Edicion"         => "badge--gris",
                                _                 => "badge--gris"
                            };
                            <tr>
                                <td style="font-size:0.78rem; color:var(--gris-500); white-space:nowrap;">@log.FechaHora.ToString("dd/MM/yy HH:mm")</td>
                                <td><span class="badge @logColor" style="font-size:0.7rem;">@log.TipoEvento</span></td>
                                <td style="font-size:0.78rem; color:var(--gris-500);">@(log.ValorAnterior ?? "—")</td>
                                <td style="font-size:0.82rem; font-weight:500; color:var(--azul);">@(log.ValorNuevo ?? "—")</td>
                                <td style="font-size:0.78rem; color:var(--gris-600);">@(log.Observaciones ?? "—")</td>
                                <td style="font-size:0.75rem; color:var(--gris-400);">@(log.NombreUsuario ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@section Styles {
<style>
.det-label { font-size:0.67rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px; }
.det-value { font-size:0.88rem; font-weight:500; color:var(--gris-900); }
.det-section-title { font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); padding-bottom:8px; border-bottom:1px solid var(--gris-200); margin-bottom:14px; }
.diff-removed { background:#fee2e2; color:#b91c1c; border-radius:3px; padding:1px 3px; text-decoration:line-through; margin:1px; display:inline-block; }
.diff-added   { background:#dcfce7; color:#15803d; border-radius:3px; padding:1px 3px; font-weight:600; margin:1px; display:inline-block; }
.diff-equal   { color:var(--gris-600); margin:1px; display:inline-block; }
</style>
}

@section Scripts {
<script>
(function(){
    // Diff simple por palabras
    function diffPalabras(antes, despues) {
        var pA = antes.trim()   === "" ? [] : antes.trim().split(/\s+/);
        var pD = despues.trim() === "" ? [] : despues.trim().split(/\s+/);

        // LCS (Longest Common Subsequence) dp tabla
        var n = pA.length, m = pD.length;
        var dp = [];
        for (var i = 0; i <= n; i++) { dp[i] = []; for (var j = 0; j <= m; j++) dp[i][j] = 0; }
        for (var i = 1; i <= n; i++)
            for (var j = 1; j <= m; j++)
                dp[i][j] = pA[i-1] === pD[j-1] ? dp[i-1][j-1] + 1 : Math.max(dp[i-1][j], dp[i][j-1]);

        // Reconstruir diff
        var ops = [], i = n, j = m;
        while (i > 0 || j > 0) {
            if (i > 0 && j > 0 && pA[i-1] === pD[j-1]) { ops.unshift({t:'eq', v:pA[i-1]}); i--; j--; }
            else if (j > 0 && (i === 0 || dp[i][j-1] >= dp[i-1][j])) { ops.unshift({t:'add', v:pD[j-1]}); j--; }
            else { ops.unshift({t:'del', v:pA[i-1]}); i--; }
        }
        return ops;
    }

    function renderAntes(ops) {
        if (!ops.length) return '<span style="color:var(--gris-400);">—</span>';
        return ops.filter(o => o.t !== 'add').map(o =>
            o.t === 'del'
                ? '<span class="diff-removed">' + escHtml(o.v) + '</span>'
                : '<span class="diff-equal">'   + escHtml(o.v) + '</span>'
        ).join(' ');
    }

    function renderDespues(ops) {
        if (!ops.length) return '<span style="color:var(--gris-400);">—</span>';
        return ops.filter(o => o.t !== 'del').map(o =>
            o.t === 'add'
                ? '<span class="diff-added">'  + escHtml(o.v) + '</span>'
                : '<span class="diff-equal">'  + escHtml(o.v) + '</span>'
        ).join(' ');
    }

    function escHtml(s) {
        return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    document.querySelectorAll('.diff-cell').forEach(function(el) {
        var antes   = el.dataset.antes;
        var despues = el.dataset.despues;
        var modo    = el.dataset.modo;
        var ops = diffPalabras(antes, despues);
        el.innerHTML = modo === 'antes' ? renderAntes(ops) : renderDespues(ops);
    });
})();
</script>
}
