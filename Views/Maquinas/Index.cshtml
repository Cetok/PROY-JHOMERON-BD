@model IEnumerable<PROYJHOME2026.Models.Maquina>
@{
    ViewData["Title"]      = "Máquinas";
    ViewData["Breadcrumb"] = "Producción / Máquinas";
    int    pagina        = ViewBag.Pagina;
    int    totalPaginas  = ViewBag.TotalPaginas;
    int    total         = ViewBag.Total;
    string nombreMaquina = ViewBag.NombreMaquina ?? "";
    string numeroDesde   = ViewBag.NumeroDesde   ?? "";
    string numeroHasta   = ViewBag.NumeroHasta   ?? "";
    string estado        = ViewBag.Estado        ?? "";
    string marca         = ViewBag.Marca         ?? "";
    string encargado     = ViewBag.Encargado     ?? "";
    bool   hayFiltros    = !string.IsNullOrEmpty(nombreMaquina) || !string.IsNullOrEmpty(numeroDesde) ||
                           !string.IsNullOrEmpty(estado) || !string.IsNullOrEmpty(marca) || !string.IsNullOrEmpty(encargado);
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Producción</div>
        <h1 class="page-header__title">Máquinas</h1>
        <p class="page-header__subtitle">@total máquina(s) encontrada(s)</p>
    </div>
    <div class="page-header__actions">
        <a asp-controller="Reportes" asp-action="IndexProduccion" class="btn btn--secondary btn--sm">
            <svg viewBox="0 0 24 24" style="width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
            </svg>
            Reportes
        </a>
        <a asp-action="Create" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nueva máquina
        </a>
    </div>
</div>

<!-- FILTROS -->
<div class="card" style="margin-bottom:20px; padding:16px 20px;">
    <form method="get" asp-action="Index">
        <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
            <!-- Nombre -->
            <div style="flex:1; min-width:160px;">
                <label class="form-label">Nombre de máquina</label>
                <input type="text" name="nombreMaquina" value="@nombreMaquina" class="form-control" placeholder="Ej: Llenadora..." />
            </div>
            <!-- Rango N° -->
            <div style="min-width:120px;">
                <label class="form-label">N° Desde</label>
                <input type="text" name="numeroDesde" value="@numeroDesde" class="form-control" placeholder="BN01" />
            </div>
            <div style="min-width:120px;">
                <label class="form-label">N° Hasta</label>
                <input type="text" name="numeroHasta" value="@numeroHasta" class="form-control" placeholder="BN09" />
            </div>
            <!-- Estado -->
            <div style="min-width:150px;">
                <label class="form-label">Estado</label>
                <select name="estado" class="form-control">
                    <option value="">Todos</option>
                    <option value="Registrado"    selected="@(estado=="Registrado"    ?"selected":null)">Registrado</option>
                    <option value="Activo"        selected="@(estado=="Activo"        ?"selected":null)">Activo</option>
                    <option value="Mantenimiento" selected="@(estado=="Mantenimiento" ?"selected":null)">Mantenimiento</option>
                    <option value="Inoperativo"   selected="@(estado=="Inoperativo"   ?"selected":null)">Inoperativo</option>
                    <option value="Dado de Baja"  selected="@(estado=="Dado de Baja"  ?"selected":null)">Dado de Baja</option>
                </select>
            </div>
            <!-- Marca -->
            <div style="min-width:130px;">
                <label class="form-label">Marca</label>
                <input type="text" name="marca" value="@marca" class="form-control" placeholder="Ej: Bosch..." />
            </div>
            <!-- Encargado -->
            <div style="min-width:150px;">
                <label class="form-label">Encargado</label>
                <input type="text" name="encargado" value="@encargado" class="form-control" placeholder="Nombre o apellido..." />
            </div>
            <div style="display:flex; gap:8px; align-self:flex-end;">
                <button type="submit" class="btn btn--primary">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    Buscar
                </button>
                @if (hayFiltros)
                {
                    <a asp-action="Index" class="btn btn--secondary">Limpiar</a>
                }
            </div>
        </div>
    </form>
</div>

<!-- TABLA -->
<div class="card" style="padding:0; overflow:hidden;">
    @if (Model.Any())
    {
        <div class="table-wrapper" style="border:none; border-radius:0;">
            <table>
                <thead>
                    <tr>
                        <th>N° Máquina</th>
                        <th>Nombre</th>
                        <th>Marca</th>
                        <th>Estado</th>
                        <th>Grupo asignado</th>
                        <th>Encargado(s)</th>
                        <th style="text-align:center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        string bc;
                        if      (m.Estado == "Registrado")    bc = "badge--gris";
                        else if (m.Estado == "Activo")        bc = "badge--verde";
                        else if (m.Estado == "Mantenimiento") bc = "badge--amarillo";
                        else if (m.Estado == "Inoperativo")   bc = "badge--rojo";
                        else                                   bc = "badge--gris";

                        string enc   = m.AsignacionActual?.Encargados != null && m.AsignacionActual.Encargados.Any()
                            ? string.Join(", ", m.AsignacionActual.Encargados.Select(e => e.Empleado?.nombre + " " + e.Empleado?.paterno))
                            : "—";
                        string grupo = m.AsignacionActual?.Grupo?.area ?? "Sin asignar";

                        <tr>
                            <td style="font-family:monospace; font-weight:700; color:var(--azul-dark);">@m.NumeroCompleto</td>
                            <td style="font-weight:600;">@m.NombreMaquina</td>
                            <td style="font-size:0.82rem; color:var(--gris-600);">@(m.Marca ?? "—")</td>
                            <td><span class="badge @bc">@m.Estado</span></td>
                            <td style="font-size:0.82rem;">@grupo</td>
                            <td style="font-size:0.82rem; color:var(--azul);">@enc</td>
                            <td>
                                <div style="display:flex; gap:6px; justify-content:center;">
                                    <a asp-action="Details" asp-route-id="@m.IdMaquina" class="btn btn--ghost btn--icon" title="Ver detalle">
                                        <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@m.IdMaquina" class="btn btn--secondary btn--icon" title="Editar">
                                        <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPaginas > 1)
        {
            <div class="pagination">
                <span style="font-size:0.75rem; color:var(--gris-400); margin-right:8px;">Página @pagina de @totalPaginas</span>
                @if (pagina > 1)
                {
                    <a asp-action="Index" asp-route-pagina="@(pagina-1)"
                       asp-route-nombreMaquina="@nombreMaquina" asp-route-numeroDesde="@numeroDesde"
                       asp-route-numeroHasta="@numeroHasta" asp-route-estado="@estado"
                       asp-route-marca="@marca" asp-route-encargado="@encargado"
                       class="pagination__btn"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg></a>
                }
                @for (int i = Math.Max(1, pagina-2); i <= Math.Min(totalPaginas, pagina+2); i++)
                {
                    <a asp-action="Index" asp-route-pagina="@i"
                       asp-route-nombreMaquina="@nombreMaquina" asp-route-numeroDesde="@numeroDesde"
                       asp-route-numeroHasta="@numeroHasta" asp-route-estado="@estado"
                       asp-route-marca="@marca" asp-route-encargado="@encargado"
                       class="pagination__btn @(i==pagina?"active":"")">@i</a>
                }
                @if (pagina < totalPaginas)
                {
                    <a asp-action="Index" asp-route-pagina="@(pagina+1)"
                       asp-route-nombreMaquina="@nombreMaquina" asp-route-numeroDesde="@numeroDesde"
                       asp-route-numeroHasta="@numeroHasta" asp-route-estado="@estado"
                       asp-route-marca="@marca" asp-route-encargado="@encargado"
                       class="pagination__btn"><svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg></a>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state__icon">
                <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
            </div>
            <div class="empty-state__title">No se encontraron máquinas</div>
            <div class="empty-state__text">
                @if (hayFiltros) { <span>Intenta con otros filtros.</span> }
                else             { <span>Aún no hay máquinas registradas.</span> }
            </div>
        </div>
    }
</div>
