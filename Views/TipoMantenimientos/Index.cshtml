@model IEnumerable<PROYJHOME2026.Models.TipoMantenimiento>
@{
    ViewData["Title"]      = "Tipos de Mantenimiento";
    ViewData["Breadcrumb"] = "Configuración / Tipos Mantenimiento";
    int pagina       = ViewBag.Pagina;
    int totalPaginas = ViewBag.TotalPaginas;
    int total        = ViewBag.Total;
    string buscar    = ViewBag.Buscar ?? "";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Configuración</div>
        <h1 class="page-header__title">Tipos de Mantenimiento</h1>
        <p class="page-header__subtitle">@total tipo(s) registrado(s)</p>
    </div>
    <div class="page-header__actions">
        <a asp-controller="MantenimientoCarros" asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver a Mantenimiento
        </a>
        <a asp-action="Create" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nuevo tipo
        </a>
    </div>
</div>


<!-- FILTRO -->
<div class="card" style="margin-bottom:20px; padding:16px 20px;">
    <form method="get" asp-action="Index" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
        <div style="flex:1; min-width:200px;">
            <label class="form-label">Buscar</label>
            <div style="position:relative;">
                <svg style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:15px;height:15px;stroke:var(--gris-400);fill:none;stroke-width:2;stroke-linecap:round;pointer-events:none;" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" name="buscar" value="@buscar" class="form-control"
                       style="padding-left:34px;" placeholder="Nombre del tipo..." />
            </div>
        </div>
        <div style="display:flex; gap:8px;">
            <button type="submit" class="btn btn--primary">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                Buscar
            </button>
            @if (!string.IsNullOrEmpty(buscar)) {
                <a asp-action="Index" class="btn btn--secondary">Limpiar</a>
            }
        </div>
    </form>
</div>

<!-- TABLA -->
<div class="card" style="padding:0; overflow:hidden;">
    @if (Model.Any())
    {
        <div class="table-wrapper" style="border:none; border-radius:0;">
            <table>
                <thead>
                    <tr>
                        <th>Tipo de mantenimiento</th>
                        <th style="text-align:center;">Mantenimientos registrados</th>
                        <th style="text-align:center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <div class="tipo-icon">
                                        <svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
                                    </div>
                                    <span style="font-weight:600; color:var(--gris-900);">@t.Nombre</span>
                                </div>
                            </td>
                            <td style="text-align:center;">
                                <span class="badge badge--amarillo">@t.MantenimientosCarros.Count</span>
                            </td>
                            <td>
                                <div style="display:flex; gap:6px; justify-content:center;">
                                    <a asp-action="Edit" asp-route-id="@t.IdTipoMante"
                                       class="btn btn--secondary btn--icon" title="Editar">
                                        <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    </a>
                                    
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPaginas > 1)
        {
            <div class="pagination">
                <span style="font-size:0.75rem; color:var(--gris-400); margin-right:8px;">Página @pagina de @totalPaginas</span>
                @if (pagina > 1) {
                    <a asp-action="Index" asp-route-pagina="@(pagina-1)" asp-route-buscar="@buscar"
                       class="pagination__btn"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg></a>
                }
                @for (int i = Math.Max(1, pagina-2); i <= Math.Min(totalPaginas, pagina+2); i++) {
                    <a asp-action="Index" asp-route-pagina="@i" asp-route-buscar="@buscar"
                       class="pagination__btn @(i == pagina ? "active" : "")">@i</a>
                }
                @if (pagina < totalPaginas) {
                    <a asp-action="Index" asp-route-pagina="@(pagina+1)" asp-route-buscar="@buscar"
                       class="pagination__btn"><svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg></a>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state__icon">
                <svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
            </div>
            <div class="empty-state__title">No hay tipos de mantenimiento</div>
            <div class="empty-state__text">
                @if (!string.IsNullOrEmpty(buscar)) { <span>Intenta con otro término.</span> }
                else { <span>Registra el primer tipo para poder asignarlo a mantenimientos.</span> }
            </div>
        </div>
    }
</div>

@section Styles {
<style>
.tipo-icon {
    width:32px; height:32px; border-radius:var(--r-sm);
    background:rgba(217,119,6,0.1); border:1px solid rgba(217,119,6,0.2);
    display:grid; place-items:center; flex-shrink:0;
}
.tipo-icon svg { width:15px; height:15px; stroke:#d97706; fill:none; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
</style>
}
