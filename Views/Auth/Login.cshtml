@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión — Jhomeron</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --azul:      #0d3393;
            --azul-dark: #0a2570;
            --azul-mid:  #1a4ab0;
            --celeste:   #3b9be8;
            --blanco:    #ffffff;
            --gris-100:  #f4f6fa;
            --gris-200:  #eaecf3;
            --gris-300:  #d6dae8;
            --gris-400:  #b0b8cc;
            --gris-500:  #7a85a0;
            --gris-900:  #1c2340;
            --rojo:      #e03d3d;
            --font-d:    'Outfit', sans-serif;
            --font-b:    'Plus Jakarta Sans', sans-serif;
        }

        html, body {
            height: 100%;
            font-family: var(--font-b);
            background: var(--gris-100);
        }

        /* ── Layout split ── */
        .login-wrap {
            display: flex;
            min-height: 100vh;
        }

        /* Panel izquierdo — imagen */
        .login-panel {
            flex: 1;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 48px 52px;
        }

        /* Imagen de fondo */
        .login-panel__bg {
            position: absolute;
            inset: 0;
            background-image: url('https://images.unsplash.com/photo-1568605117036-5fe5e7bab0b7?w=1200&q=80');
            background-size: cover;
            background-position: center;
            z-index: 0;
        }

        /* Overlay oscuro sobre la imagen */
        .login-panel__overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(
                135deg,
                rgba(10,37,112,0.88) 0%,
                rgba(13,51,147,0.75) 50%,
                rgba(10,37,112,0.65) 100%
            );
            z-index: 1;
        }

        .panel-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            position: relative;
            z-index: 2;
        }

        .panel-logo__icon {
            width: 40px; height: 40px;
            background: var(--celeste);
            border-radius: 10px;
            display: grid;
            place-items: center;
            box-shadow: 0 4px 16px rgba(59,155,232,0.4);
            flex-shrink: 0;
        }

        .panel-logo__icon svg {
            width: 20px; height: 20px;
            stroke: var(--blanco);
            fill: none;
            stroke-width: 2.2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .panel-logo__name {
            font-family: var(--font-d);
            font-weight: 700;
            font-size: 1.15rem;
            color: var(--blanco);
        }

        .panel-logo__sub {
            font-size: 0.65rem;
            color: rgba(255,255,255,0.5);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            display: block;
        }

        .panel-body {
            position: relative;
            z-index: 2;
        }

        .panel-body__tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(59,155,232,0.15);
            border: 1px solid rgba(59,155,232,0.3);
            color: #7ec8f7;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 5px 12px;
            border-radius: 20px;
            margin-bottom: 20px;
        }

        .panel-body__tag::before {
            content: '';
            width: 6px; height: 6px;
            border-radius: 50%;
            background: var(--celeste);
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50%       { opacity: 0.5; transform: scale(0.8); }
        }

        .panel-body__title {
            font-family: var(--font-d);
            font-size: 2.4rem;
            font-weight: 800;
            color: var(--blanco);
            line-height: 1.15;
            margin-bottom: 16px;
            text-shadow: 0 2px 12px rgba(0,0,0,0.3);
        }

        .panel-body__title span { color: #7ec8f7; }

        .panel-body__desc {
            font-size: 0.88rem;
            color: rgba(255,255,255,0.6);
            line-height: 1.7;
            max-width: 340px;
        }

        .panel-features {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 36px;
        }

        .panel-feature {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .panel-feature__icon {
            width: 32px; height: 32px;
            border-radius: 8px;
            background: rgba(59,155,232,0.12);
            border: 1px solid rgba(59,155,232,0.2);
            display: grid;
            place-items: center;
            flex-shrink: 0;
        }

        .panel-feature__icon svg {
            width: 14px; height: 14px;
            stroke: #7ec8f7;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
        }

        .panel-feature__text {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.55);
        }

        .panel-footer {
            position: relative;
            z-index: 2;
            font-size: 0.72rem;
            color: rgba(255,255,255,0.25);
        }

        /* Panel derecho — formulario */
        .login-form-wrap {
            width: 440px;
            flex-shrink: 0;
            background: var(--blanco);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px 44px;
        }

        .login-form-inner {
            width: 100%;
            animation: fadeUp 0.4s ease;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .form-head { margin-bottom: 32px; }

        .form-head__eyebrow {
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--celeste);
            margin-bottom: 6px;
        }

        .form-head__title {
            font-family: var(--font-d);
            font-size: 1.7rem;
            font-weight: 800;
            color: var(--azul-dark);
            line-height: 1.2;
        }

        .form-head__sub {
            font-size: 0.82rem;
            color: var(--gris-500);
            margin-top: 6px;
        }

        .error-box {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            background: rgba(224,61,61,0.07);
            border: 1.5px solid rgba(224,61,61,0.2);
            border-radius: 10px;
            padding: 12px 14px;
            margin-bottom: 22px;
            font-size: 0.82rem;
            color: #b02020;
            animation: shake 0.35s ease;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%       { transform: translateX(-5px); }
            40%       { transform: translateX(5px); }
            60%       { transform: translateX(-3px); }
            80%       { transform: translateX(3px); }
        }

        .error-box svg { width:16px; height:16px; stroke:currentColor; fill:none; stroke-width:2; flex-shrink:0; margin-top:1px; }

        .field { margin-bottom: 18px; }

        .field label {
            display: block;
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--gris-900);
            margin-bottom: 6px;
        }

        .field-input { position: relative; }

        .field-input__icon {
            position: absolute;
            left: 12px; top: 50%;
            transform: translateY(-50%);
            width: 16px; height: 16px;
            stroke: var(--gris-400); fill: none;
            stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
            pointer-events: none;
            transition: stroke 0.2s;
        }

        .field-input input {
            width: 100%;
            background: var(--gris-100);
            border: 1.5px solid var(--gris-300);
            border-radius: 8px;
            padding: 11px 42px;
            font-family: var(--font-b);
            font-size: 0.88rem;
            color: var(--gris-900);
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        }

        .field-input input::placeholder { color: var(--gris-400); }

        /* Ocultar ojo nativo de Edge/Chrome en inputs password */
        .field-input input[type="password"]::-ms-reveal,
        .field-input input[type="password"]::-ms-clear { display: none !important; }
        .field-input input::-webkit-credentials-auto-fill-button { visibility: hidden; pointer-events: none; }

        .field-input input:focus {
            background: var(--blanco);
            border-color: var(--celeste);
            box-shadow: 0 0 0 3px rgba(59,155,232,0.12);
        }

        .field-input:focus-within .field-input__icon { stroke: var(--celeste); }

        .eye-btn {
            position: absolute; right: 12px; top: 50%;
            transform: translateY(-50%);
            width: 28px; height: 28px; border-radius: 6px;
            display: flex; align-items: center; justify-content: center;
            background: none; border: none; cursor: pointer;
            color: var(--gris-400);
            transition: color 0.2s, background 0.2s;
        }
        .eye-btn:hover { color: var(--azul); background: var(--gris-200); }
        .eye-btn svg { width:16px; height:16px; stroke:currentColor; fill:none; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }

        .btn-login {
            width: 100%;
            background: var(--azul);
            color: var(--blanco);
            border: none; border-radius: 8px;
            padding: 13px;
            font-family: var(--font-b);
            font-size: 0.92rem; font-weight: 700;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center; gap: 8px;
            margin-top: 8px;
            transition: background 0.2s, box-shadow 0.2s, transform 0.15s;
        }

        .btn-login:hover {
            background: var(--azul-mid);
            box-shadow: 0 6px 20px rgba(13,51,147,0.35);
            transform: translateY(-1px);
        }

        .btn-login:active { transform: translateY(0); }
        .btn-login svg { width:16px; height:16px; stroke:currentColor; fill:none; stroke-width:2; stroke-linecap:round; }
        .btn-login .spinner { display:none; width:16px; height:16px; border:2px solid rgba(255,255,255,0.3); border-top-color:var(--blanco); border-radius:50%; animation:spin 0.7s linear infinite; }
        @@keyframes spin { to { transform: rotate(360deg); } }
        .btn-login.loading .spinner { display: block; }
        .btn-login.loading .btn-text { display: none; }

        .form-footer {
            margin-top: 28px; padding-top: 20px;
            border-top: 1px solid var(--gris-200);
            display: flex; align-items: center; gap: 8px;
            font-size: 0.72rem; color: var(--gris-400);
        }
        .form-footer svg { width:14px; height:14px; stroke:var(--gris-400); fill:none; stroke-width:2; flex-shrink:0; }

        /* ── Responsive ── */
        @@media (max-width: 780px) {
            .login-panel { display: none; }
            .login-form-wrap { width: 100%; padding: 40px 28px; min-height: 100vh; }
        }

        @@media (max-width: 480px) {
            .login-form-wrap { padding: 32px 20px; }
            .form-head__title { font-size: 1.4rem; }
        }
    </style>
</head>
<body>

<div class="login-wrap">

    <!-- ═══════════ PANEL IZQUIERDO (IMAGEN) ═══════════ -->
    <div class="login-panel">
        <div class="login-panel__bg"></div>
        <div class="login-panel__overlay"></div>

        <div class="panel-logo">
            <div class="panel-logo__icon" style="background:linear-gradient(135deg,#1a6bc4,#0ea5e9);">
                <svg viewBox="0 0 24 24" style="width:22px;height:22px;stroke:white;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;">
                    <rect x="1" y="3" width="15" height="13" rx="2"/>
                    <path d="M16 8h4l3 3v5h-7V8z"/>
                    <circle cx="5.5" cy="18.5" r="2.5"/>
                    <circle cx="18.5" cy="18.5" r="2.5"/>
                </svg>
            </div>
            <div>
                <div class="panel-logo__name">Industrias Jhomeron S.A</div>
                <span class="panel-logo__sub">Sistema de control</span>
            </div>
        </div>

        <div class="panel-body">
            <div class="panel-body__tag">Acceso seguro</div>
            <h1 class="panel-body__title">
                Gestión integral<br>de <span>recursos</span><br>y activos
            </h1>

            <div class="panel-features">
                <div class="panel-feature">
                    <div class="panel-feature__icon">
                        <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                    </div>
                    <span class="panel-feature__text">Control de empleados y grupos</span>
                </div>
                <div class="panel-feature">
                    <div class="panel-feature__icon">
                        <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                    </div>
                    <span class="panel-feature__text">Inventario de equipos y chips</span>
                </div>
                <div class="panel-feature">
                    <div class="panel-feature__icon">
                        <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    </div>
                    <span class="panel-feature__text">Flota vehicular y mantenimientos</span>
                </div>
            </div>
        </div>

        <div class="panel-footer">
            &copy; @DateTime.Now.Year Industrias Jhomeron S.A — RUC: 20601777844
        </div>
    </div>

    <!-- ═══════════ PANEL DERECHO (FORM) ═══════════ -->
    <div class="login-form-wrap">
        <div class="login-form-inner">

            <div class="form-head">
                <div class="form-head__eyebrow">Bienvenido</div>
                <h2 class="form-head__title">Iniciar sesión</h2>
                <p class="form-head__sub">Ingresa tus credenciales para continuar</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="error-box">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <form id="loginForm" asp-controller="Auth" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div class="field">
                    <label for="username">Usuario</label>
                    <div class="field-input">
                        <input type="text" id="username" name="username"
                               placeholder="Ingresa tu usuario"
                               autocomplete="username" autofocus required />
                        <svg class="field-input__icon" viewBox="0 0 24 24">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </div>
                </div>

                <div class="field">
                    <label for="password">Contraseña</label>
                    <div class="field-input">
                        <input type="password" id="password" name="password"
                               placeholder="Ingresa tu contraseña"
                               autocomplete="current-password" required />
                        <svg class="field-input__icon" viewBox="0 0 24 24">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0110 0v4"/>
                        </svg>
                        <button type="button" class="eye-btn" id="eyeBtn" title="Mostrar/ocultar contraseña">
                            <svg id="eyeOff" viewBox="0 0 24 24">
                                <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94"/>
                                <path d="M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19"/>
                                <line x1="1" y1="1" x2="23" y2="23"/>
                            </svg>
                            <svg id="eyeOn" viewBox="0 0 24 24" style="display:none;">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-login" id="btnLogin">
                    <span class="btn-text" style="display:flex; align-items:center; gap:8px;">
                        <svg viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                        Ingresar al sistema
                    </span>
                    <div class="spinner"></div>
                </button>
            </form>

            <div class="form-footer">
                <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                <span>Acceso restringido. Solo personal autorizado.</span>
            </div>

        </div>
    </div>

</div>

<script>
    const eyeBtn   = document.getElementById('eyeBtn');
    const passInput = document.getElementById('password');
    const eyeOff   = document.getElementById('eyeOff');
    const eyeOn    = document.getElementById('eyeOn');

    eyeBtn.addEventListener('click', () => {
        const visible = passInput.type === 'text';
        passInput.type = visible ? 'password' : 'text';
        eyeOff.style.display = visible ? '' : 'none';
        eyeOn.style.display  = visible ? 'none' : '';
    });

    document.getElementById('loginForm').addEventListener('submit', function () {
        const btn = document.getElementById('btnLogin');
        btn.classList.add('loading');
        btn.disabled = true;
    });

    if (window.history.replaceState)
        window.history.replaceState(null, null, window.location.href);
</script>

</body>
</html>
