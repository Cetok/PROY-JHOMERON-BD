@model PROYJHOME2026.Models.Asesorio
@{
    ViewData["Title"]      = "Nuevo Accesorio";
    ViewData["Breadcrumb"] = "Accesorios / Nuevo";
}
<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Accesorios</div>
        <h1 class="page-header__title">Nuevo Accesorio</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>
<div style="max-width:480px;">
    <div class="card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">Nombre del accesorio <span class="req">*</span></label>
                <input asp-for="TipoAsesorio" class="form-control" placeholder="Ej: GPS, Extintor, Carrocería..." maxlength="100" />
                <span asp-validation-for="TipoAsesorio" class="form-error"></span>
            </div>
            <div style="display:flex; gap:10px; padding-top:12px; border-top:1px solid var(--gris-200); margin-top:8px;">
                <button type="submit" class="btn btn--celeste btn--lg">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    Registrar
                </button>
                <a asp-action="Index" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
