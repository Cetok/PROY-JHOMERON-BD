@model PROYJHOME2026.Models.Asesorio
@{
    ViewData["Title"]      = "Detalle Accesorio";
    ViewData["Breadcrumb"] = "Accesorios / Detalle";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Accesorios</div>
        <h1 class="page-header__title">@Model.TipoAsesorio</h1>
        <p class="page-header__subtitle">@Model.CarroAsesorios.Count vehículo(s) · @Model.GrupoAsesorios.Count grupo(s)</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.IdAsesorio" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Editar
        </a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:960px; display:flex; flex-direction:column; gap:16px;">

    <!-- Vehículos -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--azul);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                Vehículos con este accesorio
            </div>
            <span class="badge badge--azul">@Model.CarroAsesorios.Count</span>
        </div>
        @if (Model.CarroAsesorios.Any())
        {
            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px,1fr)); gap:10px;">
                @foreach (var ca in Model.CarroAsesorios)
                {
                    <div style="padding:10px 14px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200);">
                        <div style="font-weight:600; font-size:0.85rem; font-family:monospace; color:var(--azul);">@ca.Carro?.Placa</div>
                        <div style="font-size:0.76rem; color:var(--gris-500);">@ca.Carro?.Marca @ca.Carro?.Modelo</div>
                        @if (ca.FechaAsignada.HasValue) {
                            <div style="font-size:0.72rem; color:var(--gris-400); margin-top:2px;">Desde @ca.FechaAsignada.Value.ToString("dd/MM/yyyy")</div>
                        }
                        @if (!string.IsNullOrEmpty(ca.Observaciones)) {
                            <div style="font-size:0.72rem; color:var(--gris-400); margin-top:2px; font-style:italic;">@ca.Observaciones</div>
                        }
                    </div>
                }
            </div>
        }
        else { <div style="text-align:center; padding:16px 0; color:var(--gris-400); font-size:0.82rem;">Ningún vehículo tiene este accesorio.</div> }
    </div>

    <!-- Grupos -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--celeste);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                Grupos con este accesorio
            </div>
            <span class="badge badge--celeste">@Model.GrupoAsesorios.Count</span>
        </div>
        @if (Model.GrupoAsesorios.Any())
        {
            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px,1fr)); gap:10px;">
                @foreach (var ga in Model.GrupoAsesorios)
                {
                    <div style="padding:10px 14px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200);">
                        <div style="font-weight:600; font-size:0.85rem; color:var(--gris-900);">@ga.Grupo?.area</div>
                        @if (ga.FechaAsignada.HasValue) {
                            <div style="font-size:0.72rem; color:var(--gris-400); margin-top:2px;">Desde @ga.FechaAsignada.Value.ToString("dd/MM/yyyy")</div>
                        }
                        @if (!string.IsNullOrEmpty(ga.Observaciones)) {
                            <div style="font-size:0.72rem; color:var(--gris-400); margin-top:2px; font-style:italic;">@ga.Observaciones</div>
                        }
                    </div>
                }
            </div>
        }
        else { <div style="text-align:center; padding:16px 0; color:var(--gris-400); font-size:0.82rem;">Ningún grupo tiene este accesorio.</div> }
    </div>

</div>
