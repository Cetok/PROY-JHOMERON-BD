@model PROYJHOME2026.Models.Asesorio
@{
    ViewData["Title"]      = "Detalle Accesorio";
    ViewData["Breadcrumb"] = "Accesorios / Detalle";
    bool esExtintorAccesorio = Model.TipoAsesorio?.ToLower().Contains("extintor") == true;
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Accesorios</div>
        <h1 class="page-header__title">@Model.TipoAsesorio</h1>
        <p class="page-header__subtitle">@Model.CarroAsesorios.Count vehículo(s) · @Model.GrupoAsesorios.Count grupo(s)</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.IdAsesorio" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Editar
        </a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:960px; display:flex; flex-direction:column; gap:16px;">

    <!-- Vehículos -->
    <div class="card">
        <div class="acc-card-header">
            <div class="acc-section-title">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--azul);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                Vehículos con este accesorio
            </div>
            <span class="badge badge--azul">@Model.CarroAsesorios.Count</span>
        </div>
        @if (Model.CarroAsesorios.Any())
        {
            <div class="acc-grid">
                @foreach (var ca in Model.CarroAsesorios)
                {
                    bool caExt = !string.IsNullOrEmpty(ca.TipoExtintor);
                    var venceC = ca.FechaVencimientoExtintor;
                    var diasC  = venceC.HasValue ? venceC.Value.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber : (int?)null;
                    var borderC = caExt && diasC.HasValue ? (diasC <= 0 ? "#dc2626" : diasC <= 30 ? "#d97706" : "#e2e8f0") : "#e2e8f0";
                    var bgC     = caExt && diasC.HasValue ? (diasC <= 0 ? "rgba(220,38,38,0.03)" : diasC <= 30 ? "rgba(217,119,6,0.03)" : "var(--gris-50)") : "var(--gris-50)";
                    <div style="border:1.5px solid @borderC; border-radius:var(--r-md); padding:12px 14px; background:@bgC;">
                        <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
                            <span style="font-family:monospace; font-weight:800; font-size:0.95rem; color:var(--azul);">@ca.Carro?.Placa</span>
                            <span style="font-size:0.78rem; color:var(--gris-500);">@ca.Carro?.Marca @ca.Carro?.Modelo</span>
                        </div>
                        <div style="display:flex; flex-wrap:wrap; gap:8px; font-size:0.74rem; color:var(--gris-500);">
                            @if (ca.FechaAsignada.HasValue) { <span>📅 Desde @ca.FechaAsignada.Value.ToString("dd/MM/yyyy")</span> }
                            @if (!string.IsNullOrEmpty(ca.Observaciones)) { <span>💬 @ca.Observaciones</span> }
                        </div>
                        @if (caExt)
                        {
                            var cC = diasC.HasValue ? (diasC <= 0 ? "#dc2626" : diasC <= 30 ? "#d97706" : "var(--gris-500)") : "var(--gris-500)";
                            var tC = diasC.HasValue ? (diasC <= 0 ? $"⛔ Vencido hace {Math.Abs(diasC.Value)} días"
                                     : diasC <= 30 ? $"⚠️ Vence en {diasC} días" : $"✅ Vence {venceC!.Value:dd/MM/yyyy}") : "Sin fecha";
                            <div style="display:flex; flex-wrap:wrap; gap:6px; align-items:center; margin-top:7px;">
                                <span class="badge" style="background:rgba(220,38,38,0.1); color:#dc2626; font-size:0.68rem;">🧯 @ca.TipoExtintor</span>
                                @if (!string.IsNullOrEmpty(ca.PesoExtintor)) { <span style="font-size:0.72rem; color:var(--gris-600);">@ca.PesoExtintor</span> }
                                <span style="font-size:0.73rem; font-weight:600; color:@cC;">@tC</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else { <div class="acc-empty">Ningún vehículo tiene este accesorio.</div> }
    </div>

    <!-- Grupos -->
    <div class="card">
        <div class="acc-card-header">
            <div class="acc-section-title">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--celeste);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                Grupos con este accesorio
            </div>
            <span class="badge badge--celeste">@Model.GrupoAsesorios.Count</span>
        </div>
        @if (Model.GrupoAsesorios.Any())
        {
            <div class="acc-grid">
                @foreach (var ga in Model.GrupoAsesorios)
                {
                    bool gaExt = !string.IsNullOrEmpty(ga.TipoExtintor);
                    var venceG = ga.FechaVencimientoExtintor;
                    var diasG  = venceG.HasValue ? venceG.Value.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber : (int?)null;
                    var borderG = gaExt && diasG.HasValue ? (diasG <= 0 ? "#dc2626" : diasG <= 30 ? "#d97706" : "#e2e8f0") : "#e2e8f0";
                    var bgG     = gaExt && diasG.HasValue ? (diasG <= 0 ? "rgba(220,38,38,0.03)" : diasG <= 30 ? "rgba(217,119,6,0.03)" : "var(--gris-50)") : "var(--gris-50)";
                    <div style="border:1.5px solid @borderG; border-radius:var(--r-md); padding:12px 14px; background:@bgG;">
                        <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900); margin-bottom:6px;">
                            <svg viewBox="0 0 24 24" style="width:13px;height:13px;stroke:var(--celeste);fill:none;stroke-width:2;vertical-align:middle;margin-right:4px;"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                            @ga.Grupo?.area
                        </div>
                        <div style="display:flex; flex-wrap:wrap; gap:8px; font-size:0.74rem; color:var(--gris-500);">
                            @if (ga.FechaAsignada.HasValue) { <span>📅 Desde @ga.FechaAsignada.Value.ToString("dd/MM/yyyy")</span> }
                            @if (!string.IsNullOrEmpty(ga.Observaciones)) { <span>💬 @ga.Observaciones</span> }
                        </div>
                        @if (gaExt)
                        {
                            var cG = diasG.HasValue ? (diasG <= 0 ? "#dc2626" : diasG <= 30 ? "#d97706" : "var(--gris-500)") : "var(--gris-500)";
                            var tG = diasG.HasValue ? (diasG <= 0 ? $"⛔ Vencido hace {Math.Abs(diasG.Value)} días"
                                     : diasG <= 30 ? $"⚠️ Vence en {diasG} días" : $"✅ Vence {venceG!.Value:dd/MM/yyyy}") : "Sin fecha";
                            <div style="display:flex; flex-wrap:wrap; gap:6px; align-items:center; margin-top:7px;">
                                <span class="badge" style="background:rgba(220,38,38,0.1); color:#dc2626; font-size:0.68rem;">🧯 @ga.TipoExtintor</span>
                                @if (!string.IsNullOrEmpty(ga.PesoExtintor)) { <span style="font-size:0.72rem; color:var(--gris-600);">@ga.PesoExtintor</span> }
                                <span style="font-size:0.73rem; font-weight:600; color:@cG;">@tG</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else { <div class="acc-empty">Ningún grupo tiene este accesorio.</div> }
    </div>

    @if (esExtintorAccesorio)
    {
        <div class="card">
            <div class="acc-card-header">
                <div class="acc-section-title">
                    <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:#dc2626;fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    Inspección de Extintores
                </div>
                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                    <a asp-controller="InspeccionExtintor" asp-action="Crear" asp-route-idAsesorio="@Model.IdAsesorio"
                       class="btn btn--celeste btn--sm">
                        <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Nueva Inspección
                    </a>
                    <a asp-controller="InspeccionExtintor" asp-action="Historial" asp-route-idAsesorio="@Model.IdAsesorio"
                       class="btn btn--secondary btn--sm">
                        <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        Ver historial
                    </a>
                </div>
            </div>
            <div style="font-size:0.82rem; color:var(--gris-400);">
                Registra y consulta las inspecciones de seguridad de los extintores asignados a los grupos.
            </div>
        </div>
    }

</div>

@section Styles {
<style>
.acc-card-header   { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200); flex-wrap:wrap; gap:8px; }
.acc-section-title { font-weight:700; font-size:0.9rem; color:var(--gris-900); }
.acc-grid          { display:grid; grid-template-columns:repeat(auto-fill, minmax(260px,1fr)); gap:10px; }
.acc-empty         { text-align:center; padding:16px 0; color:var(--gris-400); font-size:0.82rem; }

@@media (max-width: 500px) {
    .acc-grid { grid-template-columns:1fr; }
}
</style>
}
