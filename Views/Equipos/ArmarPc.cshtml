@model PROYJHOME2026.Models.Equipo
@{
    ViewData["Title"]      = Model == null ? "Armar PC Completo" : "Editar PC Completo";
    ViewData["Breadcrumb"] = "Equipos TI / Armar PC Completo";

    var cpus     = ViewBag.CpuDisponibles     as List<PROYJHOME2026.Models.Equipo> ?? new();
    var monitors = ViewBag.MonitorDisponibles as List<PROYJHOME2026.Models.Equipo> ?? new();
    var mice     = ViewBag.MouseDisponibles   as List<PROYJHOME2026.Models.Equipo> ?? new();
    var teclados = ViewBag.TecladoDisponibles as List<PROYJHOME2026.Models.Equipo> ?? new();

    string Etiqueta(PROYJHOME2026.Models.Equipo e) =>
        $"{e.marca} {e.modelo}" + (string.IsNullOrEmpty(e.numero_serie) ? "" : $" — {e.numero_serie}");
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Equipos TI</div>
        <h1 class="page-header__title">@(Model == null ? "Armar PC Completo" : $"Editar {Model.NombrePc}")</h1>
        <p class="page-header__subtitle">Selecciona componentes ya registrados en tu inventario para formar el equipo.</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div class="card" style="max-width:720px;">
    <form asp-action="ArmarPc" method="post">
        @Html.AntiForgeryToken()
        @if (Model != null)
        {
            <input type="hidden" name="idKit" value="@Model.idEquipo" />
        }

        @if (Model == null)
        {
            <div class="form-group" style="margin-bottom:20px;">
                <label class="form-label">Nombre identificador del PC <span class="req">*</span></label>
                <input type="text" name="nombrePc" class="form-control" required
                       placeholder="Ej: PC-CONTABILIDAD-01, PC-RECEPCION-02" />
            </div>
        }
        else
        {
            <div style="margin-bottom:20px; padding:12px 16px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200);">
                <div style="font-size:0.75rem; color:var(--gris-400); text-transform:uppercase; letter-spacing:0.06em;">PC Completo</div>
                <div style="font-weight:700; color:var(--gris-900);">@Model.NombrePc</div>
            </div>

            @if (Model.Componentes.Any())
            {
                <div style="margin-bottom:20px;">
                    <div class="form-label" style="margin-bottom:8px;">Componentes actuales</div>
                    <div style="display:flex; flex-direction:column; gap:6px;">
                        @foreach (var c in Model.Componentes)
                        {
                            <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 12px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200); font-size:0.85rem;">
                                <span><strong>@(c.TipoEquipo?.tipo ?? "—")</strong> — @Etiqueta(c)</span>
                                <button type="submit" formaction="@Url.Action("QuitarComponentePc")" formmethod="post"
                                        name="idEquipoComponente" value="@c.idEquipo"
                                        class="btn btn--rojo btn--sm"
                                        onclick="return confirm('¿Quitar este componente del PC? Volverá a inventario suelto.')">
                                    Quitar
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        }

        <div class="form-group" style="margin-bottom:14px;">
            <label class="form-label">CPU disponible</label>
            <select name="idCpu" class="form-control">
                <option value="">— No agregar / sin cambio —</option>
                @foreach (var e in cpus)
                {
                    <option value="@e.idEquipo">@Etiqueta(e)</option>
                }
            </select>
        </div>

        <div class="form-group" style="margin-bottom:14px;">
            <label class="form-label">Monitor disponible</label>
            <select name="idMonitor" class="form-control">
                <option value="">— No agregar / sin cambio —</option>
                @foreach (var e in monitors)
                {
                    <option value="@e.idEquipo">@Etiqueta(e)</option>
                }
            </select>
        </div>

        <div class="form-group" style="margin-bottom:14px;">
            <label class="form-label">Mouse disponible</label>
            <select name="idMouse" class="form-control">
                <option value="">— No agregar / sin cambio —</option>
                @foreach (var e in mice)
                {
                    <option value="@e.idEquipo">@Etiqueta(e)</option>
                }
            </select>
        </div>

        <div class="form-group" style="margin-bottom:20px;">
            <label class="form-label">Teclado disponible</label>
            <select name="idTeclado" class="form-control">
                <option value="">— No agregar / sin cambio —</option>
                @foreach (var e in teclados)
                {
                    <option value="@e.idEquipo">@Etiqueta(e)</option>
                }
            </select>
        </div>

        @if (!cpus.Any() && !monitors.Any() && !mice.Any() && !teclados.Any())
        {
            <div class="alert alert--warning" style="margin-bottom:16px;">
                No hay componentes sueltos disponibles. Registra primero un CPU,
                Monitor, Mouse o Teclado en <a asp-action="Create">Equipos → Nuevo</a>.
            </div>
        }

        <button type="submit" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            Guardar
        </button>
    </form>
</div>
