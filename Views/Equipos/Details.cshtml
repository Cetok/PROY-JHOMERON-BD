@model PROYJHOME2026.Models.Equipo
@{
    ViewData["Title"]      = "Detalle Equipo";
    ViewData["Breadcrumb"] = "Equipos TI / Detalle";
    var tipoStr    = Model.TipoEquipo?.tipo?.ToUpper() ?? "";
    var esTecnico  = new[] { "CPU", "LAPTOP" }.Contains(tipoStr);
    var esLaptop   = tipoStr == "LAPTOP";
    var esPcCompleto = tipoStr == "PC COMPLETO";
    var ebc = Model.estado_equipo switch {
        "Activo"        => "badge--verde",
        "Asignado"      => "badge--azul",
        "Mantenimiento" => "badge--amarillo",
        "Devuelto"      => "badge--gris",
        _               => "badge--rojo"
    };
    var asigActiva = Model.Asignaciones.FirstOrDefault(a =>
        a.EstadoAsignacion == "Activo" || a.EstadoAsignacion == "Asignado");
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Equipos TI</div>
        @if (Model.TipoEquipo != null)
        {
            <div style="margin-bottom:4px;">
                <span class="badge badge--azul" style="font-size:0.72rem;">@Model.TipoEquipo.tipo</span>
            </div>
        }
        <h1 class="page-header__title" style="color:var(--azul);">@Model.marca @Model.modelo</h1>
        <p class="page-header__subtitle" style="font-family:monospace; letter-spacing:0.06em;">
            @(esPcCompleto ? (Model.NombrePc ?? "Sin nombre") : (Model.numero_serie ?? "Sin serie"))
        </p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.idEquipo" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Editar
        </a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:1000px; display:flex; flex-direction:column; gap:16px;">

    <!-- DATOS GENERALES -->
    <div class="card">
        <div style="display:flex; align-items:center; gap:14px; margin-bottom:22px; padding-bottom:16px; border-bottom:1px solid var(--gris-200);">
            <div class="equipo-icon-lg">
                <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            </div>
            <div>
                <div style="font-size:1.1rem; font-weight:800; color:var(--azul-dark);">@Model.marca @Model.modelo</div>
                <div style="font-size:0.82rem; color:var(--gris-500); margin-top:2px;">@(Model.TipoEquipo?.tipo ?? "—") · @(esPcCompleto ? (Model.NombrePc ?? "Sin nombre") : (Model.numero_serie ?? "Sin serie"))</div>
                <div style="margin-top:6px;"><span class="badge @ebc">@Model.estado_equipo</span></div>
            </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px;">
            <div class="det-field"><div class="det-label">Tipo</div><div class="det-value">@(Model.TipoEquipo?.tipo ?? "—")</div></div>
            @if (!esPcCompleto) {
                <div class="det-field"><div class="det-label">Marca</div><div class="det-value">@(Model.marca ?? "—")</div></div>
                <div class="det-field"><div class="det-label">Modelo</div><div class="det-value">@(Model.modelo ?? "—")</div></div>
                <div class="det-field"><div class="det-label">N° Serie</div><div class="det-value" style="font-family:monospace;">@(Model.numero_serie ?? "—")</div></div>
            }
            <div class="det-field"><div class="det-label">Fecha de compra</div><div class="det-value">@Model.fecha_compra.ToString("dd/MM/yyyy")</div></div>
            <div class="det-field"><div class="det-label">Estado</div><div class="det-value"><span class="badge @ebc">@Model.estado_equipo</span></div></div>

            @if (!string.IsNullOrEmpty(Model.sistema_operativo) && !esPcCompleto)
            {
                <div class="det-field"><div class="det-label">Sistema operativo</div><div class="det-value">@Model.sistema_operativo @Model.version</div></div>
            }

            @if (esTecnico)
            {
                @if (!string.IsNullOrEmpty(Model.Procesador)) { <div class="det-field"><div class="det-label">Procesador</div><div class="det-value">@Model.Procesador</div></div> }
                @if (!string.IsNullOrEmpty(Model.TarjetaMadre)) { <div class="det-field"><div class="det-label">Tarjeta madre</div><div class="det-value">@Model.TarjetaMadre</div></div> }
                @if (!string.IsNullOrEmpty(Model.Ram)) { <div class="det-field"><div class="det-label">RAM</div><div class="det-value">@Model.Ram</div></div> }
                @if (!string.IsNullOrEmpty(Model.Disco)) { <div class="det-field"><div class="det-label">Disco</div><div class="det-value">@Model.Disco</div></div> }
                @if (esLaptop) {
                    <div class="det-field"><div class="det-label">Cargador</div><div class="det-value" style="color:#16a34a; font-weight:600;">✓ Incluido</div></div>
                } else if (!string.IsNullOrEmpty(Model.FuenteEnergia)) {
                    <div class="det-field"><div class="det-label">Fuente de energía</div><div class="det-value">@Model.FuenteEnergia</div></div>
                }
                @if (Model.GraficosIntegrados.HasValue) {
                    <div class="det-field">
                        <div class="det-label">Gráficos</div>
                        <div class="det-value">
                            @if (Model.GraficosIntegrados == true) { <span>Integrados</span> }
                            else { <span>Dedicada — @(Model.TarjetaGrafica ?? "—")</span> }
                        </div>
                    </div>
                }
            }

            @if (tipoStr == "CELULAR" && !string.IsNullOrEmpty(Model.IMEI))
            {
                <div class="det-field"><div class="det-label">IMEI</div><div class="det-value" style="font-family:monospace;">@Model.IMEI</div></div>
            }

            @if (tipoStr == "MOUSE" && Model.EsInalambrico.HasValue)
            {
                <div class="det-field"><div class="det-label">Tipo</div><div class="det-value">@(Model.EsInalambrico == true ? "Inalámbrico" : "Con cable")</div></div>
            }

            @if (!string.IsNullOrEmpty(Model.Observaciones))
            {
                <div class="det-field" style="grid-column:1/-1;">
                    <div class="det-label">Observaciones</div>
                    <div class="det-value" style="background:var(--gris-50); padding:8px 12px; border-radius:var(--r-sm); border:1px solid var(--gris-200);">@Model.Observaciones</div>
                </div>
            }
        </div>
    </div>

    <!-- PC COMPLETO: tarjetas por componente -->
    @if (esPcCompleto)
    {
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">

            <!-- CPU -->
            <div class="card">
                <div class="comp-header" style="border-color:#3b82f6;">
                    <svg viewBox="0 0 24 24" style="stroke:#3b82f6;"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
                    <span>CPU</span>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:12px;">
                    <div class="det-field"><div class="det-label">Marca</div><div class="det-value">@(Model.PcCpuMarca ?? "—")</div></div>
                    <div class="det-field"><div class="det-label">Modelo</div><div class="det-value">@(Model.PcCpuModelo ?? "—")</div></div>
                    <div class="det-field" style="grid-column:1/-1;"><div class="det-label">N° Serie</div><div class="det-value" style="font-family:monospace;">@(Model.PcCpuSerie ?? "—")</div></div>
                    @if (!string.IsNullOrEmpty(Model.PcCpuProcesador)) { <div class="det-field"><div class="det-label">Procesador</div><div class="det-value">@Model.PcCpuProcesador</div></div> }
                    @if (!string.IsNullOrEmpty(Model.PcCpuTarjetaMadre)) { <div class="det-field"><div class="det-label">Tarjeta madre</div><div class="det-value">@Model.PcCpuTarjetaMadre</div></div> }
                    @if (!string.IsNullOrEmpty(Model.PcCpuRam)) { <div class="det-field"><div class="det-label">RAM</div><div class="det-value">@Model.PcCpuRam</div></div> }
                    @if (!string.IsNullOrEmpty(Model.PcCpuDisco)) { <div class="det-field"><div class="det-label">Disco</div><div class="det-value">@Model.PcCpuDisco</div></div> }
                    @if (!string.IsNullOrEmpty(Model.PcCpuFuenteEnergia)) { <div class="det-field"><div class="det-label">Fuente</div><div class="det-value">@Model.PcCpuFuenteEnergia</div></div> }
                    @if (Model.PcCpuGraficosIntegrados.HasValue) {
                        <div class="det-field"><div class="det-label">Gráficos</div><div class="det-value">@(Model.PcCpuGraficosIntegrados == true ? "Integrados" : $"Dedicada — {Model.PcCpuTarjetaGrafica ?? "—"}")</div></div>
                    }
                    @if (!string.IsNullOrEmpty(Model.PcCpuSistemaOperativo)) { <div class="det-field"><div class="det-label">Sistema oper.</div><div class="det-value">@Model.PcCpuSistemaOperativo @Model.PcCpuVersionSO</div></div> }
                </div>
            </div>

            <!-- Monitor -->
            <div class="card">
                <div class="comp-header" style="border-color:#8b5cf6;">
                    <svg viewBox="0 0 24 24" style="stroke:#8b5cf6;"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                    <span>Monitor</span>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:12px;">
                    <div class="det-field"><div class="det-label">Marca</div><div class="det-value">@(Model.PcMonitorMarca ?? "—")</div></div>
                    <div class="det-field"><div class="det-label">Modelo</div><div class="det-value">@(Model.PcMonitorModelo ?? "—")</div></div>
                    <div class="det-field" style="grid-column:1/-1;"><div class="det-label">N° Serie</div><div class="det-value" style="font-family:monospace;">@(Model.PcMonitorSerie ?? "—")</div></div>
                </div>
            </div>

            <!-- Mouse -->
            <div class="card">
                <div class="comp-header" style="border-color:#10b981;">
                    <svg viewBox="0 0 24 24" style="stroke:#10b981;"><rect x="5" y="2" width="14" height="20" rx="7"/><line x1="12" y1="2" x2="12" y2="10"/></svg>
                    <span>Mouse</span>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:12px;">
                    <div class="det-field"><div class="det-label">Marca</div><div class="det-value">@(Model.PcMouseMarca ?? "—")</div></div>
                    <div class="det-field"><div class="det-label">Modelo</div><div class="det-value">@(Model.PcMouseModelo ?? "—")</div></div>
                    <div class="det-field"><div class="det-label">N° Serie</div><div class="det-value" style="font-family:monospace;">@(Model.PcMouseSerie ?? "—")</div></div>
                    @if (Model.PcMouseEsInalambrico.HasValue) {
                        <div class="det-field"><div class="det-label">Tipo</div><div class="det-value">@(Model.PcMouseEsInalambrico == true ? "Inalámbrico" : "Con cable")</div></div>
                    }
                </div>
            </div>

            <!-- Teclado -->
            <div class="card">
                <div class="comp-header" style="border-color:#f59e0b;">
                    <svg viewBox="0 0 24 24" style="stroke:#f59e0b;"><rect x="2" y="6" width="20" height="12" rx="2"/><line x1="6" y1="10" x2="6" y2="10"/><line x1="10" y1="10" x2="10" y2="10"/><line x1="14" y1="10" x2="14" y2="10"/><line x1="18" y1="10" x2="18" y2="10"/><line x1="6" y1="14" x2="18" y2="14"/></svg>
                    <span>Teclado</span>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:12px;">
                    <div class="det-field"><div class="det-label">Marca</div><div class="det-value">@(Model.PcTecladoMarca ?? "—")</div></div>
                    <div class="det-field"><div class="det-label">Modelo</div><div class="det-value">@(Model.PcTecladoModelo ?? "—")</div></div>
                    <div class="det-field" style="grid-column:1/-1;"><div class="det-label">N° Serie</div><div class="det-value" style="font-family:monospace;">@(Model.PcTecladoSerie ?? "—")</div></div>
                </div>
            </div>

            <!-- Mousepad -->
            <div class="card">
                <div class="comp-header" style="border-color:#6b7280;">
                    <svg viewBox="0 0 24 24" style="stroke:#6b7280;"><rect x="3" y="5" width="18" height="14" rx="3"/></svg>
                    <span>Mousepad</span>
                </div>
                <div style="margin-top:12px;">
                    <div class="det-field"><div class="det-label">Marca</div><div class="det-value">@(Model.PcMousepadMarca ?? "—")</div></div>
                </div>
            </div>

        </div>
    }

    <!-- MANTENIMIENTO + CAMBIO DE COMPONENTE (CPU / Laptop) -->
    @if (esTecnico)
    {
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
            <!-- Cambio de componente -->
            <div class="card">
                <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900); margin-bottom:14px; padding-bottom:10px; border-bottom:1px solid var(--gris-200);">
                    <svg viewBox="0 0 24 24" style="width:15px;height:15px;stroke:var(--celeste);fill:none;stroke-width:2;vertical-align:middle;margin-right:5px;"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    Cambio de componente
                </div>
                <form asp-action="CambiarComponente" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idEquipo" value="@Model.idEquipo" />
                    <div class="form-group" style="margin-bottom:10px;">
                        <label class="form-label">Componente <span class="req">*</span></label>
                        <select name="componente" class="form-control" required>
                            <option value="">— Seleccionar —</option>
                            <option value="Procesador">Procesador</option>
                            <option value="TarjetaMadre">Tarjeta madre</option>
                            <option value="Ram">RAM</option>
                            <option value="Disco">Disco</option>
                            <option value="FuenteEnergia">@(esLaptop ? "Cargador" : "Fuente de energía")</option>
                            <option value="TarjetaGrafica">Tarjeta gráfica</option>
                            <option value="SistemaOperativo">Sistema operativo</option>
                            <option value="Version">Versión SO</option>
                        </select>
                    </div>
                    <div class="form-group" style="margin-bottom:10px;">
                        <label class="form-label">Nuevo valor <span class="req">*</span></label>
                        <input type="text" name="valorNuevo" class="form-control" required placeholder="Ej: 32 GB DDR4..." />
                    </div>
                    <div class="form-group" style="margin-bottom:12px;">
                        <label class="form-label">Motivo / observación</label>
                        <input type="text" name="observaciones" class="form-control" maxlength="500" placeholder="Ej: Falla de hardware..." />
                    </div>
                    <button type="submit" class="btn btn--celeste btn--sm">
                        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                        Registrar cambio
                    </button>
                </form>
            </div>

            <!-- Mantenimiento -->
            @await Html.PartialAsync("_MantenimientoEquipo", Model)
        </div>
    }
    else
    {
        <!-- Para todos los demás tipos: solo mantenimiento -->
        <div style="max-width:480px;">
            @await Html.PartialAsync("_MantenimientoEquipo", Model)
        </div>
    }

    <!-- HISTORIAL DE CAMBIOS (solo CPU/Laptop/PC Completo) -->
    @if (Model.ComponenteLogs.Any())
    {
        <div class="card" style="padding:0; overflow:hidden;">
            <div style="padding:16px 20px; border-bottom:1px solid var(--gris-200);">
                <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">Historial de cambios</div>
                <div style="font-size:0.78rem; color:var(--gris-400); margin-top:2px;">Componentes, mantenimientos y actualizaciones</div>
            </div>
            <div class="table-wrapper" style="border:none; border-radius:0;">
                <table>
                    <thead>
                        <tr>
                            <th>Fecha / Hora</th>
                            <th>Tipo</th>
                            <th>Componente</th>
                            <th>Anterior</th>
                            <th>Nuevo</th>
                            <th>Observación</th>
                            <th>Usuario</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.ComponenteLogs)
                        {
                            var logColor = log.TipoEvento switch {
                                "CambioComponente" => "badge--azul",
                                "Mantenimiento"    => "badge--amarillo",
                                "ActualizacionSO"  => "badge--celeste",
                                _                  => "badge--gris"
                            };
                            <tr>
                                <td style="font-size:0.78rem; color:var(--gris-500); white-space:nowrap;">@log.FechaHora.ToString("dd/MM/yy HH:mm")</td>
                                <td><span class="badge @logColor" style="font-size:0.7rem;">@log.TipoEvento</span></td>
                                <td style="font-size:0.82rem; font-weight:500;">@(log.Componente ?? "—")</td>
                                <td style="font-size:0.78rem; color:var(--gris-500);">@(log.ValorAnterior ?? "—")</td>
                                <td style="font-size:0.82rem; font-weight:500; color:var(--azul);">@(log.ValorNuevo ?? "—")</td>
                                <td style="font-size:0.78rem; color:var(--gris-600);">@(log.Observaciones ?? "—")</td>
                                <td style="font-size:0.75rem; color:var(--gris-400);">@(log.NombreUsuario ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ASIGNACIONES -->
    <div class="card" style="padding:0; overflow:hidden;">
        <div style="padding:16px 20px; border-bottom:1px solid var(--gris-200); display:flex; justify-content:space-between; align-items:center;">
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">Historial de asignaciones</div>
            <span class="badge badge--azul">@Model.Asignaciones.Count</span>
        </div>
        @if (Model.Asignaciones.Any())
        {
            <div class="table-wrapper" style="border:none; border-radius:0;">
                <table>
                    <thead><tr><th>Empleado</th><th>Fecha asignación</th><th>Estado</th><th>Último evento</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var a in Model.Asignaciones.OrderByDescending(x => x.FechaAsignacion))
                        {
                            var abc = a.EstadoAsignacion switch {
                                "Activo"           => "badge--verde",
                                "Asignado"         => "badge--azul",
                                "En mantenimiento" => "badge--amarillo",
                                "Devuelto"         => "badge--gris",
                                _                  => "badge--rojo"
                            };
                            var ultimoHist = a.Historiales.OrderByDescending(h => h.Fecha).FirstOrDefault();
                            <tr>
                                <td>@(a.Empleado?.nombre ?? "—") @(a.Empleado?.paterno ?? "")</td>
                                <td style="font-size:0.8rem; color:var(--gris-500);">@a.FechaAsignacion.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge @abc">@a.EstadoAsignacion</span></td>
                                <td style="font-size:0.78rem; color:var(--gris-500);">
                                    @if (ultimoHist != null) { <span>@ultimoHist.Motivo?.TipoMotivo — @ultimoHist.Fecha.ToString("dd/MM/yy")</span> }
                                    else { <span>—</span> }
                                </td>
                                <td>
                                    <a asp-controller="Asignaciones" asp-action="Details" asp-route-id="@a.IdAsignacion"
                                       class="btn btn--ghost btn--icon btn--sm">
                                        <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else { <div style="text-align:center; padding:20px; color:var(--gris-400); font-size:0.82rem;">Sin asignaciones registradas.</div> }
    </div>
    @{
    var historial = ViewBag.HistorialCambios as List<PROYJHOME2026.Models.AuditoriaLog>;
}

@if (historial != null && historial.Any())
{
    <div class="card" style="padding:0; overflow:hidden; margin-top:16px;">
        <div style="padding:14px 20px; border-bottom:1px solid var(--gris-200); display:flex; justify-content:space-between; align-items:center;">
            <span style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                📋 Historial de cambios
            </span>
            <span class="badge badge--gris">@historial.Count registro(s)</span>
        </div>
        <div class="table-wrapper" style="border:none; border-radius:0; max-height:380px; overflow-y:auto;">
            <table>
                <thead>
                    <tr>
                        <th>Fecha / Hora</th>
                        <th>Acción</th>
                        <th>Descripción / Cambio</th>
                        <th>Datos anteriores</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in historial)
                    {
                        string accionColor;
                        if      (log.Accion == "Crear")        accionColor = "badge--verde";
                        else if (log.Accion == "Editar")       accionColor = "badge--azul";
                        else if (log.Accion == "Eliminar")     accionColor = "badge--rojo";
                        else if (log.Accion == "CambioEstado") accionColor = "badge--amarillo";
                        else                                    accionColor = "badge--gris";

                        <tr>
                            <td style="font-size:0.75rem; color:var(--gris-400); white-space:nowrap;">
                                @log.FechaHora.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                <span class="badge @accionColor" style="font-size:0.68rem;">@log.Accion</span>
                            </td>
                            <td style="font-size:0.8rem; color:var(--gris-800); max-width:280px;">
                                @(log.Descripcion ?? "—")
                            </td>
                            <td style="font-size:0.75rem; color:var(--gris-500); max-width:200px;">
                                @if (!string.IsNullOrEmpty(log.DatosAnteriores))
                                {
                                    <span title="@log.DatosAnteriores" style="cursor:help; text-decoration:underline dotted;">
                                        @(log.DatosAnteriores.Length > 60 ? log.DatosAnteriores[..60] + "..." : log.DatosAnteriores)
                                    </span>
                                }
                                else
                                {
                                    <span style="color:var(--gris-300);">—</span>
                                }
                            </td>
                            <td style="font-size:0.75rem; color:var(--azul);">
                                @(log.NombreUsuario ?? "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (historial != null)
{
    <div style="margin-top:16px; padding:14px 20px; background:var(--gris-50); border-radius:var(--r-md); border:1px solid var(--gris-200); font-size:0.82rem; color:var(--gris-400);">
        📋 Sin historial de cambios registrado.
    </div>
}

</div>

@section Styles {
<style>
.equipo-icon-lg { width:52px; height:52px; border-radius:var(--r-md); background:linear-gradient(135deg, var(--azul-dark), var(--azul-mid)); display:grid; place-items:center; flex-shrink:0; box-shadow:0 4px 14px rgba(26,58,107,0.25); }
.equipo-icon-lg svg { width:24px; height:24px; stroke:var(--blanco); fill:none; stroke-width:1.6; stroke-linecap:round; }
.det-label { font-size:0.67rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px; }
.det-value { font-size:0.88rem; font-weight:500; color:var(--gris-900); }
.comp-header { display:flex; align-items:center; gap:8px; padding-bottom:10px; border-bottom:2px solid; font-weight:700; font-size:0.9rem; color:var(--gris-900); }
.comp-header svg { width:16px; height:16px; fill:none; stroke-width:1.8; stroke-linecap:round; flex-shrink:0; }
</style>
}
