@model PROYJHOME2026.Models.Equipo
@{
    ViewData["Title"]      = "Nuevo Equipo";
    ViewData["Breadcrumb"] = "Equipos / Nuevo";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Equipos TI</div>
        <h1 class="page-header__title">Nuevo Equipo</h1>
        <p class="page-header__subtitle">Registra un equipo en el inventario</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:680px;">
    <div class="card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <!-- Identificación -->
            <div style="margin-bottom:24px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Identificación
                </p>
                <div class="form-grid">
                    <div class="form-group form-group--full">
                        <label class="form-label">Tipo de equipo <span class="req">*</span></label>
                        <select asp-for="idTipoEquipo" asp-items="ViewBag.TiposList" class="form-control">
                            <option value="">— Seleccionar tipo —</option>
                        </select>
                        <span asp-validation-for="idTipoEquipo" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Marca <span class="req">*</span></label>
                        <input asp-for="marca" class="form-control" placeholder="Ej: Dell, HP, Lenovo..." />
                        <span asp-validation-for="marca" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Modelo <span class="req">*</span></label>
                        <input asp-for="modelo" class="form-control" placeholder="Ej: Latitude 5520..." />
                        <span asp-validation-for="modelo" class="form-error"></span>
                    </div>
                    <div class="form-group form-group--full">
                        <label class="form-label">Número de serie</label>
                        <input asp-for="numero_serie" class="form-control" placeholder="Ej: SN-2024-001" />
                        <span asp-validation-for="numero_serie" class="form-error"></span>
                        <div class="form-hint">Debe ser único en el sistema.</div>
                    </div>
                </div>
            </div>

            <!-- Software -->
            <div style="margin-bottom:24px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Software
                </p>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Sistema operativo</label>
                        <input asp-for="sistema_operativo" class="form-control" placeholder="Ej: Windows 11..." />
                        <span asp-validation-for="sistema_operativo" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Versión</label>
                        <input asp-for="version" class="form-control" placeholder="Ej: 22H2" />
                        <span asp-validation-for="version" class="form-error"></span>
                    </div>
                </div>
            </div>

            <!-- Compra -->
            <div style="margin-bottom:28px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Compra
                </p>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Fecha de compra <span class="req">*</span></label>
                        <input asp-for="fecha_compra" type="date" class="form-control" />
                        <span asp-validation-for="fecha_compra" class="form-error"></span>
                    </div>
                </div>
                <div class="form-hint" style="margin-top:8px;">
                    <svg style="width:13px;height:13px;stroke:var(--celeste);fill:none;stroke-width:2;vertical-align:middle;" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    El equipo se registra como <strong>Activo</strong> automáticamente. Su estado cambia cuando se registra un evento en el historial de su asignación.
                </div>
                <input asp-for="estado_equipo" type="hidden" value="Activo" />
            </div>

            <div style="display:flex; gap:10px; padding-top:4px; border-top:1px solid var(--gris-200);">
                <button type="submit" class="btn btn--celeste btn--lg">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    Registrar equipo
                </button>
                <a asp-action="Index" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
