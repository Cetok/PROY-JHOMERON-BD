@model PROYJHOME2026.Models.Equipo
@{
    ViewData["Title"]      = "Editar Equipo";
    ViewData["Breadcrumb"] = "Equipos TI / Editar";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Equipos TI</div>
        <h1 class="page-header__title">Editar Equipo</h1>
        <p class="page-header__subtitle">@Model.marca @Model.modelo</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Details" asp-route-id="@Model.idEquipo" class="btn btn--ghost btn--sm">
            <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            Ver detalle
        </a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:780px;">
    <div class="card">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="idEquipo" type="hidden" />

            <!-- Identificación -->
            <div style="margin-bottom:24px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Identificación
                </p>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Tipo de equipo <span class="req">*</span></label>
                        <select asp-for="idTipoEquipo" asp-items="ViewBag.TiposList" class="form-control">
                            <option value="">— Seleccionar tipo —</option>
                        </select>
                        <span asp-validation-for="idTipoEquipo" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">N° de serie</label>
                        <input asp-for="numero_serie" class="form-control" />
                        <span asp-validation-for="numero_serie" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Marca <span class="req">*</span></label>
                        <input asp-for="marca" class="form-control" />
                        <span asp-validation-for="marca" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Modelo <span class="req">*</span></label>
                        <input asp-for="modelo" class="form-control" />
                        <span asp-validation-for="modelo" class="form-error"></span>
                    </div>
                </div>
            </div>

            <!-- Software -->
            <div style="margin-bottom:24px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Software
                </p>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Sistema operativo</label>
                        <input asp-for="sistema_operativo" class="form-control" />
                        <span asp-validation-for="sistema_operativo" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Versión</label>
                        <input asp-for="version" class="form-control" />
                        <span asp-validation-for="version" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Correo del equipo</label>
                        <input asp-for="correo_equipo" type="email" class="form-control" />
                        <span asp-validation-for="correo_equipo" class="form-error"></span>
                    </div>
                </div>
            </div>

            <!-- Estado y fecha -->
            <div style="margin-bottom:28px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Estado y adquisición
                </p>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Estado <span class="req">*</span></label>
                        <select asp-for="estado_equipo" class="form-control">
                            <option value="">— Seleccionar —</option>
                            <option value="Activo">Activo</option>
                            <option value="Inactivo">Inactivo</option>
                            <option value="En reparación">En reparación</option>
                            <option value="De baja">De baja</option>
                        </select>
                        <span asp-validation-for="estado_equipo" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Fecha de compra <span class="req">*</span></label>
                        <input asp-for="fecha_compra" type="date" class="form-control" />
                        <span asp-validation-for="fecha_compra" class="form-error"></span>
                    </div>
                </div>
            </div>

            <div style="display:flex; gap:10px; padding-top:4px; border-top:1px solid var(--gris-200);">
                <button type="submit" class="btn btn--primary btn--lg">
                    <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v14a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    Guardar cambios
                </button>
                <a asp-action="Index" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
