@model PROYJHOME2026.Models.Equipo
@{
    ViewData["Title"]      = "Editar Equipo";
    ViewData["Breadcrumb"] = "Equipos / Editar";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Equipos TI</div>
        <h1 class="page-header__title">Editar Equipo</h1>
        <p class="page-header__subtitle">@Model.marca @Model.modelo</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Details" asp-route-id="@Model.idEquipo" class="btn btn--ghost btn--sm">Ver detalle</a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:760px;">
    <div class="card">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="idEquipo"     type="hidden" />
            <input asp-for="estado_equipo" type="hidden" />

            <!-- Información básica -->
            <div style="margin-bottom:24px;">
                <p class="form-section-title">Información básica</p>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Tipo de equipo <span class="req">*</span></label>
                        <select asp-for="idTipoEquipo" asp-items="ViewBag.TiposList"
                                class="form-control" id="selectTipo" onchange="toggleCamposTecnicos()">
                            <option value="">— Seleccionar tipo —</option>
                        </select>
                        <span asp-validation-for="idTipoEquipo" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Marca <span class="req">*</span></label>
                        <input asp-for="marca" class="form-control" />
                        <span asp-validation-for="marca" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Modelo <span class="req">*</span></label>
                        <input asp-for="modelo" class="form-control" />
                        <span asp-validation-for="modelo" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Número de serie</label>
                        <input asp-for="numero_serie" class="form-control" />
                        <span asp-validation-for="numero_serie" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Fecha de compra</label>
                        <input asp-for="fecha_compra" type="date" class="form-control" />
                        <span asp-validation-for="fecha_compra" class="form-error"></span>
                    </div>
                </div>
            </div>

            <!-- Campos técnicos CPU/Laptop (dinámicos) -->
            <div id="seccionTecnica" style="display:none; margin-bottom:24px;">
                <p class="form-section-title" id="tituloTecnico">Especificaciones técnicas</p>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Procesador</label>
                        <input asp-for="Procesador" class="form-control" placeholder="Ej: Intel Core i5-12400" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Tarjeta madre</label>
                        <input asp-for="TarjetaMadre" class="form-control" placeholder="Ej: ASUS B660M" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">RAM</label>
                        <input asp-for="Ram" class="form-control" placeholder="Ej: 16 GB DDR4" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Disco</label>
                        <input asp-for="Disco" class="form-control" placeholder="Ej: SSD 512 GB NVMe" />
                    </div>
                    <div class="form-group" id="campoFuente" style="display:none;">
                        <label class="form-label">Fuente de energía</label>
                        <input asp-for="FuenteEnergia" class="form-control"
                               placeholder="Ej: 600W 80 Plus Bronze" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Sistema operativo</label>
                        <input asp-for="sistema_operativo" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Versión</label>
                        <input asp-for="version" class="form-control" />
                    </div>
                </div>

                <!-- Gráficos -->
                <div style="margin-top:12px; padding:14px 16px; background:var(--gris-50); border:1px solid var(--gris-200); border-radius:var(--r-sm);">
                    <label class="form-label" style="margin-bottom:10px;">Gráficos</label>
                    <div style="display:flex; gap:20px; margin-bottom:12px;">
                        <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:0.88rem;">
                            <input type="radio" name="GraficosIntegrados" value="true"
                                   @(Model.GraficosIntegrados == true ? "checked" : "")
                                   onchange="toggleTarjetaGrafica()" style="accent-color:var(--azul);" />
                            Gráficos integrados
                        </label>
                        <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:0.88rem;">
                            <input type="radio" name="GraficosIntegrados" value="false"
                                   @(Model.GraficosIntegrados == false ? "checked" : "")
                                   onchange="toggleTarjetaGrafica()" style="accent-color:var(--azul);" />
                            Tarjeta gráfica dedicada
                        </label>
                    </div>
                    <div id="campoTarjetaGrafica" style="display:@(Model.GraficosIntegrados == false ? "block" : "none");">
                        <label class="form-label">Tarjeta gráfica</label>
                        <input asp-for="TarjetaGrafica" class="form-control" />
                    </div>
                </div>
            </div>

            <!-- Campos SO para otros tipos (no CPU/Laptop) -->
            <div id="seccionSO" style="display:none; margin-bottom:24px;">
                <p class="form-section-title">Software</p>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Sistema operativo</label>
                        <input asp-for="sistema_operativo" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Versión</label>
                        <input asp-for="version" class="form-control" />
                    </div>
                </div>
            </div>


                    <!-- ── CELULAR: IMEI + SO ──────────────────── -->
                    <div id="campoCelular" style="display:none;">
                        <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                            Datos del celular
                        </p>
                        <div class="form-grid">
                            <div class="form-group">
                                <label class="form-label">IMEI</label>
                                <input asp-for="IMEI" class="form-control" placeholder="Ej: 353123450000001" maxlength="50" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Sistema operativo</label>
                                <input asp-for="sistema_operativo" id="soCelular" class="form-control" placeholder="Ej: Android, iOS" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Versión</label>
                                <input asp-for="version" id="versionCelular" class="form-control" placeholder="Ej: Android 14, iOS 17" />
                            </div>
                        </div>
                    </div>

                    <!-- ── MOUSE ────────────────────────────────── -->
                    <div id="campoMouse" style="display:none;">
                        <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                            Datos del mouse
                        </p>
                        <div class="form-grid">
                            <div class="form-group">
                                <label class="form-label">¿Es inalámbrico?</label>
                                <div style="display:flex; gap:20px; margin-top:8px;">
                                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:0.88rem;">
                                        <input type="radio" name="EsInalambrico" value="true"
                                               @(Model?.EsInalambrico == true ? "checked" : "")
                                               style="accent-color:var(--azul);" />
                                        Sí, inalámbrico
                                    </label>
                                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:0.88rem;">
                                        <input type="radio" name="EsInalambrico" value="false"
                                               @(Model?.EsInalambrico == false ? "checked" : "")
                                               style="accent-color:var(--azul);" />
                                        Con cable
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
            <!-- Observaciones (todos) -->
            <div style="margin-bottom:24px;">
                <p class="form-section-title">Observaciones</p>
                <div class="form-group">
                    <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="1000"
                              placeholder="Estado del equipo, si es nuevo, condición, detalles adicionales..."></textarea>
                </div>
            </div>

            <div style="display:flex; gap:10px; padding-top:4px; border-top:1px solid var(--gris-200);">
                <button type="submit" class="btn btn--celeste btn--lg">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    Guardar cambios
                </button>
                <a asp-action="Details" asp-route-id="@Model.idEquipo" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Styles {
<style>
.form-section-title {
    font-family:var(--font-display); font-size:0.72rem; font-weight:700;
    letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste);
    margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);
}
</style>
}

@section Scripts {
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
<script>
const TIPOS_TECNICOS = ['CPU', 'LAPTOP'];

function getNombreTipo() {
    const sel = document.getElementById('selectTipo');
    return sel.options[sel.selectedIndex]?.text?.toUpperCase() ?? '';
}

function toggleCamposTecnicos() {
    const tipo     = getNombreTipo();
    const esTec    = TIPOS_TECNICOS.some(t => tipo.includes(t));
    const esLaptop = tipo.includes('LAPTOP');

    document.getElementById('seccionTecnica').style.display = esTec  ? 'block' : 'none';
    document.getElementById('seccionSO').style.display      = !esTec ? 'block' : 'none';

    if (esTec) {
        const labelFuente = document.getElementById('labelFuente');
        const inputFuente = document.getElementById('inputFuente');
        if (esLaptop) {
            labelFuente.textContent    = 'Cargador';
            inputFuente.placeholder    = 'Ej: Incluido 65W, No incluido';
        } else {
            labelFuente.textContent    = 'Fuente de energía';
            inputFuente.placeholder    = 'Ej: 600W 80 Plus Bronze';
        }
        toggleTarjetaGrafica();
    }
}

function toggleTarjetaGrafica() {
    const dedicada = document.querySelector('input[name="GraficosIntegrados"]:checked')?.value === 'false';
    document.getElementById('campoTarjetaGrafica').style.display = dedicada ? 'block' : 'none';
    if (!dedicada) document.querySelector('[name="TarjetaGrafica"]').value = '';
}

document.addEventListener('DOMContentLoaded', () => { toggleCamposTecnicos(); });
</script>
}
