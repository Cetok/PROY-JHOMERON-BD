<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Jhomeron</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
    /* Sidebar color override */
    .sidebar { background: #0d3393 !important; height: 100vh; overflow: hidden; }
    .sidebar__nav { flex: 1; overflow-y: auto; min-height: 0; }
    .sidebar__logo { border-bottom-color: rgba(255,255,255,0.08) !important; }
    .sidebar__section-label { color: rgba(255,255,255,0.35) !important; }
    .sidebar__link:hover, .sidebar__link.active { background: rgba(255,255,255,0.1) !important; }
    .sidebar__footer { border-top-color: rgba(255,255,255,0.08) !important; }
    .notif-wrapper { position:relative; }
    .notif-badge {
        position:absolute; top:-4px; right:-4px;
        min-width:18px; height:18px; border-radius:9px;
        background:var(--rojo, #dc2626); color:white;
        font-size:0.65rem; font-weight:700; line-height:18px;
        text-align:center; padding:0 4px;
        pointer-events:none; display:none;
    }
    .notif-panel {
        position:absolute; top:calc(100% + 8px); right:0;
        width:340px; background:white;
        border:1px solid var(--gris-200); border-radius:var(--r-md);
        box-shadow:0 8px 32px rgba(0,0,0,0.12);
        z-index:9999; display:none;
    }
    .notif-panel__header {
        display:flex; justify-content:space-between; align-items:center;
        padding:12px 16px; border-bottom:1px solid var(--gris-200);
    }
    .notif-panel__list { max-height:380px; overflow-y:auto; }
    .notif-panel__footer { padding:10px 16px; border-top:1px solid var(--gris-200); text-align:center; }
    .notif-item {
        display:flex; gap:10px; padding:12px 16px;
        border-bottom:1px solid var(--gris-100);
        transition:background 0.15s;
    }
    .notif-item:hover { background:var(--gris-50); }
    .notif-item--no-leida { background:rgba(26,58,107,0.03); }

    /* ── Button color overrides ── */
    .btn--primary, button[type="submit"].btn--primary {
        background: #0d3393 !important;
        color: white !important;
        border-color: #0d3393 !important;
    }
    .btn--primary:hover {
        background: #0a2570 !important;
        box-shadow: 0 4px 14px rgba(13,51,147,0.35) !important;
    }
    .btn--celeste {
        background: #0ea5e9 !important;
        color: white !important;
        border-color: #0ea5e9 !important;
    }
    .btn--celeste:hover {
        background: #0284c7 !important;
        box-shadow: 0 4px 14px rgba(14,165,233,0.4) !important;
    }
    </style>
</head>
<body>

<div class="layout">

    <aside class="sidebar" id="sidebar">

        <div class="sidebar__logo">
            <div class="sidebar__logo-icon" style="width:42px;height:42px;border-radius:10px;background:linear-gradient(135deg,#1a6bc4,#0ea5e9);display:grid;place-items:center;flex-shrink:0;box-shadow:0 4px 12px rgba(14,165,233,0.4);">
                <svg viewBox="0 0 24 24" style="width:22px;height:22px;stroke:white;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;">
                    <rect x="1" y="3" width="15" height="13" rx="2"/>
                    <path d="M16 8h4l3 3v5h-7V8z"/>
                    <circle cx="5.5" cy="18.5" r="2.5"/>
                    <circle cx="18.5" cy="18.5" r="2.5"/>
                </svg>
            </div>
            <div class="sidebar__logo-text">
                Jhomeron S.A
                <span>Panel de control</span>
            </div>
        </div>

         <nav class="sidebar__nav">
        @{
            var rolActual = Context.Session.GetString("UsuarioRol") ?? "";
            var esAdmin      = rolActual == "Admin";
            var esSoporteTI  = rolActual == "SoporteTI";
            var esTransporte = rolActual == "Transporte";
            var esProduccion = rolActual == "Produccion";
            var ctrl         = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        }

            <!-- PRINCIPAL — solo Admin ve el Dashboard principal -->
            @if (esAdmin)
            {
                <div class="sidebar__section">
                    <p class="sidebar__section-label">Principal</p>
                    <div class="sidebar__item">
                        <a class="sidebar__link @(ctrl == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">
                            <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            Dashboard
                        </a>
                    </div>
                </div>
            }

            <!-- RECURSOS HUMANOS — Admin ve todo, SoporteTI y Transporte solo empleados -->
            @if (esAdmin || esSoporteTI || esTransporte)
            {
                <div class="sidebar__section">
                    <p class="sidebar__section-label">Recursos Humanos</p>
                    <div class="sidebar__item">
                        <a class="sidebar__link @(ctrl == "Empleados" ? "active" : "")"
                           asp-controller="Empleados" asp-action="Index">
                            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
                            Empleados
                        </a>
                    </div>
                    @if (esAdmin)
                    {
                        <div class="sidebar__item">
                            <a class="sidebar__link @(ctrl == "Seguros" ? "active" : "")"
                               asp-controller="Seguros" asp-action="Index">
                                <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                Seguros
                            </a>
                        </div>
                        <div class="sidebar__item">
                            <a class="sidebar__link @(ctrl == "Asesorios" ? "active" : "")"
                               asp-controller="Asesorios" asp-action="Index">
                                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
                                Accesorios
                            </a>
                        </div>
                    }
                </div>
            }

            <!-- EQUIPOS TI — Admin y SoporteTI -->
            @if (esAdmin || esSoporteTI)
            {
                <div class="sidebar__section">
                    <p class="sidebar__section-label">Equipos TI</p>
                    <div class="sidebar__item">
                        <a class="sidebar__link @(ctrl == "Equipos" ? "active" : "")"
                           asp-controller="Equipos" asp-action="Index">
                            <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                            Equipos
                        </a>
                    </div>
                    <div class="sidebar__item">
                        <a class="sidebar__link @(ctrl == "Chips" ? "active" : "")"
                           asp-controller="Chips" asp-action="Index">
                            <svg viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 9h6v6H9z"/><path d="M9 1v4M15 1v4M9 19v4M15 19v4M1 9h4M1 15h4M19 9h4M19 15h4"/></svg>
                            Chips / SIM
                        </a>
                    </div>
                    <div class="sidebar__item">
                        <a class="sidebar__link @(ctrl == "Asignaciones" ? "active" : "")"
                           asp-controller="Asignaciones" asp-action="Index">
                            <svg viewBox="0 0 24 24"><path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M9 12l2 2 4-4"/></svg>
                            Asignaciones
                        </a>
                    </div>
                    <div class="sidebar__item">
                        <a class="sidebar__link @(ctrl == "Historiales" ? "active" : "")"
                           asp-controller="Historiales" asp-action="Index">
                            <svg viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            Historial de Equipos
                        </a>
                    </div>
                </div>
            }
            @if (esAdmin || rolActual == "Produccion")
            {
                <div class="sidebar__section">
                    <p class="sidebar__section-label">Producción</p>
                    <div class="sidebar__item">
                        <a class="sidebar__link @(ctrl == "Maquinas" ? "active" : "")"
                           asp-controller="Maquinas" asp-action="Index">
                            <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/></svg>
                            Máquinas
                        </a>
                    </div>
                    <div class="sidebar__item">
                        <a class="sidebar__link @(ctrl == "MaquinaAsignaciones" ? "active" : "")"
                           asp-controller="MaquinaAsignaciones" asp-action="Index">
                            <svg viewBox="0 0 24 24"><path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M9 12l2 2 4-4"/></svg>
                            Asignaciones
                        </a>
                    </div>
                </div>
            }

            <!-- FLOTA VEHICULAR — Admin y Transporte -->
            @if (esAdmin || esTransporte)
            {
                <div class="sidebar__section">
                    <p class="sidebar__section-label">Flota Vehicular</p>
                    <div class="sidebar__item">
                        <a class="sidebar__link @(ctrl == "Carros" ? "active" : "")"
                           asp-controller="Carros" asp-action="Index">
                            <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                            Vehículos
                        </a>
                    </div>
                    <div class="sidebar__item">
                        <a class="sidebar__link @(ctrl == "MantenimientoCarros" ? "active" : "")"
                           asp-controller="MantenimientoCarros" asp-action="Index">
                            <svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
                            Mantenimiento
                        </a>
                    </div>
                    <div class="sidebar__item">
                        <a class="sidebar__link @(ctrl == "CarroEstadoLogs" ? "active" : "")"
                           asp-controller="CarroEstadoLogs" asp-action="Index">
                            <svg viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            Historial de Carros
                        </a>
                    </div>

                </div>
            }

            <!-- REPORTES — según rol -->
            @if (esAdmin || esSoporteTI)
            {
                <div class="sidebar__section">
                    <p class="sidebar__section-label">Reportes TI</p>
                    <div class="sidebar__item">
                        <a class="sidebar__link @(ctrl == "Reportes" && (ViewContext.RouteData.Values["action"]?.ToString() ?? "") != "Dashboard" && (ViewContext.RouteData.Values["action"]?.ToString() ?? "") != "DashboardFlota" ? "active" : "")"
                           asp-controller="Reportes" asp-action="Index">
                            <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/></svg>
                            Reportes
                        </a>
                    </div>
                    <div class="sidebar__item">
                        <a class="sidebar__link @(ctrl == "Reportes" && (ViewContext.RouteData.Values["action"]?.ToString() ?? "") == "Dashboard" ? "active" : "")"
                           asp-controller="Reportes" asp-action="Dashboard">
                            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                            Dashboard
                        </a>
                    </div>
                </div>
            }
            @if (esAdmin || esTransporte)
            {
                <div class="sidebar__section">
                    <p class="sidebar__section-label">Reportes Flota</p>
                    <div class="sidebar__item">
                        <a class="sidebar__link @(ctrl == "Reportes" && (ViewContext.RouteData.Values["action"]?.ToString() ?? "") == "IndexFlota" ? "active" : "")"
                           asp-controller="Reportes" asp-action="IndexFlota">
                            <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/></svg>
                            Reportes Flota
                        </a>
                    </div>
                    <div class="sidebar__item">
                        <a class="sidebar__link @(ctrl == "Reportes" && (ViewContext.RouteData.Values["action"]?.ToString() ?? "") == "DashboardFlota" ? "active" : "")"
                           asp-controller="Reportes" asp-action="DashboardFlota">
                            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                            Dashboard Flota
                        </a>
                    </div>
                </div>
            }
             @if (esAdmin || rolActual == "Produccion")
            {
                <div class="sidebar__section">
                    <p class="sidebar__section-label">Reportes Producción</p>
                    <div class="sidebar__item">
                        <a class="sidebar__link @(ctrl == "Reportes" && (ViewContext.RouteData.Values["action"]?.ToString() ?? "") == "IndexProduccion" ? "active" : "")"
                           asp-controller="Reportes" asp-action="IndexProduccion">
                            <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/></svg>
                            Reportes
                        </a>
                    </div>
                    <div class="sidebar__item">
                        <a class="sidebar__link @(ctrl == "Reportes" && (ViewContext.RouteData.Values["action"]?.ToString() ?? "") == "DashboardProduccion" ? "active" : "")"
                           asp-controller="Reportes" asp-action="DashboardProduccion">
                            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                            Dashboard
                        </a>
                    </div>
                </div>
            }
        </nav>

        <div class="sidebar__footer">
            @{
                var sesNombre   = Context.Session.GetString("UsuarioNombre")   ?? "Usuario";
                var sesUsername = Context.Session.GetString("UsuarioUsername") ?? "";
                var sesRol      = Context.Session.GetString("UsuarioRol")      ?? "";
                var initiales   = sesNombre.Length > 0
                    ? string.Concat(sesNombre.Split(' ').Take(2).Select(p => p[0].ToString().ToUpper()))
                    : "U";
            }
            <div class="sidebar__user">
                <div class="sidebar__avatar">@initiales</div>
                <div class="sidebar__user-info">
                    <div class="sidebar__user-name">@sesNombre</div>
                    <div class="sidebar__user-role">@sesRol</div>
                </div>
                <form asp-controller="Auth" asp-action="Logout" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" title="Cerrar sesión"
                            style="background:none; border:none; cursor:pointer; padding:4px; border-radius:6px; display:flex; align-items:center; transition:background 0.15s;"
                            onmouseover="this.style.background='rgba(255,255,255,0.08)'"
                            onmouseout="this.style.background='none'">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                             stroke="rgba(255,255,255,0.35)" stroke-width="2" stroke-linecap="round">
                            <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/>
                            <polyline points="16 17 21 12 16 7"/>
                            <line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                    </button>
                </form>
            </div>
        </div>

    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div style="flex:1; display:flex; flex-direction:column; min-width:0;">

        <!-- NAVBAR -->
        <header class="navbar">
            <button class="navbar__toggle" id="sidebarToggle" aria-label="Abrir menú">
                <svg viewBox="0 0 24 24">
                    <line x1="3" y1="6"  x2="21" y2="6"/>
                    <line x1="3" y1="12" x2="21" y2="12"/>
                    <line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
            </button>

            <nav class="navbar__breadcrumb" aria-label="Ruta de navegación">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                @if (ViewData["Breadcrumb"] != null)
                {
                    <span class="navbar__breadcrumb-sep">/</span>
                    <span class="navbar__breadcrumb-current">@ViewData["Breadcrumb"]</span>
                }
            </nav>

            <div class="navbar__actions">

                <!-- CAMPANITA DE NOTIFICACIONES -->
                <div class="notif-wrapper" id="notifWrapper">
                    <button class="navbar__btn" id="notifBtn" title="Notificaciones" onclick="toggleNotifPanel()">
                        <svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
                        <span class="notif-badge" id="notifBadge">0</span>
                    </button>
                    <div class="notif-panel" id="notifPanel">
                        <div class="notif-panel__header">
                            <span style="font-weight:700; font-size:0.88rem;">Notificaciones</span>
                            <button onclick="marcarTodasLeidas()" style="font-size:0.72rem; color:var(--celeste); background:none; border:none; cursor:pointer; padding:0;">
                                Marcar todas leídas
                            </button>
                        </div>
                        <div class="notif-panel__list" id="notifList">
                            <div style="text-align:center; padding:20px; color:var(--gris-400); font-size:0.82rem;">Cargando...</div>
                        </div>
                        <div class="notif-panel__footer">
                            <a href="/Notificaciones/Index" style="font-size:0.78rem; color:var(--celeste); text-decoration:none;">Ver todas →</a>
                        </div>
                    </div>
                </div>


            </div>
        </header>

        <!-- CONTENIDO PRINCIPAL -->
        <main class="main">
            <div class="main__content">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert--success">
                        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>@TempData["Success"]</span>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert--danger">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                        <span>@TempData["Error"]</span>
                    </div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert--warning">
                        <svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        <span>@TempData["Warning"]</span>
                    </div>
                }

                @RenderBody()
            </div>

            <footer class="footer">
                <span class="footer__brand">SG-JHOMERON</span>
                <span>&copy; @DateTime.Now.Year — RUC:20601777844</span>
            </footer>
        </main>

    </div>
</div>

<script>
    // ── Sidebar toggle ────────────────────────────────────────
    const toggle  = document.getElementById('sidebarToggle');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');

    function openSidebar()  { sidebar.classList.add('open'); overlay.classList.add('open'); document.body.style.overflow = 'hidden'; }
    function closeSidebar() { sidebar.classList.remove('open'); overlay.classList.remove('open'); document.body.style.overflow = ''; }

    toggle?.addEventListener('click', () => sidebar.classList.contains('open') ? closeSidebar() : openSidebar());
    overlay?.addEventListener('click', closeSidebar);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeSidebar(); });

    // ── Notificaciones ────────────────────────────────────────
    let notifAbierto = false;

    function toggleNotifPanel() {
        notifAbierto = !notifAbierto;
        document.getElementById('notifPanel').style.display = notifAbierto ? 'block' : 'none';
        if (notifAbierto) cargarNotificaciones();
    }

    document.addEventListener('click', function(e) {
        const wrapper = document.getElementById('notifWrapper');
        if (wrapper && !wrapper.contains(e.target) && notifAbierto) {
            notifAbierto = false;
            document.getElementById('notifPanel').style.display = 'none';
        }
    });

    const coloresNotif = {
        'Mantenimiento': '#d97706',
        'Creacion':      '#16a34a',
        'Edicion':       '#2563eb',
        'Eliminacion':   '#dc2626',
        'CambioEstado':  '#7c3aed'
    };

    async function cargarNotificaciones() {
        try {
            const res  = await fetch('/Notificaciones/ObtenerNoLeidas');
            const data = await res.json();

            const badge = document.getElementById('notifBadge');
            badge.textContent    = data.contador;
            badge.style.display  = data.contador > 0 ? 'block' : 'none';

            const lista = document.getElementById('notifList');
            if (!data.notificaciones || data.notificaciones.length === 0) {
                lista.innerHTML = '<div style="text-align:center;padding:20px;color:var(--gris-400);font-size:0.82rem;">Sin notificaciones</div>';
                return;
            }

            lista.innerHTML = data.notificaciones.map(n => `
                <div class="notif-item ${!n.leida ? 'notif-item--no-leida' : ''}">
                    <div style="width:32px;height:32px;border-radius:50%;background:${(coloresNotif[n.tipo] ?? '#1a3a6b')}20;display:grid;place-items:center;flex-shrink:0;">
                        <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:${coloresNotif[n.tipo] ?? '#1a3a6b'};fill:none;stroke-width:2;stroke-linecap:round;">
                            <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        </svg>
                    </div>
                    <div style="flex:1;min-width:0;">
                        <div style="font-weight:${n.leida ? '500' : '700'};font-size:0.82rem;color:var(--gris-900);">
                            ${n.titulo}
                            ${!n.leida ? '<span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:#1a3a6b;margin-left:4px;vertical-align:middle;"></span>' : ''}
                        </div>
                        ${n.mensaje ? `<div style="font-size:0.76rem;color:var(--gris-500);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${n.mensaje}</div>` : ''}
                        <div style="font-size:0.7rem;color:var(--gris-400);margin-top:2px;">${n.fechaCreacion}</div>
                        ${n.url ? `<a href="${n.url}" style="font-size:0.73rem;color:var(--celeste);text-decoration:none;">Ver →</a>` : ''}
                    </div>
                </div>
            `).join('');
        } catch(e) {
            console.error('Error notificaciones:', e);
        }
    }

    async function marcarTodasLeidas() {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        await fetch('/Notificaciones/MarcarTodasLeidas', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token }
        });
        cargarNotificaciones();
    }

    async function actualizarContador() {
        try {
            const res  = await fetch('/Notificaciones/ObtenerNoLeidas');
            const data = await res.json();
            const badge = document.getElementById('notifBadge');
            if (badge) {
                badge.textContent   = data.contador;
                badge.style.display = data.contador > 0 ? 'block' : 'none';
            }
        } catch(e) {}
    }

    // Cargar contador al iniciar y cada 2 minutos
    actualizarContador();
    setInterval(actualizarContador, 2 * 60 * 1000);
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
