<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Jhomeron</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<div class="layout">

    <!-- ═══════════════════════════════════════
         SIDEBAR
    ══════════════════════════════════════════ -->
    <aside class="sidebar" id="sidebar">

        <div class="sidebar__logo">
            <div class="sidebar__logo-icon">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="3" width="7" height="7" rx="1.5"/>
                    <rect x="14" y="3" width="7" height="7" rx="1.5"/>
                    <rect x="3" y="14" width="7" height="7" rx="1.5"/>
                    <rect x="14" y="14" width="7" height="7" rx="1.5"/>
                </svg>
            </div>
            <div class="sidebar__logo-text">
                Jhomeron S.A
                <span>Panel de control</span>
            </div>
        </div>

        <nav class="sidebar__nav">

            <!-- PRINCIPAL -->
            <div class="sidebar__section">
                <p class="sidebar__section-label">Principal</p>
                <div class="sidebar__item">
                    <a class="sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                        Dashboard
                    </a>
                </div>
            </div>

            <!-- RRHH -->
            <div class="sidebar__section">
                <p class="sidebar__section-label">Recursos Humanos</p>
                <div class="sidebar__item">
                    <a class="sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Empleados" ? "active" : "")"
                       asp-controller="Empleados" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
                        Empleados
                    </a>
                </div>
                <div class="sidebar__item">
                    <a class="sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Grupos" ? "active" : "")"
                       asp-controller="Grupos" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                        Grupos
                    </a>
                </div>
            </div>

            <!-- EQUIPOS TI -->
            <div class="sidebar__section">
                <p class="sidebar__section-label">Equipos TI</p>
                <div class="sidebar__item">
                    <a class="sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Equipos" ? "active" : "")"
                       asp-controller="Equipos" asp-action="Index">
                        <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                        Equipos
                    </a>
                </div>
                <div class="sidebar__item">
                    <a class="sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Chips" ? "active" : "")"
                       asp-controller="Chips" asp-action="Index">
                        <svg viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 9h6v6H9z"/><path d="M9 1v4M15 1v4M9 19v4M15 19v4M1 9h4M1 15h4M19 9h4M19 15h4"/></svg>
                        Chips / SIM
                    </a>
                </div>
                <div class="sidebar__item">
                    <a class="sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Asignaciones" ? "active" : "")"
                       asp-controller="Asignaciones" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M9 12l2 2 4-4"/></svg>
                        Asignaciones
                    </a>
                </div>
                <div class="sidebar__item">
                    <a class="sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Historiales" ? "active" : "")"
                       asp-controller="Historiales" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        Historial
                    </a>
                </div>
            </div>

            <!-- FLOTA -->
            <div class="sidebar__section">
                <p class="sidebar__section-label">Flota Vehicular</p>
                <div class="sidebar__item">
                    <a class="sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Carros" ? "active" : "")"
                       asp-controller="Carros" asp-action="Index">
                        <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                        Vehículos
                    </a>
                </div>
                <div class="sidebar__item">
                    <a class="sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MantenimientoCarros" ? "active" : "")"
                       asp-controller="MantenimientoCarros" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
                        Mantenimiento
                    </a>
                </div>
                <div class="sidebar__item">
                    <a class="sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Seguros" ? "active" : "")"
                       asp-controller="Seguros" asp-action="Index">
                        <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        Seguros
                    </a>
                </div>
                <div class="sidebar__item">
                    <a class="sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Asesorios" ? "active" : "")"
                       asp-controller="Asesorios" asp-action="Index">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
                        Accesorios
                    </a>
                </div>
            </div>

            <!-- CONFIG -->
            <div class="sidebar__section">
                <p class="sidebar__section-label">Configuración</p>
                <div class="sidebar__item">
                    <a class="sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Modalidades" ? "active" : "")"
                       asp-controller="Modalidades" asp-action="Index">
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
                        Modalidades
                    </a>
                </div>
                <div class="sidebar__item">
                    <a class="sidebar__link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Motivos" ? "active" : "")"
                       asp-controller="Motivos" asp-action="Index">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        Motivos
                    </a>
                </div>
            </div>

        </nav>

        <div class="sidebar__footer">
            @{
                var sesNombre   = Context.Session.GetString("UsuarioNombre")   ?? "Usuario";
                var sesUsername = Context.Session.GetString("UsuarioUsername") ?? "";
                var sesRol      = Context.Session.GetString("UsuarioRol")      ?? "";
                var initiales   = sesNombre.Length > 0
                    ? string.Concat(sesNombre.Split(' ').Take(2).Select(p => p[0].ToString().ToUpper()))
                    : "U";
            }
            <div class="sidebar__user">
                <div class="sidebar__avatar">@initiales</div>
                <div class="sidebar__user-info">
                    <div class="sidebar__user-name">@sesNombre</div>
                    <div class="sidebar__user-role">@sesRol</div>
                </div>
                <!-- Logout -->
                <form asp-controller="Auth" asp-action="Logout" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" title="Cerrar sesión"
                            style="background:none; border:none; cursor:pointer; padding:4px; border-radius:6px; display:flex; align-items:center; transition:background 0.15s;"
                            onmouseover="this.style.background='rgba(255,255,255,0.08)'"
                            onmouseout="this.style.background='none'">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                             stroke="rgba(255,255,255,0.35)" stroke-width="2" stroke-linecap="round">
                            <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/>
                            <polyline points="16 17 21 12 16 7"/>
                            <line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                    </button>
                </form>
            </div>
        </div>

    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- ═══════════════════════════════════════
         COLUMNA DERECHA
    ══════════════════════════════════════════ -->
    <div style="flex:1; display:flex; flex-direction:column; min-width:0;">

        <!-- NAVBAR -->
        <header class="navbar">
            <button class="navbar__toggle" id="sidebarToggle" aria-label="Abrir menú">
                <svg viewBox="0 0 24 24">
                    <line x1="3" y1="6"  x2="21" y2="6"/>
                    <line x1="3" y1="12" x2="21" y2="12"/>
                    <line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
            </button>

            <nav class="navbar__breadcrumb" aria-label="Ruta de navegación">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                @if (ViewData["Breadcrumb"] != null)
                {
                    <span class="navbar__breadcrumb-sep">/</span>
                    <span class="navbar__breadcrumb-current">@ViewData["Breadcrumb"]</span>
                }
            </nav>

            <div class="navbar__search">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" placeholder="Buscar registros..." />
            </div>

            <div class="navbar__actions">
                <button class="navbar__btn" title="Notificaciones">
                    <svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
                    <span class="navbar__notif-dot"></span>
                </button>
                <button class="navbar__btn" title="Mi perfil">
                    <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </button>
            </div>
        </header>

        <!-- CONTENIDO PRINCIPAL -->
        <main class="main">
            <div class="main__content">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert--success">
                        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>@TempData["Success"]</span>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert--danger">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                        <span>@TempData["Error"]</span>
                    </div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert--warning">
                        <svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        <span>@TempData["Warning"]</span>
                    </div>
                }

                @RenderBody()
            </div>

            <footer class="footer">
                <span class="footer__brand">SG-JHOMERON</span>
                <span>&copy; @DateTime.Now.Year — RUC:20601777844</span>
            </footer>
        </main>

    </div>
</div>

<script>
    const toggle  = document.getElementById('sidebarToggle');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');

    function openSidebar() {
        sidebar.classList.add('open');
        overlay.classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
        sidebar.classList.remove('open');
        overlay.classList.remove('open');
        document.body.style.overflow = '';
    }

    toggle?.addEventListener('click', () => {
        sidebar.classList.contains('open') ? closeSidebar() : openSidebar();
    });

    overlay?.addEventListener('click', closeSidebar);

    // Cerrar con Escape
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') closeSidebar();
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
