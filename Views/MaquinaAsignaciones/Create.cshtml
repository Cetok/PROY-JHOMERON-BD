@model PROYJHOME2026.Models.MaquinaAsignacion
@{
    ViewData["Title"]      = "Nueva Asignación";
    ViewData["Breadcrumb"] = "Producción / Asignaciones / Nueva";
    var empleados = ViewBag.EmpleadosList as IEnumerable<dynamic> ?? new List<dynamic>();
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Producción</div>
        <h1 class="page-header__title">Asignar Máquina</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:680px;">
    <div class="card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div style="margin-bottom:24px;">
                <p class="form-section-title">Datos de asignación</p>
                <div class="form-grid">
                    <div class="form-group form-group--full">
                        <label class="form-label">Máquina <span class="req">*</span></label>
                        <select asp-for="IdMaquina" asp-items="ViewBag.MaquinasList" class="form-control">
                            <option value="">— Seleccionar máquina —</option>
                        </select>
                        <span asp-validation-for="IdMaquina" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Grupo / Área <span class="req">*</span></label>
                        <select asp-for="IdGrupo" asp-items="ViewBag.GruposList" class="form-control">
                            <option value="">— Seleccionar grupo —</option>
                        </select>
                        <span asp-validation-for="IdGrupo" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Fecha de asignación <span style="color:var(--gris-400);font-weight:400;">(opcional)</span></label>
                        <input asp-for="FechaAsignacion" type="date" class="form-control" />
                    </div>
                    <div class="form-group form-group--full">
                        <label class="form-label">Área específica <span style="color:var(--gris-400);font-weight:400;">(opcional)</span></label>
                        <input asp-for="AreaEspecifica" type="text" class="form-control"
                               placeholder="Ej: Área de Mezcla, Llenado, Envasado..." maxlength="200" />
                    </div>
                    <div class="form-group form-group--full">
                        <label class="form-label">Observaciones</label>
                        <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="1000"
                                  placeholder="Condiciones de la asignación, notas..."></textarea>
                    </div>
                </div>
            </div>

            <!-- ENCARGADOS -->
            <div style="margin-bottom:24px;">
                <p class="form-section-title">Encargados <span style="color:var(--gris-400);font-weight:400;font-size:0.7rem;">(mínimo 1, máximo 5)</span></p>

                <div id="encargados-container">
                    <!-- fila inicial -->
                    <div class="enc-row" style="display:flex;gap:8px;align-items:center;margin-bottom:8px;">
                        <select name="idsEncargados" class="form-control" style="flex:1;" required>
                            <option value="">— Seleccionar empleado —</option>
                            @foreach (var e in empleados)
                            {
                                <option value="@e.idEmpleado">@e.Nombre</option>
                            }
                        </select>
                        <button type="button" class="btn btn--ghost btn--icon btn-remove-enc" title="Quitar" style="display:none;">
                            <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--rojo);fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                    </div>
                </div>

                <button type="button" id="btn-add-enc" class="btn btn--secondary btn--sm" style="margin-top:4px;">
                    <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Agregar otro encargado
                </button>

                <div id="enc-contador" style="font-size:0.75rem;color:var(--gris-400);margin-top:6px;">1 encargado seleccionado</div>
            </div>

            <div asp-validation-summary="All" class="form-error" style="margin-bottom:12px;"></div>

                    <div class="form-group form-group--full">
                        <label class="form-label">Estado operativo</label>
                        <select asp-for="EstadoOperativo" class="form-control">
                            <option value="Operativo">Operativo</option>
                            <option value="Almacenado en stock">Almacenado en stock</option>
                            <option value="Inoperativo">Inoperativo</option>
                        </select>
                    </div>

            <div style="background:rgba(59,130,246,0.06); border:1px solid rgba(59,130,246,0.2); border-radius:var(--r-sm); padding:12px 14px; margin-bottom:16px; font-size:0.82rem; color:var(--azul);">
                Si ya tenía una asignación activa, se cerrará automáticamente al crear esta nueva.
            </div>

            <div style="display:flex; gap:10px; padding-top:4px; border-top:1px solid var(--gris-200);">
                <button type="submit" class="btn btn--celeste btn--lg">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    Asignar máquina
                </button>
                <a asp-action="Index" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Styles {
<style>
.form-section-title { font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200); }
</style>
}

@section Scripts {
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
<script>
(function(){
    var MAX = 5;
    var container = document.getElementById('encargados-container');
    var btnAdd    = document.getElementById('btn-add-enc');
    var contador  = document.getElementById('enc-contador');

    // Opciones de empleados para clonar
    var opcionesHTML = container.querySelector('select').innerHTML;

    function actualizarUI(){
        var filas = container.querySelectorAll('.enc-row');
        var n = filas.length;
        contador.textContent = n + ' encargado' + (n !== 1 ? 's' : '') + ' seleccionado' + (n !== 1 ? 's' : '');
        btnAdd.style.display = n >= MAX ? 'none' : '';
        filas.forEach(function(fila, i){
            var btn = fila.querySelector('.btn-remove-enc');
            btn.style.display = n > 1 ? '' : 'none';
        });
    }

    btnAdd.addEventListener('click', function(){
        var filas = container.querySelectorAll('.enc-row');
        if (filas.length >= MAX) return;

        var div = document.createElement('div');
        div.className = 'enc-row';
        div.style.cssText = 'display:flex;gap:8px;align-items:center;margin-bottom:8px;';

        var sel = document.createElement('select');
        sel.name = 'idsEncargados';
        sel.className = 'form-control';
        sel.style.flex = '1';
        sel.innerHTML = opcionesHTML;

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn btn--ghost btn--icon btn-remove-enc';
        btn.title = 'Quitar';
        btn.innerHTML = '<svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--rojo);fill:none;stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
        btn.addEventListener('click', function(){ div.remove(); actualizarUI(); });

        div.appendChild(sel);
        div.appendChild(btn);
        container.appendChild(div);
        actualizarUI();
    });

    container.addEventListener('click', function(e){
        var btn = e.target.closest('.btn-remove-enc');
        if (btn){
            var filas = container.querySelectorAll('.enc-row');
            if (filas.length > 1){ btn.closest('.enc-row').remove(); actualizarUI(); }
        }
    });

    actualizarUI();
})();
</script>
}
