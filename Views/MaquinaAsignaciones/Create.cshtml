@model PROYJHOME2026.Models.MaquinaAsignacion
@{
    ViewData["Title"]      = "Nueva Asignación";
    ViewData["Breadcrumb"] = "Producción / Asignaciones / Nueva";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Producción</div>
        <h1 class="page-header__title">Asignar Máquina</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:640px;">
    <div class="card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div style="margin-bottom:24px;">
                <p class="form-section-title">Datos de asignación</p>
                <div class="form-grid">
                    <div class="form-group form-group--full">
                        <label class="form-label">Máquina <span class="req">*</span></label>
                        <select asp-for="IdMaquina" asp-items="ViewBag.MaquinasList" class="form-control">
                            <option value="">— Seleccionar máquina —</option>
                        </select>
                        <span asp-validation-for="IdMaquina" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Grupo / Área <span class="req">*</span></label>
                        <select asp-for="IdGrupo" asp-items="ViewBag.GruposList" class="form-control">
                            <option value="">— Seleccionar grupo —</option>
                        </select>
                        <span asp-validation-for="IdGrupo" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Encargado <span class="req">*</span></label>
                        <select asp-for="IdEmpleadoEncargado" asp-items="ViewBag.EmpleadosList" class="form-control">
                            <option value="">— Seleccionar empleado —</option>
                        </select>
                        <span asp-validation-for="IdEmpleadoEncargado" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Fecha de asignación <span class="req">*</span></label>
                        <input asp-for="FechaAsignacion" type="date" class="form-control" />
                        <span asp-validation-for="FechaAsignacion" class="form-error"></span>
                    </div>
                    <div class="form-group form-group--full">
                        <label class="form-label">Observaciones</label>
                        <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="1000"
                                  placeholder="Condiciones de la asignación, notas..."></textarea>
                    </div>
                </div>
            </div>

            <div style="background:rgba(59,130,246,0.06); border:1px solid rgba(59,130,246,0.2); border-radius:var(--r-sm); padding:12px 14px; margin-bottom:16px; font-size:0.82rem; color:var(--azul);">
                Al asignar, la máquina quedará en estado <strong>Operativo</strong> en ese grupo.
                Si ya tenía una asignación activa, se cerrará automáticamente.
            </div>

            <div style="display:flex; gap:10px; padding-top:4px; border-top:1px solid var(--gris-200);">
                <button type="submit" class="btn btn--celeste btn--lg">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    Asignar máquina
                </button>
                <a asp-action="Index" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Styles {
<style>
.form-section-title { font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200); }
</style>
}
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
