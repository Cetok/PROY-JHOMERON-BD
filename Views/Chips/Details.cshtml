@model PROYJHOME2026.Models.Chip
@{
    ViewData["Title"] = "Detalle Chip";
    ViewData["Breadcrumb"] = "Chips / SIM / Detalle";
    var asignaciones = ViewBag.Asignaciones as List<PROYJHOME2026.Models.Asignacion> ?? new();
    var logs         = ViewBag.Logs as List<PROYJHOME2026.Models.ChipLog> ?? new();
    bool estaAsignado = asignaciones.Any(a => a.EstadoAsignacion == "Activo");
    bool inactivo     = Model.Estado == "Inactivo";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Equipos TI</div>
        <h1 class="page-header__title">Chip @Model.NumeroCelular</h1>
        <p class="page-header__subtitle">ID: #@Model.IdChip</p>
    </div>
    <div class="page-header__actions">
        @if (!inactivo)
        {
            <button type="button" class="btn btn--rojo"
                    onclick="document.getElementById('form-inactivar').style.display = document.getElementById('form-inactivar').style.display === 'none' ? 'flex' : 'none'">
                <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;">
                    <circle cx="12" cy="12" r="10"/><line x1="4.9" y1="4.9" x2="19.1" y2="19.1"/>
                </svg>
                Dar de baja
            </button>
            <a asp-action="Edit" asp-route-id="@Model.IdChip" class="btn btn--celeste">
                <svg viewBox="0 0 24 24">
                    <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" />
                    <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" />
                </svg>
                Editar
            </a>
        }
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24">
                <line x1="19" y1="12" x2="5" y2="12" />
                <polyline points="12 19 5 12 12 5" />
            </svg>
            Volver
        </a>
    </div>
</div>

@if (!inactivo)
{
    <div id="form-inactivar" style="display:none; max-width:960px; margin-bottom:16px;">
        <div class="card" style="border:1.5px solid var(--rojo-border); background:var(--rojo-light);">
            <div style="font-weight:700; color:var(--rojo); margin-bottom:10px;">
                ¿Dar de baja este chip?
            </div>
            <p style="font-size:0.85rem; color:var(--gris-700); margin-bottom:14px;">
                El número @Model.NumeroCelular dejará de usarse.
                @if (estaAsignado)
                {
                    <strong>Actualmente está asignado — se quitará automáticamente del equipo/empleado que lo tiene.</strong>
                }
            </p>
            <form asp-action="Inactivar" method="post" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.IdChip" />
                <div style="flex:1; min-width:220px;">
                    <label class="form-label">Motivo (opcional)</label>
                    <input type="text" name="motivo" class="form-control" placeholder="Ej: Número dado de baja por la operadora" maxlength="300" />
                </div>
                <button type="submit" class="btn btn--rojo btn--sm"
                        onclick="return confirm('¿Confirmas dar de baja el chip @Model.NumeroCelular?')">
                    Confirmar baja
                </button>
                <button type="button" class="btn btn--secondary btn--sm"
                        onclick="document.getElementById('form-inactivar').style.display='none'">
                    Cancelar
                </button>
            </form>
        </div>
    </div>
}

<div style="max-width:960px; display:flex; gap:16px; align-items:flex-start;">

    <!-- Columna principal -->
    <div style="flex:1; min-width:0; display:flex; flex-direction:column; gap:16px;">

        <!-- Info principal -->
        <div class="card">
            <div
                style="display:flex; align-items:center; gap:14px; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid var(--gris-200);">
                <div class="chip-icon-lg">
                    <svg viewBox="0 0 24 24">
                        <rect x="7" y="7" width="10" height="10" rx="1" />
                        <path d="M16 2v3M8 2v3M2 8h3M2 16h3M22 8h-3M22 16h-3M16 22v-3M8 22v-3" />
                    </svg>
                </div>
                <div>
                    <div
                        style="font-family:var(--font-display); font-size:1.15rem; font-weight:700; color:var(--azul-dark); font-family:monospace; letter-spacing:0.06em;">
                        @Model.NumeroCelular
                    </div>
                    <div style="margin-top:7px; display:flex; gap:6px; flex-wrap:wrap;">
                        @if (inactivo)
                        {
                            <span class="badge badge--rojo">Inactivo / Dado de baja</span>
                        }
                        else if (estaAsignado)
                        {
                            <span class="badge badge--celeste">Actualmente asignado</span>
                        }
                        else
                        {
                            <span class="badge badge--verde">Disponible</span>
                        }
                        <span class="badge badge--gris">@asignaciones.Count asignación(es)</span>
                    </div>
                </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
                <div>
                    <div
                        style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px;">
                        ID</div>
                        <div style="font-size:0.9rem; font-weight:500; color:var(--gris-900);">#@Model.IdChip</div>
                    </div>
                    <div>
                        <div
                            style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px;">
                            Número celular</div>
                            <div
                                style="font-size:0.9rem; font-weight:600; font-family:monospace; letter-spacing:0.05em; color:var(--gris-900);">
                                @Model.NumeroCelular</div>
                            </div>
                        </div>
        </div>

                    <!-- Historial de asignaciones -->
                    <div class="card" style="padding:0; overflow:hidden;">
                        <div
                            style="padding:16px 20px; border-bottom:1px solid var(--gris-200); display:flex; align-items:center; justify-content:space-between;">
                            <div>
                                <div class="card__title">Historial de asignaciones</div>
                                <div class="card__subtitle">Todos los equipos y empleados que usaron este chip</div>
                            </div>
                            <span class="badge badge--gris">@asignaciones.Count</span>
                        </div>

                        @if (asignaciones.Any())
                        {
                            <div class="table-wrapper" style="border:none; border-radius:0;">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Empleado</th>
                                            <th>Equipo</th>
                                            <th>Desde</th>
                                            <th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var a in asignaciones)
                                        {
                                            <tr>
                                                <td style="font-weight:600; font-size:0.85rem;">
                                                    @(a.Empleado?.nombre ?? "—") @(a.Empleado?.paterno ?? "")
                                                </td>
                                                <td style="font-size:0.82rem; color:var(--gris-600);">
                                                    @(a.Equipo?.marca ?? "—") @(a.Equipo?.modelo ?? "")
                                                </td>
                                                <td style="font-size:0.8rem; color:var(--gris-600);">
                                                    @a.FechaAsignacion.ToString("dd/MM/yyyy")
                                                </td>
                                                <td>
                                                    @{
                                                        var bc = a.EstadoAsignacion == "Activo" ? "badge--verde" : "badge--gris";
                                                    }
                                                    <span class="badge @bc">@a.EstadoAsignacion</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state" style="padding:28px;">
                                <div class="empty-state__title" style="font-size:0.9rem;">Sin asignaciones</div>
                                <div class="empty-state__text">Este chip aún no ha sido asignado a ningún equipo.</div>
                            </div>
                        }
                    </div>

                    <!-- Registro de eventos del chip -->
                    <div class="card" style="padding:0; overflow:hidden;">
                        <div
                            style="padding:16px 20px; border-bottom:1px solid var(--gris-200); display:flex; align-items:center; justify-content:space-between;">
                            <div>
                                <div class="card__title">Registro de eventos</div>
                                <div class="card__subtitle">Asignaciones, desasignaciones y bajas de este chip, con fecha y hora</div>
                            </div>
                            <span class="badge badge--gris">@logs.Count</span>
                        </div>

                        @if (logs.Any())
                        {
                            <div class="table-wrapper" style="border:none; border-radius:0;">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Fecha / Hora</th>
                                            <th>Evento</th>
                                            <th>Detalle</th>
                                            <th>Usuario</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var l in logs)
                                        {
                                            var badgeLog = l.TipoEvento switch {
                                                "Asignado"    => "badge--celeste",
                                                "Desasignado" => "badge--amarillo",
                                                "Inactivo"    => "badge--rojo",
                                                _             => "badge--gris"
                                            };
                                            <tr>
                                                <td style="font-size:0.78rem; color:var(--gris-500); white-space:nowrap;">
                                                    @l.Fecha.ToString("dd/MM/yy HH:mm")
                                                </td>
                                                <td><span class="badge @badgeLog" style="font-size:0.7rem;">@l.TipoEvento</span></td>
                                                <td style="font-size:0.82rem; color:var(--gris-700);">@(l.Detalle ?? "—")</td>
                                                <td style="font-size:0.75rem; color:var(--gris-400);">@(l.RegistradoPor ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state" style="padding:28px;">
                                <div class="empty-state__title" style="font-size:0.9rem;">Sin eventos registrados</div>
                                <div class="empty-state__text">Aún no hay asignaciones, desasignaciones ni bajas de este chip.</div>
                            </div>
                        }
                    </div>

    </div>

</div>

            @section Styles {
                <style>
                    .chip-icon-lg {
                        width: 52px;
                        height: 52px;
                        border-radius: var(--r-md);
                        background: rgba(59, 155, 232, 0.1);
                        border: 1px solid rgba(59, 155, 232, 0.25);
                        display: grid;
                        place-items: center;
                        flex-shrink: 0;
                    }

                    .chip-icon-lg svg {
                        width: 24px;
                        height: 24px;
                        stroke: var(--celeste);
                        fill: none;
                        stroke-width: 1.8;
                        stroke-linecap: round;
                        stroke-linejoin: round;
                    }
                </style>
            }
