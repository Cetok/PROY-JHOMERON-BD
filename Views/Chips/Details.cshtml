@model PROYJHOME2026.Models.Chip
@{
    ViewData["Title"]      = "Detalle Chip";
    ViewData["Breadcrumb"] = "Chips / SIM / Detalle";
    var asignaciones = ViewBag.Asignaciones as List<PROYJHOME2026.Models.Asignacion> ?? new();
    bool estaAsignado = asignaciones.Any(a => a.EstadoAsignacion == "Activo");
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Equipos TI</div>
        <h1 class="page-header__title">Chip @Model.NumeroCelular</h1>
        <p class="page-header__subtitle">ID: #@Model.IdChip</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.IdChip" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Editar
        </a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:700px; display:flex; flex-direction:column; gap:16px;">

    <!-- Info principal -->
    <div class="card">
        <div style="display:flex; align-items:center; gap:14px; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid var(--gris-200);">
            <div class="chip-icon-lg">
                <svg viewBox="0 0 24 24"><rect x="7" y="7" width="10" height="10" rx="1"/><path d="M16 2v3M8 2v3M2 8h3M2 16h3M22 8h-3M22 16h-3M16 22v-3M8 22v-3"/></svg>
            </div>
            <div>
                <div style="font-family:var(--font-display); font-size:1.15rem; font-weight:700; color:var(--azul-dark); font-family:monospace; letter-spacing:0.06em;">
                    @Model.NumeroCelular
                </div>
                <div style="margin-top:7px; display:flex; gap:6px; flex-wrap:wrap;">
                    @if (estaAsignado)
                    {
                        <span class="badge badge--celeste">Actualmente asignado</span>
                    }
                    else
                    {
                        <span class="badge badge--verde">Disponible</span>
                    }
                    <span class="badge badge--gris">@asignaciones.Count asignación(es)</span>
                </div>
            </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
            <div>
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px;">ID</div>
                <div style="font-size:0.9rem; font-weight:500; color:var(--gris-900);">#@Model.IdChip</div>
            </div>
            <div>
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px;">Número celular</div>
                <div style="font-size:0.9rem; font-weight:600; font-family:monospace; letter-spacing:0.05em; color:var(--gris-900);">@Model.NumeroCelular</div>
            </div>
        </div>
    </div>

    <!-- Historial de asignaciones -->
    <div class="card" style="padding:0; overflow:hidden;">
        <div style="padding:16px 20px; border-bottom:1px solid var(--gris-200); display:flex; align-items:center; justify-content:space-between;">
            <div>
                <div class="card__title">Historial de asignaciones</div>
                <div class="card__subtitle">Todos los equipos y empleados que usaron este chip</div>
            </div>
            <span class="badge badge--gris">@asignaciones.Count</span>
        </div>

        @if (asignaciones.Any())
        {
            <div class="table-wrapper" style="border:none; border-radius:0;">
                <table>
                    <thead>
                        <tr>
                            <th>Empleado</th>
                            <th>Equipo</th>
                            <th>Desde</th>
                            <th>Hasta</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in asignaciones)
                        {
                            <tr>
                                <td style="font-weight:600; font-size:0.85rem;">
                                    @(a.Empleado?.nombre ?? "—") @(a.Empleado?.paterno ?? "")
                                </td>
                                <td style="font-size:0.82rem; color:var(--gris-600);">
                                    @(a.Equipo?.marca ?? "—") @(a.Equipo?.modelo ?? "")
                                </td>
                                <td style="font-size:0.8rem; color:var(--gris-600);">
                                    @a.FechaAsignacion.ToString("dd/MM/yyyy")
                                </td>
                                <td style="font-size:0.8rem; color:var(--gris-600);">
                                    @(a.FechaDevolucion.HasValue ? a.FechaDevolucion.Value.ToString("dd/MM/yyyy") : "—")
                                </td>
                                <td>
                                    @{
                                        var bc = a.EstadoAsignacion == "Activo"    ? "badge--verde"
                                               : a.EstadoAsignacion == "Devuelto"  ? "badge--gris"
                                               : "badge--amarillo";
                                    }
                                    <span class="badge @bc">@a.EstadoAsignacion</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state" style="padding:28px;">
                <div class="empty-state__title" style="font-size:0.9rem;">Sin asignaciones</div>
                <div class="empty-state__text">Este chip aún no ha sido asignado a ningún equipo.</div>
            </div>
        }
    </div>

    <!-- Zona peligro -->
    <div class="card" style="border-color:var(--rojo-border); background:var(--rojo-light);">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
            <div>
                <div style="font-weight:700; color:var(--rojo); font-size:0.88rem;">Zona de peligro</div>
                <div style="font-size:0.76rem; color:var(--gris-600); margin-top:2px;">
                    @if (asignaciones.Any())
                    { <span>Tiene @asignaciones.Count asignación(es). No se puede eliminar.</span> }
                    else
                    { <span>Sin asignaciones. Se puede eliminar.</span> }
                </div>
            </div>
            <a asp-action="Delete" asp-route-id="@Model.IdChip" class="btn btn--danger btn--sm">
                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6M9 6V4h6v2"/></svg>
                Eliminar
            </a>
        </div>
    </div>
</div>

@section Styles {
<style>
.chip-icon-lg {
    width: 52px; height: 52px; border-radius: var(--r-md);
    background: rgba(59,155,232,0.1); border: 1px solid rgba(59,155,232,0.25);
    display: grid; place-items: center; flex-shrink: 0;
}
.chip-icon-lg svg {
    width: 24px; height: 24px; stroke: var(--celeste);
    fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
}
</style>
}
