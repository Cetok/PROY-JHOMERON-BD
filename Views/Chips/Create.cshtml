@model PROYJHOME2026.Models.Chip
@{
    ViewData["Title"]      = "Nuevo Chip";
    ViewData["Breadcrumb"] = "Chips / SIM / Nuevo";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Equipos TI</div>
        <h1 class="page-header__title">Nuevo Chip / SIM</h1>
        <p class="page-header__subtitle">Registra un número de chip o SIM</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:480px;">
    <div class="card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div style="margin-bottom:24px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Datos del chip
                </p>
                <div class="form-group">
                    <label class="form-label">Número celular <span class="req">*</span></label>
                    <input asp-for="NumeroCelular" class="form-control"
                           placeholder="Ej: 987654321"
                           maxlength="20" inputmode="tel" />
                    <span asp-validation-for="NumeroCelular" class="form-error"></span>
                    <div class="form-hint">Máximo 20 caracteres. Debe ser único.</div>
                </div>
            </div>

            <div style="display:flex; gap:10px; padding-top:4px; border-top:1px solid var(--gris-200);">
                <button type="submit" class="btn btn--celeste btn--lg">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    Registrar chip
                </button>
                <a asp-action="Index" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
