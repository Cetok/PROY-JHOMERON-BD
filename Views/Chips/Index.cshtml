@model IEnumerable<PROYJHOME2026.Models.Chip>
@{
    ViewData["Title"]      = "Chips / SIM";
    ViewData["Breadcrumb"] = "Chips / SIM";
    int pagina       = ViewBag.Pagina;
    int totalPaginas = ViewBag.TotalPaginas;
    int total        = ViewBag.Total;
    string buscar    = ViewBag.Buscar ?? "";
    string orden     = ViewBag.Orden  ?? "az";
    var idsAsignados = ViewBag.IdsAsignados as List<int> ?? new();
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Equipos TI</div>
        <h1 class="page-header__title">Chips / SIM</h1>
        <p class="page-header__subtitle">@total chip(s) registrado(s)</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Create" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nuevo chip
        </a>
    </div>
</div>

<!-- FILTRO -->
<div class="card" style="margin-bottom:20px; padding:16px 20px;">
    <form method="get" asp-action="Index" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
        <div style="flex:1; min-width:200px;">
            <label class="form-label">Buscar número</label>
            <div style="position:relative;">
                <svg style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:15px;height:15px;stroke:var(--gris-400);fill:none;stroke-width:2;stroke-linecap:round;pointer-events:none;" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" name="buscar" value="@buscar" class="form-control"
                       style="padding-left:34px;" placeholder="Ej: 987654321..." />
            </div>
        </div>
        <div style="min-width:130px;">
            <label class="form-label">Ordenar</label>
            <select name="orden" class="form-control">
                @if (orden == "za") {
                    <option value="az">A → Z</option>
                    <option value="za" selected>Z → A</option>
                } else {
                    <option value="az" selected>A → Z</option>
                    <option value="za">Z → A</option>
                }
            </select>
        </div>
        <div style="display:flex; gap:8px;">
            <button type="submit" class="btn btn--primary">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                Buscar
            </button>
            @if (!string.IsNullOrEmpty(buscar))
            {
                <a asp-action="Index" class="btn btn--secondary">Limpiar</a>
            }
        </div>
    </form>
</div>

<!-- TABLA -->
<div class="card" style="padding:0; overflow:hidden;">
    @if (Model.Any())
    {
        <div class="table-wrapper" style="border:none; border-radius:0;">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Número Celular</th>
                        <th>Estado</th>
                        <th style="text-align:center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        bool asignado = idsAsignados.Contains(c.IdChip);
                        <tr>
                            <td style="color:var(--gris-400); font-size:0.78rem; font-weight:400; width:60px;">
                                @c.IdChip
                            </td>
                            <td>
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <div class="chip-icon">
                                        <svg viewBox="0 0 24 24"><rect x="7" y="7" width="10" height="10" rx="1"/><path d="M16 2v3M8 2v3M2 8h3M2 16h3M22 8h-3M22 16h-3M16 22v-3M8 22v-3"/></svg>
                                    </div>
                                    <span style="font-family:monospace; font-size:0.9rem; font-weight:600; letter-spacing:0.05em; color:var(--gris-900);">
                                        @c.NumeroCelular
                                    </span>
                                </div>
                            </td>
                            <td>
                                @if (asignado)
                                {
                                    <span class="badge badge--celeste">Asignado</span>
                                }
                                else
                                {
                                    <span class="badge badge--verde">Disponible</span>
                                }
                            </td>
                            <td>
                                <div style="display:flex; gap:6px; justify-content:center;">
                                    <a asp-action="Details" asp-route-id="@c.IdChip"
                                       class="btn btn--ghost btn--icon" title="Ver detalle">
                                        <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@c.IdChip"
                                       class="btn btn--secondary btn--icon" title="Editar">
                                        <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@c.IdChip"
                                       class="btn btn--danger btn--icon" title="Eliminar">
                                        <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6M9 6V4h6v2"/></svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPaginas > 1)
        {
            <div class="pagination">
                <span style="font-size:0.75rem; color:var(--gris-400); margin-right:8px;">
                    Página @pagina de @totalPaginas
                </span>
                @if (pagina > 1)
                {
                    <a asp-action="Index" asp-route-pagina="@(pagina-1)" asp-route-buscar="@buscar" asp-route-orden="@orden"
                       class="pagination__btn">
                        <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                    </a>
                }
                @for (int i = Math.Max(1, pagina - 2); i <= Math.Min(totalPaginas, pagina + 2); i++)
                {
                    <a asp-action="Index" asp-route-pagina="@i" asp-route-buscar="@buscar" asp-route-orden="@orden"
                       class="pagination__btn @(i == pagina ? "active" : "")">@i</a>
                }
                @if (pagina < totalPaginas)
                {
                    <a asp-action="Index" asp-route-pagina="@(pagina+1)" asp-route-buscar="@buscar" asp-route-orden="@orden"
                       class="pagination__btn">
                        <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state__icon">
                <svg viewBox="0 0 24 24"><rect x="7" y="7" width="10" height="10" rx="1"/><path d="M16 2v3M8 2v3M2 8h3M2 16h3M22 8h-3M22 16h-3M16 22v-3M8 22v-3"/></svg>
            </div>
            <div class="empty-state__title">No se encontraron chips</div>
            <div class="empty-state__text">
                @if (!string.IsNullOrEmpty(buscar))
                { <span>Intenta con otro número.</span> }
                else { <span>Aún no hay chips registrados.</span> }
            </div>
            <a asp-action="Create" class="btn btn--celeste" style="margin-top:8px;">
                <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Registrar primer chip
            </a>
        </div>
    }
</div>

@section Styles {
<style>
.chip-icon {
    width: 32px; height: 32px; border-radius: var(--r-sm);
    background: rgba(59,155,232,0.08); border: 1px solid rgba(59,155,232,0.2);
    display: grid; place-items: center; flex-shrink: 0;
}
.chip-icon svg {
    width: 15px; height: 15px; stroke: var(--celeste);
    fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
}
</style>
}
