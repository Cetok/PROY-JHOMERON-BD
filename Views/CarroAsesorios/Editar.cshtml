@model PROYJHOME2026.Models.CarroAsesorio
@{
    ViewData["Title"]      = "Editar Accesorio de Vehículo";
    ViewData["Breadcrumb"] = "Flota / Editar Accesorio";
}
<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Flota Vehicular</div>
        <h1 class="page-header__title">Editar Accesorio</h1>
        <p class="page-header__subtitle">@Model.Carro?.Placa — @Model.Asesorio?.TipoAsesorio</p>
    </div>
    <div class="page-header__actions">
        <a asp-controller="Carros" asp-action="Details" asp-route-id="@Model.IdCarro" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>
<div style="max-width:540px;">
    <div class="card">
        <form asp-action="Editar" asp-route-idCarro="@Model.IdCarro" asp-route-idAsesorio="@Model.IdAsesorio" method="post">
            @Html.AntiForgeryToken()
            <div style="background:var(--gris-50); border:1px solid var(--gris-200); border-radius:var(--r-sm); padding:10px 14px; margin-bottom:18px; font-size:0.85rem; color:var(--gris-700);">
                <strong>Accesorio:</strong> @Model.Asesorio?.TipoAsesorio &nbsp;·&nbsp;
                <strong>Vehículo:</strong> @Model.Carro?.Placa @Model.Carro?.Marca @Model.Carro?.Modelo
            </div>
            <div class="form-group">
                <label class="form-label">Fecha de asignación</label>
                <input asp-for="FechaAsignada" type="date" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">Observaciones</label>
                <textarea asp-for="Observaciones" class="form-control" rows="2" maxlength="500"></textarea>
            </div>
            <div style="display:flex; gap:10px; padding-top:12px; border-top:1px solid var(--gris-200); margin-top:8px;">
                <button type="submit" class="btn btn--celeste btn--lg">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    Guardar cambios
                </button>
                <a asp-controller="Carros" asp-action="Details" asp-route-id="@Model.IdCarro" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
