    }
    @if (esAdmin || rol == "SSOMA") {
        <button class="dash-tab @(tabInicial=="ssoma"?"active":"")" onclick="cambiarTab('ssoma',this)">
            <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
