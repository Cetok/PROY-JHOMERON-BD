@{
    ViewData["Title"]      = "Dashboard";
    ViewData["Breadcrumb"] = "Dashboard de Análisis";
    var tabInicial = ViewBag.TabInicial as string ?? "resumen";
    var esAdmin    = (bool)(ViewBag.EsAdmin ?? false);
    var rol        = ViewBag.Rol as string ?? "";
}

@section Styles {
<style>
/* ── TABS ─────────────────────────────────────────────────── */
.dash-tabs { display:flex; gap:4px; flex-wrap:wrap; margin-bottom:20px; background:#fff; padding:8px; border-radius:12px; border:1px solid #e2e8f0; }
.dash-tab  { padding:8px 16px; border-radius:8px; border:none; background:transparent; cursor:pointer; font-size:0.82rem; font-weight:600; color:#64748b; display:flex; align-items:center; gap:6px; transition:all 0.15s; }
.dash-tab:hover   { background:#f1f5f9; color:#1e293b; }
.dash-tab.active  { background:linear-gradient(135deg,#0d3393,#0ea5e9); color:white; }
.dash-tab svg     { width:15px; height:15px; stroke:currentColor; fill:none; stroke-width:2; }

/* ── PANEL ────────────────────────────────────────────────── */
.dash-panel       { display:none; }
.dash-panel.active{ display:block; }

/* ── KPIs ─────────────────────────────────────────────────── */
.kpi-row { display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:12px; margin-bottom:20px; }
.kpi-box { background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:16px; position:relative; overflow:hidden; }
.kpi-box::before { content:''; position:absolute; left:0;top:0;bottom:0; width:4px; border-radius:12px 0 0 12px; }
.kpi-box--azul::before    { background:#0d3393; }
.kpi-box--celeste::before { background:#0ea5e9; }
.kpi-box--verde::before   { background:#16a34a; }
.kpi-box--amarillo::before{ background:#d97706; }
.kpi-box--rojo::before    { background:#dc2626; }
.kpi-box--purple::before  { background:#7c3aed; }
.kpi-val  { font-size:2rem; font-weight:800; color:#0d3393; line-height:1; }
.kpi-lbl  { font-size:0.72rem; color:#64748b; margin-top:4px; }
.kpi-sub  { font-size:0.7rem; color:#94a3b8; margin-top:2px; }

/* ── GRID GRÁFICOS ────────────────────────────────────────── */
.chart-grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px; }
.chart-grid-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; margin-bottom:16px; }
.chart-grid-1 { display:grid; grid-template-columns:1fr; gap:16px; margin-bottom:16px; }
.chart-card   { background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:18px; }
.chart-title  { font-size:0.82rem; font-weight:700; color:#1e293b; margin-bottom:4px; }
.chart-sub    { font-size:0.69rem; color:#94a3b8; margin-bottom:14px; }
.chart-wrap   { position:relative; }

/* ── TABLAS INTERNAS ──────────────────────────────────────── */
.mini-table { width:100%; border-collapse:collapse; font-size:0.78rem; }
.mini-table th { background:#f8fafc; color:#64748b; font-weight:700; font-size:0.68rem; text-transform:uppercase; letter-spacing:0.05em; padding:7px 10px; text-align:left; border-bottom:1px solid #e2e8f0; }
.mini-table td { padding:7px 10px; border-bottom:1px solid #f1f5f9; color:#374151; }
.mini-table tr:last-child td { border-bottom:none; }
.mini-table tr:hover td { background:#f8fafc; }

/* ── BADGES ───────────────────────────────────────────────── */
.b { display:inline-block; padding:2px 8px; border-radius:20px; font-size:0.68rem; font-weight:700; }
.b-verde    { background:#dcfce7; color:#16a34a; }
.b-rojo     { background:#fee2e2; color:#dc2626; }
.b-amarillo { background:#fef9c3; color:#d97706; }
.b-azul     { background:#dbeafe; color:#1d4ed8; }
.b-gris     { background:#f1f5f9; color:#64748b; }
.b-purple   { background:#ede9fe; color:#7c3aed; }
.b-naranja  { background:#ffedd5; color:#ea580c; }

/* ── LOADING ──────────────────────────────────────────────── */
.dash-loading { display:flex; align-items:center; justify-content:center; gap:10px; padding:40px; color:#94a3b8; font-size:0.85rem; }
.spin { width:20px; height:20px; border:2px solid #e2e8f0; border-top-color:#0d3393; border-radius:50%; animation:spin 0.7s linear infinite; }
@@keyframes spin { to { transform:rotate(360deg); } }

@@media(max-width:768px) {
    .chart-grid-2,.chart-grid-3 { grid-template-columns:1fr; }
    .kpi-row { grid-template-columns:repeat(2,1fr); }
}
</style>
}

<!-- HEADER -->
<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Análisis</div>
        <h1 class="page-header__title">Dashboard</h1>
        <p class="page-header__subtitle">Datos en tiempo real · <span id="ultima-act"></span></p>
    </div>
    <div class="page-header__actions">
        <button class="btn btn--secondary btn--sm" onclick="refrescarPanel()">
            <svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
            Refrescar
        </button>
    </div>
</div>

<!-- TABS -->
<div class="dash-tabs">
    @if (esAdmin) {
        <button class="dash-tab @(tabInicial=="resumen"?"active":"")" onclick="cambiarTab('resumen',this)">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
