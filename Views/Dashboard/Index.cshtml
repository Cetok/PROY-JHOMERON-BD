@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
const COLORES = ['#0d3393','#0ea5e9','#16a34a','#d97706','#dc2626','#7c3aed','#06b6d4','#f97316','#ec4899','#84cc16'];
const CHART_OPT = (tipo) => ({
    responsive:true, maintainAspectRatio:false, animation:{duration:500},
    plugins:{
        legend:{ display: tipo==='doughnut', position:'bottom', labels:{color:'#64748b',padding:8,font:{size:11}} },
        tooltip:{ backgroundColor:'#fff', titleColor:'#1e293b', bodyColor:'#64748b', borderColor:'#e2e8f0', borderWidth:1, padding:10 }
    },
    scales: tipo==='doughnut'?{}:{ x:{grid:{color:'#f1f5f9'},ticks:{color:'#94a3b8',font:{size:10}}}, y:{grid:{color:'#f1f5f9'},ticks:{color:'#94a3b8',font:{size:10}}} }
});

const charts = {};
function crearGrafico(id, tipo, labels, datos, colores) {
    const canvas = document.getElementById(id);
    if (!canvas) return;
    if (charts[id]) { charts[id].destroy(); }
    const datasets = tipo==='doughnut'
        ? [{ data:datos, backgroundColor:colores||COLORES, borderWidth:2, borderColor:'#fff', hoverOffset:6 }]
        : [{ data:datos, backgroundColor:colores||COLORES[0], borderRadius:5, borderSkipped:false }];
    charts[id] = new Chart(canvas, {
        type: tipo,
        data: { labels, datasets },
        options: { ...CHART_OPT(tipo), cutout: tipo==='doughnut'?'65%':undefined }
    });
}
function crearLineal(id, labels, datasets) {
    const canvas = document.getElementById(id);
    if (!canvas) return;
    if (charts[id]) charts[id].destroy();
    charts[id] = new Chart(canvas, {
        type:'line',
        data:{ labels, datasets },
        options:{ ...CHART_OPT('line'), plugins:{...CHART_OPT('line').plugins, legend:{display:true,position:'bottom',labels:{color:'#64748b',padding:8,font:{size:11}}}} }
    });
}

function kpi(val, lbl, sub, color) {
    return `<div class="kpi-box kpi-box--${color}"><div class="kpi-val">${val}</div><div class="kpi-lbl">${lbl}</div>${sub?'<div class="kpi-sub">'+sub+'</div>':''}</div>`;
}
function badge(txt, color) { return `<span class="b b-${color}">${txt}</span>`; }
function badgeEstado(est) {
    const map = {
        'Activo':'verde','Vigente':'verde','Libre':'verde','Disponible':'verde',
        'Asignado':'azul','En proceso':'amarillo','Pendiente':'amarillo',
        'Culminado':'verde','Cancelado':'rojo','Inactivo':'gris',
        'Vencido':'rojo','Crítico':'rojo','Próximo':'naranja','Sin fecha':'gris',
        'Mantenimiento':'amarillo','Registrado':'gris','Inoperativo':'rojo','Dado de Baja':'rojo',
        'Operativo':'verde','Almacenado en stock':'amarillo'
    };
    return badge(est, map[est]||'gris');
}
function tabla(cols, filas, emptyMsg) {
    if (!filas||!filas.length) return `<p style="text-align:center;color:#94a3b8;padding:20px;font-size:0.82rem;">${emptyMsg||'Sin datos'}</p>`;
    const ths = cols.map(c=>`<th>${c}</th>`).join('');
    const trs = filas.map(f=>`<tr>${f.map(c=>`<td>${c}</td>`).join('')}</tr>`).join('');
    return `<table class="mini-table"><thead><tr>${ths}</tr></thead><tbody>${trs}</tbody></table>`;
}
function card(titulo, sub, contenido) {
    return `<div class="chart-card"><div class="chart-title">${titulo}</div><div class="chart-sub">${sub}</div>${contenido}</div>`;
}
function canvasWrap(id, h) {
    return `<div class="chart-wrap" style="height:${h||200}px;"><canvas id="${id}"></canvas></div>`;
}

// ── TAB SWITCHING ─────────────────────────────────────────
const cargados = {};
function cambiarTab(nombre, btn) {
    document.querySelectorAll('.dash-panel').forEach(p=>p.classList.remove('active'));
    document.querySelectorAll('.dash-tab').forEach(b=>b.classList.remove('active'));
    const panel = document.getElementById('panel-'+nombre);
    if (panel) panel.classList.add('active');
    if (btn) btn.classList.add('active');
    if (!cargados[nombre]) cargarPanel(nombre);
}
function refrescarPanel() {
    const activo = document.querySelector('.dash-panel.active');
    if (!activo) return;
    const nombre = activo.id.replace('panel-','');
    cargados[nombre] = false;
    cargarPanel(nombre);
}
async function cargarPanel(nombre) {
    cargados[nombre] = true;
    const load     = document.getElementById('load-'+nombre);
    const contenido= document.getElementById('contenido-'+nombre);
    if (load)      load.style.display     = 'flex';
    if (contenido) contenido.style.display= 'none';
    try {
        const rutas = { resumen:'Resumen', flota:'Flota', ti:'TI', produccion:'Produccion', logistica:'Logistica', ssoma:'SSoma', rrhh:'RRHH' };
        const res   = await fetch('/Dashboard/Datos'+rutas[nombre]);
        if (!res.ok) throw new Error(res.statusText);
        const d = await res.json();
        if (load)      load.style.display     = 'none';
        if (contenido) { contenido.style.display = 'block'; renderPanel(nombre, d, contenido); }
    } catch(e) {
        if (load) load.innerHTML = `<span style="color:#dc2626;">Error al cargar datos: ${e.message}</span>`;
    }
    document.getElementById('ultima-act').textContent = 'Actualizado ' + new Date().toLocaleTimeString('es-PE');
}

// ── RENDERS ───────────────────────────────────────────────
function renderPanel(nombre, d, el) {
    const fn = {resumen:renderResumen, flota:renderFlota, ti:renderTI, produccion:renderProduccion, logistica:renderLogistica, ssoma:renderSSoma, rrhh:renderRRHH};
    if (fn[nombre]) fn[nombre](d, el);
}

// RESUMEN
function renderResumen(d, el) {
    const k = d.kpis, am = d.actividadMensual;
    el.innerHTML = `
    <div class="kpi-row">
        ${kpi(k.totalEmpleados,'Empleados',k.empleadosActivos+' activos','azul')}
        ${kpi(k.totalEquipos,'Equipos TI',k.equiposAsignados+' asignados','celeste')}
        ${kpi(k.totalCarros,'Vehículos',k.carrosActivos+' activos','verde')}
        ${kpi(k.totalMaquinas,'Máquinas',k.maquinasActivas+' activas','purple')}
        ${kpi(k.totalChips,'Chips/SIM',k.chipsAsignados+' asignados','celeste')}
        ${kpi(k.mantePendientes,'Mant. Pendientes',k.manteEnProceso+' en proceso','amarillo')}
    </div>
    <div class="chart-grid-2">
        ${card('Actividad mensual','Asignaciones y mantenimientos últimos 6 meses',canvasWrap('ch-resumen-act',220))}
        ${card('Distribución de flota','Estado actual de vehículos',canvasWrap('ch-resumen-carros',220))}
    </div>`;
    setTimeout(()=>{
        crearLineal('ch-resumen-act',
            am.map(x=>x.mes),
            [
                {label:'Asignaciones',data:am.map(x=>x.asigs),borderColor:COLORES[0],backgroundColor:COLORES[0]+'20',fill:true,tension:0.4,borderWidth:2},
                {label:'Mantenimientos',data:am.map(x=>x.mantes),borderColor:COLORES[2],backgroundColor:COLORES[2]+'20',fill:true,tension:0.4,borderWidth:2}
            ]
        );
    },100);
}

// FLOTA
function renderFlota(d, el) {
    const diasColor = (d) => d<=0?'rojo':d<=7?'rojo':d<=30?'naranja':'verde';
    el.innerHTML = `
    <div class="kpi-row">
        ${kpi(d.totalCarros,'Total vehículos','','azul')}
        ${kpi(d.carrosActivos,'Activos','','verde')}
        ${kpi(d.mantePendTotal,'Mant. pendientes','','amarillo')}
        ${kpi(d.manteTotal,'Mant. totales','','celeste')}
        ${kpi(d.vencimientos.length,'Venc. próx. (30d)','','rojo')}
    </div>
    <div class="chart-grid-3">
        ${card('Estado de vehículos','Distribución por estado',canvasWrap('ch-flota-est',180))}
        ${card('Mantenimientos por mes','Últimos 6 meses',canvasWrap('ch-flota-meses',180))}
        ${card('Estado de mantenimientos','Todos los mantenimientos',canvasWrap('ch-flota-mante-est',180))}
    </div>
    <div class="chart-grid-2">
        ${card('Vencimientos próximos (30 días)','Seguros, modalidades y habilitaciones',`<div style="overflow-x:auto">${tabla(
            ['Placa','Documento','Fecha','Días rest.'],
            d.vencimientos.map(v=>[v.placa, v.tipo, v.fecha, badge(v.diasRest+' días', diasColor(v.diasRest))]),
            'Sin vencimientos próximos ✓'
        )}</div>`)}
        ${card('Top vehículos con más mantenimientos','Histórico total',canvasWrap('ch-flota-top',200))}
    </div>
    <div class="chart-grid-1">
        ${card('Mantenimientos pendientes','Próximos programados',`<div style="overflow-x:auto">${tabla(
            ['Placa','Tipo','Fecha programada','Días rest.'],
            d.mantePendientes.map(m=>[m.placa, m.tipo, m.fecha, badge(m.diasRest+' días',diasColor(m.diasRest))]),
            'Sin mantenimientos pendientes ✓'
        )}</div>`)}
    </div>`;
    setTimeout(()=>{
        crearGrafico('ch-flota-est','doughnut', d.estadoCarros.map(e=>e.estado), d.estadoCarros.map(e=>e.total));
        crearGrafico('ch-flota-meses','bar', d.mantesPorMes.map(m=>m.mes), d.mantesPorMes.map(m=>m.total), COLORES[0]);
        crearGrafico('ch-flota-mante-est','doughnut', d.manteEstado.map(e=>e.estado), d.manteEstado.map(e=>e.total));
        crearGrafico('ch-flota-top','bar', d.topCarros.map(c=>c.placa), d.topCarros.map(c=>c.total), COLORES[2]);
    },100);
}

// TI
function renderTI(d, el) {
    el.innerHTML = `
    <div class="kpi-row">
        ${kpi(d.totalEquipos,'Total equipos','','azul')}
        ${kpi(d.asigActivas,'Asignaciones activas','','verde')}
        ${kpi(d.asigInactivas,'Asignaciones inactivas','','gris')}
        ${kpi(d.equiposSinAsignar,'Equipos disponibles','(estado Activo)','celeste')}
    </div>
    <div class="chart-grid-3">
        ${card('Equipos por tipo','Distribución por categoría',canvasWrap('ch-ti-tipo',190))}
        ${card('Estado de equipos','Distribución actual',canvasWrap('ch-ti-est',190))}
        ${card('Asignaciones por mes','Últimos 6 meses',canvasWrap('ch-ti-meses',190))}
    </div>
    <div class="chart-grid-2">
        ${card('Asignaciones activas vs inactivas','Proporción general',canvasWrap('ch-ti-asig',160))}
        ${card('Últimas asignaciones','10 más recientes',`<div style="overflow-x:auto">${tabla(
            ['Empleado','Equipo','Área','Estado','Fecha'],
            d.ultimasAsig.map(a=>[a.empleado, a.equipo, a.area, badgeEstado(a.estado), a.fecha]),
            'Sin asignaciones'
        )}</div>`)}
    </div>`;
    setTimeout(()=>{
        crearGrafico('ch-ti-tipo','bar', d.porTipo.map(t=>t.tipo), d.porTipo.map(t=>t.total), COLORES.slice(0,d.porTipo.length));
        crearGrafico('ch-ti-est','doughnut', d.porEstado.map(e=>e.estado), d.porEstado.map(e=>e.total));
        crearGrafico('ch-ti-meses','bar', d.asigsPorMes.map(m=>m.mes), d.asigsPorMes.map(m=>m.total), COLORES[1]);
        crearGrafico('ch-ti-asig','doughnut', ['Activas','Inactivas'], [d.asigActivas,d.asigInactivas], [COLORES[2],COLORES[8]]);
    },100);
}

// PRODUCCIÓN
function renderProduccion(d, el) {
    el.innerHTML = `
    <div class="kpi-row">
