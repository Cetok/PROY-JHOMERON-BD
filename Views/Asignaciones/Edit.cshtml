@model PROYJHOME2026.Models.Asignacion
@{
    ViewData["Title"]      = "Editar Asignación";
    ViewData["Breadcrumb"] = "Asignaciones / Editar";
    var equiposJson = ViewBag.EquiposJson as string ?? "[]";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Equipos TI</div>
        <h1 class="page-header__title">Editar Asignación #@Model.IdAsignacion</h1>
        <p class="page-header__subtitle">
            @(Model.Empleado?.nombre ?? "") @(Model.Empleado?.paterno ?? "") →
            @(Model.Equipo?.marca ?? "") @(Model.Equipo?.modelo ?? "")
        </p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Details" asp-route-id="@Model.IdAsignacion" class="btn btn--ghost btn--sm">Ver detalle</a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:680px;">
    <div class="card">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="IdAsignacion"     type="hidden" />
            <input asp-for="EstadoAsignacion" type="hidden" />

            <!-- Empleado y Equipo -->
            <div style="margin-bottom:24px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Empleado y Equipo
                </p>
                <div class="form-grid">
                    <div class="form-group form-group--full">
                        <label class="form-label">Empleado <span class="req">*</span></label>
                        <select asp-for="IdEmpleado" asp-items="ViewBag.EmpleadosList" class="form-control">
                            <option value="">— Seleccionar empleado —</option>
                        </select>
                        <span asp-validation-for="IdEmpleado" class="form-error"></span>
                    </div>
                    <div class="form-group form-group--full">
                        <label class="form-label">Equipo <span class="req">*</span></label>
                        <select asp-for="IdEquipo" asp-items="ViewBag.EquiposList"
                                class="form-control" id="selectEquipo" onchange="toggleChip()">
                            <option value="">— Seleccionar equipo —</option>
                        </select>
                        <span asp-validation-for="IdEquipo" class="form-error"></span>
                    </div>
                </div>
            </div>

            <!-- Chip — solo visible si el equipo es Celular -->
            <div id="seccionChip" style="margin-bottom:24px; display:none;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Chip / SIM
                </p>
                <div class="form-group">
                    <label class="form-label">Chip / SIM <span style="color:var(--gris-400); font-weight:400;">(opcional)</span></label>
                    <select asp-for="IdChip" asp-items="ViewBag.ChipsList" class="form-control">
                        <option value="">— Sin chip —</option>
                    </select>
                    <span asp-validation-for="IdChip" class="form-error"></span>
                </div>
            </div>

            <!-- Área / Grupo y datos adicionales -->
            <div style="margin-bottom:24px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Área y datos adicionales
                </p>
                <div class="form-grid">
                    <div class="form-group form-group--full">
                        <label class="form-label">Área / Grupo <span style="color:var(--gris-400); font-weight:400;">(opcional)</span></label>
                        <select asp-for="IdGrupo" asp-items="ViewBag.GruposList" class="form-control">
                            <option value="">— Sin área —</option>
                        </select>
                        <span asp-validation-for="IdGrupo" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Fecha de asignación <span class="req">*</span></label>
                        <input asp-for="FechaAsignacion" type="date" class="form-control" />
                        <span asp-validation-for="FechaAsignacion" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Número de cargo</label>
                        <input asp-for="NumeroCargo" class="form-control"
                               placeholder="Ej: C-001, EQ-2024-05..." />
                        <span asp-validation-for="NumeroCargo" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Correo del equipo</label>
                        <input asp-for="CorreoEquipo" type="email" class="form-control" />
                        <span asp-validation-for="CorreoEquipo" class="form-error"></span>
                    </div>
                </div>
            </div>

            <div style="display:flex; gap:10px; padding-top:4px; border-top:1px solid var(--gris-200);">
                <button type="submit" class="btn btn--primary btn--lg">
                    <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v14a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    Guardar cambios
                </button>
                <a asp-action="Index" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
// ── Equipos disponibles con su tipo para detectar celular ────
const equipos      = @Html.Raw(equiposJson);
const selectEquipo = document.getElementById('selectEquipo');
const seccionChip  = document.getElementById('seccionChip');

function toggleChip() {
    const equipo    = equipos.find(e => e.id == selectEquipo.value);
    const esCelular = equipo ? equipo.tipo?.toLowerCase().includes('celular') : false;
    seccionChip.style.display = esCelular ? 'block' : 'none';

    if (!esCelular) {
        const sel = seccionChip.querySelector('select');
        if (sel) sel.value = '';
    }
}

// Al cargar verificar si el equipo actual es celular
toggleChip();
</script>
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
