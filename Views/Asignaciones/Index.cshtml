@model IEnumerable<PROYJHOME2026.Models.Asignacion>
@{
    ViewData["Title"]      = "Asignaciones";
    ViewData["Breadcrumb"] = "Asignaciones";
    int    pagina       = ViewBag.Pagina;
    int    totalPaginas = ViewBag.TotalPaginas;
    int    total        = ViewBag.Total;
    int    porPagina    = ViewBag.PorPagina ?? 10;
    string buscar       = ViewBag.Buscar ?? "";
    string estado       = ViewBag.Estado ?? "";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Equipos TI</div>
        <h1 class="page-header__title">Asignaciones</h1>
        <p class="page-header__subtitle">@total asignación(es) encontrada(s)</p>
    </div>
    <div class="page-header__actions">
        <a asp-controller="Reportes" asp-action="Index" asp-route-tab="asignaciones" class="btn btn--secondary btn--sm">
            <svg viewBox="0 0 24 24" style="width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
            </svg>
            Reportes
        </a>
        <a asp-action="Create" class="btn btn--celeste">
            <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nueva asignación
        </a>
    </div>
</div>

<!-- FILTROS -->
<div class="card" style="margin-bottom:20px; padding:16px 20px;">
    <form method="get" asp-action="Index" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
        <div style="flex:1; min-width:200px;">
            <label class="form-label">Buscar</label>
            <div style="position:relative;">
                <svg style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:15px;height:15px;stroke:var(--gris-400);fill:none;stroke-width:2;stroke-linecap:round;pointer-events:none;" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" name="buscar" value="@buscar" class="form-control"
                       style="padding-left:34px;" placeholder="Empleado, equipo, serie, área..." />
            </div>
        </div>
        <div style="min-width:160px;">
            <label class="form-label">Estado</label>
            <select name="estado" class="form-control">
                <option value="">Todos</option>
                @if (estado == "Activo") { <option value="Activo" selected>✓ Activo</option> }
                else { <option value="Activo">✓ Activo</option> }
                @if (estado == "En mantenimiento") { <option value="En mantenimiento" selected>⚙ Mantenimiento</option> }
                else { <option value="En mantenimiento">⚙ Mantenimiento</option> }
                @if (estado == "Inactivo") { <option value="Inactivo" selected>✗ Inactivo</option> }
                else { <option value="Inactivo">✗ Inactivo</option> }
            </select>
        </div>
        <div style="display:flex; gap:8px;">
            <button type="submit" class="btn btn--primary">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                Buscar
            </button>
            @if (!string.IsNullOrEmpty(buscar) || !string.IsNullOrEmpty(estado))
            {
                <a asp-action="Index" class="btn btn--secondary">Limpiar</a>
            }
        </div>
    </form>
</div>

<!-- TABLA -->
<div class="card" style="padding:0; overflow:hidden;">
    @if (Model.Any())
    {
        <div class="table-wrapper" style="border:none; border-radius:0;">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Empleado</th>
                        <th>Equipo</th>
                        <th>Área / Grupo</th>
                        <th>Fecha asignación</th>
                        <th>Estado</th>
                        <th style="text-align:center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int itemNum = (pagina - 1) * porPagina + 1; }
                    @foreach (var a in Model)
                    {
                        <tr>
                            <!-- ✅ Número correlativo con paginación -->
                            <td style="color:var(--gris-400); font-size:0.78rem; font-weight:400; width:50px;">
                                @itemNum
                            </td>
                            <td>
                                <div style="font-weight:600; font-size:0.86rem; color:var(--gris-900);">
                                    @(a.Empleado?.nombre ?? "—") @(a.Empleado?.paterno ?? "")
                                </div>
                                @if (!string.IsNullOrEmpty(a.Empleado?.dni))
                                {
                                    <div style="font-size:0.74rem; color:var(--gris-400);">@a.Empleado.dni</div>
                                }
                            </td>
                            <td style="font-size:0.82rem; color:var(--gris-600);">
                                @(a.Equipo?.marca ?? "—") @(a.Equipo?.modelo ?? "")
                                @if (!string.IsNullOrEmpty(a.Equipo?.numero_serie))
                                {
                                    <div style="font-size:0.72rem; font-family:monospace; color:var(--gris-400);">@a.Equipo.numero_serie</div>
                                }
                            </td>
                            <!-- ✅ Área/Grupo en lugar de chip -->
                            <td style="font-size:0.82rem; color:var(--gris-600);">
                                @if (a.Grupo != null)
                                {
                                    <span class="badge badge--azul" style="font-size:0.72rem;">@a.Grupo.area</span>
                                }
                                else
                                {
                                    <span style="color:var(--gris-300);">—</span>
                                }
                            </td>
                            <td style="font-size:0.8rem; color:var(--gris-600);">
                                @a.FechaAsignacion.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @{
                                    var bc = a.EstadoAsignacion == "Activo"           ? "badge--verde"
                                           : a.EstadoAsignacion == "En mantenimiento" ? "badge--amarillo"
                                           : a.EstadoAsignacion == "Inactivo"         ? "badge--rojo"
                                           : "badge--gris";
                                }
                                <span class="badge @bc">@a.EstadoAsignacion</span>
                            </td>
                            <td>
                                <div style="display:flex; gap:6px; justify-content:center;">
                                    <a asp-action="Details" asp-route-id="@a.IdAsignacion"
                                       class="btn btn--ghost btn--icon" title="Ver detalle">
                                        <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </a>
                                    @if (a.EstadoAsignacion == "Activo")
                                    {
                                        <a asp-action="Edit" asp-route-id="@a.IdAsignacion"
                                           class="btn btn--secondary btn--icon" title="Editar">
                                            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                        itemNum++;
                    }
                </tbody>
            </table>
        </div>

        @if (totalPaginas > 1)
        {
            <div class="pagination">
                <span style="font-size:0.75rem; color:var(--gris-400); margin-right:8px;">
                    Página @pagina de @totalPaginas
                </span>
                @if (pagina > 1)
                {
                    <a asp-action="Index" asp-route-pagina="@(pagina-1)"
                       asp-route-buscar="@buscar" asp-route-estado="@estado"
                       class="pagination__btn">
                        <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                    </a>
                }
                @for (int i = Math.Max(1, pagina - 2); i <= Math.Min(totalPaginas, pagina + 2); i++)
                {
                    <a asp-action="Index" asp-route-pagina="@i"
                       asp-route-buscar="@buscar" asp-route-estado="@estado"
                       class="pagination__btn @(i == pagina ? "active" : "")">@i</a>
                }
                @if (pagina < totalPaginas)
                {
                    <a asp-action="Index" asp-route-pagina="@(pagina+1)"
                       asp-route-buscar="@buscar" asp-route-estado="@estado"
                       class="pagination__btn">
                        <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state__icon">
                <svg viewBox="0 0 24 24"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 014-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 01-4 4H3"/></svg>
            </div>
            <div class="empty-state__title">No se encontraron asignaciones</div>
            <div class="empty-state__text">
                @if (!string.IsNullOrEmpty(buscar) || !string.IsNullOrEmpty(estado))
                { <span>Intenta con otros filtros.</span> }
                else { <span>Aún no hay asignaciones registradas.</span> }
            </div>
        </div>
    }
</div>
