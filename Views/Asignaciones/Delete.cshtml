@model PROYJHOME2026.Models.Asignacion
@{
    ViewData["Title"]      = "Eliminar Asignación";
    ViewData["Breadcrumb"] = "Asignaciones / Eliminar";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Equipos TI</div>
        <h1 class="page-header__title">Eliminar Asignación</h1>
        <p class="page-header__subtitle">Esta acción no se puede deshacer</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Cancelar
        </a>
    </div>
</div>

<div style="max-width:560px;">

    <div class="alert alert--danger" style="margin-bottom:20px;">
        <svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <span>Si esta asignación tiene historiales registrados, no se podrá eliminar.</span>
    </div>

    <div class="card" style="margin-bottom:20px;">
        <div style="display:grid; gap:14px;">
            <div>
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px;">Empleado</div>
                <div style="font-weight:600; color:var(--gris-900);">
                    @(Model.Empleado?.nombre ?? "—") @(Model.Empleado?.paterno ?? "") @(Model.Empleado?.materno ?? "")
                </div>
            </div>
            <div>
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px;">Equipo</div>
                <div style="font-weight:600; color:var(--gris-900);">
                    @(Model.Equipo?.marca ?? "—") @(Model.Equipo?.modelo ?? "")
                </div>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
                <div>
                    <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px;">Chip</div>
                    <div style="font-size:0.85rem; color:var(--gris-700); font-family:monospace;">
                        @(Model.Chip?.NumeroCelular ?? "Sin chip")
                    </div>
                </div>
                <div>
                    <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px;">Estado</div>
                    @{
                        var bc = Model.EstadoAsignacion == "Activo"   ? "badge--verde"
                               : Model.EstadoAsignacion == "Devuelto" ? "badge--gris"
                               : "badge--rojo";
                    }
                    <span class="badge @bc">@Model.EstadoAsignacion</span>
                </div>
                <div>
                    <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px;">Fecha asignación</div>
                    <div style="font-size:0.85rem; color:var(--gris-700);">@Model.FechaAsignacion.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdAsignacion" />
        <div style="display:flex; gap:10px;">
            <button type="submit" class="btn btn--danger btn--lg">
                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6M9 6V4h6v2"/></svg>
                Sí, eliminar definitivamente
            </button>
            <a asp-action="Details" asp-route-id="@Model.IdAsignacion" class="btn btn--secondary btn--lg">
                No, conservar
            </a>
        </div>
    </form>
</div>
