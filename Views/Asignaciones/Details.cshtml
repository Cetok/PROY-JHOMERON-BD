@model PROYJHOME2026.Models.Asignacion
@{
    ViewData["Title"]      = "Detalle Asignación";
    ViewData["Breadcrumb"] = "Asignaciones / Detalle";
    bool activa = Model.EstadoAsignacion == "Activo";
    var bc      = activa ? "badge--verde" : "badge--gris";
    var historial = ViewBag.HistorialCambios as List<PROYJHOME2026.Models.AuditoriaLog>;
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Equipos TI</div>
        <h1 class="page-header__title">Asignación #@Model.IdAsignacion</h1>
        <p class="page-header__subtitle">
            @(Model.Empleado?.nombre ?? "—") @(Model.Empleado?.paterno ?? "") →
            @{
                var tipoSub = Model.Equipo?.TipoEquipo?.tipo ?? "";
                var nombreSub = tipoSub.ToUpper().Contains("PC COMPLETO") && !string.IsNullOrEmpty(Model.Equipo?.NombrePc)
                    ? Model.Equipo!.NombrePc
                    : (Model.Equipo?.marca ?? "—") + (string.IsNullOrEmpty(Model.Equipo?.modelo) ? "" : " " + Model.Equipo!.modelo);
            }
            @nombreSub
        </p>
    </div>
    <div class="page-header__actions">
        @if (activa)
        {
            <a asp-action="Edit" asp-route-id="@Model.IdAsignacion" class="btn btn--celeste btn--sm">
                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Editar
            </a>
        }
        <a asp-action="Index" class="btn btn--secondary btn--sm">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

@if (!activa)
{
    <div class="alert alert--warning" style="margin-bottom:16px;">
        <svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <span>Esta asignación está <strong>Inactiva</strong>. Ya no se pueden registrar nuevos eventos.</span>
    </div>
}

<!-- DATOS PRINCIPALES -->
<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">

    <!-- Empleado -->
    <div class="card">
        <p class="det-section-title">Empleado</p>
        <div style="display:flex; align-items:center; gap:12px;">
            <div class="mini-avatar">
                @((Model.Empleado?.nombre?.Length > 0 ? Model.Empleado.nombre[0].ToString() : "?").ToUpper())@((Model.Empleado?.paterno?.Length > 0 ? Model.Empleado.paterno[0].ToString() : "").ToUpper())
            </div>
            <div>
                <div style="font-weight:700; color:var(--gris-900); font-size:0.95rem;">
                    @(Model.Empleado?.nombre ?? "—") @(Model.Empleado?.paterno ?? "") @(Model.Empleado?.materno ?? "")
                </div>
                <div style="font-size:0.78rem; color:var(--gris-500); margin-top:2px;">
                    DNI: @(Model.Empleado?.dni ?? "—")
                </div>
            </div>
        </div>
    </div>

    <!-- Equipo -->
    <div class="card">
        <p class="det-section-title">Equipo asignado</p>
        <div style="font-weight:700; font-size:0.95rem; color:var(--gris-900);">
            @{
                var tipoEq = Model.Equipo?.TipoEquipo?.tipo ?? "";
                var nombreEq = tipoEq == "PC Completo" && !string.IsNullOrEmpty(Model.Equipo?.NombrePc)
                    ? Model.Equipo!.NombrePc
                    : (Model.Equipo?.marca ?? "—") + (string.IsNullOrEmpty(Model.Equipo?.modelo) ? "" : " " + Model.Equipo!.modelo);
            }
            @nombreEq
        </div>
        @if (Model.Equipo?.TipoEquipo != null)
        {
            <span class="badge badge--azul" style="margin-top:6px; display:inline-block; font-size:0.72rem;">@Model.Equipo.TipoEquipo.tipo</span>
        }
        <div style="font-size:0.78rem; color:var(--gris-500); margin-top:6px; font-family:monospace;">
            Serie: @(Model.Equipo?.numero_serie ?? "—")
        </div>
    </div>
</div>

<!-- DETALLES DE LA ASIGNACIÓN -->
<div class="card" style="margin-bottom:16px;">
    <p class="det-section-title">Detalles de la asignación</p>
    <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:16px;">
        <div class="det-field">
            <div class="det-label">Estado</div>
            <div class="det-value"><span class="badge @bc">@Model.EstadoAsignacion</span></div>
        </div>
        <div class="det-field">
            <div class="det-label">Fecha asignación</div>
            <div class="det-value">@Model.FechaAsignacion.ToString("dd/MM/yyyy")</div>
        </div>
        <div class="det-field">
            <div class="det-label">Chip / SIM</div>
            <div class="det-value" style="font-family:monospace;">
                @if (Model.Chip != null)
                { @Model.Chip.NumeroCelular }
                else
                { <span style="color:var(--gris-400); font-weight:400;">Sin chip</span> }
            </div>
        </div>
        <div class="det-field">
            <div class="det-label">Grupo / Área</div>
            <div class="det-value">@(Model.Grupo?.area ?? "—")</div>
        </div>
        @if (!string.IsNullOrEmpty(Model.CorreoEquipo))
        {
            <div class="det-field">
                <div class="det-label">Correo corporativo</div>
                <div class="det-value">@Model.CorreoEquipo</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.NumeroCargo))
        {
            <div class="det-field">
                <div class="det-label">N° Cargo</div>
                <div class="det-value" style="font-family:monospace; color:var(--azul); font-weight:700;">@Model.NumeroCargo</div>
            </div>
        }
    </div>
</div>

<!-- HISTORIAL DE EVENTOS (de la asignación) -->
<div class="card" style="padding:0; overflow:hidden; margin-bottom:16px;">
    <div style="padding:14px 20px; border-bottom:1px solid var(--gris-200); display:flex; align-items:center; justify-content:space-between;">
        <div>
            <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">Historial de eventos</div>
            <div style="font-size:0.75rem; color:var(--gris-400); margin-top:2px;">Eventos registrados en esta asignación</div>
        </div>
        @if (activa)
        {
            <a asp-controller="Historiales" asp-action="Create"
               asp-route-asignacionId="@Model.IdAsignacion"
               class="btn btn--celeste btn--sm">
                <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Agregar evento
            </a>
        }
    </div>

    @if (Model.Historiales != null && Model.Historiales.Any())
    {
        <div class="table-wrapper" style="border:none; border-radius:0;">
            <table>
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Motivo</th>
                        <th>Observaciones</th>
                        <th style="text-align:center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model.Historiales.OrderByDescending(h => h.Fecha))
                    {
                        bool esCierre = new[] { "Devuelto", "Perdida", "Rotura", "Baja" }
                            .Contains(h.Motivo?.TipoMotivo ?? "");
                        <tr>
                            <td style="font-size:0.82rem; white-space:nowrap; color:var(--gris-500);">
                                @h.Fecha.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                <span class="badge @(esCierre ? "badge--rojo" : "badge--celeste")" style="font-size:0.7rem;">
                                    @(h.Motivo?.TipoMotivo ?? "—")
                                </span>
                            </td>
                            <td style="font-size:0.82rem; color:var(--gris-600); max-width:260px;">
                                @if (!string.IsNullOrEmpty(h.Observaciones))
                                { <span>@h.Observaciones</span> }
                                else
                                { <span style="color:var(--gris-300);">—</span> }
                            </td>
                            <td>
                                <div style="display:flex; gap:6px; justify-content:center;">
                                    <a asp-controller="Historiales" asp-action="Details" asp-route-id="@h.IdHistoria"
                                       class="btn btn--ghost btn--icon" title="Ver">
                                        <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </a>
                                    <a asp-controller="Historiales" asp-action="Delete" asp-route-id="@h.IdHistoria"
                                       class="btn btn--danger btn--icon" title="Eliminar">
                                        <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state" style="padding:28px 20px;">
            <div class="empty-state__icon" style="width:40px; height:40px;">
                <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            </div>
            <div class="empty-state__title" style="font-size:0.9rem;">Sin eventos registrados</div>
            <div class="empty-state__text">
                @if (activa)
                { <span>Usa el botón "Agregar evento" para registrar un cambio.</span> }
                else
                { <span>Esta asignación no tiene eventos registrados.</span> }
            </div>
        </div>
    }
</div>

<!-- HISTORIAL DE CAMBIOS (auditoría) -->
@if (historial != null && historial.Any())
{
    <div class="card" style="padding:0; overflow:hidden;">
        <div style="padding:14px 20px; border-bottom:1px solid var(--gris-200); display:flex; justify-content:space-between; align-items:center;">
            <span style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">📋 Historial de cambios</span>
            <span class="badge badge--gris">@historial.Count registro(s)</span>
        </div>
        <div class="table-wrapper" style="border:none; border-radius:0; max-height:320px; overflow-y:auto;">
            <table>
                <thead>
                    <tr>
                        <th>Fecha / Hora</th>
                        <th>Acción</th>
                        <th>Descripción / Cambio</th>
                        <th>Datos anteriores</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in historial)
                    {
                        string accionColor;
                        if      (log.Accion == "Crear")        accionColor = "badge--verde";
                        else if (log.Accion == "Editar")       accionColor = "badge--azul";
                        else if (log.Accion == "Eliminar")     accionColor = "badge--rojo";
                        else if (log.Accion == "CambioEstado") accionColor = "badge--amarillo";
                        else                                    accionColor = "badge--gris";
                        <tr>
                            <td style="font-size:0.75rem; color:var(--gris-400); white-space:nowrap;">@log.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge @accionColor" style="font-size:0.68rem;">@log.Accion</span></td>
                            <td style="font-size:0.8rem; color:var(--gris-800); max-width:250px;">@(log.Descripcion ?? "—")</td>
                            <td style="font-size:0.75rem; color:var(--gris-500); max-width:200px;">
                                @if (!string.IsNullOrEmpty(log.DatosAnteriores))
                                {
                                    <span title="@log.DatosAnteriores">
                                        @(log.DatosAnteriores.Length > 60 ? log.DatosAnteriores[..60] + "…" : log.DatosAnteriores)
                                    </span>
                                }
                                else { <span style="color:var(--gris-300);">—</span> }
                            </td>
                            <td style="font-size:0.75rem; color:var(--azul);">@(log.NombreUsuario ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Styles {
<style>
.det-label { font-size:0.67rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px; }
.det-value { font-size:0.88rem; font-weight:500; color:var(--gris-900); }
.det-section-title { font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); padding-bottom:8px; border-bottom:1px solid var(--gris-200); margin-bottom:14px; }
.mini-avatar { width:40px; height:40px; border-radius:50%; background:linear-gradient(135deg,var(--azul-mid),var(--celeste)); display:grid; place-items:center; font-weight:700; font-size:0.75rem; color:white; flex-shrink:0; }
</style>
}
