@model PROYJHOME2026.Models.Asignacion
@{
    ViewData["Title"]      = "Detalle Asignación";
    ViewData["Breadcrumb"] = "Asignaciones / Detalle";
    bool activa = Model.EstadoAsignacion == "Activo";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Equipos TI</div>
        <h1 class="page-header__title">Asignación #@Model.IdAsignacion</h1>
        <p class="page-header__subtitle">
            @(Model.Empleado?.nombre ?? "—") @(Model.Empleado?.paterno ?? "") →
            @(Model.Equipo?.marca ?? "—") @(Model.Equipo?.modelo ?? "")
        </p>
    </div>
    <div class="page-header__actions">
        @if (activa)
        {
            <a asp-action="Edit" asp-route-id="@Model.IdAsignacion" class="btn btn--secondary btn--sm">
                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Editar
            </a>
            <a asp-controller="Historiales" asp-action="Create"
               asp-route-asignacionId="@Model.IdAsignacion"
               class="btn btn--celeste">
                <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                Registrar evento
            </a>
        }
        <a asp-action="Index" class="btn btn--ghost btn--sm">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

@if (!activa)
{
    <div class="alert alert--warning" style="margin-bottom:20px; max-width:780px;">
        <svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <span>Esta asignación está <strong>Inactiva</strong>. Ya no se pueden registrar nuevos eventos.</span>
    </div>
}

<div style="max-width:1060px; display:flex; gap:16px; align-items:flex-start;">

<!-- Columna principal -->
<div style="flex:1; min-width:0; display:flex; flex-direction:column; gap:16px;">

    <!-- Card datos de asignación -->
    <div class="card">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:22px; padding-bottom:18px; border-bottom:1px solid var(--gris-200); flex-wrap:wrap;">
            @{
                var bc = Model.EstadoAsignacion == "Activo" ? "badge--verde" : "badge--gris";
            }
            <span class="badge @bc" style="font-size:0.8rem; padding:5px 12px;">@Model.EstadoAsignacion</span>
            <span style="font-size:0.8rem; color:var(--gris-500);">
                Asignado el @Model.FechaAsignacion.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-PE"))
            </span>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px;">

            <!-- Empleado -->
            <div style="grid-column:1/-1; padding-bottom:16px; border-bottom:1px solid var(--gris-200);">
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:8px;">Empleado</div>
                <div style="display:flex; align-items:center; gap:10px;">
                    <div class="mini-avatar">
                        @((Model.Empleado?.nombre?.Length > 0 ? Model.Empleado.nombre[0].ToString() : "?").ToUpper())@((Model.Empleado?.paterno?.Length > 0 ? Model.Empleado.paterno[0].ToString() : "").ToUpper())
                    </div>
                    <div>
                        <div style="font-weight:600; color:var(--gris-900);">
                            @(Model.Empleado?.nombre ?? "—") @(Model.Empleado?.paterno ?? "") @(Model.Empleado?.materno ?? "")
                        </div>
                        <div style="font-size:0.78rem; color:var(--gris-500);">DNI: @(Model.Empleado?.dni ?? "—")</div>
                    </div>
                </div>
            </div>

            <!-- Equipo -->
            <div style="grid-column:span 2; padding-bottom:16px; border-bottom:1px solid var(--gris-200);">
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:8px;">Equipo</div>
                <div style="font-weight:600; color:var(--gris-900);">
                    @(Model.Equipo?.marca ?? "—") @(Model.Equipo?.modelo ?? "")
                </div>
                @if (Model.Equipo?.TipoEquipo != null)
                {
                    <span class="badge badge--azul" style="margin-top:5px; display:inline-block;">@Model.Equipo.TipoEquipo.tipo</span>
                }
                <div style="font-size:0.78rem; color:var(--gris-500); margin-top:4px;">
                    Serie: @(Model.Equipo?.numero_serie ?? "—")
                </div>
            </div>

            <!-- Chip -->
            <div style="padding-bottom:16px; border-bottom:1px solid var(--gris-200);">
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:8px;">Chip / SIM</div>
                @if (Model.Chip != null)
                {
                    <div style="font-family:monospace; font-weight:600; font-size:0.9rem; color:var(--gris-900);">@Model.Chip.NumeroCelular</div>
                }
                else
                {
                    <span style="color:var(--gris-400); font-size:0.84rem;">Sin chip asignado</span>
                }
            </div>

            <div>
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:4px;">Fecha asignación</div>
                <div style="font-size:0.88rem; font-weight:500; color:var(--gris-900);">@Model.FechaAsignacion.ToString("dd/MM/yyyy")</div>
            </div>
            <div>
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:4px;">Correo corporativo</div>
                @if (!string.IsNullOrEmpty(Model.NumeroCargo))
                {
                    <div class="det-field">
                        <div class="det-label">Número de cargo</div>
                        <div class="det-value" style="font-family:monospace; font-weight:700; color:var(--azul);">@Model.NumeroCargo</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.CorreoEquipo))
                {
                    <div style="font-size:0.88rem; font-weight:500; color:var(--gris-900);">@Model.CorreoEquipo</div>
                }
                else
                {
                    <span style="color:var(--gris-400); font-size:0.84rem;">No asignado</span>
                }
            </div>
            <div>
                <div style="font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:4px;">Estado</div>
                <span class="badge @bc">@Model.EstadoAsignacion</span>
            </div>
        </div>
    </div>

    <!-- Historial de eventos -->
    <div class="card" style="padding:0; overflow:hidden;">
        <div style="padding:16px 20px; border-bottom:1px solid var(--gris-200); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
            <div>
                <div class="card__title">Historial de eventos</div>
                <div class="card__subtitle">Todos los eventos registrados en esta asignación</div>
            </div>
            @if (activa)
            {
                <a asp-controller="Historiales" asp-action="Create"
                   asp-route-asignacionId="@Model.IdAsignacion"
                   class="btn btn--celeste btn--sm">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Agregar evento
                </a>
            }
        </div>

        @if (Model.Historiales != null && Model.Historiales.Any())
        {
            <div class="table-wrapper" style="border:none; border-radius:0;">
                <table>
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Motivo</th>
                            <th>Observaciones</th>
                            <th style="text-align:center;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.Historiales.OrderByDescending(h => h.Fecha))
                        {
                            bool esCierre = new[] { "Devuelto", "Perdida", "Rotura", "Baja" }
                                .Contains(h.Motivo?.TipoMotivo ?? "");
                            <tr>
                                <td style="font-size:0.82rem; white-space:nowrap; color:var(--gris-600);">
                                    @h.Fecha.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    @if (esCierre)
                                    {
                                        <span class="badge badge--rojo">@(h.Motivo?.TipoMotivo ?? "—")</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge--celeste">@(h.Motivo?.TipoMotivo ?? "—")</span>
                                    }
                                </td>
                                <td style="font-size:0.82rem; color:var(--gris-600); max-width:260px;">
                                    @if (!string.IsNullOrEmpty(h.Observaciones))
                                    {
                                        <span style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                                            @h.Observaciones
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--gris-300);">—</span>
                                    }
                                </td>
                                <td>
                                    <div style="display:flex; gap:6px; justify-content:center;">
                                        <a asp-controller="Historiales" asp-action="Details" asp-route-id="@h.IdHistoria"
                                           class="btn btn--ghost btn--icon" title="Ver">
                                            <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        </a>
                                        <a asp-controller="Historiales" asp-action="Delete" asp-route-id="@h.IdHistoria"
                                           class="btn btn--danger btn--icon" title="Eliminar">
                                            <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6M9 6V4h6v2"/></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state" style="padding:28px 20px;">
                <div class="empty-state__icon" style="width:40px; height:40px;">
                    <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                </div>
                <div class="empty-state__title" style="font-size:0.9rem;">Sin eventos registrados</div>
                <div class="empty-state__text">
                    @if (activa)
                    { <span>Usa el botón "Agregar evento" para registrar un cambio.</span> }
                    else
                    { <span>Esta asignación no tiene eventos registrados.</span> }
                </div>
            </div>
        }
    </div>

</div>


</div>

@section Styles {
<style>
.mini-avatar {
    width:36px; height:36px; border-radius:50%;
    background:linear-gradient(135deg, var(--azul-mid), var(--celeste));
    display:grid; place-items:center;
    font-family:var(--font-display); font-weight:700; font-size:0.72rem; color:var(--blanco); flex-shrink:0;
}
</style>
}
