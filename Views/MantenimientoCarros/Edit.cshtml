@model PROYJHOME2026.Models.MantenimientoCarro
@{
    ViewData["Title"]      = "Editar Mantenimiento";
    ViewData["Breadcrumb"] = "Mantenimientos / Editar";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Mantenimientos</div>
        <h1 class="page-header__title">Editar Mantenimiento</h1>
        <p class="page-header__subtitle">Solo disponible cuando está En proceso</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Details" asp-route-id="@Model.IdMante" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Cancelar
        </a>
    </div>
</div>

<div style="max-width:680px;">
    <div class="card">
        <form asp-action="Edit" asp-route-id="@Model.IdMante" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="IdMante" type="hidden" />
            <input asp-for="IdCarro" type="hidden" />
            <input asp-for="Estado" type="hidden" />

            <div style="background:var(--gris-50); border:1px solid var(--gris-200); border-radius:var(--r-sm); padding:10px 14px; margin-bottom:18px; font-size:0.85rem; color:var(--gris-700);">
                <strong>Vehículo:</strong> @Model.Carro?.Placa @Model.Carro?.Marca @Model.Carro?.Modelo
            </div>

            <div class="form-grid" style="margin-bottom:20px;">
                <div class="form-group">
                    <label class="form-label">Tipo de mantenimiento <span class="req">*</span></label>
                    <select asp-for="IdTipoMante" asp-items="ViewBag.TiposList" class="form-control">
                        <option value="">— Seleccionar tipo —</option>
                    </select>
                    <span asp-validation-for="IdTipoMante" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Fecha programada</label>
                    <input asp-for="FechaProgramada" type="date" class="form-control" />
                    <span asp-validation-for="FechaProgramada" class="form-error"></span>
                </div>
            </div>

            <div class="form-group" style="margin-bottom:24px;">
                <label class="form-label">Observaciones</label>
                <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="500"></textarea>
                <span asp-validation-for="Observaciones" class="form-error"></span>
            </div>

            <div style="display:flex; gap:10px; padding-top:4px; border-top:1px solid var(--gris-200);">
                <button type="submit" class="btn btn--celeste btn--lg">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    Guardar cambios
                </button>
                <a asp-action="Details" asp-route-id="@Model.IdMante" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
