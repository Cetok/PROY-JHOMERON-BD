@model PROYJHOME2026.Models.MantenimientoCarro
@{
    ViewData["Title"]      = "Nuevo Mantenimiento";
    ViewData["Breadcrumb"] = "Mantenimientos / Nuevo";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Flota Vehicular</div>
        <h1 class="page-header__title">Nuevo Mantenimiento</h1>
        <p class="page-header__subtitle">Se registrará como <strong>Pendiente</strong> hasta la fecha programada</p>
    </div>
    <div class="page-header__actions">
        <a asp-controller="TipoMantenimientos" asp-action="Index" class="btn btn--secondary btn--sm">
            <svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            Tipos
        </a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:680px;">
    <div class="card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div style="margin-bottom:24px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Información del mantenimiento
                </p>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Vehículo <span class="req">*</span></label>
                        <select asp-for="IdCarro" asp-items="ViewBag.CarrosList" class="form-control">
                            <option value="">— Seleccionar vehículo —</option>
                        </select>
                        <span asp-validation-for="IdCarro" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Tipo de mantenimiento <span class="req">*</span></label>
                        <select asp-for="IdTipoMante" asp-items="ViewBag.TiposList" class="form-control">
                            <option value="">— Seleccionar tipo —</option>
                        </select>
                        <span asp-validation-for="IdTipoMante" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Fecha programada <span class="req">*</span></label>
                        <input asp-for="FechaProgramada" type="date" class="form-control" />
                        <span asp-validation-for="FechaProgramada" class="form-error"></span>
                        <div class="form-hint">Fecha en que se realizará el mantenimiento.</div>
                    </div>
                </div>
            </div>

            <div style="margin-bottom:28px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Observaciones
                </p>
                <div class="form-group">
                    <textarea asp-for="Observaciones" class="form-control" rows="3"
                              maxlength="500" placeholder="Descripción del trabajo, piezas, notas..."></textarea>
                    <span asp-validation-for="Observaciones" class="form-error"></span>
                </div>
            </div>

            <div style="background:rgba(59,155,232,0.06); border:1px solid rgba(59,155,232,0.2); border-radius:var(--r-sm); padding:10px 14px; margin-bottom:20px; font-size:0.82rem; color:var(--azul);">
                📅 El mantenimiento quedará en estado <strong>Pendiente</strong>. Cuando llegue la fecha programada recibirás una notificación para dar inicio al proceso.
            </div>

            <div style="display:flex; gap:10px; padding-top:4px; border-top:1px solid var(--gris-200);">
                <button type="submit" class="btn btn--celeste btn--lg">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    Registrar mantenimiento
                </button>
                <a asp-action="Index" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
