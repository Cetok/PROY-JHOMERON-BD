@model PROYJHOME2026.Models.MantenimientoCarro
@{
    ViewData["Title"]      = "Eliminar Mantenimiento";
    ViewData["Breadcrumb"] = "Mantenimientos / Eliminar";
    var bc = Model.Estado switch {
        "En proceso"  => "badge--amarillo",
        "Culminado"   => "badge--verde",
        "Cancelado"   => "badge--rojo",
        _             => "badge--gris"
    };
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Mantenimientos</div>
        <h1 class="page-header__title">Eliminar Mantenimiento</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:500px;">
    <div class="card" style="border-color:var(--rojo-border);">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px; padding-bottom:14px; border-bottom:1px solid var(--gris-200);">
            <div style="width:44px;height:44px;border-radius:var(--r-md);background:var(--rojo-light);border:1px solid var(--rojo-border);display:grid;place-items:center;flex-shrink:0;">
                <svg viewBox="0 0 24 24" style="width:20px;height:20px;stroke:var(--rojo);fill:none;stroke-width:1.8;stroke-linecap:round;"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
            </div>
            <div>
                <div style="font-weight:700; font-size:0.95rem;">@Model.TipoMantenimiento?.Nombre</div>
                <div style="font-size:0.78rem; color:var(--gris-600);">
                    Vehículo: <strong style="font-family:monospace; color:var(--azul);">@Model.Carro?.Placa</strong>
                    — <span class="badge @bc" style="font-size:0.7rem;">@Model.Estado</span>
                </div>
            </div>
        </div>

        @if (Model.Estado == "En proceso")
        {
            <div style="background:rgba(245,158,11,0.1); border:1px solid rgba(245,158,11,0.3); border-radius:var(--r-sm); padding:10px 14px; margin-bottom:16px; font-size:0.82rem; color:#92400e;">
                ⚙️ Al eliminar, el vehículo volverá a estado <strong>Activo</strong> si no tiene otros mantenimientos en proceso.
            </div>
        }

        <div style="background:var(--rojo-light); border:1px solid var(--rojo-border); border-radius:var(--r-sm); padding:10px 14px; margin-bottom:16px; font-size:0.82rem; color:var(--rojo);">
            ⚠️ Esta acción no se puede deshacer.
        </div>

        <form asp-action="Delete" method="post" style="display:flex; gap:10px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.IdMante" />
            <button type="submit" class="btn btn--danger btn--lg">
                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6M9 6V4h6v2"/></svg>
                Eliminar definitivamente
            </button>
            <a asp-action="Details" asp-route-id="@Model.IdMante" class="btn btn--secondary btn--lg">Cancelar</a>
        </form>
    </div>
</div>
