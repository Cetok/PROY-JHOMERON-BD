@model PROYJHOME2026.Models.MantenimientoCarro
@{
    ViewData["Title"]      = "Detalle Mantenimiento";
    ViewData["Breadcrumb"] = "Mantenimientos / Detalle";
    var bc = Model.Estado switch {
        "En proceso"  => "badge--amarillo",
        "Culminado"   => "badge--verde",
        "Cancelado"   => "badge--rojo",
        _             => "badge--gris"
    };
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Mantenimientos</div>
        <h1 class="page-header__title">@Model.TipoMantenimiento?.Nombre</h1>
        <p class="page-header__subtitle">@Model.Carro?.Placa — @Model.Carro?.Marca @Model.Carro?.Modelo</p>
    </div>
    <div class="page-header__actions">
        @if (Model.Estado == "En proceso")
        {
            <a asp-action="Edit" asp-route-id="@Model.IdMante" class="btn btn--celeste">
                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Editar
            </a>
        }
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>


<div style="max-width:860px; display:flex; gap:16px; align-items:flex-start;">

    <!-- Info principal -->
    <div style="flex:1; min-width:0;">
        <div class="card">
            <div style="display:flex; align-items:center; gap:16px; margin-bottom:24px; padding-bottom:18px; border-bottom:1px solid var(--gris-200);">
                <div class="mante-icon-lg">
                    <svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
                </div>
                <div>
                    <div style="font-family:var(--font-display); font-size:1.1rem; font-weight:800; color:var(--azul-dark);">
                        @Model.TipoMantenimiento?.Nombre
                    </div>
                    <div style="font-size:0.85rem; color:var(--gris-600); margin-top:2px;">
                        Vehículo: <strong style="color:var(--azul); font-family:monospace;">@Model.Carro?.Placa</strong>
                        @Model.Carro?.Marca @Model.Carro?.Modelo
                    </div>
                    <span class="badge @bc" style="margin-top:6px; display:inline-block;">@Model.Estado</span>
                </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px;">
                <div class="det-field">
                    <div class="det-label">Fecha de inicio</div>
                    <div class="det-value">@(Model.FechaMante.HasValue ? Model.FechaMante.Value.ToString("dd/MM/yyyy") : "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Fecha de culminación</div>
                    <div class="det-value">@(Model.FechaCulminada.HasValue ? Model.FechaCulminada.Value.ToString("dd/MM/yyyy") : "—")</div>
                </div>
                <div class="det-field">
                    <div class="det-label">Estado</div>
                    <div class="det-value"><span class="badge @bc">@Model.Estado</span></div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Observaciones))
                {
                    <div class="det-field" style="grid-column:1/-1;">
                        <div class="det-label">Observaciones</div>
                        <div class="det-value">@Model.Observaciones</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Acciones rápidas -->
    <div style="width:220px; flex-shrink:0; display:flex; flex-direction:column; gap:12px;">

        @if (Model.Estado == "En proceso")
        {
            <div class="card" style="border-color:rgba(34,197,94,0.3); background:rgba(34,197,94,0.04);">
                <div style="font-weight:700; color:#15803d; font-size:0.82rem; margin-bottom:8px;">Culminar mantenimiento</div>
                <div style="font-size:0.75rem; color:var(--gris-600); margin-bottom:12px;">El vehículo volverá a estado Activo.</div>
                <form asp-action="Culminar" asp-route-id="@Model.IdMante" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn--verde btn--sm" style="width:100%; justify-content:center;">
                        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                        Marcar culminado
                    </button>
                </form>
            </div>

            <div class="card" style="border-color:rgba(245,158,11,0.3); background:rgba(245,158,11,0.04);">
                <div style="font-weight:700; color:#b45309; font-size:0.82rem; margin-bottom:8px;">Cancelar mantenimiento</div>
                <div style="font-size:0.75rem; color:var(--gris-600); margin-bottom:12px;">El vehículo volverá a estado Activo.</div>
                <form asp-action="Cancelar" asp-route-id="@Model.IdMante" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn--warning btn--sm" style="width:100%; justify-content:center;"
                            onclick="return confirm('¿Cancelar este mantenimiento?')">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                        Cancelar
                    </button>
                </form>
            </div>
        }

        <div class="card" style="border-color:var(--rojo-border); background:var(--rojo-light);">
            <div style="font-weight:700; color:var(--rojo); font-size:0.82rem; margin-bottom:6px;">Zona de peligro</div>
            <div style="font-size:0.75rem; color:var(--gris-600); margin-bottom:12px;">Eliminar registro permanentemente.</div>
            <a asp-action="Delete" asp-route-id="@Model.IdMante" class="btn btn--danger btn--sm" style="width:100%; justify-content:center;">
                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                Eliminar
            </a>
        </div>

    </div>
</div>

@section Styles {
<style>
.mante-icon-lg {
    width:56px; height:56px; border-radius:var(--r-md);
    background:linear-gradient(135deg, #b45309, #d97706);
    display:grid; place-items:center; flex-shrink:0;
    box-shadow:0 4px 16px rgba(180,83,9,0.3);
}
.mante-icon-lg svg { width:26px; height:26px; stroke:white; fill:none; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
.det-label { font-size:0.67rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:3px; }
.det-value { font-size:0.88rem; font-weight:500; color:var(--gris-900); }
.btn--verde { background:#16a34a; color:white; border:none; cursor:pointer; }
.btn--verde:hover { background:#15803d; }
.btn--warning { background:#d97706; color:white; border:none; cursor:pointer; }
.btn--warning:hover { background:#b45309; }
</style>
}
