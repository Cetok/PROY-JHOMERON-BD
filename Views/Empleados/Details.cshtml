@model PROYJHOME2026.Models.Empleado
@{
    ViewData["Title"]      = "Detalle Empleado";
    ViewData["Breadcrumb"] = "Empleados / Detalle";
    var grupos  = ViewBag.Grupos  as List<PROYJHOME2026.Models.Grupo>         ?? new();
    var seguros = ViewBag.Seguros as List<PROYJHOME2026.Models.EmpleadoSeguro> ?? new();
    var estadoLog = ViewBag.EstadoLog as List<PROYJHOME2026.Models.EmpleadoEstadoLog> ?? new();
    var ebc = Model.estado switch {
        "Activo"    => "badge--verde",
        "Inactivo"  => "badge--rojo",
        "Licencia"  => "badge--amarillo",
        "Suspendido"=> "badge--gris",
        _           => "badge--gris"
    };
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Recursos Humanos</div>
        <h1 class="page-header__title">@Model.nombre @Model.paterno @Model.materno</h1>
        <p class="page-header__subtitle">ID: #@Model.idEmpleado</p>
    </div>
     <div class="page-header__actions">
        @if (Context.Session.GetString("UsuarioRol") == "Admin")
        {
            <a asp-action="Edit" asp-route-id="@Model.idEmpleado" class="btn btn--celeste">
                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Editar
            </a>
        }
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>


<div class="emp-details-layout">

    <!-- COLUMNA IZQUIERDA: datos + seguros -->
    <div style="display:flex; flex-direction:column; gap:16px;">

        <!-- DATOS DEL EMPLEADO -->
        <div class="card">
            <div style="display:flex; align-items:center; gap:14px; margin-bottom:22px; padding-bottom:18px; border-bottom:1px solid var(--gris-200);">
                <div class="emp-avatar-lg">
                    @((Model.nombre?.Length > 0 ? Model.nombre[0].ToString() : "?").ToUpper())@((Model.paterno?.Length > 0 ? Model.paterno[0].ToString() : "").ToUpper())
                </div>
                <div>
                    <div style="font-family:var(--font-display); font-size:1.1rem; font-weight:700; color:var(--azul-dark);">
                        @Model.nombre @Model.paterno @Model.materno
                    </div>
                    <div style="font-size:0.78rem; color:var(--gris-500); margin-top:3px;">
                        @(Model.TipoDocumento == "Carnet" ? "Carnet" : "DNI"): @(Model.dni ?? "No registrado")
                    </div>
                    <div style="margin-top:7px;">
                        @{ var bc = Model.estado == "Activo" ? "badge--verde" : Model.estado == "Inactivo" ? "badge--rojo" : "badge--gris"; }
                        <span class="badge @bc">@(Model.estado ?? "Sin estado")</span>
                    </div>
                </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <div class="det-field"><div class="det-label">Nombre</div><div class="det-value">@(Model.nombre ?? "—")</div></div>
                <div class="det-field"><div class="det-label">Ap. Paterno</div><div class="det-value">@(Model.paterno ?? "—")</div></div>
                <div class="det-field"><div class="det-label">Ap. Materno</div><div class="det-value">@(Model.materno ?? "—")</div></div>
                <div class="det-field">
                    <div class="det-label">Tipo de documento</div>
                    <div class="det-value">
                        @if (Model.TipoDocumento == "Carnet")
                        { <span>Carnet de Extranjería</span> }
                        else
                        { <span>DNI</span> }
                    </div>
                </div>
                <div class="det-field">
                    <div class="det-label">@(Model.TipoDocumento == "Carnet" ? "N° Carnet" : "DNI")</div>
                    <div class="det-value" style="font-family:monospace; letter-spacing:0.05em;">@(Model.dni ?? "—")</div>
                </div>
                <div class="det-field" style="grid-column:1/-1;">
                    <div class="det-label">Correo</div>
                    <div class="det-value" style="color:var(--celeste);">
                        @if (!string.IsNullOrEmpty(Model.correo))
                        { <a href="mailto:@Model.correo" style="color:var(--celeste);">@Model.correo</a> }
                        else { <span>—</span> }
                    </div>
                </div>
                <div class="det-field" style="grid-column:1/-1;">
                    <div class="det-label">Dirección</div>
                    <div class="det-value">@(Model.direccion ?? "—")</div>
                </div>
                <div class="det-field" style="grid-column:1/-1;">
                    <div class="det-label">Cargo / Puesto</div>
                    <div class="det-value">@(Model.Cargo ?? "—")</div>
                </div>
            </div>
        </div>


        <!-- Panel cambio de estado -->
        <div class="card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
                <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                    <svg viewBox="0 0 24 24" style="width:15px;height:15px;stroke:#d97706;fill:none;stroke-width:1.8;vertical-align:middle;margin-right:5px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    Estado del empleado
                </div>
                <span class="badge @ebc">@(Model.estado ?? "Activo")</span>
            </div>
            @if (Context.Session.GetString("UsuarioRol") == "Admin")
            {
            <form asp-action="CambiarEstado" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idEmpleado" value="@Model.idEmpleado" />
                <div class="form-grid" style="margin-bottom:12px;">
                    <div class="form-group" style="margin:0;">
                        <label class="form-label">Nuevo estado <span class="req">*</span></label>
                        <select name="nuevoEstado" class="form-control" required>
                            <option value="">— Seleccionar —</option>
                            @foreach (var op in new[] { "Activo", "Inactivo", "Licencia", "Suspendido" }) {
                                if (Model.estado == op) { <option value="@op" selected>@op</option> }
                                else                    { <option value="@op">@op</option> }
                            }
                        </select>
                    </div>
                    <div class="form-group" style="margin:0;">
                        <label class="form-label">Observación</label>
                        <input type="text" name="observaciones" class="form-control" maxlength="500"
                               placeholder="Motivo del cambio de estado..." />
                    </div>
                </div>
                <button type="submit" class="btn btn--primary btn--sm"
                        onclick="return confirm('¿Confirmar cambio de estado?')">
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    Registrar cambio
                </button>
            </form>
            }
            @if (estadoLog.Any())
            {
                <div style="margin-top:14px; padding-top:12px; border-top:1px solid var(--gris-200);">
                    <div style="font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gris-400); margin-bottom:8px;">Historial de estados</div>
                    <div style="display:flex; flex-direction:column; gap:5px;">
                        @foreach (var log in estadoLog) {
                            var lcb = log.EstadoNuevo switch {
                                "Activo"     => "badge--verde",
                                "Inactivo"   => "badge--rojo",
                                "Licencia"   => "badge--amarillo",
                                "Suspendido" => "badge--gris",
                                _            => "badge--gris"
                            };
                            <div style="display:flex; align-items:center; gap:8px; padding:6px 10px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200); font-size:0.78rem;">
                                <span style="color:var(--gris-400); font-size:0.7rem; flex-shrink:0;">@log.FechaHora.ToString("dd/MM/yy HH:mm")</span>
                                <span class="badge badge--gris" style="font-size:0.65rem;">@log.EstadoAnterior</span>
                                <svg viewBox="0 0 24 24" style="width:11px;height:11px;stroke:var(--gris-400);fill:none;stroke-width:2;flex-shrink:0;"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                <span class="badge @lcb" style="font-size:0.65rem;">@log.EstadoNuevo</span>
                                @if (!string.IsNullOrEmpty(log.Observaciones)) { <span style="color:var(--gris-600);">@log.Observaciones</span> }
                                <span style="margin-left:auto; color:var(--gris-400); font-size:0.7rem;">@(log.NombreUsuario ?? "—")</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- SEGUROS DEL EMPLEADO -->
        <div class="card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--gris-200);">
                <div style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                    <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:var(--azul);fill:none;stroke-width:1.8;vertical-align:middle;margin-right:6px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    Seguros asignados
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <span class="badge badge--azul">@seguros.Count</span>
                    <a asp-controller="EmpleadoSeguros" asp-action="Asignar" asp-route-idEmpleado="@Model.idEmpleado"
                       class="btn btn--celeste btn--sm">
                        <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Asignar seguro
                    </a>
                </div>
            </div>

            @if (seguros.Any())
            {
                <div style="display:flex; flex-direction:column; gap:8px;">
                    @foreach (var es in seguros)
                    {
                        <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 14px; background:var(--gris-50); border-radius:var(--r-sm); border:1px solid var(--gris-200);">
                            <div>
                                <div style="display:flex; align-items:center; gap:6px;">
                                    <svg viewBox="0 0 24 24" style="width:13px;height:13px;stroke:var(--azul);fill:none;stroke-width:2;flex-shrink:0;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                    <span style="font-weight:600; font-size:0.85rem; color:var(--gris-900);">@es.Seguro?.TipoSeguro</span>
                                </div>
                                <div style="font-size:0.72rem; color:var(--gris-400); margin-top:3px;">
                                    @(es.FechaAsignada.HasValue ? "Desde " + es.FechaAsignada.Value.ToString("dd/MM/yyyy") : "Sin fecha de inicio")
                                    @if (es.FechaCulminada.HasValue) { <span> · Vence @es.FechaCulminada.Value.ToString("dd/MM/yyyy")</span> }
                                </div>
                            </div>
                            <div style="display:flex; gap:4px; flex-shrink:0; margin-left:8px;">
                                <a asp-controller="EmpleadoSeguros" asp-action="Editar"
                                   asp-route-idEmpleado="@Model.idEmpleado" asp-route-idSeguro="@es.IdSeguro"
                                   class="btn btn--ghost btn--icon btn--sm" title="Editar fechas">
                                    <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                                <form asp-controller="EmpleadoSeguros" asp-action="Quitar" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idEmpleado" value="@Model.idEmpleado" />
                                    <input type="hidden" name="idSeguro"   value="@es.IdSeguro" />
                                    <button type="submit" class="btn btn--danger btn--icon btn--sm" title="Quitar seguro"
                                            onclick="return confirm('¿Quitar este seguro del empleado?')">
                                        <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="text-align:center; padding:16px 0; color:var(--gris-400); font-size:0.82rem;">
                    Este empleado no tiene seguros asignados.
                </div>
            }
        </div>

    </div>

    <!-- COLUMNA DERECHA -->
    <div style="display:flex; flex-direction:column; gap:16px;">

        <!-- Grupos -->
        <div class="card">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;">
                <div>
                    <div class="card__title">Grupos asignados</div>
                    <div class="card__subtitle">Áreas a las que pertenece</div>
                </div>
                <a asp-action="Edit" asp-route-id="@Model.idEmpleado"
                   class="btn btn--secondary btn--sm" title="Cambiar grupos">
                    <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    Editar
                </a>
            </div>

            @if (grupos.Any())
            {
                <div style="display:flex; flex-direction:column; gap:6px;">
                    @foreach (var g in grupos)
                    {
                        <div style="display:flex; align-items:center; gap:10px; padding:9px 12px; background:var(--celeste-glow); border:1px solid var(--celeste-border); border-radius:var(--r-sm);">
                            <div style="width:8px; height:8px; border-radius:50%; background:var(--celeste); flex-shrink:0;"></div>
                            <span style="font-size:0.87rem; font-weight:600; color:var(--azul-dark);">@(g?.area ?? "—")</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="text-align:center; padding:16px 0;">
                    <div style="font-size:0.82rem; color:var(--gris-400);">Sin grupos asignados</div>
                    <a asp-action="Edit" asp-route-id="@Model.idEmpleado"
                       class="btn btn--celeste btn--sm" style="margin-top:10px;">
                        Asignar grupo
                    </a>
                </div>
            }
        </div>

    </div>
    @{
    var historial = ViewBag.HistorialCambios as List<PROYJHOME2026.Models.AuditoriaLog>;
}

@if (historial != null && historial.Any())
{
    <div class="card" style="padding:0; overflow:hidden; margin-top:16px;">
        <div style="padding:14px 20px; border-bottom:1px solid var(--gris-200); display:flex; justify-content:space-between; align-items:center;">
            <span style="font-weight:700; font-size:0.9rem; color:var(--gris-900);">
                📋 Historial de cambios
            </span>
            <span class="badge badge--gris">@historial.Count registro(s)</span>
        </div>
        <div style="overflow-x:auto; overflow-y:auto; max-height:500px; border:none; border-radius:0;">
            <table style="min-width:700px;">
                <thead>
                    <tr>
                        <th style="white-space:nowrap; min-width:130px;">Fecha / Hora</th>
                        <th style="min-width:110px;">Acción</th>
                        <th style="min-width:240px;">Descripción / Cambio</th>
                        <th style="min-width:200px;">Datos anteriores</th>
                        <th style="min-width:130px;">Usuario</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in historial)
                    {
                        string accionColor;
                        if      (log.Accion == "Crear")        accionColor = "badge--verde";
                        else if (log.Accion == "Editar")       accionColor = "badge--azul";
                        else if (log.Accion == "Eliminar")     accionColor = "badge--rojo";
                        else if (log.Accion == "CambioEstado") accionColor = "badge--amarillo";
                        else                                    accionColor = "badge--gris";

                        <tr>
                            <td style="font-size:0.75rem; color:var(--gris-400); white-space:nowrap;">
                                @log.FechaHora.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                <span class="badge @accionColor" style="font-size:0.68rem;">@log.Accion</span>
                            </td>
                            <td style="font-size:0.8rem; color:var(--gris-800);">
                                @(log.Descripcion ?? "—")
                            </td>
                            <td style="font-size:0.75rem; color:var(--gris-500);">
                                @if (!string.IsNullOrEmpty(log.DatosAnteriores))
                                {
                                    <span title="@log.DatosAnteriores" style="cursor:help; text-decoration:underline dotted;">
                                        @(log.DatosAnteriores.Length > 80 ? log.DatosAnteriores[..80] + "..." : log.DatosAnteriores)
                                    </span>
                                }
                                else { <span style="color:var(--gris-300);">—</span> }
                            </td>
                            <td style="font-size:0.75rem; color:var(--azul); white-space:nowrap;">
                                @(log.NombreUsuario ?? "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (historial != null)
{
    <div style="margin-top:16px; padding:14px 20px; background:var(--gris-50); border-radius:var(--r-md); border:1px solid var(--gris-200); font-size:0.82rem; color:var(--gris-400);">
        📋 Sin historial de cambios registrado.
    </div>
}

</div>

<!-- ══ CUENTAS BANCARIAS ══════════════════════════════════════ -->
<div class="card" style="margin-top:16px;">
    <div class="card__header">
        <div>
            <div class="card__title">Cuentas bancarias</div>
            <div class="card__subtitle">Datos de depósito del empleado</div>
        </div>
    </div>
    <div style="padding:0 20px 20px;">

        @if (ViewBag.CuentasBancarias != null && ((List<PROYJHOME2026.Models.CuentaBancaria>)ViewBag.CuentasBancarias).Any())
        {
            <div class="table-wrapper" style="border:none; margin:0;">
                <table>
                    <thead>
                        <tr>
                            <th>Banco</th>
                            <th>Tipo</th>
                            <th>N° Cuenta</th>
                            <th>CCI</th>
                            <th>Registrado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var cb in (List<PROYJHOME2026.Models.CuentaBancaria>)ViewBag.CuentasBancarias)
                    {
                        <tr>
                            <td style="font-weight:600; color:var(--azul-dark);">@cb.TipoBanco</td>
                            <td style="font-size:0.82rem; color:var(--gris-500);">@(cb.TipoCuenta ?? "—")</td>
                            <td style="font-family:monospace; font-size:0.85rem;">@cb.NumeroCuenta</td>
                            <td style="font-family:monospace; font-size:0.82rem; color:var(--gris-400);">@(cb.NumeroCCI ?? "—")</td>
                            <td style="font-size:0.75rem; color:var(--gris-400);">@cb.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a asp-controller="CuentasBancarias" asp-action="Editar"
                                   asp-route-id="@cb.IdCuenta"
                                   class="btn btn--sm btn--celeste">Editar</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p style="font-size:0.82rem; color:var(--gris-400); padding:10px 0;">Sin cuentas bancarias registradas.</p>
        }

        <!-- Formulario agregar cuenta -->
        <details style="margin-top:14px;">
            <summary style="cursor:pointer; font-size:0.84rem; font-weight:600; color:var(--celeste); user-select:none;">
                + Agregar cuenta bancaria
            </summary>
            <form asp-controller="CuentasBancarias" asp-action="Crear" method="post"
                  style="margin-top:12px; display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idEmpleado" value="@Model.idEmpleado" />
                <div>
                    <label class="form-label">Banco <span class="req">*</span></label>
                    <select name="tipoBanco" class="form-control" required>
                        <option value="">— Selecciona —</option>
                        <option>BCP</option>
                        <option>Interbank</option>
                        <option>BBVA</option>
                        <option>Scotiabank</option>
                        <option>BanBif</option>
                        <option>Pichincha</option>
                        <option>Nación</option>
                        <option>Mibanco</option>
                        <option>Banbif</option>
                        <option>Otro</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">Tipo de cuenta</label>
                    <select name="tipoCuenta" class="form-control">
                        <option value="">— Selecciona —</option>
                        <option>Ahorro</option>
                        <option>Corriente</option>
                        <option>CTS</option>
                        <option>Sueldo</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">Número de cuenta <span class="req">*</span></label>
                    <input type="text" name="numeroCuenta" class="form-control"
                           placeholder="Ej: 19410XXXXXXXX" required />
                </div>
                <div>
                    <label class="form-label">CCI (opcional)</label>
                    <input type="text" name="numeroCCI" class="form-control"
                           placeholder="20 dígitos" />
                </div>
                <div style="grid-column:1/-1; display:flex; justify-content:flex-end;">
                    <button type="submit" class="btn btn--primary btn--sm">Guardar cuenta</button>
                </div>
            </form>
        </details>
    </div>
</div>

@section Styles {
<style>
.emp-avatar-lg {
    width: 52px; height: 52px; border-radius: 50%;
    background: linear-gradient(135deg, var(--azul-mid), var(--celeste));
    display: grid; place-items: center;
    font-family: var(--font-display); font-weight: 800;
    font-size: 1rem; color: var(--blanco); flex-shrink: 0;
    box-shadow: var(--shadow-cel);
}
.det-label { font-size: 0.67rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gris-400); margin-bottom: 3px; }
.det-value { font-size: 0.88rem; font-weight: 500; color: var(--gris-900); }

/* Layout principal */
.emp-details-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 20px;
    align-items: start;
    max-width: 1000px;
}

@@media (max-width: 820px) {
    .emp-details-layout { grid-template-columns: 1fr; }
}

/* Campos de datos en móvil — 1 columna */
