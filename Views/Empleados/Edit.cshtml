@model PROYJHOME2026.Controllers.EmpleadoFormViewModel
@{
    ViewData["Title"]      = "Editar Empleado";
    ViewData["Breadcrumb"] = "Empleados / Editar";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Recursos Humanos</div>
        <h1 class="page-header__title">Editar Empleado</h1>
        <p class="page-header__subtitle">@Model.Empleado.nombre @Model.Empleado.paterno @Model.Empleado.materno</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Details" asp-route-id="@Model.Empleado.idEmpleado" class="btn btn--ghost btn--sm">
            <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            Ver detalle
        </a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="Empleado.idEmpleado" type="hidden" />

    <div style="display:grid; grid-template-columns:1fr 340px; gap:20px; align-items:start;">

        <!-- ── COLUMNA IZQUIERDA: datos ── -->
        <div class="card">

            <div style="margin-bottom:24px;">
                <p class="form-section-title">Datos personales</p>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Nombre <span class="req">*</span></label>
                        <input asp-for="Empleado.nombre" class="form-control" placeholder="Ej: Juan" />
                        <span asp-validation-for="Empleado.nombre" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Apellido paterno <span class="req">*</span></label>
                        <input asp-for="Empleado.paterno" class="form-control" placeholder="Ej: García" />
                        <span asp-validation-for="Empleado.paterno" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Apellido materno</label>
                        <input asp-for="Empleado.materno" class="form-control" placeholder="Ej: López" />
                        <span asp-validation-for="Empleado.materno" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">DNI <span class="req">*</span></label>
                        <input asp-for="Empleado.dni" class="form-control"
                               maxlength="8" inputmode="numeric" />
                        <span asp-validation-for="Empleado.dni" class="form-error"></span>
                    </div>
                </div>
            </div>

            <div style="margin-bottom:24px;">
                <p class="form-section-title">Contacto</p>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Correo electrónico</label>
                        <input asp-for="Empleado.correo" type="email" class="form-control"
                               placeholder="correo@empresa.com" />
                        <span asp-validation-for="Empleado.correo" class="form-error"></span>
                    </div>
                    <div class="form-group form-group--full">
                        <label class="form-label">Dirección</label>
                        <input asp-for="Empleado.direccion" class="form-control"
                               placeholder="Av. Ejemplo 123, Lima" />
                        <span asp-validation-for="Empleado.direccion" class="form-error"></span>
                    </div>
                </div>
            </div>

            <div>
                <p class="form-section-title">Estado</p>
                <div style="max-width:200px;">
                    <label class="form-label">Estado <span class="req">*</span></label>
                    <select asp-for="Empleado.estado" class="form-control">
                        <option value="">— Seleccionar —</option>
                        <option value="Activo">Activo</option>
                        <option value="Inactivo">Inactivo</option>
                    </select>
                    <span asp-validation-for="Empleado.estado" class="form-error"></span>
                </div>
            </div>

        </div>

        <!-- ── COLUMNA DERECHA: grupos ── -->
        <div style="display:flex; flex-direction:column; gap:16px;">

            <div class="card">
                <p class="form-section-title" style="margin-bottom:12px;">Grupos / Áreas</p>
                <p style="font-size:0.78rem; color:var(--gris-500); margin-bottom:14px;">
                    Los grupos marcados son los que ya tiene asignados. Puedes cambiarlos.
                </p>

                @if (Model.Grupos.Any())
                {
                    <div style="display:flex; flex-direction:column; gap:6px;">
                        @for (int i = 0; i < Model.Grupos.Count; i++)
                        {
                            <label class="grupo-check">
                                <input type="checkbox"
                                       name="Grupos[@i].Marcado"
                                       value="true"
                                       @(Model.Grupos[i].Marcado ? "checked" : "") />
                                <input type="hidden" name="Grupos[@i].IdGrupo" value="@Model.Grupos[i].IdGrupo" />
                                <input type="hidden" name="Grupos[@i].Area"    value="@Model.Grupos[i].Area" />
                                <div class="grupo-check__box">
                                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                </div>
                                <span>@Model.Grupos[i].Area</span>
                            </label>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert--warning" style="margin:0;">
                        <svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        <span>No hay grupos creados. <a asp-controller="Grupos" asp-action="Create" style="color:inherit; text-decoration:underline;">Crear grupo</a>.</span>
                    </div>
                }
            </div>

            <div style="display:flex; flex-direction:column; gap:8px;">
                <button type="submit" class="btn btn--primary btn--lg" style="width:100%; justify-content:center;">
                    <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v14a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    Guardar cambios
                </button>
                <a asp-action="Details" asp-route-id="@Model.Empleado.idEmpleado"
                   class="btn btn--secondary btn--lg" style="width:100%; justify-content:center;">
                    Cancelar
                </a>
            </div>

        </div>
    </div>
</form>

@section Styles {
<style>
.form-section-title {
    font-family: var(--font-display);
    font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--celeste);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--gris-200);
    margin-bottom: 14px;
}
.grupo-check {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 12px;
    border: 1.5px solid var(--gris-300);
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: border-color var(--t), background var(--t);
    user-select: none;
}
.grupo-check:hover { border-color: var(--celeste); background: var(--celeste-glow); }
.grupo-check input[type="checkbox"] { display: none; }
.grupo-check__box {
    width: 18px; height: 18px;
    border: 2px solid var(--gris-300);
    border-radius: 4px;
    display: grid; place-items: center; flex-shrink: 0;
    transition: all var(--t); background: var(--blanco);
}
.grupo-check__box svg {
    width: 11px; height: 11px; stroke: var(--blanco);
    fill: none; stroke-width: 3; stroke-linecap: round;
    opacity: 0; transition: opacity var(--t);
}
.grupo-check input[type="checkbox"]:checked ~ .grupo-check__box {
    background: var(--celeste); border-color: var(--celeste);
}
.grupo-check input[type="checkbox"]:checked ~ .grupo-check__box svg { opacity: 1; }
.grupo-check input[type="checkbox"]:checked ~ span { color: var(--azul-dark); font-weight: 600; }
.grupo-check span { font-size: 0.87rem; color: var(--gris-700); }

@@media (max-width: 760px) {
    form > div { grid-template-columns: 1fr !important; }
}
</style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
