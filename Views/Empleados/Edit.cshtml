@model PROYJHOME2026.Models.Empleado
@{
    ViewData["Title"]      = "Editar Empleado";
    ViewData["Breadcrumb"] = "Empleados / Editar";
}

<div class="page-header">
    <div class="page-header__info">
        <div class="page-header__eyebrow">Recursos Humanos</div>
        <h1 class="page-header__title">Editar Empleado</h1>
        <p class="page-header__subtitle">@Model.nombre @Model.paterno @Model.materno</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Details" asp-route-id="@Model.idEmpleado" class="btn btn--ghost btn--sm">
            <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            Ver detalle
        </a>
        <a asp-action="Index" class="btn btn--secondary">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
    </div>
</div>

<div style="max-width:760px;">
    <div class="card">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="idEmpleado" type="hidden" />

            <!-- Datos personales -->
            <div style="margin-bottom:24px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Datos personales
                </p>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Nombre <span class="req">*</span></label>
                        <input asp-for="nombre" class="form-control" placeholder="Ej: Juan" />
                        <span asp-validation-for="nombre" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Apellido paterno <span class="req">*</span></label>
                        <input asp-for="paterno" class="form-control" placeholder="Ej: García" />
                        <span asp-validation-for="paterno" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Apellido materno</label>
                        <input asp-for="materno" class="form-control" placeholder="Ej: López" />
                        <span asp-validation-for="materno" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">DNI <span class="req">*</span></label>
                        <input asp-for="dni" class="form-control" maxlength="8" inputmode="numeric" />
                        <span asp-validation-for="dni" class="form-error"></span>
                    </div>
                </div>
            </div>

            <!-- Contacto -->
            <div style="margin-bottom:24px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Contacto
                </p>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Correo electrónico</label>
                        <input asp-for="correo" type="email" class="form-control"
                               placeholder="correo@empresa.com" />
                        <span asp-validation-for="correo" class="form-error"></span>
                    </div>
                    <div class="form-group form-group--full">
                        <label class="form-label">Dirección</label>
                        <input asp-for="direccion" class="form-control"
                               placeholder="Av. Ejemplo 123, Lima" />
                        <span asp-validation-for="direccion" class="form-error"></span>
                    </div>
                </div>
            </div>

            <!-- Estado -->
            <div style="margin-bottom:28px;">
                <p style="font-family:var(--font-display); font-size:0.72rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--celeste); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--gris-200);">
                    Estado
                </p>
                <div style="max-width:200px;">
                    <label class="form-label">Estado <span class="req">*</span></label>
                    <select asp-for="estado" class="form-control">
                        <option value="">— Seleccionar —</option>
                        <option value="Activo">Activo</option>
                        <option value="Inactivo">Inactivo</option>
                    </select>
                    <span asp-validation-for="estado" class="form-error"></span>
                </div>
            </div>

            <!-- Acciones -->
            <div style="display:flex; gap:10px; padding-top:4px; border-top:1px solid var(--gris-200);">
                <button type="submit" class="btn btn--primary btn--lg">
                    <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v14a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    Guardar cambios
                </button>
                <a asp-action="Index" class="btn btn--secondary btn--lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
